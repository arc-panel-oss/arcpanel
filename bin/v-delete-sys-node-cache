#!/bin/bash
# info: delete Node.js tarballs from the download cache (E13)
# options: [VERSION]
#
# example: v-delete-sys-node-cache 22.3.0
#
# This function removes one cached Node.js version, or every cached version
# when VERSION is omitted. Runtimes users have installed are not affected;
# the next install of a removed version downloads it again.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
version=${1#v}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/node.sh
source $ARCPANEL/func/node.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ -n "$version" ] && [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
	check_result "$E_INVALID" "invalid version :: $version"
fi
if [ -n "$version" ] && [ ! -d "$NODE_CACHE/v$version" ]; then
	check_result "$E_NOTEXIST" "Node.js v$version is not in the cache"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

delete_version() {
	rm -rf "${NODE_CACHE:?}/v$1"
}

if [ -n "$version" ]; then
	node_with_cache_lock "v$version" delete_version "$version"
else
	for item in $(node_cached_versions); do
		node_with_cache_lock "v$item" delete_version "$item"
	done
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
