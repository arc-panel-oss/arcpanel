#!/bin/bash
# info: send a test message to an alert channel (E16)
# options: SCOPE ID [FORMAT]
#
# example: v-test-alert-channel system 17940000001234
#
# This function sends a test message to channel ID of SCOPE now, also when
# the channel is turned off, and prints the result: ok, or the error of the
# delivery (exit code 15). The channel's STATUS and LAST_SENT are updated;
# a failed test does not count towards turning the channel off. FORMAT json
# prints {"RESULT": "ok|failed", "ERROR": "..."}.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
scope=$1
id=$2
format=${3-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/alerts.sh
source $ARCPANEL/func/alerts.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'SCOPE ID [FORMAT]'
alerts_check_scope "$scope"
if ! alerts_channel_exists "$scope" "$id"; then
	check_result "$E_NOTEXIST" "channel $id does not exist in scope $scope"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

alerts_check_lock
alerts_channel_read "$scope" "$id"
name=${CH[NAME]}
type=${CH[TYPE]}
host=$(alerts_hostname)
title="Test message from ArcPanel on $host"
text="This is a test of the alert channel $name ($type) of $([ "$scope" = system ] && echo 'the server' || echo "$scope")."$'\n'"Time: $(alerts_ts "$(alerts_now)")"$'\n'"Panel: $(alerts_object_url "$scope" '')"
alerts_send_type "$scope" "$title" "$text"
rc=$?
error=$ALERT_SEND_ERROR
alerts_channel_read "$scope" "$id"
ALERT_DELIVERIES='[]'
if [ "$rc" -eq 0 ]; then
	CH[STATUS]=ok
	CH[LAST_SENT]=$(alerts_ts "$(alerts_now)")
	alerts_delivery_add "$id" "$name" "$type" sent ''
else
	CH[STATUS]=${error:0:200}
	alerts_delivery_add "$id" "$name" "$type" failed "$error"
fi
alerts_channel_write "$scope"
alerts_history_add test '' "$scope" '' '' info '' "$title" ''
alerts_unlock

if [ "$format" = 'json' ]; then
	jq -n --arg r "$([ "$rc" -eq 0 ] && echo ok || echo failed)" --arg e "$error" '{RESULT: $r, ERROR: $e}'
elif [ "$rc" -eq 0 ]; then
	echo "ok"
else
	echo "Error: $error"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

if [ "$rc" -ne 0 ]; then
	log_event "$E_CONNECT" "$ARGUMENTS"
	exit "$E_CONNECT"
fi
log_event "$OK" "$ARGUMENTS"

exit
