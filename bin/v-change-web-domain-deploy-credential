#!/bin/bash
# info: renew a credential of a web domain's Git Deploy
# options: USER DOMAIN KIND [VALUE_FILE]
#
# example: v-change-web-domain-deploy-credential alice shop.example.com key
# example: v-change-web-domain-deploy-credential alice shop.example.com token /tmp/token
#
# This function renews a credential of a domain's Git Deploy (E20). KIND
# key creates a new deploy key (pull mode, the authentication becomes key)
# and prints its public part once; token stores the token read from
# VALUE_FILE (pull mode with an https:// URL, the authentication becomes
# token); webhook creates a new webhook secret (pull mode) and prints it
# once; id gives the domain a new ID, so the webhook and upload URLs change.
# Secrets live in the E38 store and are never written to the configuration.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
kind=$3
file=$4

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/domain.sh
source $ARCPANEL/func/domain.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/queuetask.sh
source $ARCPANEL/func/queuetask.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/deploy.sh
source $ARCPANEL/func/deploy.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# Additional argument formatting
format_domain

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN KIND [VALUE_FILE]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
if ! deploy_exists "$user" "$domain"; then
	check_result "$E_NOTEXIST" "deploy is not on for $domain"
fi
mode=$(deploy_get "$user" "$domain" MODE)
case "$kind" in
	key | webhook)
		[ "$mode" = 'pull' ] || check_result "$E_INVALID" "$kind is a credential of pull mode"
		secret_check_system
		;;
	token)
		[ "$mode" = 'pull' ] || check_result "$E_INVALID" "token is a credential of pull mode"
		if [[ "$(deploy_get "$user" "$domain" URL)" != https://* ]]; then
			check_result "$E_INVALID" "a token needs an https:// repository URL"
		fi
		secret_check_system
		secret_check_value_file "$file"
		if [ "$(secret_file_value "$file" | wc -l)" -gt 0 ]; then
			check_result "$E_INVALID" "a token is one line"
		fi
		;;
	id) ;;
	*) check_result "$E_INVALID" "invalid kind :: $kind" ;;
esac
if ! deploy_package_allows "$user"; then
	check_result "$E_FORBIDEN" "the package of $user does not allow Git Deploy"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

case "$kind" in
	key)
		public_key=$(deploy_new_key "$user" "$domain")
		check_result $? "the deploy key could not be created" "$E_FORBIDEN"
		deploy_lock "$user" "$domain"
		deploy_set "$user" "$domain" AUTH=key "PUBLIC_KEY=$public_key"
		deploy_unlock
		echo "PUBLIC_KEY='$public_key'"
		;;
	token)
		secret_file_value "$file" | deploy_store_secret "$user" "$domain" token
		check_result $? "the token could not be stored" "$E_FORBIDEN"
		deploy_lock "$user" "$domain"
		deploy_set "$user" "$domain" AUTH=token
		deploy_unlock
		;;
	webhook)
		webhook_secret=$(deploy_new_webhook_secret "$user" "$domain")
		check_result $? "the webhook secret could not be created" "$E_FORBIDEN"
		echo "WEBHOOK_SECRET='$webhook_secret'"
		;;
	id)
		deploy_lock "$user" "$domain"
		id=$(deploy_new_id)
		deploy_set "$user" "$domain" "ID=$id"
		deploy_unlock
		echo "ID='$id'"
		;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

$BIN/v-log-action "$user" "Info" "Web" "Git Deploy credential renewed (Domain: $domain, Kind: $kind)."
log_event "$OK" "$user $domain $kind"

exit
