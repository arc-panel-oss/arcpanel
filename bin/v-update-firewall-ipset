#!/bin/bash
# info: update firewall ipset
# options: [REFRESH]
#
# example: v-update-firewall-ipset
#
# This function refreshes the IP lists that are expired (no), all lists that
# update automatically (yes) or none (load), then reloads the firewall once

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

refresh=${1:-no}

# Includes
source /etc/profile.d/arcpanel.sh
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

is_refresh_ipset_format_valid "$refresh" 'Refresh IP lists (load/yes/no)'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

ipset_hstobject='../../../data/firewall/ipset'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

for ipset_name in $(search_objects "$ipset_hstobject" 'SUSPENDED' 'no' 'LISTNAME' 2> /dev/null); do

	ipset_time="$(get_object_value "$ipset_hstobject" 'LISTNAME' "$ipset_name" '$TIME')"
	ipset_date="$(get_object_value "$ipset_hstobject" 'LISTNAME' "$ipset_name" '$DATE')"
	ipset_au="$(get_object_value "$ipset_hstobject" 'LISTNAME' "$ipset_name" '$AUTOUPDATE')"

	# The table loads the list files themselves: nothing to do for lists
	# that do not update
	if [ "$ipset_au" = 'no' ] || [ "$refresh" = 'load' ]; then
		continue
	fi

	last_updated_ts=$(date -d "$ipset_date $ipset_time" +%s)
	now=$(date +%s)
	hours_since_update=$(((now - last_updated_ts) / (60 * 60)))

	if [[ "$hours_since_update" -lt 24 ]] && [ "$refresh" = 'no' ]; then
		continue
	fi

	ARCPANEL_FIREWALL_NO_RELOAD=1 $BIN/v-add-firewall-ipset "$ipset_name" '' '' '' 'yes'
done

"$BIN/v-update-firewall"
check_result $? "Unable to reload the firewall" "$E_UPDATE"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
