#!/bin/bash
# info: archive to directory
# options: USER ARCHIVE DIRECTORY [SELECTED_DIR] [STRIP] [TEST]
#
# example: v-extract-fs-archive admin /home/admin/latest.tar.gz /home/admin/latest
#
# This function extracts archive into directory on the file system as the
# user. Both paths must be absolute and inside the user's home; DIRECTORY and
# its missing parents are created. zip, tar, tar.gz/tgz, tar.bz2/tbz, tar.zst,
# 7z (with 7-Zip installed) and rar archives are unpacked into DIRECTORY; a
# single .gz, .bz2 or .zst file is moved into DIRECTORY and decompressed there.

user=$1
src_file=$2
dst_dir=$3
selected_dir=$4
strip=$5
test=$6

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/fs.sh
source $ARCPANEL/func/fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER ARCHIVE DIRECTORY [SELECTED_DIR] [STRIP] [TEST]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

# Checking source and destination paths, then the source
fs_check_path "$src_file"
fs_check_new_path "$dst_dir"
if [ ! -e "$src_file" ]; then
	echo "Error: source file $src_file doesn't exist"
	exit 3
fi

rc=''

if [ -n "$strip" ]; then
	is_int_format_valid "$strip" 'strip-components'
	tar_strip_level="--strip-components $strip"
fi
# Extracting gziped archive
if [ -n "$(echo $src_file | egrep -i '.tgz|.tar.gz')" ]; then
	x='yes'
	if [ -z "$test" ] || [ "$test" = "no" ]; then
		user_exec mkdir -p "$dst_dir" > /dev/null 2>&1
		user_exec tar -xzf "$src_file" -C "$dst_dir" --no-wildcards "$selected_dir" $tar_strip_level > /dev/null 2>&1
		rc=$?
	else
		user_exec tar -tf "$src_file" --no-wildcards "$selected_dir" > /dev/null 2>&1
		rc=$?
	fi
fi

# Extracting bziped archive
if [ -n "$(echo $src_file | egrep -i '.tbz|.tar.bz')" ]; then
	x='yes'
	if [ -z "$test" ] || [ "$test" = "no" ]; then
		user_exec mkdir -p "$dst_dir" > /dev/null 2>&1
		user_exec tar -xjf "$src_file" -C "$dst_dir" --no-wildcards "$selected_dir" $tar_strip_level > /dev/null 2>&1
		rc=$?
	else
		user_exec tar -tf "$src_file" --no-wildcards "$selected_dir" > /dev/null 2>&1
		rc=$?
	fi
fi

# Extracting ZSTD archive
if [ -n "$(echo $src_file | egrep -i '.tar.zst')" ]; then
	x='yes'
	if [ -z "$test" ] || [ "$test" = "no" ]; then
		user_exec mkdir -p "$dst_dir" > /dev/null 2>&1
		user_exec tar -I pzstd -xf "$src_file" -C "$dst_dir" --no-wildcards "$selected_dir" $tar_strip_level > /dev/null 2>&1
		rc=$?
	else
		user_exec tar -I pzstd -tf "$src_file" --no-wildcards "$selected_dir" > /dev/null 2>&1
		rc=$?
	fi
fi

# Extracting gziped file
if [ -n "$(echo $src_file | grep -i '.zst')" ] && [ -z "$x" ]; then
	user_exec mkdir -p "$dst_dir" > /dev/null 2>&1
	user_exec mv "$src_file" "$dst_dir" > /dev/null 2>&1
	user_exec pzstd -d -f "$dst_dir/$(basename $src_file)" > /dev/null 2>&1
	rc=$?
fi

# Extracting gziped file
if [ -n "$(echo $src_file | grep -i '.gz')" ] && [ -z "$x" ]; then
	user_exec mkdir -p "$dst_dir" > /dev/null 2>&1
	user_exec mv "$src_file" "$dst_dir" > /dev/null 2>&1
	user_exec gzip -d -f "$dst_dir/$(basename $src_file)" > /dev/null 2>&1
	rc=$?
fi

# Extracting bziped file
if [ -n "$(echo $src_file | grep -i '.bz')" ] && [ -z "$x" ]; then
	user_exec mkdir -p "$dst_dir" > /dev/null 2>&1
	user_exec mv "$src_file" "$dst_dir" # >/dev/null 2>&1
	user_exec bzip2 -d -f "$dst_dir/$(basename $src_file)" > /dev/null 2>&1
	rc=$?
fi

# Extracting ziped archive
if [ -n "$(echo $src_file | grep -i '.zip')" ]; then
	user_exec mkdir -p "$dst_dir" > /dev/null 2>&1
	user_exec unzip -o "$src_file" -d "$dst_dir" > /dev/null 2>&1
	rc=$?
fi

# Extracting 7z archive: unpacked in place like zip, the archive stays
if [[ "$src_file" =~ \.7[zZ]$ ]]; then
	sevenzip=$(command -v 7z 7za 7zz | head -n 1)
	if [ -z "$sevenzip" ]; then
		check_result "$E_NOTEXIST" "7-Zip (7z, 7za or 7zz) is not installed"
	fi
	user_exec mkdir -p "$dst_dir" > /dev/null 2>&1
	user_exec "$sevenzip" x -y -bd -o"$dst_dir" -- "$src_file" > /dev/null 2>&1
	rc=$?
fi

# Extracting tared archive
if [ -n "$(echo $src_file | grep -i '.tar')" ] && [ -z "$x" ]; then
	x='yes'
	if [ -z "$test" ] || [ "$test" = "no" ]; then
		user_exec mkdir -p "$dst_dir" > /dev/null 2>&1
		user_exec tar -xf "$src_file" -C "$dst_dir" --no-wildcards "$selected_dir" $tar_strip_level > /dev/null 2>&1
		rc=$?
	else
		user_exec tar -tf "$src_file" --no-wildcards "$selected_dir" > /dev/null 2>&1
		rc=$?
	fi
fi

# Extracting rared archive
if [ -n "$(echo $src_file | grep -i '.rar')" ]; then
	user_exec mkdir -p "$dst_dir" > /dev/null 2>&1
	user_exec unrar -x -f "$src_file" "$dst_dir" > /dev/null 2>&1
	rc=$?
fi

# Checking result
if [ -z "$rc" ]; then
	check_result "$E_INVALID" "unsupported archive format $src_file"
fi
if [ "$rc" -ne 0 ]; then
	echo "Error: $src_file was not extracted"
	exit 3
fi

# Exiting
exit
