#!/bin/bash
# info: add a secret to the secret store of a user (E38)
# options: USER NAME VALUE_FILE [DESCRIPTION]
#
# example: v-add-user-secret alice /shop/db_password /tmp/value 'Shop database'
#
# This function stores the value held in VALUE_FILE as version 1 of the
# secret NAME (/path/name: one to five segments of letters, digits, _ . -)
# of USER, encrypted with the user's key. One trailing newline of the file
# is dropped; the value is 1 byte to 32 KiB without NUL bytes. The value is
# never printed or logged; apps reference it as {{secret:NAME}}.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
name=$2
file=$3
description=$4

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER NAME VALUE_FILE [DESCRIPTION]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
secret_check_name "$name"
secret_check_description "$description"
secret_check_value_file "$file"
secret_check_system

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

secret_check_user "$user"
secret_lock "$user"
if secret_exists "$user" "$name"; then
	check_result "$E_EXISTS" "secret $name already exists"
fi
if [ "$(secret_count "$user")" -ge "$(secret_limit)" ]; then
	check_result "$E_LIMIT" "$user has reached the limit of $(secret_limit) secrets"
fi
# Apps may still reference the name of a secret deleted with FORCE
out=$(secret_file_value "$file" | secret_check_value_usable "$user" "$name")
check_result $? "$out"
secret_file_value "$file" | secret_store_version "$user" "$name" "$description" > /dev/null
check_result $? "the secret could not be stored" "$E_FORBIDEN"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

$BIN/v-log-action "$user" "Info" "Secrets" "Secret added (Name: $name)."
log_event "$OK" "$user $name"

exit
