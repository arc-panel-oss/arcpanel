#!/bin/bash
# info: list the logs of a Node.js app (E14)
# options: USER DOMAIN [STREAM] [OFFSET] [LINES] [FORMAT]
#
# example: v-list-node-app-logs alice api.example.com out
# example: v-list-node-app-logs alice api.example.com err 18231 '' json
#
# This function shows a log of the app: STREAM is out (default), err,
# install or build. Without OFFSET it shows the last LINES lines (default
# 200, at most 1000); with OFFSET (bytes) it shows what was written after
# it, at most 256 KB and whole lines only. OFFSET in the output is where
# the next read starts; an offset beyond the end (the log was rotated)
# starts again at 0.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
stream=${3:-out}
offset=$4
lines=${5:-200}
format=${6-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/nodeapp.sh
source $ARCPANEL/func/nodeapp.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# Additional argument formatting
format_domain

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN [STREAM] [OFFSET] [LINES] [FORMAT]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
nodeapp_check_app "$user" "$domain" any
case "$stream" in
	out | err | install | build) ;;
	*) check_result "$E_INVALID" "invalid stream :: $stream (out, err, install or build)" ;;
esac
if [ -n "$offset" ] && ! [[ "$offset" =~ ^[0-9]{1,12}$ ]]; then
	check_result "$E_INVALID" "invalid offset :: $offset"
fi
if ! [[ "$lines" =~ ^[0-9]{1,4}$ ]] || [ "$lines" -lt 1 ] || [ "$lines" -gt 1000 ]; then
	check_result "$E_INVALID" "invalid lines :: $lines (1 to 1000)"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

file="$(nodeapp_dir "$user" "$domain")/logs/$stream.log"
# Read as the user: size, then the text (a file replaced by a symlink is not
# followed)
size=$(node_as_user "$user" bash -c '[ -f "$1" ] && [ ! -L "$1" ] && stat -c %s "$1" || echo 0' log "$file" 2> /dev/null)
size=${size:-0}
if [ -z "$offset" ]; then
	text=$(node_as_user "$user" bash -c '[ -f "$1" ] && [ ! -L "$1" ] && tail -n "$2" "$1" | tail -c 262144' log "$file" "$lines" 2> /dev/null | tr -d '\000')
	next="$size"
else
	if [ "$offset" -gt "$size" ]; then
		offset=0
	fi
	chunk=$(
		node_as_user "$user" bash -c '[ -f "$1" ] && [ ! -L "$1" ] && tail -c +"$(($2 + 1))" "$1" | head -c 262144' log "$file" "$offset" 2> /dev/null | tr -d '\000'
		echo x
	)
	chunk=${chunk%x}
	# Whole lines only: the rest is read next time
	if [[ "$chunk" == *$'\n'* ]]; then
		text=${chunk%$'\n'*}$'\n'
	else
		text=''
	fi
	next=$((offset + $(printf '%s' "$text" | wc -c)))
	text=${text%$'\n'}
fi

json=$(printf '%s' "$text" | jq -Rsc --arg stream "$stream" --arg size "$size" --arg next "$next" '
	{ STREAM: $stream, SIZE: $size, OFFSET: $next, LINES: (if . == "" then [] else split("\n") end) }')

case "$format" in
	json) jq . <<< "$json" ;;
	*) jq -r '.LINES[]' <<< "$json" ;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
