#!/bin/bash
# info: delete access key
# options: ACCESS_KEY_ID
#
# example: v-delete-access-key mykey
#
# This function removes a key from in $ARCPANEL/data/access-keys/

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

access_key_id=$1

check_args '1' "$#" "ACCESS_KEY_ID"
is_format_valid 'access_key_id'
is_object_valid 'key' 'KEY' "$access_key_id"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ ! -d "$ARCPANEL/data/access-keys/" ]; then
	exit "$E_NOTEXIST"
fi

if [[ -e "${ARCPANEL}/data/access-keys/${access_key_id}" ]]; then
	source_conf "${ARCPANEL}/data/access-keys/${access_key_id}"
	rm "${ARCPANEL}/data/access-keys/${access_key_id}"
else
	exit "$E_NOTEXIST"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
log_history "Access key $access_key_id deleted" "Info" "$USER" "API"
log_event "$OK" "$ARGUMENTS"

exit
