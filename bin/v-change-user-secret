#!/bin/bash
# info: change the value of a secret of a user (E38)
# options: USER NAME VALUE_FILE [RESTART]
#
# example: v-change-user-secret alice /shop/db_password /tmp/value yes
#
# This function stores the value held in VALUE_FILE as the next version of
# the secret NAME of USER and keeps the last five versions. It prints the
# apps that reference the secret (node:DOMAIN, docker:NAME); with RESTART
# set to yes it restarts the ones that run, so they get the new value.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
name=$2
file=$3
restart=${4-no}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER NAME VALUE_FILE [RESTART]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
secret_check_name "$name"
secret_check_value_file "$file"
if [ "$restart" != 'yes' ] && [ "$restart" != 'no' ]; then
	check_result "$E_INVALID" "RESTART must be yes or no"
fi
secret_check_system

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

secret_check_user "$user"
secret_lock "$user"
secret_check_exists "$user" "$name"
out=$(secret_file_value "$file" | secret_check_value_usable "$user" "$name")
check_result $? "$out"
secret_file_value "$file" | secret_store_version "$user" "$name" > /dev/null
check_result $? "the secret could not be stored" "$E_FORBIDEN"
secret_after_change "$user" "$name" "$restart"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

$BIN/v-log-action "$user" "Info" "Secrets" "Secret changed (Name: $name)."
log_event "$OK" "$user $name"

exit
