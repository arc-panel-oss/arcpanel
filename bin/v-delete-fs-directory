#!/bin/bash
# info: delete directory
# options: USER DIRECTORY
#
# example: v-delete-fs-directory admin /home/admin/report1
#
# This function deletes directory on the file system as the user. The path
# must be absolute and inside the user's home; the home itself cannot be
# deleted.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

user=$1
dst_dir=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/fs.sh
source $ARCPANEL/func/fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DIRECTORY'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

# Checking destination path
fs_check_entry "$dst_dir"

# Deleting directory
user_exec rm -rf -- "$dst_dir" > /dev/null 2>&1
if [ $? -ne 0 ]; then
	echo "Error: directory $dst_dir was not deleted"
	exit 3
fi

# Exiting
exit
