#!/bin/bash
# info: set up the Node.js manager (E13)
# options: NONE
#
# example: v-add-sys-node
#
# This function prepares a server for per-user Node.js runtimes: the shared
# download cache, the keyring of the Node.js releasers, the release index,
# the daily refresh of the index and the "developer" package, plus the
# 5-minute v-check-sys-node repair job of Node.js apps (E14). It is safe to
# run again and keeps packages an administrator has changed.
# NODE_RELEASES_URL, NODE_SCHEDULE_URL and NODE_NVM_URL in arcpanel.conf
# override the download locations (mirrors, tests).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/node.sh
source $ARCPANEL/func/node.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

COMMON_PACKAGES="$ARCPANEL/install/common/packages"
CRONTAB="/var/spool/cron/crontabs/arcpanelweb"
CRON_LINE="25 04 * * * sudo /usr/local/arcpanel/bin/v-update-sys-node-releases"
CHECK_LINE="*/5 * * * * sudo /usr/local/arcpanel/bin/v-check-sys-node repair > /dev/null 2>&1"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "$(id -u)" != '0' ]; then
	echo "Error: v-add-sys-node can only be executed by the root user"
	exit "$E_FORBIDEN"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Cache and keyring
node_cache_prepare
if ! node_keyring_build; then
	echo "Warning: the keyring of the Node.js releasers could not be built from $NODE_KEYS_SOURCE"
fi

# Release index; a server without network gets it on first use
if [ ! -s "$NODE_CACHE/index.json" ]; then
	node_releases_refresh > /dev/null 2>&1 || true
fi

# Developer package
if [ ! -f "$ARCPANEL/data/packages/developer.pkg" ] && [ -f "$COMMON_PACKAGES/developer.pkg" ]; then
	install -m 644 "$COMMON_PACKAGES/developer.pkg" "$ARCPANEL/data/packages/developer.pkg"
	install -m 644 "$COMMON_PACKAGES/developer.tenancy" "$ARCPANEL/data/packages/developer.tenancy"
	sed -i 's/\r$//' "$ARCPANEL/data/packages/developer.pkg" "$ARCPANEL/data/packages/developer.tenancy"
	# Same nameservers as the default package
	ns=$(grep -m1 "^NS=" "$ARCPANEL/data/packages/default.pkg" 2> /dev/null)
	if [ -n "$ns" ]; then
		sed -i "s/^NS=.*/$ns/" "$ARCPANEL/data/packages/developer.pkg"
	fi
fi
# Node.js apps of the developer package (E14), for servers set up before it
if [ -f "$ARCPANEL/data/packages/developer.tenancy" ] && ! grep -q "^NODE_APPS=" "$ARCPANEL/data/packages/developer.tenancy"; then
	tenancy_pkg_set developer NODE_APPS 10
fi

# Daily refresh of the release index
# (sed, not >>: fs.protected_regular forbids root to open another user's
# file for appending in the sticky crontab directory)
if [ -f "$CRONTAB" ] && ! grep -q "v-update-sys-node-releases" "$CRONTAB"; then
	sed -i -e "\$a$CRON_LINE" "$CRONTAB"
	chown arcpanelweb:arcpanelweb "$CRONTAB"
	chmod 600 "$CRONTAB"
fi

# Node.js apps (E14): converge the daemons and apps every 5 minutes
if [ -f "$CRONTAB" ] && ! grep -q "v-check-sys-node" "$CRONTAB"; then
	sed -i -e "\$a$CHECK_LINE" "$CRONTAB"
	chown arcpanelweb:arcpanelweb "$CRONTAB"
	chmod 600 "$CRONTAB"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
