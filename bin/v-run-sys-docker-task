#!/bin/bash
# info: run the Docker engine task started by v-start-sys-docker-task (E4)
# options: [DATA_ROOT]
#
# example: v-run-sys-docker-task
#
# This function is the command of the docker.engine job that
# v-start-sys-docker-task starts (E15): it runs v-add-sys-docker; the job
# runner records the result. It refuses to run outside such a job.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
data_root=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/job.sh
source $ARCPANEL/func/job.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# Perform verification if read-only mode is enabled (E39 W5 L22)
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if ! job_is_current 'docker\.engine'; then
	check_result "$E_FORBIDEN" "the task was not started by v-start-sys-docker-task"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

echo "$ v-add-sys-docker $data_root"
"$BIN/v-add-sys-docker" ${data_root:+"$data_root"}
rc=$?
if [ "$rc" -ne 0 ]; then
	echo "Exit code $rc"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit "$rc"
