#!/bin/bash
# info: schedule user backup creation
# options: USER [FORMAT]
#
# example: v-schedule-user-backup admin
#
# This function for scheduling user backup creation.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
format=shell

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/queuetask.sh
source $ARCPANEL/func/queuetask.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "$#" -gt 2 ]; then
	check_result "$E_ARGS" "too many arguments"
fi
if [ "$#" -eq 2 ]; then
	format=$2
fi
check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user' 'format'
is_system_enabled "$BACKUP_INCREMENTAL" 'BACKUP_INCREMENTAL'
is_object_valid 'user' 'USER' "$user"
is_incremental_backup_enabled

is_backup_scheduled 'backup'

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Adding backup task to the queue
log=$ARCPANEL/log/backup.log
qt_queue snapshot '' "$ARCPANEL/data/queue/backup.pipe" \
	"$BIN/v-backup-user-restic $user yes >> $log 2>&1"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
