#!/bin/bash
# info: archive directory
# options: USER ARCHIVE SOURCE [SOURCE...]
#
# example: v-add-fs-archive admin /home/admin/archive.tar /home/admin/readme.txt
#
# This function creates tar archive as the user. The archive and every source
# must be absolute paths inside the user's home; the archive must not exist.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

user=$1
archive=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/fs.sh
source $ARCPANEL/func/fs.sh

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER ARCHIVE FILE [FILE_2] [FILE_3] [FILE ...]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

homedir=$(fs_home "$user")
shift 2

# Checking archive path: the archive and the tar written before gzip
tar_file=${archive/.gz/}
fs_check_path "$archive"
fs_check_path "$tar_file"
if [ -e "$archive" ]; then
	echo "Error: archive already exist $archive"
	exit 1
fi

# Checking source paths
for src in "$@"; do
	fs_check_path "$src"
done

for src in "$@"; do
	# Deleting leading home path
	src=${src#"$homedir"/}

	# Creating tar.gz archive
	user_exec tar -rf "$tar_file" -C "$homedir" -- "$src" > /dev/null 2>&1
	if [ "$?" -ne 0 ]; then
		echo "Error: archive $archive was not created"
		exit 3
	fi
done

# Checking gzip
if [[ "$archive" =~ \.gz$ ]]; then
	user_exec gzip -- "$tar_file" > /dev/null 2>&1
	if [ "$?" -ne 0 ]; then
		echo "Error: archive $archive was not gziped"
		exit 3
	fi
fi

exit
