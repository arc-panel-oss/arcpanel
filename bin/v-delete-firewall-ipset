#!/bin/bash
# info: delete firewall ipset
# options: NAME
#
# example: v-delete-firewall-ipset country-nl
#
# This function removes an IP list from the system firewall; a list that an
# active rule uses is refused

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

ip_name=${1}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/firewall.sh
source $ARCPANEL/func/firewall.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'NAME'
is_format_valid 'ip_name'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

# Define variables for ipset configuration
ipset_hstobject='../../../data/firewall/ipset'
is_object_valid "$ipset_hstobject" 'LISTNAME' "$ip_name"
ip_version="$(get_object_value "$ipset_hstobject" 'LISTNAME' "$ip_name" '$IP_VERSION')"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

IPSET_PATH="$ARCPANEL/data/firewall/ipset"
IPSET_FILE="${ip_name}.${ip_version}"

# An active rule that uses the list
in_use=$(grep -F "IP='ipset:${ip_name}'" "$ARCPANEL/data/firewall/rules.conf" 2> /dev/null | grep -F "SUSPENDED='no'" | sed -n "s/^RULE='\([0-9]*\)'.*/\1/p" | head -n 1)
if [ -n "$in_use" ]; then
	check_result "$E_INUSE" "IP list ${ip_name} is used by firewall rule ${in_use}. Cannot remove"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

sed -i "/LISTNAME='$ip_name'/d" "${IPSET_PATH}.conf"
rm -f "${IPSET_PATH}/${IPSET_FILE}.iplist"

if fw_loaded; then
	"$BIN/v-update-firewall"
	check_result $? "Unable to reload the firewall" "$E_UPDATE"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "Firewall" "IPset IP list deleted (Name: $ip_name)."
log_event "$OK" "$ARGUMENTS"

exit
