#!/bin/bash
# info: list a folder of a restic snapshot
# options: USER SNAPSHOT FOLDER
#
# example: v-list-user-files-restic alice 4f2a91c0 /home/alice/web
#
# This function prints `restic ls --json` for FOLDER of a snapshot of USER.
# FOLDER is /home/USER or a folder below it; every argument reaches restic
# quoted and after "--" (E39 W1).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
folder=$3
# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/safe-fs.sh
source $ARCPANEL/func/safe-fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER SNAPSHOT FOLDER'
is_format_valid 'user' 'snapshot'
is_system_enabled "$BACKUP_SYSTEM" 'BACKUP_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

folder="${folder%/}"
if ! is_snapshot_path_valid "$folder"; then
	check_result "$E_FORBIDEN" "the folder is outside the home directory of $user"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

source_conf $ARCPANEL/conf/restic.conf

restic_user "$user" ls --json -- "$snapshot" "$folder"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
