#!/bin/bash
# info: delete firewall rule
# options: RULE
#
# example: v-delete-firewall-rule SSH_BLOCK
#
# This function deletes firewall rule.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
rule=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/firewall.sh
source $ARCPANEL/func/firewall.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'RULE'
is_format_valid 'rule'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'
is_object_valid '../../../data/firewall/rules' 'RULE' "$rule"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# The rules before the change, put back when the load fails
fw_keep_rules

# Deleting rule
sed -i "/RULE='$rule' /d" $ARCPANEL/data/firewall/rules.conf

# Reorder firewall rules
rulesf="$ARCPANEL/data/firewall/rules.conf"

if [[ ! -f "$rulesf" ]]; then
	echo "Error: $rulesf not found" >&2
	exit 1
fi

# An empty file has nothing to reorder, but the table still loses the rule
if [[ -s "$rulesf" ]]; then
	rules_tmp="$(mktemp "${rulesf}.XXXXXX")"
	trap 'rm -f "$rules_tmp"' EXIT

	# Sort by rule number (field 2, quote-delimited) and renumber sequentially
	sort -n -k 2 -t \' "$rulesf" \
		| awk -v q="'" '{ n++; sub("RULE=" q "[0-9]+" q, "RULE=" q n q); print }' \
			> "$rules_tmp"

	mv "$rules_tmp" "$rulesf"
fi

# Updating system firewall; a table nft refuses fails the command
fw_apply_rules

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "Firewall" "Removed firewall rule (ID: $rule)."
log_event "$OK" "$ARGUMENTS"

exit
