#!/bin/bash
# info: delete php fpm version
# options: VERSION
#
# example: v-delete-web-php 7.3
#
# This function removes an installed PHP-FPM version with its extension
# packages. It refuses the default version and a version that web domains use
# (E41).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
version=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/php.sh
source $ARCPANEL/func/php.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'VERSION'

if [ -z "$WEB_BACKEND" ]; then
	echo "Multiple php versions are not supported for modphp"
fi

# Set file locations
php_fpm="/etc/init.d/php$version-fpm"

if ! php_version_format_valid "$version"; then
	check_result "$E_INVALID" "invalid PHP version :: $version (for example 8.3)"
fi
if ! php_version_installed "$version"; then
	check_result "$E_NOTEXIST" "PHP $version is not installed"
fi
if [ "$version" = "$(php_default_version)" ]; then
	check_result "$E_FORBIDEN" "PHP $version is the default version"
fi
used=$(php_used_by "$version" | head -n 5 | paste -sd, -)
if [ -n "$used" ]; then
	check_result "$E_FORBIDEN" "PHP $version is used by web domains: $used"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Every installed package of the version, extensions included
mph=$(dpkg-query -W -f='${Package} ${db:Status-Status}\n' "php$version" "php$version-*" 2> /dev/null \
	| awk '$2 == "installed" { print $1 }' | tr '\n' ' ')

# Purge php packages
# shellcheck disable=SC2086
apt-get -y purge $mph > /dev/null 2>&1 &
BACK_PID=$!

# Check if package removal is done, print a spinner
echo "Removing PHP-$version, please wait..."
spinner="/-\|"
spin_i=1
while kill -0 $BACK_PID > /dev/null 2>&1; do
	printf "\b${spinner:spin_i++%${#spinner}:1}"
	sleep 0.5
done

# Do a blank echo to get the \n back
echo

# Check if removal was successful
if [ -f "$php_fpm" ]; then
	echo "ERROR: Uninstallation failed, please run the following command manually for debugging:"
	echo "apt-get purge $mph"
	check_result "$E_UPDATE" "PHP $version could not be removed"
fi

# Remove the backend template, the php.ini backups and the folder
rm -f "$PHP_FPM_TPL_DIR/$(php_tpl_name "$version").tpl"
rm -rf "$PHP_DATA/ini-backups/$version"
[[ -d /etc/php/$version ]] && rm -rf "/etc/php/$version"
php_apt_cache_clear

if [ "$WEB_BACKEND" = "php-fpm" ]; then
	conf=$(find /etc/php* -name www.conf)
	# Check if www.conf exists
	if [ -z "$conf" ]; then
		# If not grab the "last php version
		last=$($BIN/v-list-sys-php "shell" | tail -n1)
		cp -f $ARCPANEL/install/deb/php-fpm/www.conf /etc/php/$last/fpm/pool.d/www.conf
		$BIN/v-restart-web-backend
	fi
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "System" "Uninstalled PHP $version."
log_event "$OK" "$ARGUMENTS"

exit
