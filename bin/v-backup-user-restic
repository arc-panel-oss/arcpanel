#!/bin/bash
# info: backup system user with all its objects to restic backup
# options: USER NOTIFY
#
# example: v-backup-user-restic admin yes
#
# Backup user with all its objects to restic backup. If the repo doesn't exists a new one will be created.
#

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#
# Argument definition
user=$1
notify=${2-no}
# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/domain.sh
source $ARCPANEL/func/domain.sh
# shellcheck source=/usr/local/arcpanel/func/db.sh
source $ARCPANEL/func/db.sh
# shellcheck source=/usr/local/arcpanel/func/backup.sh
source $ARCPANEL/func/backup.sh
# shellcheck source=/usr/local/arcpanel/func/backuprun.sh
source $ARCPANEL/func/backuprun.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_system_enabled "$BACKUP_INCREMENTAL" 'BACKUP_INCREMENTAL'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_incremental_backup_enabled

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Record this run, failed ones included (Fleet PD2)
br_begin "$user" restic

# Set notification email and subject
subj="$user → backup failed"
email=$(grep CONTACT "$ARCPANEL/data/users/$ROOT_USER/user.conf" | cut -f 2 -d \')

source_conf $ARCPANEL/conf/restic.conf

if [ ! -f "$USER_DATA/restic.conf" ]; then
	password=$(generate_password '' '32')
	echo "$password" > $USER_DATA/restic.conf

	restic --repo "${REPO%/}/$user" --password-file $USER_DATA/restic.conf init
	if [ $? -ne 0 ]; then
		check_result $E_CONNECT "Unable to create restic repo"
	fi
else
	# Check if repo exists and is accessible with restic key
	restic --repo "${REPO%/}/$user" --password-file $USER_DATA/restic.conf --json snapshots > /dev/null
	if [ $? -ne 0 ]; then
		# Send an email
		echo "Unable to open restic backup. It might not exists or key is incorrect" | $SENDMAIL -s "$subj" "$email" "yes"
		check_result $E_CONNECT "Unable to access restic repo"
	fi
fi

# create backup of the user.conf an database
$BIN/v-backup-user-config $user
export GOMAXPROCS=2
export RESTIC_READ_CONCURRENCY=2
# The data of Docker apps lives outside the home (E39 W1)
paths=("/home/$user")
if [ -d "$HOMEDIR/.arcpanel-apps/$user" ] && [ ! -L "$HOMEDIR/.arcpanel-apps/$user" ]; then
	paths+=("$HOMEDIR/.arcpanel-apps/$user")
fi
# Objects of the buckets (E44) when the package allows it, mirrored into a
# root-only folder on the backup disk for the snapshot and removed after it
objects_dir=''
if [ "$OBJECT_STORAGE_SYSTEM" = 'silo' ] && [ -s "$USER_DATA/buckets.conf" ]; then
	# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
	source $ARCPANEL/func/tenancy.sh
	# shellcheck source=/usr/local/arcpanel/func/silo.sh
	source $ARCPANEL/func/silo.sh
	if [ "$(silo_pkg_value "$user" OBJECT_STORAGE_BACKUP)" = 'yes' ] && silo_wait; then
		objects_dir=$(silo_backup_dir "$user")
		rm -rf -- "$objects_dir"
		mkdir -p -m 700 "$objects_dir"
		for bucket in $(silo_buckets "$user"); do
			silo_backup_bucket "$bucket" "$objects_dir/$bucket" || echo "[ ! ] The objects of bucket $bucket could not be read"
		done
		paths+=("$objects_dir")
	fi
fi
# pm2 keeps the environment of running apps, resolved secrets included (E38 D14)
ionice -c2 -n7 nice -n 19 restic --repo "${REPO%/}/$user" --limit-upload 10240 --read-concurrency 2 --password-file $USER_DATA/restic.conf backup "${paths[@]}" \
	--exclude "/home/$user/.pm2/dump.pm2*" --exclude "$HOMEDIR/.arcpanel-apps/$user/*/.incoming"
backup_rc=$?
if [ -n "$objects_dir" ]; then
	rm -rf -- "$objects_dir"
fi

if [ "$backup_rc" -ne 0 ]; then
	echo "Unable to create the backup" | $SENDMAIL -s "$subj" "$email" "yes"
	check_result $E_BACKUP "Unable to backup user"
fi

# The snapshot of this run: the repository holds only this user's
# shellcheck disable=SC2034
BR_ARCHIVE=$(restic --repo "${REPO%/}/$user" --password-file $USER_DATA/restic.conf --json snapshots --latest 1 2> /dev/null \
	| jq -r 'sort_by(.time) | last | .short_id // empty' 2> /dev/null)

if [[ -n "$SNAPSHOTS" && "$SNAPSHOTS" -ge 0 ]]; then
	restic_prune="$restic_prune --keep-last $SNAPSHOTS"
fi
if [[ -n "$KEEP_DAILY" && "$KEEP_DAILY" -ge 0 ]]; then
	restic_prune="$restic_prune --keep-daily $KEEP_DAILY"
fi
if [[ -n "$KEEP_WEEKLY" && "$KEEP_WEEKLY" -ge 0 ]]; then
	restic_prune="$restic_prune --keep-weekly $KEEP_WEEKLY"
fi
if [[ -n "$KEEP_MONTHLY" && "$KEEP_MONTHLY" -ge 0 ]]; then
	restic_prune="$restic_prune --keep-monthly $KEEP_MONTHLY"
fi
if [[ -n "$KEEP_YEARLY" && "$KEEP_YEARLY" -ge 0 ]]; then
	restic_prune="$restic_prune --keep-yearly $KEEP_YEARLY"
fi

restic --repo "${REPO%/}/$user" --password-file $USER_DATA/restic.conf forget $restic_prune --prune

# Send notification
if [ -e "$BACKUP/$user.log" ] && [ "$notify" = "yes" ]; then
	subj="$user → backup has been completed"
	email=$(get_user_value '$CONTACT')
	cat $BACKUP/$user.log | $SENDMAIL -s "$subj" "$email" "$notify"
	$BIN/v-add-user-notification "$user" "Snapshot created successfully" "Snap shot of user successfully created"
fi

# Deleting task from queue
sed -i "/v-backup-user-restic $user /d" $ARCPANEL/data/queue/backup.pipe

# Logging
$BIN/v-log-action "$user" "Info" "Backup" "Backup created."
$BIN/v-log-action "system" "Info" "Backup" "Backup created (User: $user)."
log_event "$OK" "$ARGUMENTS"

exit
