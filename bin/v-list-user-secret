#!/bin/bash
# info: list one secret of a user (E38)
# options: USER NAME [FORMAT]
#
# example: v-list-user-secret alice /shop/db_password json
#
# This function lists the secret NAME of USER: description, current version,
# fingerprint, the kept versions with their fingerprints and dates, and the
# apps that reference it (node:DOMAIN, docker:NAME). It never prints a value.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
name=$2
format=${3-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# VERSION|FINGERPRINT|TIME|DATE per kept version, oldest first
version_rows() {
	local v
	while IFS= read -r v; do
		[ -n "$v" ] || continue
		echo "$(secret_field "$v" VERSION)|$(secret_field "$v" FINGERPRINT)|$(secret_field "$v" TIME)|$(secret_field "$v" DATE)"
	done < <(secret_versions "$user" "$name") | sort -t'|' -k1,1n
}

json_list() {
	local version fingerprint time date i=0 used
	echo '{'
	printf '    %s: {\n' "$(secret_json_string "$name")"
	printf '        "NAME": %s,\n' "$(secret_json_string "$name")"
	printf '        "DESCRIPTION": %s,\n' "$(secret_json_string "$(secret_field "$line" DESCRIPTION)")"
	printf '        "VERSION": "%s",\n' "$(secret_field "$line" VERSION)"
	printf '        "FINGERPRINT": "%s",\n' "$(secret_field "$line" FINGERPRINT)"
	printf '        "REFERENCE": %s,\n' "$(secret_json_string "{{secret:$name}}")"
	echo '        "VERSIONS": ['
	while IFS='|' read -r version fingerprint time date; do
		if [ "$i" -gt 0 ]; then
			echo ','
		fi
		i=$((i + 1))
		printf '            {"VERSION": "%s", "FINGERPRINT": "%s", "TIME": "%s", "DATE": "%s"}' "$version" "$fingerprint" "$time" "$date"
	done < <(version_rows)
	if [ "$i" -gt 0 ]; then
		echo
	fi
	echo '        ],'
	printf '        "USED_BY": ['
	i=0
	while IFS= read -r used; do
		[ -n "$used" ] || continue
		if [ "$i" -gt 0 ]; then
			printf ', '
		fi
		i=$((i + 1))
		printf '%s' "$(secret_json_string "$used")"
	done <<< "$users"
	echo '],'
	printf '        "TIME": "%s",\n' "$(secret_field "$line" TIME)"
	printf '        "DATE": "%s"\n' "$(secret_field "$line" DATE)"
	echo '    }'
	echo '}'
}

shell_list() {
	echo "NAME:          $name"
	echo "DESCRIPTION:   $(secret_field "$line" DESCRIPTION)"
	echo "VERSION:       $(secret_field "$line" VERSION)"
	echo "FINGERPRINT:   $(secret_field "$line" FINGERPRINT)"
	echo "VERSIONS:      $(secret_field "$line" VERSIONS)"
	echo "USED_BY:       $(echo "$users" | tr '\n' ' ')"
	echo "DATE:          $(secret_field "$line" DATE) $(secret_field "$line" TIME)"
}

plain_list() {
	echo -e "$name\t$(secret_field "$line" DESCRIPTION)\t$(secret_field "$line" VERSION)\t$(secret_field "$line" FINGERPRINT)\t$(secret_field "$line" VERSIONS)\t$(echo "$users" | tr '\n' ' ')\t$(secret_field "$line" TIME)\t$(secret_field "$line" DATE)"
}

csv_list() {
	echo "NAME,DESCRIPTION,VERSION,FINGERPRINT,VERSIONS,USED_BY,TIME,DATE"
	echo "$name,\"$(secret_field "$line" DESCRIPTION)\",$(secret_field "$line" VERSION),$(secret_field "$line" FINGERPRINT),\"$(secret_field "$line" VERSIONS)\",\"$(echo "$users" | tr '\n' ' ')\",$(secret_field "$line" TIME),$(secret_field "$line" DATE)"
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER NAME [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
secret_check_name "$name"
secret_check_exists "$user" "$name"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

line=$(secret_line "$user" "$name")
users=$(secret_used_by "$user" "$name")
case $format in
	json) json_list ;;
	plain) plain_list ;;
	csv) csv_list ;;
	shell) shell_list ;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
