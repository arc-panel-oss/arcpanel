#!/bin/bash
# info: queue a Let's Encrypt certificate for a web or mail domain
# options: USER DOMAIN [ALIASES] [KEY_ALGO] [MAIL] [FORMAT]
#
# example: v-schedule-letsencrypt-domain admin example.com www.example.com ecdsa-256
# example: v-schedule-letsencrypt-domain admin example.com '' ecdsa-256 yes
#
# This function queues a Let's Encrypt certificate: the letsencrypt queue,
# run by cron every five minutes, issues it with v-add-letsencrypt-domain.
# ALIASES defaults to the aliases of the web domain, KEY_ALGO (rsa,
# ecdsa-256, ecdsa-384) to its current key type. MAIL=yes queues the
# certificate of the mail domain (no aliases) and leaves a queued web
# certificate of the same domain in place.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
aliases=$3
key_algo="${4,,}"
mail="${5,,}"
format=shell

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/queuetask.sh
source $ARCPANEL/func/queuetask.sh
# shellcheck source=/usr/local/arcpanel/func/domain.sh
source $ARCPANEL/func/domain.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "$#" -gt 6 ]; then
	check_result "$E_ARGS" "too many arguments"
fi
if [ "$#" -eq 6 ]; then
	format=$6
fi
check_args '2' "$#" 'USER DOMAIN [ALIASES] [KEY_ALGO] [MAIL] [FORMAT]'
is_format_valid 'user' 'domain' 'aliases' 'key_algo' 'format'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_system_enabled "$WEB_SSL" 'SSL_SUPPORT'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
if [ -n "$mail" ] && [ "$mail" != "yes" ] && [ "$mail" != "no" ]; then
	check_result "$E_INVALID" "MAIL must be yes or no"
fi
if [ "$mail" = "yes" ]; then
	is_object_valid 'mail' 'DOMAIN' "$domain"
	is_object_unsuspended 'mail' 'DOMAIN' "$domain"
else
	is_object_valid 'web' 'DOMAIN' "$domain"
	is_object_unsuspended 'web' 'DOMAIN' "$domain"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Parsing domain aliases and key type
if [ "$mail" != "yes" ]; then
	get_domain_values 'web'
	if [ -z "$aliases" ]; then
		aliases="$ALIAS"
	fi
fi
if [ -z "$key_algo" ]; then
	key_algo="${SSL_KEY_ALGO:-ecdsa-256}"
	is_format_valid 'key_algo'
fi

# Adding cronjob scheduler for LE
$BIN/v-add-cron-letsencrypt-job

# One queued line per domain and kind. A web line and a mail line may both wait.
# Replacing a line marks its task failed; the new line carries a new id.
pipe=$ARCPANEL/data/queue/letsencrypt.pipe
touch "$pipe"
qt_lock
if [ "$mail" = "yes" ]; then
	qt_fail_replaced "$pipe" "v-add-letsencrypt-domain ${user} ${domain} '' yes "
	sed -i "\|v-add-letsencrypt-domain ${user} ${domain} '' yes |d" "$pipe"
	qt_create_unlocked letsencrypt "$domain mail"
	printf '%s%s\n' "$(qt_prefix)" \
		"$BIN/v-add-letsencrypt-domain $user $domain '' yes $key_algo" >> "$pipe"
else
	qt_fail_replaced "$pipe" "v-add-letsencrypt-domain ${user} ${domain} '.*' no "
	sed -i "\|v-add-letsencrypt-domain ${user} ${domain} '.*' no |d" "$pipe"
	qt_create_unlocked letsencrypt "$domain"
	printf '%s%s\n' "$(qt_prefix)" \
		"$BIN/v-add-letsencrypt-domain $user $domain '$aliases' no $key_algo" >> "$pipe"
fi
qt_cleanup_unlocked
qt_unlock
qt_emit_id "$QT_ID" "$format"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
