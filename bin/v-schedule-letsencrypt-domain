#!/bin/bash
# info: queue a Let's Encrypt certificate for a web domain
# options: USER DOMAIN [ALIASES] [KEY_ALGO]
#
# example: v-schedule-letsencrypt-domain admin example.com www.example.com ecdsa-256
#
# This function queues a Let's Encrypt certificate for a web domain: the
# letsencrypt queue, run by cron every five minutes, issues it with
# v-add-letsencrypt-domain. ALIASES defaults to the aliases of the domain,
# KEY_ALGO (rsa, ecdsa-256, ecdsa-384) to its current key type.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
aliases=$3
key_algo="${4,,}"

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/domain.sh
source $ARCPANEL/func/domain.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN [ALIASES] [KEY_ALGO]'
is_format_valid 'user' 'domain' 'aliases' 'key_algo'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_system_enabled "$WEB_SSL" 'SSL_SUPPORT'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Parsing domain aliases and key type
get_domain_values 'web'
if [ -z "$aliases" ]; then
	aliases="$ALIAS"
fi
if [ -z "$key_algo" ]; then
	key_algo="${SSL_KEY_ALGO:-ecdsa-256}"
	is_format_valid 'key_algo'
fi

# Adding cronjob scheduler for LE
$BIN/v-add-cron-letsencrypt-job

# Adding LE task (MAIL 'no': the web domain), replacing one queued before
touch $ARCPANEL/data/queue/letsencrypt.pipe
sed -i "/ $domain /d" $ARCPANEL/data/queue/letsencrypt.pipe
echo "$BIN/v-add-letsencrypt-domain $user $domain '$aliases' no $key_algo" \
	>> $ARCPANEL/data/queue/letsencrypt.pipe

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
