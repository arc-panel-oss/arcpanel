#!/bin/bash
# info: list the PHP versions the panel knows and their state (E7 batch 3, E41)
# options: [FORMAT]
#
# example: v-list-sys-php-versions json
#
# This function lists every version of the PHP version catalog
# (install/common/php/versions.conf) and any installed version the catalog
# does not list, with INSTALLED (yes or no), DEFAULT (yes for the version of
# the system php binary), USED_BY (the USER/DOMAIN web domains whose backend
# template uses it, comma-separated), STATUS (active, security, eol or
# unknown), RELEASED, ACTIVE_UNTIL, EOL, INSTALLABLE (the catalog allows new
# installs), AVAILABLE (the PHP repository of the server provides it) and
# EXTENSIONS (the number of modules enabled for PHP-FPM).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/php.sh
source $ARCPANEL/func/php.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

versions=$({
	php_catalog_versions
	php_installed_versions
} | sort -uV)

# One apt-cache call for every version
packages=()
for version in $versions; do
	packages+=("php$version-fpm")
done
if [ "${#packages[@]}" -gt 0 ]; then
	php_apt_refresh "${packages[@]}"
fi

default=$(php_default_version)
json='{}'
for version in $versions; do
	installed=no
	extensions=0
	if php_version_installed "$version"; then
		installed=yes
		extensions=$(php_mods_enabled "$version" fpm | grep -c .)
	fi
	is_default=no
	if [ "$version" = "$default" ]; then
		is_default=yes
	fi
	installable=no
	if php_version_installable "$version"; then
		installable=yes
	fi
	available=no
	if php_version_available "$version"; then
		available=yes
	fi
	used_by=$(php_used_by "$version" | paste -sd, -)
	json=$(jq -c --arg v "$version" --arg i "$installed" --arg d "$is_default" --arg u "$used_by" \
		--arg s "$(php_version_status "$version")" --arg r "$(php_catalog_get "$version" RELEASED)" \
		--arg a "$(php_catalog_get "$version" ACTIVE_UNTIL)" --arg e "$(php_catalog_get "$version" EOL)" \
		--arg n "$installable" --arg av "$available" --arg x "$extensions" \
		'. + {($v): {INSTALLED: $i, DEFAULT: $d, USED_BY: $u, STATUS: $s, RELEASED: $r,
			ACTIVE_UNTIL: $a, EOL: $e, INSTALLABLE: $n, AVAILABLE: $av, EXTENSIONS: $x}}' <<< "$json")
done

case "$format" in
	json) jq . <<< "$json" ;;
	plain) jq -r 'to_entries[] | [.key, .value.INSTALLED, .value.DEFAULT, .value.USED_BY, .value.STATUS,
		.value.RELEASED, .value.ACTIVE_UNTIL, .value.EOL, .value.INSTALLABLE, .value.AVAILABLE,
		.value.EXTENSIONS] | join("\t")' <<< "$json" ;;
	*)
		{
			echo "VERSION INSTALLED DEFAULT STATUS EOL INSTALLABLE AVAILABLE EXTENSIONS USED_BY"
			echo "------- --------- ------- ------ --- ----------- --------- ---------- -------"
			jq -r 'to_entries[] | [.key] + ([.value | .INSTALLED, .DEFAULT, .STATUS, .EOL, .INSTALLABLE,
				.AVAILABLE, .EXTENSIONS, .USED_BY] | map(if . == "" then "-" else . end)) | join(" ")' <<< "$json"
		} | column -t
		;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
