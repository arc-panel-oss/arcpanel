#!/bin/bash
# info: delete user backup
# options: USER BACKUP [DESTINATION]
#
# example: v-delete-user-backup admin admin.2012-12-21_00-10-00.tar
#          v-delete-user-backup alice alice.2026-10-22_05-10-00.tar offsite
#
# This function deletes user backup from every destination that holds it,
# or from DESTINATION only (E48); the record goes when no destination holds
# the archive any more.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
backup=$2
destination=$3

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/backup.sh
source $ARCPANEL/func/backup.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/backup-driver.sh
source $ARCPANEL/func/backup-driver.sh
# shellcheck source=/usr/local/arcpanel/func/backup-job.sh
source $ARCPANEL/func/backup-job.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER BACKUP [DESTINATION]'
is_format_valid 'user' 'backup'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'backup' 'BACKUP' "$2"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

dests=$(bj_archive_destinations "$user" "$backup")
if [ -n "$destination" ]; then
	if [[ ",$dests," != *",$destination,"* ]]; then
		check_result "$E_NOTEXIST" "$destination does not hold $backup"
	fi
	dests=$destination
fi
bd_session
for dest in ${dests//,/ }; do
	bj_delete_archive "$user" "$backup" "$dest"
done
if [ -z "$destination" ]; then
	# A copy fetched to the server for a restore or a download
	rm -f "$BACKUP/$backup"
	sed -i "/^BACKUP='$backup' /d" "$USER_DATA/backup.conf"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Update counter
U_BACKUPS=$(grep BACKUP $USER_DATA/backup.conf | wc -l)
update_user_value "$user" '$U_BACKUPS' "$U_BACKUPS"

# Logging
$BIN/v-log-action "$user" "Info" "Backup" "Deleted backup (Archive: $backup)."
log_event "$OK" "$ARGUMENTS"

exit
