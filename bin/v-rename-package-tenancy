#!/bin/bash
# info: rename the reseller settings of a package
# options: OLD_NAME NEW_NAME
#
# example: v-rename-package-tenancy starter basic
#
# This function moves the reseller settings of a package to its new name and
# updates RESELLER_PACKAGES lists that name it. The panel runs it after
# v-rename-user-package.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
old_name=$1
new_name=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'OLD_NAME NEW_NAME'
is_object_format_valid "$old_name" 'old_name'
is_object_format_valid "$new_name" 'new_name'
is_package_valid "$new_name"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

old_file=$(tenancy_package_file "$old_name")
if [ -f "$old_file" ]; then
	mv -f "$old_file" "$(tenancy_package_file "$new_name")"
fi

for package in $(tenancy_all_packages); do
	list=$(tenancy_pkg_get "$package" RESELLER_PACKAGES)
	if [[ ",$list," == *",$old_name,"* ]]; then
		list=",$list,"
		list="${list//,$old_name,/,$new_name,}"
		list="${list#,}"
		tenancy_pkg_set "$package" RESELLER_PACKAGES "${list%,}"
	fi
done

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
