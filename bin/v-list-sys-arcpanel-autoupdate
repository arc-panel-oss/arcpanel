#!/bin/bash
# info: list hestia autoupdate settings (alias of v-list-sys-hestia-autoupdate)
# options: [FORMAT]
#
# example: v-list-sys-arcpanel-autoupdate
#
# ArcPanel name for v-list-sys-hestia-autoupdate. It runs the original command with the same
