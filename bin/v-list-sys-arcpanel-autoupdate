#!/bin/bash
# info: list arcpanel autoupdate settings
# options: [FORMAT]
#
# example: v-list-sys-arcpanel-autoupdate
#
# This function for obtaining autoupdate settings. Since 2.5.0 automatic
# updates are enabled when the update policy is patch
# (docs/features/specs/2026-10-20-005-e33-update-center-phase-1-design.md
# §10; v-list-sys-update-policy lists the whole policy).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/updates.sh
source $ARCPANEL/func/updates.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# JSON list function
json_list() {
	echo '['
	if [ -z "$check_cron" ]; then
		echo -e "\t\"Disabled\""
	else
		echo -e "\t\"Enabled\""
	fi
	echo "]"
}

# SHELL list function
shell_list() {
	echo -n "AUTOUPDATE:     "
	if [ -z "$check_cron" ]; then
		echo "Disabled"
	else
		echo "Enabled"
	fi
}

# PLAIN list function
plain_list() {
	if [ -z "$check_cron" ]; then
		echo "Disabled"
	else
		echo "Enabled"
	fi
}

# CSV list function
csv_list() {
	echo "AUTOUPDATE"
	if [ -z "$check_cron" ]; then
		echo "Disabled"
	else
		echo "Enabled"
	fi
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Enabled with the policy patch
check_cron=''
if [ "$(upd_policy_get UPDATE_POLICY)" = 'patch' ]; then
	check_cron='yes'
fi

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	csv) csv_list ;;
	shell) shell_list ;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
