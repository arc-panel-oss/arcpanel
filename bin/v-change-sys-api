#!/bin/bash
# info: Enable / Disable API access
# options: STATUS [VERSION]
#
# example: v-change-sys-api enable api
#          # Enable access keys and REST API v2 (API_SYSTEM)
# example: v-change-sys-api enable v1
#          # Enable REST API v1 (lib/api, API_V1)
# example: v-change-sys-api enable legacy
#          # Enable REST API v1 with the legacy hash and password login (API)
# example: v-change-sys-api enable all
#          # All of the above
#
# example: v-change-sys-api disable
#          # Disable every API and clear the allowed addresses
#
# The switches are configuration keys only; lib/api/index.php ships in the
# package and reads API_V1 (E39 W4 D9).

status=$1
version=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

check_args '1' "$#" "STATUS" "VERSION"
is_type_valid "enable,disable" "$status"
if [ -n "$version" ]; then
	is_type_valid "legacy,api,v1,all" "$version"
fi
# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ "$status" = "enable" ]; then
	if [ "$version" = "legacy" ] || [ "$version" = "all" ]; then
		$BIN/v-change-sys-config-value "API" "yes"
	fi
	if [ "$version" = "legacy" ] || [ "$version" = "v1" ] || [ "$version" = "all" ]; then
		$BIN/v-change-sys-config-value "API_V1" "yes"
	fi
	if [ "$version" = "api" ] || [ "$version" = "all" ]; then
		$BIN/v-change-sys-config-value "API_SYSTEM" "1"
	fi
else
	$BIN/v-change-sys-config-value "API" "no"
	$BIN/v-change-sys-config-value "API_V1" "no"
	$BIN/v-change-sys-config-value "API_ALLOWED_IP" ""
	$BIN/v-change-sys-config-value "API_SYSTEM" "0"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
if [ "$status" = "enable" ]; then
	$BIN/v-log-action "system" "Warning" "System" "System API access enabled."
else
	$BIN/v-log-action "system" "Info" "System" "System API access disabled."
fi
log_event "$OK" "$ARGUMENTS"
