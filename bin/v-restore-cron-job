#!/bin/bash
# info: restore single cron job
# options: USER BACKUP DOMAIN [NOTIFY]
#
# example: v-restore-cron-job USER BACKUP CRON [NOTIFY]
#
# This function allows the user to restore a single cron job
# from a backup archive.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
backup=$2
cronjob=$3
notify=$4

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

args_usage='USER BACKUP CRON [NOTIFY]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user' 'backup'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

$BIN/v-restore-user "$user" "$backup" 'no' 'no' 'no' 'no' "$cronjob" 'no' "$notify"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
