#!/bin/bash
# info: Install update from Git repository (alias of v-update-sys-hestia-git)
# options: REPOSITORY BRANCH INSTALL
#
# example: v-update-sys-arcpanel-git
#
# ArcPanel name for v-update-sys-hestia-git. It runs the original command with the same
# arguments, so output, exit codes and logging are identical (ADR-0006).

exec "$(dirname "$(readlink -f "$0")")/v-update-sys-hestia-git" "$@"
