#!/bin/bash
# info: change php.ini directives of a PHP version (E41)
# options: VERSION SAPI FILE
#
# example: v-change-sys-php-ini-values 8.4 fpm /tmp/values
#
# This function changes directives of the php.ini form in the PHP-FPM (fpm)
# or command line (cli) php.ini of an installed version. FILE holds
# directive=value lines (memory_limit=256M); each directive is replaced in
# place, or added at the end of the [PHP] section when the file does not set
# it, and comments are kept. The result is validated, saved and applied as
# v-change-sys-php-ini does.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
version=$1
sapi=$2
src=$3

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/php.sh
source $ARCPANEL/func/php.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'VERSION SAPI FILE'
php_ini_check_args "$version" "$sapi"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

php_lock "$version"
# Only a file the panel wrote (E39 W5 P1)
is_panel_file_valid "$src"
php_ini_intake "$src"
values=$PHP_INI_CANDIDATE
candidate=$(php_tmp_file ini)
trap 'rm -f "$values" "$candidate"' EXIT

if ! out=$(php_ini_helper "$version" merge "$(php_ini_file "$version" "$sapi")" "$values" "$candidate" "$sapi" 2>&1); then
	check_result "$E_INVALID" "${out:-the values could not be applied}"
fi

if ! findings=$(php_ini_validate "$version" "$sapi" "$candidate"); then
	php_ini_findings_text <<< "$findings"
	check_result "$E_INVALID" "the php.ini was not saved"
fi
php_ini_findings_text <<< "$findings"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

id=$(php_ini_apply "$version" "$sapi" "$candidate")
rc=$?
if [ "$rc" -ne 0 ]; then
	echo "$id"
	check_result "$rc" "PHP-FPM $version did not run with the new php.ini; the previous file was restored"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
directives=$(cut -d= -f1 "$values" | grep -E '^[a-z0-9_.]+$' | paste -sd, -)
$BIN/v-log-action "system" "Info" "System" "php.ini changed (Version: $version, SAPI: $sapi, Directives: $directives, Backup: $id)."
log_event "$OK" "$ARGUMENTS"

exit
