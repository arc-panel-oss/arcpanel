#!/bin/bash
# info: delete arcpanel autoupdate cron job
# options: NONE
#
# example: v-delete-cron-arcpanel-autoupdate
#
# This function turns automatic updates off. Since 2.5.0 it sets the update
# policy notify with v-change-sys-update-policy, which still announces new
# versions and installs none, and keeps the window and the delay
# (docs/features/specs/2026-10-20-005-e33-update-center-phase-1-design.md
# §10); the policy off stays off. It also removes the nightly line of
# v-update-sys-arcpanel-git.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/updates.sh
source $ARCPANEL/func/updates.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

is_system_enabled "$CRON_SYSTEM" 'CRON_SYSTEM'

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if grep -q 'v-update-sys-arcpanel-git' "$UPD_CRONTAB"; then
	sed -i "/v-update-sys-arcpanel-git/d" "$UPD_CRONTAB"
	$BIN/v-restart-cron
	check_result $? "Cron restart failed" > /dev/null
	$BIN/v-log-action "system" "Warning" "Updates" "Automatic updates from Git disabled."
fi

policy='notify'
if [ "$(upd_policy_get UPDATE_POLICY)" = 'off' ]; then
	policy='off'
fi
# shellcheck disable=SC2046
$BIN/v-change-sys-update-policy $(upd_policy_args "$policy")
check_result $? "Update policy change failed" > /dev/null

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
