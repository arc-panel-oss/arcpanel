#!/bin/bash
# info: change file permission
# options: USER FILE PERMISSIONS
#
# example: v-change-fs-file-permission admin /home/admin/readme.txt 0777
#
# This function changes file access permissions on the file system as the
# user. The path must be absolute and inside the user's home; PERMISSIONS is
# an octal mode.

user=$1
src_file=$2
permissions=$3

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/fs.sh
source $ARCPANEL/func/fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER FILE PERMISSIONS'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

# Checking source path, then the file
fs_check_path "$src_file"
if [ ! -f "$src_file" ]; then
	echo "Error: source file doesn't exist $src_file"
	exit 3
fi

if ! fs_mode_valid "$permissions"; then
	check_result "$E_INVALID" "invalid permissions $permissions"
fi

# Changing file permissions
user_exec chmod -R "$permissions" -- "$src_file" > /dev/null 2>&1
if [ $? -ne 0 ]; then
	echo "Error: access permission on $src_file was not changed"
	exit 3
fi

$BIN/v-log-action "system" "Info" "System" "File system permissions changed (User: $user, File: $src_file, Permissions: $permissions)."

# Exiting
exit
