#!/bin/bash
# info: delete ssh key
# options: USER KEY
#
# example: v-delete-user-ssh-key user unique_id
#
# Delete user ssh key from authorized_keys

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
keyid=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source "$ARCPANEL/func/main.sh"
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"
# Additional argument formatting

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER KEYID'
is_format_valid 'user'
is_no_new_line_format "$keyid"
is_object_valid 'user' 'USER' "$user"

AUTHKEY_FILE="$HOMEDIR/$user/.ssh/authorized_keys"
# An early, readable error; the safety comes from working as the user
if ! readlink -f "$AUTHKEY_FILE" | grep -Eq "^$HOMEDIR/$user/.ssh/"; then
	check_result "$E_FORBIDEN" "Invalid authorized keys path"
fi

if ! user_exec test -f "$AUTHKEY_FILE"; then
	exit
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Filter the file into a new one next to it and rename it over the old
# one, all as the user (E39 W1)
user_exec sh -c 'umask 077
f="$1/authorized_keys"
t=$(mktemp "$1/.authorized_keys.XXXXXX") || exit 1
awk -v id="$2" '"'"'{
    value = $0
    sub(/^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+/, "", value)

    if (value != id)
        print
}'"'"' "$f" > "$t" && chmod --reference="$f" "$t" && mv -f "$t" "$f" || { rm -f "$t"; exit 1; }' sh "$HOMEDIR/$user/.ssh" "$keyid"
check_result $? "the key could not be removed from $AUTHKEY_FILE" "$E_FORBIDEN"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
"$BIN/v-log-action" "$user" "Info" "SSH" "SSH key deleted (Key ID: $keyid)."
log_event "$OK" "$ARGUMENTS"

exit
