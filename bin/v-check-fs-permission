#!/bin/bash
# info: check file permission
# options: USER FILE
#
# example: v-check-fs-permission admin /home/admin/readme.txt
#
# This function checks that the user can read a file or folder on the file
# system. The path must be absolute and inside the user's home.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

user=$1
src=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/fs.sh
source $ARCPANEL/func/fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER FILE'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

# Checking path
fs_check_path "$src"

# Checking if file has readable permission
user_exec ls -- "$src" > /dev/null 2>&1
if [ $? -ne 0 ]; then
	echo "Error: can't read $src"
	exit 1
fi

# Exiting
exit
