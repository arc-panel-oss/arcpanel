#!/bin/bash
# info: check the health of the server after an ArcPanel update
# options: BASELINE [FORMAT]
#
# example: v-check-sys-arcpanel-health /usr/local/arcpanel/data/updates/baseline-12.conf json
#
# This function checks the server after an update of the panel packages
# (docs/features/specs/2026-10-20-005-e33-update-center-phase-1-design.md
# §7.4) against BASELINE, the file the update task writes before it installs
# (TARGET, the running SERVICES and up to five SITE lines with their HTTP
# STATUS), and lists each check (services, panel, web, firewall, packages,
# sites) with STATUS ok or fail and a MESSAGE. It exits with an error after
# listing the checks when one fails.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
baseline=$1
format=${2-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/updates.sh
source $ARCPANEL/func/updates.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'BASELINE [FORMAT]'
# The update task writes its baselines into the folder of the Update Center
if [[ "$baseline" != "$UPD_DIR"/baseline-*.conf ]] || [[ "$baseline" == *..* ]]; then
	check_result "$E_INVALID" "invalid baseline $baseline (a file $UPD_DIR/baseline-ID.conf)"
fi
if [ ! -f "$baseline" ] || ! grep -q "^TARGET='" "$baseline"; then
	check_result "$E_NOTEXIST" "baseline $baseline does not exist"
fi
is_format_valid 'format'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

upd_health "$baseline"
upd_checks_print "$format"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

if upd_checks_failed; then
	exit "$E_FORBIDEN"
fi

exit
