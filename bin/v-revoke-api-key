#!/bin/bash
# info: revokes api key
# options: [HASH]
#
# example: v-revoke-api-key mykey
#
# This function removes a key from in $ARCPANEL/data/keys/

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

hash=$1

args_usage='HASH'
check_args '1' "$#" "$args_usage"
is_format_valid 'hash'

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ ! -d "$ARCPANEL/data/keys/" ]; then
	exit "$E_NOTEXIST"
fi

if [[ -e "$ARCPANEL/data/keys/$hash" ]]; then
	rm $ARCPANEL/data/keys/$hash
else
	exit "$E_NOTEXIST"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "System" "System API key revoked (Key: $hash)."
log_event "$OK" "$ARGUMENTS"

exit
