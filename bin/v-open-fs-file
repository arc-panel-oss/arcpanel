#!/bin/bash
# info: open file
# options: USER FILE
#
# example: v-open-fs-file admin /home/admin/README.md
#
# This function opens/reads files on the file system as the user. The path
# must be absolute and inside the user's home.

user=$1
src_file=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/fs.sh
source $ARCPANEL/func/fs.sh

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER FILE'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

# Checking path, then the file
fs_check_path "$src_file"
if [ ! -f "$src_file" ]; then
	echo "Error: file not found $src_file"
	exit 2
fi

# Reading file
user_exec cat -- "$src_file" 2> /dev/null
if [ $? -ne 0 ]; then
	echo "Error: file $src_file was not opened"
	exit 3
fi

# Exiting
exit
