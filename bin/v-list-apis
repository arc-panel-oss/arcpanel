#!/bin/bash
# info: list available APIs
# options: [FORMAT]
#
# example: v-list-apis json

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format="${1:-shell}"

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# JSON list function
json_list() {
	echo '{'
	local quote COMMANDS_ARR
	for api in $ARCPANEL/data/api/*; do
		api="$(basename -- "$api")"
		COMMANDS="" API_VERSION=""
		source_conf $ARCPANEL/data/api/$api

		COMMANDS_ARR='[]'
		if [[ -n "$COMMANDS" ]]; then
			COMMANDS_ARR="[\"$(echo "$COMMANDS" | sed -E 's|,|", "|g')\"]"
		fi

		echo -en "$quote"
		echo -n '    "'$api'": {"COMMANDS": '${COMMANDS_ARR}', "ROLE": "'${ROLE}'", "API_VERSION": "'${API_VERSION:-1}'"}'
		quote=",\n"
	done
	echo -e '\n}'
}

# SHELL list function
shell_list() {
	list="API\tROLE\tVERSION\tCOMMANDS\n"
	list+="---\t----\t-------\t--------\n"

	for api in $ARCPANEL/data/api/*; do
		api="$(basename -- "$api")"
		COMMANDS="" API_VERSION=""
		source_conf $ARCPANEL/data/api/$api
		list+="${api}\t${ROLE}\t${API_VERSION:-1}\t${COMMANDS}\n"
	done
	echo -e "$list" | column -t -s "	"
}

# Listing data
case $format in
	json) json_list ;;
	shell) shell_list ;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
