#!/bin/bash
# info: show the current or last Quick Install of a user (E7 batch 2)
# options: USER [LINES] [FORMAT]
#
# example: v-list-user-quick-install-task alice 100 json
#
# This function prints the task record (ID, DOMAIN, APP, STATUS, EXIT,
# START, END) and the last LINES lines of its output (default 100, at most
# 1000). STATUS is running, done or failed; a running task whose process is
# gone is reported, and stored, as failed. Without a task, STATUS is empty.
# Since E15 it reads the newest quick-install job of USER; deprecated in
# 2.7.0 (read the job with v-list-job), removed in 2.8.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
lines=${2-100}
format=${3-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/quickinstall.sh
source $ARCPANEL/func/quickinstall.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [LINES] [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
if [[ ! "$lines" =~ ^[0-9]{1,4}$ ]] || [ "$lines" -lt 1 ] || [ "$lines" -gt 1000 ]; then
	check_result "$E_INVALID" "invalid number of lines :: $lines (1 to 1000)"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

qi_task_reap "$user"
id=$(qi_task_id "$user" || true)
json=$(job_legacy_json "$id" lines "$lines" | jq -c --arg domain "$(qi_task_get "$user" DOMAIN)" \
	--arg app "$(qi_task_get "$user" APP)" --arg user "$user" '
	{ USER: $user, ID, DOMAIN: $domain, APP: $app, STATUS, EXIT, START, END, LOG }')
log=$(jq -r .LOG <<< "$json")

case "$format" in
	json) printf '%s\n' "$json" | jq . ;;
	*)
		printf '%s\n' "$json" | jq -r 'to_entries[] | select(.key != "LOG") | "\(.key): \(.value)"'
		echo
		printf '%s\n' "$log"
		;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
