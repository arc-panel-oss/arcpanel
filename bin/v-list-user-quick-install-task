#!/bin/bash
# info: show the current or last Quick Install of a user (E7 batch 2)
# options: USER [LINES] [FORMAT]
#
# example: v-list-user-quick-install-task alice 100 json
#
# This function prints the task record (ID, DOMAIN, APP, STATUS, EXIT,
# START, END) and the last LINES lines of its output (default 100, at most
# 1000). STATUS is running, done or failed; a running task whose process is
# gone is reported, and stored, as failed. Without a task, STATUS is empty.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
lines=${2-100}
format=${3-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/quickinstall.sh
source $ARCPANEL/func/quickinstall.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [LINES] [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
if [[ ! "$lines" =~ ^[0-9]{1,4}$ ]] || [ "$lines" -lt 1 ] || [ "$lines" -gt 1000 ]; then
	check_result "$E_INVALID" "invalid number of lines :: $lines (1 to 1000)"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ -f "$(qi_task_conf "$user")" ]; then
	exec {lock}> "$(qi_task_lock "$user")"
	flock -x "$lock"
	qi_task_reap "$user"
	flock -u "$lock"
fi

log=''
if [ -f "$(qi_task_log "$user")" ]; then
	# no colours, no carriage returns of progress bars
	log=$(tail -n "$lines" "$(qi_task_log "$user")" | sed -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' -e 's/\r$//' -e 's/.*\r//')
fi

json=$(jq -nc --arg id "$(qi_task_get "$user" ID)" --arg domain "$(qi_task_get "$user" DOMAIN)" \
	--arg app "$(qi_task_get "$user" APP)" --arg status "$(qi_task_get "$user" STATUS)" \
	--arg exit "$(qi_task_get "$user" EXIT)" --arg start "$(qi_task_get "$user" START)" \
	--arg end "$(qi_task_get "$user" END)" --arg log "$log" --arg user "$user" '
	{ USER: $user, ID: $id, DOMAIN: $domain, APP: $app, STATUS: $status, EXIT: $exit,
		START: $start, END: $end, LOG: $log }')

case "$format" in
	json) printf '%s\n' "$json" | jq . ;;
	*)
		printf '%s\n' "$json" | jq -r 'to_entries[] | select(.key != "LOG") | "\(.key): \(.value)"'
		echo
		printf '%s\n' "$log"
		;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
