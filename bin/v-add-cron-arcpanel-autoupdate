#!/bin/bash
# info: add cron job for arcpanel automatic updates
# options: [MODE]
#
# example: v-add-cron-arcpanel-autoupdate
# example: v-add-cron-arcpanel-autoupdate git
#
# This function turns automatic updates on. Since 2.5.0 the mode apt (the
# default) sets the update policy patch with v-change-sys-update-policy
# (docs/features/specs/2026-10-20-005-e33-update-center-phase-1-design.md
# §10): the window and the delay that are set stay; without them the window
# starts at the hour of the nightly line of v-update-sys-arcpanel-all that
# older releases wrote, or at a random night hour, and the delay is 2 days.
# The mode git adds a nightly line of v-update-sys-arcpanel-git, unless the
# policy patch already updates the panel.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
mode=${1:-apt}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/updates.sh
source $ARCPANEL/func/updates.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "$mode" != 'apt' ] && [ "$mode" != 'git' ]; then
	check_result "$E_INVALID" "invalid mode $mode (apt or git)"
fi
is_system_enabled "$CRON_SYSTEM" 'CRON_SYSTEM'

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ "$mode" = 'apt' ]; then
	# Nothing to do when the policy patch is set and its line is in place
	if upd_policy_set UPDATE_POLICY && [ "$(upd_policy_get UPDATE_POLICY)" = 'patch' ] \
		&& upd_cron_installed && ! upd_cron_old; then
		exit
	fi
	# shellcheck disable=SC2046
	$BIN/v-change-sys-update-policy $(upd_policy_args patch)
	check_result $? "Update policy change failed" > /dev/null
	exit
fi

if [ "$(upd_policy_get UPDATE_POLICY)" = 'patch' ] || grep -q 'v-update-sys-arcpanel-git' "$UPD_CRONTAB"; then
	exit
fi
sed -i -e "\$a0 0 * * * sudo /usr/local/arcpanel/bin/v-update-sys-arcpanel-git" "$UPD_CRONTAB"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Restarting cron
$BIN/v-restart-cron
check_result $? "Cron restart failed" > /dev/null

# Logging
$BIN/v-log-action "system" "Info" "Updates" "Automatic updates from Git enabled."
log_event "$OK" "$ARGUMENTS"

exit
