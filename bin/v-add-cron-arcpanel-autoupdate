#!/bin/bash
# info: add cron job for hestia automatic updates (alias of v-add-cron-hestia-autoupdate)
# options: MODE
#
# example: v-add-cron-arcpanel-autoupdate
#
# ArcPanel name for v-add-cron-hestia-autoupdate. It runs the original command with the same
# arguments, so output, exit codes and logging are identical (ADR-0006).

exec "$(dirname "$(readlink -f "$0")")/v-add-cron-hestia-autoupdate" "$@"
