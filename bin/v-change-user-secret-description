#!/bin/bash
# info: change the description of a secret of a user (E38)
# options: USER NAME DESCRIPTION
#
# example: v-change-user-secret-description alice /shop/db_password 'Shop DB'
#
# This function changes the description of the secret NAME of USER. The
# value and its version stay as they are.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
name=$2
description=$3

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER NAME DESCRIPTION'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
secret_check_name "$name"
secret_check_description "$description"
secret_check_system

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

secret_check_user "$user"
secret_lock "$user"
secret_check_exists "$user" "$name"
line=$(secret_line "$user" "$name")
secret_write_line "$user" "$name" "$description" "$(secret_field "$line" VERSION)" \
	"$(secret_field "$line" VERSIONS)" "$(secret_field "$line" FINGERPRINT)"
check_result $? "the description could not be stored" "$E_FORBIDEN"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

$BIN/v-log-action "$user" "Info" "Secrets" "Secret description changed (Name: $name)."
log_event "$OK" "$user $name"

exit
