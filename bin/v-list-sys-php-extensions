#!/bin/bash
# info: list the PHP extensions of a version (E41)
# options: VERSION [FORMAT]
#
# example: v-list-sys-php-extensions 8.4 json
#
# This function lists the extension catalog entries
# (install/common/php/extensions.conf) that apply to an installed PHP version,
# with INSTALLED and AVAILABLE (yes or no), FPM and CLI (on or off, whether the
# module is enabled for that SAPI), BUILTIN ('yes' for a module compiled into
# the PHP binary, always on) and CATALOG='yes', followed by the modules
# enabled on the server that the catalog does not list (CATALOG='no', read
# only).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
version=$1
format=${2-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/php.sh
source $ARCPANEL/func/php.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'VERSION [FORMAT]'
php_ext_check_args "$version"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

php_ext_load
names=$(php_ext_names "$version")

# One apt-cache and one dpkg-query call for every package
packages=()
for name in $names; do
	pkg=$(php_ext_package "$name" "$version")
	if [ -n "$pkg" ]; then
		packages+=("$pkg")
	fi
done
installed_pkgs=''
if [ "${#packages[@]}" -gt 0 ]; then
	php_apt_refresh "${packages[@]}"
	installed_pkgs=" $(php_dpkg_installed "${packages[@]}" | tr '\n' ' ') "
fi
fpm_mods=" $(php_mods_enabled "$version" fpm | tr '\n' ' ') "
cli_mods=" $(php_mods_enabled "$version" cli | tr '\n' ' ') "
builtin_mods=" $(php_mods_builtin "$version" | tr '\n' ' ') "

# Tab-separated rows, turned into JSON by one jq call:
# NAME PACKAGE MODULE GROUP REQUIRED CONFLICTS NOTE CATALOG TOGGLE_ONLY INSTALLED AVAILABLE FPM CLI BUILTIN
rows=''
modules=' '
for name in $names; do
	line=${PHP_EXT[$name]}
	module=$(php_kv "$line" MODULE)
	modules="$modules$module "
	pkg=$(php_kv "$line" PACKAGE)
	pkg=${pkg//%v/$version}
	toggle=no
	if [ -z "$pkg" ]; then
		toggle=yes
	fi
	installed=no
	if php_mod_present "$version" "$module" && { [ -z "$pkg" ] || [[ "$installed_pkgs" == *" $pkg "* ]]; }; then
		installed=yes
	fi
	available=no
	if [ "$installed" = 'yes' ] || { [ -n "$pkg" ] && [ "${PHP_APT[$pkg]-}" = 'yes' ]; }; then
		available=yes
	fi
	fpm=off
	if [[ "$fpm_mods" == *" $module "* ]]; then
		fpm=on
	fi
	cli=off
	if [[ "$cli_mods" == *" $module "* ]]; then
		cli=on
	fi
	# A module compiled into the binary is always on and cannot be changed
	builtin=no
	if [ "$installed" = 'no' ] && [[ "$builtin_mods" == *" $module "* ]] && ! php_mod_present "$version" "$module"; then
		builtin=yes
		installed=yes
		available=yes
		fpm=on
		cli=on
	fi
	rows+="$name"$'\t'"$pkg"$'\t'"$module"$'\t'"$(php_kv "$line" GROUP)"$'\t'"$(php_kv "$line" REQUIRED)"$'\t'
	rows+="$(php_kv "$line" CONFLICTS)"$'\t'"$(php_kv "$line" NOTE)"$'\t'"yes"$'\t'"$toggle"$'\t'"$installed"$'\t'
	rows+="$available"$'\t'"$fpm"$'\t'"$cli"$'\t'"$builtin"$'\n'
done

# Modules enabled on the server that the catalog does not list
for module in $(printf '%s\n' $fpm_mods $cli_mods | sort -u); do
	if [[ "$modules" == *" $module "* ]] || [ -n "${PHP_EXT[$module]+set}" ]; then
		continue
	fi
	fpm=off
	if [[ "$fpm_mods" == *" $module "* ]]; then
		fpm=on
	fi
	cli=off
	if [[ "$cli_mods" == *" $module "* ]]; then
		cli=on
	fi
	rows+="$module"$'\t\t'"$module"$'\tother\tno\t\t\tno\tno\tyes\tyes\t'"$fpm"$'\t'"$cli"$'\tno\n'
done

json=$(printf '%s' "$rows" | jq -Rn '[inputs | split("\t") | {key: .[0], value: {
	PACKAGE: .[1], MODULE: .[2], GROUP: .[3], REQUIRED: .[4], CONFLICTS: .[5], NOTE: .[6], CATALOG: .[7],
	TOGGLE_ONLY: .[8], INSTALLED: .[9], AVAILABLE: .[10], FPM: .[11], CLI: .[12], BUILTIN: .[13]}}] | from_entries')

case "$format" in
	json) jq . <<< "$json" ;;
	plain) jq -r 'to_entries[] | [.key, .value.GROUP, .value.INSTALLED, .value.AVAILABLE, .value.FPM,
		.value.CLI, .value.REQUIRED, .value.CATALOG, .value.PACKAGE] | join("\t")' <<< "$json" ;;
	*)
		{
			echo "NAME GROUP INSTALLED AVAILABLE FPM CLI REQUIRED CATALOG"
			echo "---- ----- --------- --------- --- --- -------- -------"
			jq -r 'to_entries[] | [.key, .value.GROUP, .value.INSTALLED, .value.AVAILABLE, .value.FPM,
				.value.CLI, .value.REQUIRED, .value.CATALOG] | join(" ")' <<< "$json"
		} | column -t
		;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
