#!/bin/bash
# info: add user login
# options: USER IP STATUS [FINGERPRINT] [USER_AGENT] [AUTHLOG] [REASON]
#
# The user agent and the reason are made log-safe (quotes and control
# characters replaced) instead of refused, so a failure always reaches the
# auth log that fail2ban reads.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
ip46=$2
status=$3
session_id=$4
user_agent=$5
authlog="${6-no}"
reason="${7}"

active="yes"
if [ "$status" = "failed" ]; then
	active="no"
fi

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER IP SESSION_ID USER_AGENT [AUTHLOG] [REASON]'
is_format_valid 'user' 'ip46'
is_common_format_valid "$session_id" "SESSION_ID"
is_common_format_valid "$authlog" "AUTHLOG"

is_object_valid 'user' 'USER' "$user"

user_agent=$(log_safe "$user_agent")
reason=$(log_safe "$reason")

# Generating timestamp
time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

if [ ! -f "$USER_DATA/auth.log" ]; then
	touch "$USER_DATA/auth.log"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

echo "DATE='$date' TIME='$time' IP='$ip46' ACTION='login' STATUS='$status' USER_AGENT='$user_agent' SESSION='$session_id' ACTIVE='$active'" >> "$USER_DATA/auth.log"

if [ "$authlog" = "yes" ]; then
	echo "$date $time $user $ip46 failed to login ($reason)" >> "$ARCPANEL/log/auth.log"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
