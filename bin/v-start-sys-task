#!/bin/bash
# info: start a long server operation in the background (E7 batch 3)
# options: KIND [ARG...]
#
# example: v-start-sys-task php 8.3,8.4 -
# example: v-start-sys-task php-ext 8.4 redis,apcu -
# example: v-start-sys-task plugin web-terminal on
# example: v-start-sys-task arcpanel-update arcpanel
# example: v-start-sys-task arcpanel-release 2.5.1 admin arcadmin
# example: v-start-sys-task package python add
#
# This function checks a system task and starts v-run-sys-task in a
# transient systemd unit (arcpanel-sys-task-ID), so the task outlives a
# restart of the panel, and prints the task ID. One task runs at a time.
# Kinds and arguments:
#   php ADD DELETE            PHP versions to install and to remove, comma
#                             lists or "-"; a version in use by a web domain
#                             or the system default is not removed
#   php-ext VERSION ADD DELETE  PHP extensions of one installed version to
#                             install and to remove (E41), comma lists of
#                             catalog names or "-"
#   plugin NAME on|off        filemanager, web-terminal, quota, cgroups,
#                             firewall or malware-scan: v-add-sys-NAME or
#                             v-delete-sys-NAME
#   arcpanel-update [PACKAGE]   v-update-sys-arcpanel PACKAGE, or every package
#   arcpanel-release VERSION TRIGGER [ACTOR]  the update of the panel packages
#                             to a release of the manifest with pre-flight,
#                             health check and rollback (E33); TRIGGER is
#                             policy, admin or api, ACTOR the user or key
#   package SLUG add|delete   v-add-sys-package or v-delete-sys-package of a
#                             system package of the catalog (E5)
# The state and the output are read with v-list-sys-task.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
kind=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/systask.sh
source $ARCPANEL/func/systask.sh
# shellcheck source=/usr/local/arcpanel/func/syspackages.sh
source $ARCPANEL/func/syspackages.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# A comma list of PHP versions, or "-" for none
php_list() {
	if [ "$1" = '-' ]; then
		return
	fi
	if [[ ! "$1" =~ ^[0-9]{1,2}\.[0-9]{1,2}(,[0-9]{1,2}\.[0-9]{1,2})*$ ]]; then
		check_result "$E_INVALID" "invalid PHP version list :: $1"
	fi
	echo "${1//,/ }"
}

# A comma list of PHP extension names, or "-" for none
ext_list() {
	if [ "$1" = '-' ]; then
		return
	fi
	if [[ ! "$1" =~ ^[a-z0-9_]{1,32}(,[a-z0-9_]{1,32})*$ ]]; then
		check_result "$E_INVALID" "invalid PHP extension list :: $1"
	fi
	echo "${1//,/ }"
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'KIND [ARG...]'

case "$kind" in
	php)
		check_args '3' "$#" 'php ADD DELETE'
		add=$(php_list "$2")
		delete=$(php_list "$3")
		if [ -z "$add$delete" ]; then
			check_result "$E_ARGS" "no PHP version to install or remove"
		fi
		if [ -z "$WEB_BACKEND" ]; then
			check_result "$E_DISABLED" "multiple PHP versions need a PHP-FPM backend"
		fi
		supported=$(st_php_supported)
		for version in $add; do
			if ! grep -qx "$version" <<< "$supported"; then
				check_result "$E_INVALID" "PHP $version is not supported"
			fi
			if st_php_installed "$version"; then
				check_result "$E_EXISTS" "PHP $version is already installed"
			fi
			if ! php_version_available "$version"; then
				check_result "$E_NOTEXIST" "PHP $version is not available from the PHP repository of this system"
			fi
		done
		for version in $delete; do
			if ! st_php_installed "$version"; then
				check_result "$E_NOTEXIST" "PHP $version is not installed"
			fi
			if [ "$version" = "$(st_php_default)" ]; then
				check_result "$E_FORBIDEN" "PHP $version is the default version"
			fi
			if [ -n "$(st_php_used_by "$version")" ]; then
				check_result "$E_FORBIDEN" "PHP $version is used by web domains"
			fi
		done
		args="$2 $3"
		;;
	php-ext)
		check_args '4' "$#" 'php-ext VERSION ADD DELETE'
		php_ext_check_args "$2"
		add=$(ext_list "$3")
		delete=$(ext_list "$4")
		if [ -z "$add$delete" ]; then
			check_result "$E_ARGS" "no PHP extension to install or remove"
		fi
		for name in $add; do
			php_ext_check_args "$2" "$name"
			if [ -z "$(php_ext_package "$name" "$2")" ]; then
				check_result "$E_FORBIDEN" "$name ships with PHP $2 and can only be turned on and off"
			fi
			if php_ext_installed "$name" "$2"; then
				check_result "$E_EXISTS" "the extension $name is already installed for PHP $2"
			fi
			if ! php_ext_available "$name" "$2"; then
				check_result "$E_NOTEXIST" "the extension $name is not available for PHP $2 from the PHP repository"
			fi
		done
		for name in $delete; do
			php_ext_check_args "$2" "$name"
			if [ "$(php_ext_get "$name" REQUIRED)" = 'yes' ] || [ -z "$(php_ext_package "$name" "$2")" ]; then
				check_result "$E_FORBIDEN" "the extension $name cannot be removed"
			fi
			if ! php_ext_installed "$name" "$2"; then
				check_result "$E_NOTEXIST" "the extension $name is not installed for PHP $2"
			fi
		done
		args="$2 $3 $4"
		;;
	plugin)
		check_args '3' "$#" 'plugin NAME on|off'
		case "$2" in
			filemanager | web-terminal | quota | cgroups | firewall | malware-scan | silo) ;;
			*) check_result "$E_INVALID" "invalid plugin :: $2" ;;
		esac
		if [ "$3" != 'on' ] && [ "$3" != 'off' ]; then
			check_result "$E_INVALID" "invalid plugin state :: $3 (on or off)"
		fi
		args="$2 $3"
		;;
	arcpanel-update)
		if [ -n "$2" ]; then
			case "$2" in
				arcpanel | arcpanel-nginx | arcpanel-php) ;;
				*) check_result "$E_INVALID" "invalid package :: $2" ;;
			esac
		fi
		args="${2-}"
		;;
	arcpanel-release)
		check_args '3' "$#" 'arcpanel-release VERSION TRIGGER [ACTOR]'
		if [[ ! "$2" =~ ^[0-9]+\.[0-9]+\.[0-9]+(~[0-9A-Za-z.]+)?$ ]]; then
			check_result "$E_INVALID" "invalid version :: $2"
		fi
		case "$3" in
			policy | admin | api) ;;
			*) check_result "$E_INVALID" "invalid trigger :: $3" ;;
		esac
		if [[ ! "${4-}" =~ ^[A-Za-z0-9._@:-]{0,64}$ ]]; then
			check_result "$E_INVALID" "invalid actor :: $4"
		fi
		args="$2 $3${4:+ $4}"
		;;
	package)
		check_args '3' "$#" 'package SLUG add|delete'
		sp_check_slug "$2"
		case "$3" in
			add)
				if ! sp_available "$2"; then
					check_result "$E_INVALID" "system package $2 is not available on $(sp_release)"
				fi
				if [ "$(sp_status "$2")" = 'installed' ]; then
					check_result "$E_EXISTS" "system package $2 is already installed"
				fi
				;;
			delete)
				if ! sp_record_exists "$2"; then
					check_result "$E_FORBIDEN" "system package $2 was not installed by ArcPanel"
				fi
				used=$(sp_used_by "$2" | tr '
' ' ')
				if [ -n "$used" ]; then
					check_result "$E_FORBIDEN" "system package $2 is needed by web domains: ${used% }"
				fi
				;;
			*) check_result "$E_INVALID" "invalid action :: $3 (add or delete)" ;;
		esac
		args="$2 $3"
		;;
	*)
		check_result "$E_INVALID" "invalid task kind :: $kind (php, php-ext, plugin, arcpanel-update, package)"
		;;
esac

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

st_task_dir
exec {lock}> "$(st_task_lock)"
flock -x "$lock"

if st_task_running; then
	check_result "$E_INUSE" "Another system task is running"
fi

id="$(date +%s)$(printf '%04d' $((RANDOM % 10000)))"
log=$(st_task_log)
: > "$log"
chmod 640 "$log"
st_task_set "ID=$id" "KIND=$kind" "ARGS=$args" STATUS=running PID= UNIT= EXIT= \
	"START=$(date +'%F %T')" END=

if st_has_systemd; then
	# A transient unit outside arcpanel.service: a restart of the panel during
	# a package update does not stop it
	unit="arcpanel-sys-task-$id"
	if ! systemd-run --unit="$unit" --collect --quiet \
		--property="StandardOutput=append:$log" --property="StandardError=append:$log" \
		"$BIN/v-run-sys-task" "$id" {lock}>&-; then
		st_task_set STATUS=failed EXIT=1 "END=$(date +'%F %T')"
		check_result "$E_UPDATE" "the task could not be started"
	fi
	st_task_set "UNIT=$unit"
else
	setsid "$BIN/v-run-sys-task" "$id" < /dev/null >> "$log" 2>&1 {lock}>&- &
	st_task_set "PID=$!"
fi

flock -u "$lock"
echo "$id"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "System" "System task started (Task: $kind $args)."
log_event "$OK" "$ARGUMENTS"

exit
