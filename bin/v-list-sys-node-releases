#!/bin/bash
# info: list the Node.js majors that can be installed (E13)
# options: [FORMAT]
#
# example: v-list-sys-node-releases json
#
# This function lists one row per Node.js major (18 and later) built for the
# server's architecture: MAJOR, LATEST (newest X.Y.Z), LTS (codename),
# STATUS (current, active, maintenance or eol), EOL (date) and CACHED (yes
# when LATEST is in the download cache). The index is downloaded when the
# cache has none yet.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/node.sh
source $ARCPANEL/func/node.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

node_arch > /dev/null
check_result $? "Node.js releases are not built for $(uname -m)" "$E_NOTEXIST"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

node_index_ensure
check_result $? "Could not download the release index from $(node_url_host "$(node_releases_url)")" "$E_CONNECT"

json=$(node_releases_json | jq -c --arg arch "$(node_arch)" '{ARCH: $arch, RELEASES: .}')
node_print "$format" "$json" '.RELEASES' 'MAJOR LATEST LTS STATUS EOL CACHED'

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
