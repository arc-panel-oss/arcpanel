#!/bin/bash
# info: delete firewall blocking rule
# options: IP_CIDR CHAIN
#
# example: v-delete-firewall-ban 198.11.130.250 MAIL
# example: v-delete-firewall-ban 2001:db8::7 ALL
#
# This function deletes blocking rule from system firewall

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
ip_cidr=$1
chain=$(echo "$2" | tr '[:lower:]' '[:upper:]')

# Defining absolute path for fail2ban-client
f2bcli="/usr/bin/fail2ban-client"

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/firewall.sh
source $ARCPANEL/func/firewall.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# Delete the address from the set of a chain; reload when the set refuses it.
# The sets merge overlapping bans, so the set is rebuilt from the ban list
# instead when a network leaves while other bans of the chain remain, and
# when an address leaves while a network of its family remains: deleting it
# from the merged network would cut a hole into that ban.
unban_element() {
	local family
	family=$(fw_family "$2")
	if [[ "$2" == */* ]] && grep -qF "CHAIN='$1'" "$conf" 2> /dev/null; then
		reload='yes'
	elif fw_chain_bans "$1" "$family" < "$conf" 2> /dev/null | grep -q '/'; then
		reload='yes'
	elif ! "$FW_NFT" delete element inet arcpanel "$(fw_ban_set "$1" "$family")" "{ $2 }" 2> /dev/null; then
		reload='yes'
	fi
}

# Lift the ban in the Fail2Ban jails of a chain, unless Fail2Ban called us
# (prevents a recursive deadlock)
unban_fail2ban() {
	if [ -z "${ARCPANEL_F2B_CALLER:-}" ] && [ -x "$f2bcli" ]; then
		for f2bjail in $("$f2bcli" status | grep -i 'Jail list:' | cut -d':' -f2- | sed -E 's/\s*//g' | tr ',' ' '); do
			if "$f2bcli" get "$f2bjail" actions | grep -Eq "^arcpanel-$1" 2> /dev/null; then
				"$f2bcli" set "$f2bjail" unbanip "$2" &> /dev/null
			fi
		done
	fi
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'IP_CIDR CHAIN'
is_format_valid 'ip_cidr' 'chain'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

# A server left on iptables has no sets (spec §16 H5)
fw_require_nftables

fw_lock

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# IPv6 addresses are kept in lower case
ip_cidr=$(echo "$ip_cidr" | tr '[:upper:]' '[:lower:]')

conf="$ARCPANEL/data/firewall/banlist.conf"
synced=()
if [ "$chain" == "ALL" ]; then
	check_ip=$(grep -F "IP='$ip_cidr' CHAIN=" $conf 2> /dev/null)
	if [ -z "$check_ip" ]; then
		exit
	fi
	while read -r line; do
		parse_object_kv_list "$line"
		sip=$(echo "$IP" | sed "s|/|\\\/|g")
		sed -i "/IP='$sip' CHAIN='$CHAIN'/d" $conf
		unban_element "$CHAIN" "$IP"
		synced+=("$CHAIN $IP")
	done <<< "$check_ip"
else
	# Checking ip in banlist
	check_ip=$(grep -F "IP='$ip_cidr' CHAIN='$chain'" $conf 2> /dev/null)
	if [ -z "$check_ip" ]; then
		exit
	fi

	# Deleting ip from banlist
	sip=$(echo "$ip_cidr" | sed "s|/|\\\/|g")
	sed -i "/IP='$sip' CHAIN='$chain'/d" $conf
	unban_element "$chain" "$ip_cidr"
	synced+=("$chain $ip_cidr")
fi

if [ "${reload:-no}" = 'yes' ] && fw_loaded; then
	"$BIN/v-update-firewall"
else
	# The boot unit loads the saved table
	fw_save_bans
fi

# Changing permissions
chmod 660 $conf

# Fail2Ban runs our unban action under the firewall lock: release it first
fw_unlock
for pair in "${synced[@]}"; do
	unban_fail2ban "${pair%% *}" "${pair#* }"
done

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "Firewall" "Removed IP from ban list (IP: $ip_cidr, Service: $chain)."
log_event "$OK" "$ARGUMENTS"

exit
