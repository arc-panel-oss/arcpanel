#!/bin/bash
# info: delete a secret of a user (E38)
# options: USER NAME [FORCE]
#
# example: v-delete-user-secret alice /shop/db_password
#
# This function deletes the secret NAME of USER with all its versions. A
# secret that an app references is refused with E_INUSE and the list of
# those apps, unless FORCE is yes; such apps then fail to start until the
# reference is removed or the secret is added again.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
name=$2
force=${3-no}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER NAME [FORCE]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
secret_check_name "$name"
if [ "$force" != 'yes' ] && [ "$force" != 'no' ]; then
	check_result "$E_INVALID" "FORCE must be yes or no"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ ! -d "$(secret_dir "$user")" ]; then
	check_result "$E_NOTEXIST" "secret $name not found"
fi
secret_lock "$user"
secret_check_exists "$user" "$name"
used=$(secret_used_by "$user" "$name")
if [ -n "$used" ] && [ "$force" != 'yes' ]; then
	check_result "$E_INUSE" "secret $name is used by $(echo "$used" | tr '\n' ' ' | sed 's/ $//')"
fi
secret_remove "$user" "$name"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

$BIN/v-log-action "$user" "Info" "Secrets" "Secret deleted (Name: $name)."
log_event "$OK" "$user $name"

exit
