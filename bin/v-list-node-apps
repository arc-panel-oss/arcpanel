#!/bin/bash
# info: list the Node.js apps of a user (E14)
# options: USER [FORMAT]
#
# example: v-list-node-apps alice json
#
# This function lists the apps of the user with their live state from the
# user's pm2 daemon: STATUS (online, stopped, errored, launching,
# suspended, missing), PID, CPU (%), MEMORY (MB), RESTARTS and UPTIME
# (seconds), plus the package limit NODE_APPS.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
format=${2-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/nodeapp.sh
source $ARCPANEL/func/nodeapp.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

jlist='[]'
if [ "$(nodeapp_count "$user")" -gt 0 ]; then
	jlist=$(nodeapp_jlist "$user")
fi
daemon=no
nodeapp_daemon_active "$user" && daemon=yes

json=$(nodeapp_rows_json "$user" "$jlist" | jq -sc \
	--arg user "$user" --arg node "$(node_pkg_key "$user" NODE)" --arg limit "$(nodeapp_limit "$user")" \
	--arg daemon "$daemon" --arg pm2 "$(nodeapp_pm2_runtime "$user")" \
	--arg instances "$(nodeapp_max_instances)" --arg memory "$(nodeapp_memory_limit "$user")" '
	{ USER: $user, NODE: $node, LIMIT: $limit, COUNT: (length | tostring), DAEMON: $daemon,
		PM2_RUNTIME: $pm2, MAX_INSTANCES: $instances, MEMORY_LIMIT: $memory, APPS: . }')

node_print "$format" "$json" '.APPS' 'DOMAIN NAME RUNTIME PORT STATUS CPU MEMORY RESTARTS UPTIME'

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
