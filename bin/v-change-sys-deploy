#!/bin/bash
# info: change a server setting of Git Deploy
# options: KEY VALUE
#
# example: v-change-sys-deploy DEPLOY_PORT 8090
# example: v-change-sys-deploy DEPLOY_OIDC_ISSUERS https://token.actions.githubusercontent.com,https://gitlab.com,https://git.example.com
#
# This function changes a server setting of Git Deploy (E20 §3.4):
# DEPLOY_PORT (the port of the webhook and upload endpoint, 1024-65535, or
# empty to turn the endpoint off), DEPLOY_MAX_ARTIFACT (the largest archive,
# 1M to 1024M), DEPLOY_BUILD_TIMEOUT (seconds, 60-7200) and
# DEPLOY_OIDC_ISSUERS (comma-separated https:// issuers allowed for trusted
# publishers). A new port moves the NGINX file, the reservation and the
# firewall rule.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
key=${1^^}
value=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/ports.sh
source $ARCPANEL/func/ports.sh
# shellcheck source=/usr/local/arcpanel/func/tool-ports.sh
source $ARCPANEL/func/tool-ports.sh
# shellcheck source=/usr/local/arcpanel/func/queuetask.sh
source $ARCPANEL/func/queuetask.sh
# shellcheck source=/usr/local/arcpanel/func/deploy.sh
source $ARCPANEL/func/deploy.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'KEY VALUE'
case "$key" in
	DEPLOY_PORT)
		[ -z "$value" ] || [ "$value" = "$(deploy_port_current)" ] || deploy_port_check "$value"
		;;
	DEPLOY_MAX_ARTIFACT)
		if ! [[ "$value" =~ ^[0-9]{1,4}[MG]$ ]]; then
			check_result "$E_INVALID" "invalid size :: $value"
		fi
		bytes=$(deploy_bytes "$value")
		if [ "$bytes" -lt 1048576 ] || [ "$bytes" -gt 1073741824 ]; then
			check_result "$E_INVALID" "the archive limit must be between 1M and 1024M"
		fi
		;;
	DEPLOY_BUILD_TIMEOUT)
		if ! [[ "$value" =~ ^[0-9]{2,4}$ ]] || [ "$value" -lt 60 ] || [ "$value" -gt 7200 ]; then
			check_result "$E_INVALID" "the build timeout must be between 60 and 7200 seconds"
		fi
		;;
	DEPLOY_OIDC_ISSUERS)
		[ -n "$value" ] || check_result "$E_INVALID" "at least one issuer is needed"
		for issuer in ${value//,/ }; do
			if ! [[ "$issuer" =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$ ]]; then
				check_result "$E_INVALID" "invalid issuer :: $issuer"
			fi
		done
		;;
	*) check_result "$E_INVALID" "invalid key :: $key" ;;
esac

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

ports_lock
old=$(grep -m1 "^$key=" "$ARCPANEL/conf/arcpanel.conf" | cut -d"'" -f2)
$BIN/v-change-sys-config-value "$key" "$value" > /dev/null
check_result $? "the setting could not be saved" "$E_UPDATE"
source_conf "$ARCPANEL/conf/arcpanel.conf"
if [ "$key" = 'DEPLOY_PORT' ] || [ "$key" = 'DEPLOY_MAX_ARTIFACT' ]; then
	if ! deploy_port_update; then
		$BIN/v-change-sys-config-value "$key" "$old" > /dev/null
		source_conf "$ARCPANEL/conf/arcpanel.conf"
		deploy_port_update > /dev/null 2>&1
		check_result "$E_UPDATE" "NGINX refused the deploy port; $key keeps $old"
	fi
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "System" "Git Deploy setting changed (Key: $key)."
log_event "$OK" "$ARGUMENTS"

exit
