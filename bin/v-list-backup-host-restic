#!/bin/bash
# info: list the incremental backup host
# options: [FORMAT]
#
# example: v-list-backup-host-restic json
#
# This function lists the restic repository of incremental backups and its
# retention as earlier versions did: the destination and retention of the
# backup job "Nightly snapshots" (E48); for an S3 backup host also its
# endpoint, region and access key ID, never the secret.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format=${1-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/backup-driver.sh
source $ARCPANEL/func/backup-driver.sh
# shellcheck source=/usr/local/arcpanel/func/backup-job.sh
source $ARCPANEL/func/backup-job.sh
# shellcheck source=/usr/local/arcpanel/func/backup-legacy.sh
source $ARCPANEL/func/backup-legacy.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# JSON list function
json_list() {
	echo '{'
	echo '    "restic": {
	"REPO": "'$REPO'",
	"SNAPSHOTS": "'$SNAPSHOTS'",
	"KEEP_DAILY": "'$KEEP_DAILY'",
	"KEEP_WEEKLY": "'$KEEP_WEEKLY'",
	"KEEP_MONTHLY": "'$KEEP_MONTHLY'",
	"KEEP_YEARLY": "'$KEEP_YEARLY'",
	"S3_ENDPOINT": "'$S3_ENDPOINT'",
	"S3_REGION": "'$S3_REGION'",
	"S3_KEY_ID": "'$S3_KEY_ID'"
	}'
	echo '}'
}

# SHELL list function
shell_list() {
	echo "REPO:           $REPO"
	echo "SNAPSHOTS:      $SNAPSHOTS"
	echo "KEEP_DAILY:      $KEEP_DAILY"
	echo "KEEP_WEEKLY:     $KEEP_WEEKLY"
	echo "KEEP_MONTHLY:    $KEEP_MONTHLY"
	echo "KEEP_YEARLY:     $KEEP_YEARLY"
	if [ -n "$S3_ENDPOINT" ]; then
		echo "S3_ENDPOINT:     $S3_ENDPOINT"
		echo "S3_REGION:       $S3_REGION"
		echo "S3_KEY_ID:       $S3_KEY_ID"
	fi
}

# PLAIN list function
plain_list() {
	echo -e "$REPO\t$SNAPSHOTS\t$KEEP_DAILY\t$KEEP_WEEKLY\t$KEEP_MONTHLY\t$KEEP_YEARLY"
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# The job "Nightly snapshots" and its destination (E48)
if ! bl_restic_values; then
	exit
fi

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list | column -t ;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
