#!/bin/bash
# info: add firewall blocking rule
# options: IP_CIDR CHAIN
#
# example: v-add-firewall-ban 37.120.129.20 MAIL
# example: v-add-firewall-ban 2001:db8::7 SSH
#
# This function adds a blocking rule to the system firewall: the IPv4 or
# IPv6 address or network joins the ban set of the chain

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
ip_cidr=$1
chain=$(echo "$2" | tr '[:lower:]' '[:upper:]')

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/firewall.sh
source $ARCPANEL/func/firewall.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'IP_CIDR CHAIN'
is_format_valid 'ip_cidr' 'chain'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

# A server left on iptables has no sets (spec §16 H5)
fw_require_nftables

fw_lock

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# IPv6 addresses are kept in lower case
ip_cidr=$(echo "$ip_cidr" | tr '[:upper:]' '[:lower:]')

# Checking server ip
if fw_is_own_ip "$ip_cidr"; then
	exit
fi

# Checking ip exclusions
excludes="$ARCPANEL/data/firewall/excludes.conf"
check_excludes=$(grep -ixF -- "$ip_cidr" $excludes 2> /dev/null)
if [ -n "$check_excludes" ]; then
	exit
fi

# Checking ip in banlist
conf="$ARCPANEL/data/firewall/banlist.conf"
check_ip=$(grep -F "IP='$ip_cidr' CHAIN='$chain'" $conf 2> /dev/null)
if [ -n "$check_ip" ]; then
	# A listed ban is put back in case its set lost it
	"$FW_NFT" add element inet arcpanel "$(fw_ban_set "$chain" "$(fw_family "$ip_cidr")")" "{ $ip_cidr }" 2> /dev/null
	exit
fi

# Adding chain
$BIN/v-add-firewall-chain $chain

# Generating timestamp
time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

# Adding ip to banlist, then to the set; a reload when the set refuses it
# (for example a network that overlaps a ban). A stopped firewall stays
# stopped and loads the ban with its next start
echo "IP='$ip_cidr' CHAIN='$chain' TIME='$time' DATE='$date'" >> $conf
if fw_stopped; then
	:
elif ! "$FW_NFT" add element inet arcpanel "$(fw_ban_set "$chain" "$(fw_family "$ip_cidr")")" "{ $ip_cidr }" 2> /dev/null; then
	"$BIN/v-update-firewall"
else
	# The boot unit loads the saved table
	fw_save_bans
fi

# Changing permissions
chmod 660 $conf

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Warning" "Firewall" "Banned IP address $ip_cidr."
log_event "$OK" "$ARGUMENTS"

exit
