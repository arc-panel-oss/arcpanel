#!/bin/bash
# info: list the open alerts of a scope (E16)
# options: SCOPE [FORMAT]
#
# example: v-list-alerts system json
#
# This function prints the open (fired, not yet resolved) metric alerts of
# SCOPE (system or a user), keyed by ID: RULE, TITLE, OBJECT, SEVERITY,
# VALUE, DETAIL, SINCE (condition first seen), FIRED, LAST_NOTIFIED and
# COUNT (messages sent).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
scope=$1
format=${2-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/alerts.sh
source $ARCPANEL/func/alerts.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'SCOPE [FORMAT]'
alerts_check_scope "$scope"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

titles='{}'
for rule in $ALERT_TYPES; do
	titles=$(jq -c --arg r "$rule" --arg t "${ALERT_TITLE[$rule]}" '. + {($r): $t}' <<< "$titles")
done

json=$(cat "$ALERTS_STATE" 2> /dev/null | jq -R -s -c --arg scope "$scope" --argjson titles "$titles" "
	split(\"\n\") | map(select(length > 0) | $ALERTS_JQ_RECORD
		| select(.SCOPE == \$scope and .KIND == \"metric\" and (.FIRED // \"\") != \"\")
		| {ID, RULE, TITLE: (\$titles[.RULE] // .RULE), SCOPE, OBJECT, SEVERITY, VALUE, DETAIL: (.DETAIL // \"\"),
			SINCE, FIRED, LAST_NOTIFIED, COUNT})
	| map({key: .ID, value: .}) | from_entries")
[ -n "$json" ] || json='{}'

case "$format" in
	json) printf '%s\n' "$json" | jq . ;;
	plain) printf '%s\n' "$json" | jq -r '.[] | [.ID, .RULE, .OBJECT, .SEVERITY, .VALUE, .FIRED, .LAST_NOTIFIED, .COUNT] | @tsv' ;;
	*)
		{
			echo "ID RULE OBJECT SEVERITY FIRED"
			echo "-- ---- ------ -------- -----"
			printf '%s\n' "$json" | jq -r '.[] | [.ID, .RULE, .OBJECT, .SEVERITY, (.FIRED | sub(" "; "_"))] | join(" ")'
		} | column -t
		;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
