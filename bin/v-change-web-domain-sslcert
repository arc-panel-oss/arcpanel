#!/bin/bash
# info: change domain ssl certificate
# options: USER DOMAIN SSL_DIR [RESTART]
#
# example: v-change-web-domain-sslcert admin example.com /home/admin/tmp
#
# This function changes SSL domain certificate and the key. If ca file present
# it will be replaced as well. The previous certificate is handed to the user
# in a folder below private/, copied there by the user (E39 W1).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
domain_idn=$2
ssl_dir=$3
restart=$4

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/domain.sh
source $ARCPANEL/func/domain.sh
# shellcheck source=/usr/local/arcpanel/func/safe-fs.sh
source $ARCPANEL/func/safe-fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# Additional argument formatting
format_domain
format_domain_idn
# TODO: $domain_idn not used in this script - maybe $domain should be converted to $doman_idn ?

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN SSL_DIR [RESTART]'
is_format_valid 'user' 'domain' 'ssl_dir'
is_system_enabled "$WEB_SYSTEM" 'WEB_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
is_object_value_exist 'web' 'DOMAIN' "$domain" '$SSL'
if [ -n "$restart" ]; then
	is_restart_format_valid "$restart" 'restart'
fi
# Root reads the new files: regular files only, never a link
for ext in crt key ca; do
	if [ -L "$ssl_dir/$domain.$ext" ]; then
		check_result "$E_FORBIDEN" "$ssl_dir/$domain.$ext is a link"
	fi
done
is_web_domain_cert_valid

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# The certificate folder in the home must be root's all the way down
if ! root_dir_safe "$HOMEDIR/$user/conf/web/$domain/ssl"; then
	check_result "$E_FORBIDEN" "$HOMEDIR/$user/conf/web/$domain/ssl is not root's"
fi

# Deleting old certificate; the user gets a copy of it below private/
safe_workdir sslcert
tmpdir=$SAFE_WORKDIR
mkdir "$tmpdir/ssl-previous"
mv $USER_DATA/ssl/$domain.* "$tmpdir/ssl-previous/"
rm -f $HOMEDIR/$user/conf/web/$domain/ssl/$domain.*
if [ -d "$HOMEDIR/$user/web/$domain/private" ]; then
	copy_into_home "$tmpdir/ssl-previous" "$HOMEDIR/$user/web/$domain/private/ssl-previous-$(date +%Y%m%d%H%M%S)" > /dev/null 2>&1
fi

# Adding new certificate to user data directory
cp -f $ssl_dir/$domain.crt $USER_DATA/ssl/$domain.crt
cp -f $ssl_dir/$domain.key $USER_DATA/ssl/$domain.key
cp -f $ssl_dir/$domain.crt $USER_DATA/ssl/$domain.pem
if [ -e "$ssl_dir/$domain.ca" ]; then
	cp -f $ssl_dir/$domain.ca $USER_DATA/ssl/$domain.ca
	cat $USER_DATA/ssl/$domain.ca >> $USER_DATA/ssl/$domain.pem
fi

# Adding new certificate to user dir
cp -f $USER_DATA/ssl/$domain.crt $HOMEDIR/$user/conf/web/$domain/ssl/$domain.crt
cp -f $USER_DATA/ssl/$domain.key $HOMEDIR/$user/conf/web/$domain/ssl/$domain.key
cp -f $USER_DATA/ssl/$domain.pem $HOMEDIR/$user/conf/web/$domain/ssl/$domain.pem
if [ -e "$USER_DATA/ssl/$domain.ca" ]; then
	cp -f $USER_DATA/ssl/$domain.ca $HOMEDIR/$user/conf/web/$domain/ssl/$domain.ca
fi
safe_workdir_cleanup

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Restarting web server
$BIN/v-restart-web "$restart"
check_result $? "Web restart failed" > /dev/null

$BIN/v-restart-proxy "$restart"
check_result $? "Proxy restart failed" > /dev/null

# Logging
$BIN/v-log-action "$user" "Info" "Web" "SSL certificate changed (Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit
