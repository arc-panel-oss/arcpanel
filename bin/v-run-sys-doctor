#!/bin/bash
# info: run the Doctor checks of the server or of domains (E17)
# options: SCOPE [DOMAIN] [ACTOR] [MODE]
#
# example: v-run-sys-doctor system
# example: v-run-sys-doctor alice example.com alice
# example: v-run-sys-doctor all '' cron
#
# This function runs the read-only Doctor checks
# (docs/features/specs/2026-11-05-003-e17-doctor-design.md): SCOPE system
# runs the server checks, a user the web and mail checks of every domain of
# the user (4 domains at a time) or of DOMAIN, all runs everything (the
# nightly run). Each check has 30 seconds. The results are written to
# data/doctor/server.json and data/users/USER/doctor/DOMAIN.json and read
# with v-list-sys-doctor.
#
# MODE job (default) starts a job of type doctor.run (E15) that runs the
# checks and prints the job ID; ACTOR is who asked (a panel login, api:KEY,
# cron). MODE now runs the checks in this process and prints a line per
# scope or domain.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
scope=$1
domain=${2-}
actor=${3-}
mode=${4:-job}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/job.sh
source $ARCPANEL/func/job.sh
# shellcheck source=/usr/local/arcpanel/func/doctor.sh
source $ARCPANEL/func/doctor.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'SCOPE [DOMAIN] [ACTOR] [MODE]'
case "$scope" in
	system | all)
		if [ -n "$domain" ]; then
			check_result "$E_INVALID" "a domain needs a user scope"
		fi
		;;
	*)
		user=$scope
		is_format_valid 'user'
		is_object_valid 'user' 'USER' "$user"
		if [ -n "$domain" ]; then
			is_format_valid 'domain'
			if ! doctor_domain_exists "$user" web "$domain" && ! doctor_domain_exists "$user" mail "$domain"; then
				check_result "$E_NOTEXIST" "$user has no web or mail domain $domain"
			fi
		fi
		;;
esac
[ -n "$actor" ] || actor=$(job_default_actor)
if ! job_actor_valid "$actor"; then
	check_result "$E_INVALID" "invalid actor :: $actor"
fi
case "$mode" in
	job | now) ;;
	*) check_result "$E_INVALID" "invalid mode :: $mode (job or now)" ;;
esac

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ "$mode" = 'job' ] && ! job_is_current 'doctor\.run'; then
	case "$scope" in
		system)
			juser=system object=doctor:system resource=/system/doctor
			;;
		all)
			juser=system object=doctor:all resource=/system/doctor
			;;
		*)
			juser=$scope object="doctor:$scope" resource="/users/$scope/doctor"
			if [ -n "$domain" ]; then
				object="doctor:$scope:$domain" resource="/users/$scope/doctor/$domain"
			fi
			;;
	esac
	job_start doctor.run "$juser" "$object" "$actor" "$resource" -- \
		v-run-sys-doctor "$scope" "$domain" "$actor" job
	job_check_started "$?" "a Doctor run of ${domain:-$scope} is running"
	echo "$JOB_ID"
	log_event "$OK" "$ARGUMENTS"
	exit
fi

DOCTOR_CACHE=$(mktemp -d)
export DOCTOR_CACHE
trap 'rm -rf "$DOCTOR_CACHE"' EXIT

case "$scope" in
	system)
		doctor_run_server
		;;
	all)
		doctor_run_server
		# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
		source "$ARCPANEL/func/tenancy.sh"
		mapfile -t users < <(tenancy_all_users)
		doctor_run_users "${users[@]}"
		;;
	*)
		if [ -n "$domain" ]; then
			doctor_run_domain "$user" "$domain"
		else
			doctor_run_users "$user"
		fi
		;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
