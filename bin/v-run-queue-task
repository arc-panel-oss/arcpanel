#!/bin/bash
# info: run a queued command and record its result
# options: USER ID -- COMMAND [ARG…]
#
# example: v-run-queue-task admin 17280000001234 -- /usr/local/arcpanel/bin/v-backup-user admin yes
#
# This function runs one command that a v-schedule-* script queued. The
# record must exist and be queued. The command's output is appended to the
# task log and also written to standard output, so the redirection on the
# queue line (>> $ARCPANEL/log/backup.log and the others) still receives it.
#
# When the command fails and its line is still in the pipe, the record is
# queued again (ERROR, ATTEMPTS) and the next pass of the queue retries it,
# as the queue did before the records. A line whose record is missing or
# finished is removed without running anything.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

user=$1
id=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/queuetask.sh
source $ARCPANEL/func/queuetask.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '4' "$#" 'USER ID -- COMMAND [ARG…]'
is_format_valid 'user' 'id'
is_object_valid 'user' 'USER' "$user"
if [ "$3" != "--" ]; then
	check_result "$E_INVALID" "missing -- before the command"
fi
if ! [[ "$id" =~ ^[0-9]{14}$ ]]; then
	check_result "$E_INVALID" "invalid id format :: $id"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

shift 3

if ! qt_prepare_argv "$@"; then
	check_result "$E_FORBIDEN" "command is not allowed"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

qt_lock
qt_cleanup_unlocked
if ! qt_runnable_unlocked "$user" "$id"; then
	# A dead line: it would never run again and would block the next
	# backup of the user (is_backup_scheduled). A running record belongs
	# to another pass, which decides about its line.
	if [ "$(qt_get "$user" "$id" STATUS)" != "running" ]; then
		qt_remove_line "$user" "$id"
	fi
	qt_unlock
	exit 0
fi

attempts=$(qt_get "$user" "$id" ATTEMPTS)
if ! [[ "$attempts" =~ ^[0-9]+$ ]]; then
	attempts=0
fi
attempts=$((attempts + 1))
qt_set "$user" "$id" STATUS=running "START=$(date +'%F %T')" "PID=$$" \
	EXIT= ERROR= END= "ATTEMPTS=$attempts"
qt_unlock

log=$(qt_log "$user" "$id")
touch "$log"
chmod 640 "$log"

"${QT_ARGV[@]}" 2>&1 | tee -a "$log"
rc=${PIPESTATUS[0]}
chmod 640 "$log"

qt_lock
if [ "$rc" -eq 0 ]; then
	qt_set "$user" "$id" STATUS=succeeded "EXIT=0" "END=$(date +'%F %T')" PID=
elif qt_line_queued "$user" "$id"; then
	# The worker kept its line: the next pass runs it again
	qt_set "$user" "$id" STATUS=queued EXIT= START= END= PID= \
		"ERROR=attempt $attempts failed with exit code $rc, queued again"
else
	qt_set "$user" "$id" STATUS=failed "EXIT=$rc" "END=$(date +'%F %T')" PID=
fi
qt_unlock

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$rc" "$ARGUMENTS"

exit "$rc"
