#!/bin/bash
# info: list the last one-off task of a user's app processes (E42)
# options: USER [FORMAT]
#
# example: v-list-app-process-task alice json
#
# This function shows the last task started with v-start-app-process-task:
# its id, domain, process, task, STATUS (running, done or failed), exit
# code and times. A running task whose process is gone is shown as failed.
# Since E15 it reads the newest app-process.* job of USER; deprecated in
# 3.0.0 (read the job with v-list-job), removed in 3.1.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
format=${2-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/appprocess.sh
source $ARCPANEL/func/appprocess.sh
# shellcheck source=/usr/local/arcpanel/func/job.sh
source $ARCPANEL/func/job.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

appproc_task_running "$user" > /dev/null
id=$(appproc_task_id "$user" || true)
if [ -n "$id" ]; then
	json=$(jq -nc --arg id "$id" --arg domain "$(appproc_task_get "$user" DOMAIN)" \
		--arg name "$(appproc_task_get "$user" NAME)" --arg task "$(appproc_task_get "$user" TASK)" \
		--arg status "$(appproc_task_get "$user" STATUS)" --arg exit "$(appproc_task_get "$user" EXIT)" \
		--arg start "$(appproc_task_get "$user" START)" --arg end "$(appproc_task_get "$user" END)" '
		{ TASK: { ID: $id, DOMAIN: $domain, NAME: $name, TASK: $task, STATUS: $status, EXIT: $exit,
			START: $start, END: $end } }')
else
	json='{"TASK":null}'
fi

case "$format" in
	json) jq . <<< "$json" ;;
	*) jq -r '.TASK // {} | to_entries[] | "\(.key): \(.value)"' <<< "$json" ;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
