#!/bin/bash
# info: change hestia ssl certificate (alias of v-change-sys-hestia-ssl)
# options: SSL_DIR [RESTART]
#
# example: v-change-sys-arcpanel-ssl
#
# ArcPanel name for v-change-sys-hestia-ssl. It runs the original command with the same
# arguments, so output, exit codes and logging are identical (ADR-0006).

