#!/bin/bash
# info: delete system firewall
# options: NONE
#
# example: v-delete-sys-firewall
#
# This function disables firewall support

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/firewall.sh
source $ARCPANEL/func/firewall.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ -z "$FIREWALL_SYSTEM" ]; then
	exit
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Updating FIREWALL_SYSTEM value
$BIN/v-change-sys-config-value "FIREWALL_SYSTEM" ""

# Stopping firewall
$BIN/v-stop-firewall

# The distribution's nftables.service, masked while the firewall ran
fw_unmask_distro_unit

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Warning" "Firewall" "System firewall disabled."
log_event "$OK" "$ARGUMENTS"

exit
