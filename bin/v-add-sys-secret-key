#!/bin/bash
# info: set up the secret store (E38)
# options: NONE
#
# example: v-add-sys-secret-key
#
# This function creates the master key of the secret store once:
# $ARCPANEL/data/secrets/.master/identity (an age identity, root 0400) and
# its public recipient. An existing key is kept, so the command is safe to
# run on every upgrade. Keep a copy of the identity off the server: without
# it no secret can be decrypted, also not from backups.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "$(id -u)" != '0' ]; then
	echo "Error: v-add-sys-secret-key can only be executed by the root user"
	exit "$E_FORBIDEN"
fi
if ! command -v age > /dev/null 2>&1 || ! command -v age-keygen > /dev/null 2>&1; then
	check_result "$E_NOTEXIST" "age is not installed (apt-get install age)"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

new=no
if [ ! -f "$SECRET_MASTER/identity" ]; then
	new=yes
fi
secret_master_init
check_result $? "the master key could not be created" "$E_FORBIDEN"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

if [ "$new" = 'yes' ]; then
	echo "The master key of the secret store is $SECRET_MASTER/identity: keep a copy off the server."
	log_history "Created the master key of the secret store." 'Info' 'system' 'Secrets'
fi
log_event "$OK" "$ARGUMENTS"

exit
