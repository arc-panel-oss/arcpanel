#!/bin/bash
# info: rebuild the object storage of a user
# options: USER
#
# example: v-rebuild-user-object-storage alice
#
# This function brings Silo back to USER's flat files: missing buckets are
# created (empty) with their quota and versioning, the object storage user
# and its policy are written, keys without a service account are dropped
# and service accounts without a record removed. v-rebuild-user runs it.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/silo.sh
source $ARCPANEL/func/silo.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
if ! silo_installed; then
	exit
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

silo_lock
silo_require_running
silo_rebuild_user "$user" yes > /dev/null

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
