#!/bin/bash
# info: set up the file transfers of the panel app (E3)
# options: NONE
#
# example: v-add-sys-panel-files
#
# This function creates the staging tree of the file manager below the
# panel app's storage directory (uploads, editor saves and download tickets,
# owned by arcpanelweb, mode 0700) and adds the panel app's scheduler to the
# arcpanelweb crontab; the scheduler removes stale uploads and tickets.
# It is idempotent and runs on every upgrade.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/fs.sh
source $ARCPANEL/func/fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

CRONTAB="/var/spool/cron/crontabs/arcpanelweb"
SCHEDULE_LINE="* * * * * $ARCPANEL/php/bin/php $ARCPANEL/web-app/artisan schedule:run > /dev/null 2>&1"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "$(id -u)" != '0' ]; then
	echo "Error: v-add-sys-panel-files can only be executed by the root user"
	exit "$E_FORBIDEN"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

if [ ! -d "$ARCPANEL/web-app/storage" ]; then
	check_result "$E_NOTEXIST" "the panel app is not installed"
fi
if ! id "$FS_STAGING_OWNER" > /dev/null 2>&1; then
	check_result "$E_NOTEXIST" "user $FS_STAGING_OWNER doesn't exist"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Staging tree; storage/app may not exist on servers set up before E3
for dir in "$ARCPANEL/web-app/storage/app" "$FS_STAGING" "$FS_UPLOADS" "$FS_DOWNLOADS"; do
	if [ -L "$dir" ]; then
		rm -f "$dir"
	fi
	mkdir -p "$dir"
	chown "$FS_STAGING_OWNER:$FS_STAGING_OWNER" "$dir"
done
chmod 750 "$ARCPANEL/web-app/storage/app"
chmod 700 "$FS_STAGING" "$FS_UPLOADS" "$FS_DOWNLOADS"

# Scheduler of the panel app
# (sed, not >>: fs.protected_regular forbids root to open another user's
# file for appending in the sticky crontab directory)
if [ -f "$CRONTAB" ] && ! grep -q "artisan schedule:run" "$CRONTAB"; then
	sed -i -e "\$a$SCHEDULE_LINE" "$CRONTAB"
	chown arcpanelweb:arcpanelweb "$CRONTAB"
	chmod 600 "$CRONTAB"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
