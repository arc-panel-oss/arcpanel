#!/bin/bash
# info: backup all users
# options: NONE
#
# example: v-backup-users
#
# This function backups all system users.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Auto-repair all databases before backuping all accounts
mysqlrepair --all-databases --check --auto-repair > /dev/null 2>&1

# Incremental backups of the users whose package allows them, after the archives
run_incremental() {
	if [ "$BACKUP_INCREMENTAL" = 'yes' ]; then
		ARC_SKIP_DB_REPAIR=yes "$BIN/v-backup-users-restic"
	fi
}

if [ -z "$BACKUP_SYSTEM" ]; then
	run_incremental
	exit
fi
# The runs are recorded as nightly ones (Fleet PD2)
export ARC_BACKUP_TRIGGER=schedule
for user in $("$BIN/v-list-users" list); do
	check_suspend=$(grep "SUSPENDED='no'" $ARCPANEL/data/users/$user/user.conf)
	log=$ARCPANEL/log/backup.log
	if [ ! -f "$ARCPANEL/data/users/$user/user.conf" ]; then
		continue
	fi
	check_backup_conditions
	check_suspend=$(grep "SUSPENDED='no'" $ARCPANEL/data/users/$user/user.conf)
	log=$ARCPANEL/log/backup.log
	if [ -n "$check_suspend" ]; then
		echo -e "================================" >> $log
		echo -e "$user" >> $log
		echo -e "--------------------------------\n" >> $log
		nice -n 19 ionice -c2 -n7 $BIN/v-backup-user $user >> $log 2>&1
		echo -e "\n--------------------------------\n\n" >> $log
	fi
done

run_incremental

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
