#!/bin/bash
# info: suspend a Docker app (E4)
# options: USER NAME
#
# example: v-suspend-docker-app alice status
#
# This function stops the containers of the Docker app NAME of USER and
# marks it suspended: it does not start again until it is unsuspended. Its
# ports stay assigned.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
name=$2

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/tenancy.sh
source $HESTIA/func/tenancy.sh
# shellcheck source=/usr/local/hestia/func/ports.sh
source $HESTIA/func/ports.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
# shellcheck source=/usr/local/hestia/func/docker.sh
source $HESTIA/func/docker.sh

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER NAME'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
dockerapp_check_app "$user" "$name" any
if [ "$(dockerapp_get "$user" "$name" SUSPENDED)" = 'yes' ]; then
	check_result "$E_SUSPENDED" "the Docker app $name is already suspended"
fi
dockerapp_check_no_task "$user" "$name"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

dockerapp_lock "$user"
dockerapp_halt "$user" "$name"
dockerapp_set "$user" "$name" SUSPENDED=yes

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/v-log-action "$user" "Warning" "Docker" "Docker app suspended (Name: $name)."
log_event "$OK" "$ARGUMENTS"

exit
