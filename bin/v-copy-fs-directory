#!/bin/bash
# info: copy directory
# options: USER SRC_DIRECTORY DST_DIRECTORY
#
# example: v-copy-fs-directory alice /home/alice/dir1 /home/alice/dir2
#
# This function copies directory on the file system as the user. Both paths
# must be absolute and inside the user's home; the folder of DST_DIRECTORY
# must exist.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

user=$1
src_dir=$2
dst_dir=$3

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/fs.sh
source $ARCPANEL/func/fs.sh

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER SRC_DIRECTORY DST_DIRECTORY'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

# Checking source and destination paths, then the source
fs_check_path "$src_dir"
fs_check_path "$dst_dir"
if [ ! -e "$src_dir" ]; then
	echo "Error: source directory $src_dir doesn't exist"
	exit 3
fi

# Copying directory
user_exec cp -rf -- "$src_dir" "$dst_dir" > /dev/null 2>&1
if [ $? -ne 0 ]; then
	echo "Error: directory $src_dir was not copied"
	exit 3
fi

# Exiting
exit
