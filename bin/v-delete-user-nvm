#!/bin/bash
# info: remove Node.js (nvm) of a user (E13)
# options: USER
#
# example: v-delete-user-nvm alice
#
# This function deletes ~/.nvm of the user, with every Node.js runtime and
# global package in it, and the nvm block of ~/.bashrc.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/nodeapp.sh
source $ARCPANEL/func/nodeapp.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

[ -z "$HOMEDIR" ] && check_result "$E_NOTEXIST" "ArcPanel environment vars not present"

nvm_dir=$(node_nvm_dir "$user")
node_check_path "$user" "$nvm_dir"
if [ ! -e "$nvm_dir" ] && ! node_shell_block_present "$user"; then
	check_result "$E_NOTEXIST" "Node.js is not enabled for $user"
fi
if node_task_running "$user"; then
	check_result "$E_INUSE" "Another Node.js task is running for $user"
fi
if [ "$(nodeapp_count "$user")" -gt 0 ]; then
	check_result "$E_INUSE" "$user has Node.js apps; delete them first"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

node_shell_block_remove "$user"
if [ -e "$nvm_dir" ]; then
	node_home_dir_delete "$user" .nvm
	check_result $? "$nvm_dir could not be removed"
fi
rm -f "$ARCPANEL/data/users/$user"/node-outdated-*.json

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "$user" "Info" "Node.js" "Node.js removed."
log_event "$OK" "$ARGUMENTS"

exit
