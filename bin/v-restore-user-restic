#!/bin/bash
# info: restore user via Restic
# options: USER SNAPSHOT WEB DNS MAIL DB CRON UDIR
#
# example: v-restore-user-restic user snapshot
#
# This function for restoring a user from restic snapshot: domains,
# databases and cron jobs through their own commands, then the user's own
# folders, copied into the home as the user (E39 W1).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
web=${3:-*}
dns=${4:-*}
mail=${5:-*}
db=${6:-*}
cron=${7:-yes}
udir=${8:-yes}
notify=${9:-no}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/domain.sh
source $ARCPANEL/func/domain.sh
# shellcheck source=/usr/local/arcpanel/func/ip.sh
source $ARCPANEL/func/ip.sh
# shellcheck source=/usr/local/arcpanel/func/rebuild.sh
source $ARCPANEL/func/rebuild.sh
# shellcheck source=/usr/local/arcpanel/func/syshealth.sh
source $ARCPANEL/func/syshealth.sh
# shellcheck source=/usr/local/arcpanel/func/safe-fs.sh
source $ARCPANEL/func/safe-fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

args_usage='USER SNAPSHOT [WEB] [DNS] [MAIL] [DB] [CRON] [UDIR] [NOTIFY]'
check_args '2' "$#" "$args_usage"
is_format_valid 'user' 'snapshot'
is_object_valid 'user' 'USER' "$user"

source_conf $ARCPANEL/conf/restic.conf

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if ! restic_user "$user" cat snapshot -- "$snapshot" > /dev/null 2>&1; then
	check_result "$E_NOTEXIST" "Invalid snapshot"
fi

# Restore web domains
echo "[ * ] Restore Web domains"
$BIN/v-restore-web-domain-restic "$user" "$snapshot" "$web" 'no'
echo "[ * ] Restore DNS domains"
$BIN/v-restore-dns-domain-restic "$user" "$snapshot" "$dns"
echo "[ * ] Restore Mail domains"
$BIN/v-restore-mail-domain-restic "$user" "$snapshot" "$mail"
echo "[ * ] Restore Databases"
$BIN/v-restore-database-restic "$user" "$snapshot" "$db"
if [ -n "$cron" ]; then
	echo "[ * ] Restore Cronjobs"
	$BIN/v-restore-cron-job-restic "$user" "$snapshot"
fi
if [ "$udir" = "yes" ]; then
	echo "[ * ] Restore user files"
	safe_workdir restore-user
	restic_restore_data "$SAFE_WORKDIR" "$snapshot" --include="/home/$user" --exclude="/home/$user/web" \
		--exclude="/home/$user/conf" --exclude="/home/$user/mail" --exclude="/home/$user/backup"
	check_result $? "Unable to download user folders"
	if [ -d "$SAFE_WORKDIR/home/$user" ]; then
		copy_into_home "$SAFE_WORKDIR/home/$user" "$HOMEDIR/$user" || echo "[ ! ] Some user files could not be restored"
	fi
	safe_workdir_cleanup
fi

# Rebuilding user
rebuild_user_conf

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Update user counters
$BIN/v-update-user-counters $user
$BIN/v-update-user-counters "$ROOT_USER"
$BIN/v-update-sys-ip-counters

sed -i "/v-restore-user-restic '$user' '$snapshot' /d" $ARCPANEL/data/queue/backup.pipe

# Logging
$BIN/v-log-action "system" "Info" "Backup" "User successfully restored (User: $user, Snapshot: $snapshot)."
$BIN/v-log-action "$user" "Info" "Backup" "User successfully restored (Snapshot: $snapshot)."
log_event "$OK" "$ARGUMENTS"
exit
