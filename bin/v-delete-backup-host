#!/bin/bash
# info: delete backup host
# options: TYPE [HOST]
#
# example: v-delete-backup-host sftp
#
# This function deletes the backup host of TYPE (local, ftp, sftp, b2 or
# rclone): since E48 the backup destination named TYPE. It leaves every
# backup job first; a job left without targets is deleted. Archives on
# the host stay where they are.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
type=$1
host=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/backup-driver.sh
source $ARCPANEL/func/backup-driver.sh
# shellcheck source=/usr/local/arcpanel/func/backup-job.sh
source $ARCPANEL/func/backup-job.sh
# shellcheck source=/usr/local/arcpanel/func/backup-legacy.sh
source $ARCPANEL/func/backup-legacy.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'TYPE [HOST]'
if ! bd_exists "$type"; then
	echo "Error: invalid backup type"
	log_event "$E_INVALID" "$ARGUMENTS"
	exit "$E_INVALID"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

bl_target_drop "$type"
"$BIN/v-delete-backup-destination" "$type"
check_result $? "the backup host could not be deleted"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "Backup" "Removed remote backup host (Host: $host, Type: $type)."
log_event "$OK" "$ARGUMENTS"

exit
