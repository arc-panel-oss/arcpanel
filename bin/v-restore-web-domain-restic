#!/bin/bash
# info: restore WEB domain
# options: USER SNAPSHOT DOMAIN [NOTIFY] [NEW_USER]
#
# example: v-restore-web-domain-restic user snapshot domain.com
# example: v-restore-web-domain-restic user snapshot 'domain.com,domain2.com'
# example: v-restore-web-domain-restic user snapshot '*'
#
# This function for restoring web domains from restic snapshot. The record,
# certificates and paths read from the snapshot are validated; the site
# files are copied into the home as the user. Custom web server
# configuration is not restored from a snapshot, because the user can
# change it in ~/backup before the backup runs (E39 W1).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
web=$3
notify=${4-no}
new_user=${5-no}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/backup-driver.sh
source $ARCPANEL/func/backup-driver.sh
# shellcheck source=/usr/local/arcpanel/func/backup-job.sh
source $ARCPANEL/func/backup-job.sh
# shellcheck source=/usr/local/arcpanel/func/domain.sh
source $ARCPANEL/func/domain.sh
# shellcheck source=/usr/local/arcpanel/func/ip.sh
source $ARCPANEL/func/ip.sh
# shellcheck source=/usr/local/arcpanel/func/rebuild.sh
source $ARCPANEL/func/rebuild.sh
# shellcheck source=/usr/local/arcpanel/func/syshealth.sh
source $ARCPANEL/func/syshealth.sh
# shellcheck source=/usr/local/arcpanel/func/safe-fs.sh
source $ARCPANEL/func/safe-fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

args_usage='USER SNAPSHOT DOMAIN [NOTIFY] [NEW_USER]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user' 'snapshot'
is_object_valid 'user' 'USER' "$user"

# The user's repository on the destination that holds the snapshot (E48)
restic_select "$user" "$snapshot"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

safe_workdir restore-web
tmpdir=$SAFE_WORKDIR
read_snapshot_index "$tmpdir" "$snapshot"
check_result $? "Unable to download from snapshot"

# Folders of a web domain the user writes; logs and stats are rebuilt
web_folders='public_html public_shtml private cgi-bin document_errors'

domains=""
IFS=',' read -r -a domains <<< "$WEB"
for domain in "${domains[@]}"; do
	if [[ ",$web," == *",$domain,"* || "$web" = '*' ]]; then
		if ! is_restore_name_valid domain "$domain"; then
			restore_skip "web domain" "$domain" "invalid name"
			continue
		fi
		# Cleanup previous domain keys
		restore_record_reset web

		# Checking domain existence
		check_config=$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)
		if [ -z "$check_config" ]; then
			check_new=$(is_domain_new 'web' $domain)
			if [ "$check_new" = 'yes' ]; then
				error="$domain belongs to another user"
				echo "$error" | $SENDMAIL -s "$subj" $email $notify
				sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
				check_result "$E_PARSING" "$error"
			fi
		fi
		restic_restore_config "$tmpdir" "$snapshot" --include="/home/$user/backup/web/$domain"
		check_result $? "Unable to download domain from snapshot"
		src="$tmpdir/home/$user/backup/web/$domain"

		# Restoring web.conf
		if [ -z "$check_config" ]; then
			if ! parse_backup_record "$(restore_record_keys web)" "$(head -n 1 -- "$src/arcpanel/web.conf" 2> /dev/null)"; then
				restore_skip "web domain" "$domain" "invalid record"
				continue
			fi
			DOMAIN=$domain

			# Aliases: valid names that no other user holds
			aliases=''
			for dom_alias in ${ALIAS//,/ }; do
				if is_restore_name_valid domain "$dom_alias" && [ -z "$(is_domain_new 'web' "$dom_alias")" ]; then
					aliases+=",$dom_alias"
				fi
			done
			ALIAS=${aliases#,}

			# Checking IP address
			if ! is_restore_ip_valid "$IP"; then
				IP=''
			fi
			check_ip=$(is_ip_valid $IP $user)
			if [ -n "$check_ip" ]; then
				local_ip=''
				get_user_ip $user
				IP=$ip
			fi
			if ! is_restore_ip_valid "$IP"; then
				restore_skip "web domain" "$domain" "no valid IP address"
				continue
			fi
			if [ -n "$IP6" ] && ! is_restore_ip_valid "$IP6"; then
				IP6=''
			fi

			# Checking web, proxy and backend templates
			if ! is_restore_template_valid "$TPL" || [ -n "$(is_web_template_valid "$TPL")" ] \
				|| [ -n "$(is_template_allowed_for "$TPL" web "$user")" ]; then
				TPL='default'
			fi
			if ! is_restore_template_valid "$PROXY" || [ -n "$(is_proxy_template_valid "$PROXY")" ] \
				|| [ -n "$(is_template_allowed_for "$PROXY" proxy "$user")" ]; then
				PROXY='default'
			fi
			if ! is_restore_template_valid "$BACKEND" || [ -n "$(is_backend_template_valid "$BACKEND")" ]; then
				BACKEND='default'
			fi
			# Only a PHP version the package allows (E39 W5 P3, P5)
			if ! php_backend_allowed_for_user "$user" "$BACKEND"; then
				restore_skip "backend template $BACKEND of" "$domain" "the package does not allow its PHP version, the domain uses default"
				BACKEND='default'
			fi

			# Custom roots stay below ~/web of the user
			if ! is_restore_web_root_valid "$CUSTOM_DOCROOT"; then
				CUSTOM_DOCROOT=''
			fi
			if ! is_restore_web_root_valid "$CUSTOM_PHPROOT"; then
				CUSTOM_PHPROOT=''
			fi

			# FTP accounts of this user only
			restore_web_ftp_filter

			# Copying SSL certificates
			if [ "$SSL" = 'yes' ]; then
				if copy_from_work "$src/arcpanel/$domain.crt" "$USER_DATA/ssl/$domain.crt"; then
					for ext in ca pem key; do
						copy_from_work "$src/arcpanel/$domain.$ext" "$USER_DATA/ssl/$domain.$ext"
					done
				fi
			fi

			# Merging web.conf keys
			str=$(restore_record web "U_BANDWIDTH='0' SUSPENDED='no' TIME='$(date +%T)' DATE='$(date +%F)'")
			if [ -z "$str" ]; then
				restore_skip "web domain" "$domain" "invalid record"
				continue
			fi
			echo "$str" >> $USER_DATA/web.conf

			# PHP-FPM profile of the domain (E41): a profile this server does not
			# have falls back to default
			php_profile=$(grep -oE "PROFILE='[a-z0-9][a-z0-9-]{0,31}'" "$src/arcpanel/web.php.conf" 2> /dev/null | head -n1 | cut -d\' -f2)
			if [ -n "$php_profile" ] && [ "$WEB_BACKEND_POOL" != 'user' ]; then
				restored_profile=$(php_restore_profile "$user" "$php_profile")
				if [ "$restored_profile" != "$php_profile" ]; then
					restore_skip "PHP-FPM profile $php_profile of" "$domain" "it does not exist on this server or the package does not allow it, the domain uses $restored_profile"
				fi
				php_domain_profile_set "$user" "$domain" "$restored_profile"
			fi

			# Rebuilding backend
			if [ -n "$WEB_BACKEND" ]; then
				$BIN/v-add-web-domain-backend $user $domain $BACKEND
			fi
		fi

		if [ -n "$(find "$src/conf" -mindepth 1 -maxdepth 1 -type f ! -name '*.ca' ! -name '*.crt' ! -name '*.key' ! -name '*.pem' ! -name '*.conf' 2> /dev/null)" ]; then
			restore_skip "custom web server configuration of" "$domain" "not restored from snapshots"
		fi

		# Rebuilding vhost to prevent user overwrite default config changes not ideal
		rebuild_web_domain_conf

		# The site files: emptied and copied back by the user
		restic_restore_data "$tmpdir" "$snapshot" --include="/home/$user/web/$domain"
		check_result $? "Unable to download user data"
		for folder in $web_folders; do
			if [ -d "$tmpdir/home/$user/web/$domain/$folder" ] && [ -d "$HOMEDIR/$user/web/$domain/$folder" ]; then
				if [ "$folder" = 'public_html' ]; then
					user_exec find "$HOMEDIR/$user/web/$domain/public_html/" -mindepth 1 -delete
				fi
				copy_into_home "$tmpdir/home/$user/web/$domain/$folder" "$HOMEDIR/$user/web/$domain/$folder"
				check_result $? "the files of $domain could not be copied into the home" "$E_FORBIDEN"
			fi
		done
		rm -rf -- "$tmpdir/home/$user/web/$domain"

		if [ "$new_user" = "yes" ]; then
			echo "[ * ] Fix permissions"
			chown --no-dereference $user:$user \
				$HOMEDIR/$user/web/$domain \
				$HOMEDIR/$user/web/$domain/private \
				$HOMEDIR/$user/web/$domain/cgi-bin \
				$HOMEDIR/$user/web/$domain/public_*html \
				$HOMEDIR/$user/web/$domain/logs \
				$HOMEDIR/$user/web/$domain/stats

			chown root:$user /var/log/$WEB_SYSTEM/domains/$domain.*
		fi
		# Rebuilding web config for the second time to make sure ftp users keep working
		rebuild_web_domain_conf

	fi
done
#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#
if [ "$new_user" = "yes" ]; then
	rebuild_user_conf
fi
safe_workdir_cleanup

# Update user counters
$BIN/v-update-user-counters $user
$BIN/v-update-user-counters "$ROOT_USER"
$BIN/v-update-sys-ip-counters

sed -i "/v-restore-web-domain-restic '$user' '$snapshot' '$web' /d" $ARCPANEL/data/queue/backup.pipe

# Logging
$BIN/v-log-action "system" "Info" "Backup" "Web domain successfully restored (User: $user, Snapshot: $snapshot, Domain: $web)."
$BIN/v-log-action "$user" "Info" "Backup" "Web domain successfully restored (User: $user, Snapshot: $snapshot, Domain: $web)."
log_event "$OK" "$ARGUMENTS"
exit
