#!/bin/bash
# info: run a Docker app task started by v-start-docker-app-task (E4)
# options: USER NAME ACTION [VERSION]
#
# example: v-run-docker-app-task alice status install
#
# This function is the command of the docker.ACTION jobs that
# v-start-docker-app-task and v-add-docker-app start (E15): it runs the task;
# the job runner records the result. It refuses to run outside such a job.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
name=$2
action=$3
target=$4

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/ports.sh
source $ARCPANEL/func/ports.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# Perform verification if read-only mode is enabled (E39 W5 L22)
check_arcpanel_demo_mode
# shellcheck source=/usr/local/arcpanel/func/docker.sh
source $ARCPANEL/func/docker.sh

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ -z "$action" ]; then
	echo "Usage: v-run-docker-app-task USER NAME ACTION [VERSION]"
	exit "$E_ARGS"
fi
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
if ! dockerapp_name_valid "$name" || ! dockerapp_exists "$user" "$name" \
	|| ! [[ "$action" =~ ^(install|update|rollback|snapshot)$ ]] \
	|| ! job_is_current "docker\\.$action" || [ "${JOB[OBJECT]}" != "docker:$user:$name" ]; then
	check_result "$E_FORBIDEN" "the task was not started by v-start-docker-app-task"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

export ARC_DOCKER_TASK="$user/$name"
# The task log is written by root from output the app controls: capped
exec > >(log_cap) 2>&1
echo "== $action of the Docker app $name ($(date +'%F %T'))"
case "$action" in
	install) docker_with_timeout 1800 dockerapp_task_install "$user" "$name" ;;
	update) docker_with_timeout 1800 dockerapp_task_update "$user" "$name" "$target" ;;
	rollback) docker_with_timeout 1800 dockerapp_task_rollback "$user" "$name" ;;
	snapshot) "$BIN/v-backup-docker-apps" "$user" "$name" ;;
	*) check_result "$E_INVALID" "invalid action :: $action" ;;
esac
rc=$?
if [ "$rc" -ne 0 ]; then
	echo "Exit code $rc"
	if [ "$rc" -eq 124 ] && [ "$action" != 'snapshot' ]; then
		echo "The task took more than 30 minutes"
		dockerapp_update "$user" "$name" STATUS=failed REASON=timeout
	fi
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit "$rc"
