#!/bin/bash
# info: generate access key
# options: USER [PERMISSIONS] [COMMENT] [ALLOWED_IPS] [EXPIRES] [FORMAT]
#
# example: v-add-access-key admin v-purge-nginx-cache,v-list-mail-accounts comment json
# example: v-add-access-key bob v2-observe fleet 203.0.113.7,2001:db8::/48 1830297600 json
#
# The "PERMISSIONS" argument is optional for the admin user only.
# This function creates a key file in $ARCPANEL/data/access-keys/
#
# ALLOWED_IPS limits the key to at most 20 addresses or CIDR networks, comma
# separated; EXPIRES is the Unix time after which the key is refused, at
# least an hour and at most three years ahead (E43 B6). Both are set once:
# a different restriction means a new key. A format name (json, shell,
# plain, csv) as the fourth argument is FORMAT, as before ALLOWED_IPS existed.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
permissions=$2
comment=$3
allowed_ips=''
expires=''
format=shell
if [ "$#" -le 4 ] && [[ "${4-}" =~ ^(json|shell|plain|csv)$ ]]; then
	format=$4
else
	allowed_ips="${4-}"
	expires="${5-}"
	format="${6-shell}"
fi
# The list without spaces
allowed_ips="${allowed_ips// /}"

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# LENGTH characters of the tr set MATRIX from /dev/urandom (E39 W4 D12); tr
# drops the other bytes, so every character is equally likely
keygen() {
	local length=$1 matrix=$2 key=''
	while [ "${#key}" -lt "$length" ]; do
		key+=$(head -c 512 /dev/urandom | LC_ALL=C tr -dc "$matrix")
	done
	printf '%s\n' "${key:0:length}"
}

access_key_id="$(keygen 20 'A-Za-z0-9')"
secret_access_key="$(keygen 40 'A-Za-z0-9_=-')"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

# Remove whitespace and bin path from permissions
permissions="$(cleanup_key_permissions "$permissions")"

time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [PERMISSIONS] [COMMENT] [ALLOWED_IPS] [EXPIRES] [FORMAT]'
# Every value ends up in the key file, one line per key (E39 W5 §4)
for arg in "$@"; do
	if [[ "$arg" == *[[:cntrl:]]* ]]; then
		check_result "$E_INVALID" "invalid argument: control characters are not allowed"
	fi
done
is_format_valid 'user' 'comment' 'format'
is_object_valid 'user' 'USER' "$user"
is_key_permissions_format_valid "$permissions" "$user"
is_access_key_ips_format_valid "$allowed_ips"
is_access_key_expiry_valid "$expires"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ ! -d "$ARCPANEL/data/access-keys/" ]; then
	mkdir -p $ARCPANEL/data/access-keys/
	chown root:root $ARCPANEL/data/access-keys/
	chmod 750 $ARCPANEL/data/access-keys/
fi

if [[ -e "$ARCPANEL/data/access-keys/${access_key_id}" ]]; then
	while [[ -e "$ARCPANEL/data/access-keys/${access_key_id}" ]]; do
		access_key_id=$(keygen 20 'A-Za-z0-9')
	done
fi

echo "SECRET_ACCESS_KEY='$secret_access_key'" > "$ARCPANEL/data/access-keys/${access_key_id}"
echo "USER='$user'" >> "$ARCPANEL/data/access-keys/${access_key_id}"
echo "PERMISSIONS='$permissions'" >> "$ARCPANEL/data/access-keys/${access_key_id}"
echo "COMMENT='$comment'" >> "$ARCPANEL/data/access-keys/${access_key_id}"
echo "TIME='$time'" >> "$ARCPANEL/data/access-keys/${access_key_id}"
echo "DATE='$date'" >> "$ARCPANEL/data/access-keys/${access_key_id}"
# Restrictions (E43 B6), checked by v-check-access-key and v-check-access-key-permissions
echo "ALLOWED_IPS='$allowed_ips'" >> "$ARCPANEL/data/access-keys/${access_key_id}"
echo "EXPIRES='$expires'" >> "$ARCPANEL/data/access-keys/${access_key_id}"

chmod 640 "$ARCPANEL/data/access-keys/${access_key_id}"

$BIN/v-list-access-key "$access_key_id" "$format"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
log_history "Access key $access_key_id generated" "Warning" "$user" "API"
log_event "$OK" "$ARGUMENTS"

exit
