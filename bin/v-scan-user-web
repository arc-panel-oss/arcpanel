#!/bin/bash
# info: scan the web files of a user for malware (E25)
# options: USER [DOMAIN] [MODE] [TRIGGER] [FORMAT]
#
# example: v-scan-user-web alice example.com full manual json
#
# This function scans the public_html folder of one web domain, or of every
# web domain of the user when DOMAIN is empty, with the malware scanner
# (func/malware-scan.php) running as the user under nice and ionice. MODE is
# full (default) or incremental (only new and changed files since the last
# scan with the same rules). TRIGGER is manual (default) or nightly.
#
# The open findings of the scanned domains are replaced by the result;
# ignored and quarantined files are left out. New findings send a panel
# notification to the user and the administrator. Prints the scan record.
# A scan of the user that is already running answers E_INUSE.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=${2-}
mode=${3:-full}
trigger=${4:-manual}
format=${5:-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/malware.sh
source $ARCPANEL/func/malware.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [DOMAIN] [MODE] [TRIGGER] [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
if [ -n "$domain" ]; then
	is_format_valid 'domain'
	is_object_valid 'web' 'DOMAIN' "$domain"
fi
case "$mode" in
	full | incremental) ;;
	*) check_result "$E_INVALID" "invalid mode :: $mode (full or incremental)" ;;
esac
case "$trigger" in
	manual | nightly) ;;
	*) check_result "$E_INVALID" "invalid trigger :: $trigger (manual or nightly)" ;;
esac
case "$format" in
	json | shell | plain) ;;
	*) check_result "$E_INVALID" "invalid format :: $format" ;;
esac
is_malware_scan_enabled

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

malware_init "$user"
if ! malware_scan_lock "$user"; then
	check_result "$E_INUSE" "a malware scan of $user is running"
fi

dir=$(malware_dir "$user")
id=$(malware_new_id)
while [ -e "$dir/scans/$id.json" ]; do
	id=$(malware_new_id)
done
version=$(malware_rules_version)
start=$(date +'%F %T')
work=$(mktemp -d)
chmod 700 "$work"
trap 'rm -rf "$work"' EXIT

# The scan record: running now, completed at the end
record() {
	local counts=${3:-}
	if [ -z "$counts" ]; then
		counts='{}'
	fi
	jq -nc --arg id "$id" --arg domain "$domain" --arg mode "$mode" --arg trigger "$trigger" \
		--arg status "$1" --arg start "$start" --arg end "${2-}" --arg rules "$version" \
		--argjson counts "$counts" '
		{ ID: $id, DOMAIN: $domain, MODE: $mode, TRIGGER: $trigger, STATUS: $status,
			START: $start, END: $end, FILES: 0, CHANGED: 0, SKIPPED: 0, ERRORS: 0,
			FINDINGS: 0, NEW: 0, NEW_SUMMARY: [], RULES: $rules, ERROR: "" } + $counts'
}
malware_write "$dir/scans/$id.json" "$(record running)"

if [ -n "$domain" ]; then
	domains=("$domain")
else
	mapfile -t domains < <(malware_user_domains "$user")
fi

run="$work/run.jsonl"
: > "$run"
scanned=()
problems=()
files=0
changed=0
skipped=0
errors=0
for d in "${domains[@]}"; do
	state="$dir/state/$d.tsv"
	feed=/dev/null
	if [ "$mode" = 'incremental' ] && [ -f "$state" ] && [ "$(head -n 1 "$state")" = "#rules $version" ]; then
		feed=$state
	fi
	malware_run_scanner "$user" "$(malware_docroot "$user" "$d")" < "$feed" > "$work/out" 2> "$work/err"
	rc=$?
	if [ "$rc" -eq 3 ]; then
		problems+=("$d: public_html does not exist")
		rm -f "$state"
		continue
	fi
	if ! tail -n 1 "$work/out" | jq -e '.t == "done"' > /dev/null 2>&1; then
		problems+=("$d: the scan did not finish (exit code $rc)")
		continue
	fi
	scanned+=("$d")
	jq -c --arg d "$d" 'select(.t == "file" or .t == "hit") + {d: $d}' "$work/out" >> "$run"
	read -r f c s e < <(tail -n 1 "$work/out" | jq -r '"\(.files) \(.changed) \(.skipped) \(.errors)"')
	files=$((files + f))
	changed=$((changed + c))
	skipped=$((skipped + s))
	errors=$((errors + e))
	{
		echo "#rules $version"
		jq -r 'select(.t == "file") | [.path, (.mtime | tostring), (.size | tostring), .sha256] | @tsv' "$work/out"
	} > "$state.$$"
	chmod 640 "$state.$$"
	mv -f "$state.$$" "$state"
done

# Hits with their finding ids
: > "$work/hits.jsonl"
while IFS= read -r hit; do
	hit_domain=$(jq -r '.d' <<< "$hit")
	hit_path=$(jq -r '.path' <<< "$hit")
	jq -c --arg id "$(malware_finding_id "$hit_domain" "$hit_path")" '. + {id: $id}' <<< "$hit" >> "$work/hits.jsonl"
done < <(jq -c 'select(.t == "hit")' "$run")

scanned_json=$(printf '%s\n' "${scanned[@]}" | jq -R . | jq -sc 'map(select(. != ""))')
now=$(date +'%F %T')

malware_lock "$user"
malware_read "$user" findings > "$work/prev.json"
malware_read "$user" ignore > "$work/ignore.json"
malware_read "$user" quarantine > "$work/quarantine.json"
jq -n --slurpfile prev "$work/prev.json" --slurpfile ignore "$work/ignore.json" \
	--slurpfile quarantine "$work/quarantine.json" --slurpfile hits "$work/hits.jsonl" \
	--slurpfile run "$run" --argjson scanned "$scanned_json" --arg scan "$id" --arg now "$now" '
	{critical: 0, high: 1, medium: 2} as $rank
	| ($ignore[0] | map({(.SHA256): true}) | add // {}) as $ignored
	| ($quarantine[0] | map({"\(.DOMAIN)/\(.PATH)/\(.SHA256)": true}) | add // {}) as $quarantined
	| ($run | map(select(.t == "file") | {"\(.d)/\(.path)": .}) | add // {}) as $files
	| ($prev[0] | map({(.ID): .}) | add // {}) as $before
	| def open: $ignored[.SHA256] != true and $quarantined["\(.DOMAIN)/\(.PATH)/\(.SHA256)"] != true;
	[$prev[0][] | select(.DOMAIN as $d | ($scanned | index($d)) == null
		or $files["\(.DOMAIN)/\(.PATH)"].changed == false) | select(open)] as $kept
	| [$hits[] | {ID: .id, DOMAIN: .d, PATH: .path, SHA256: .sha256,
		SIZE: ($files["\(.d)/\(.path)"].size // 0), MTIME: ($files["\(.d)/\(.path)"].mtime // 0),
		SEVERITY: .severity, RULES: .rules, LINE: .line, SNIPPET: .snippet, DETECTED: $now, SCAN: $scan}
		| select(open)
		| if $before[.ID].SHA256 == .SHA256 then .DETECTED = $before[.ID].DETECTED | .NEW = false else .NEW = true end] as $found
	| {
		findings: ($kept + ($found | map(del(.NEW))) | sort_by($rank[.SEVERITY], .DOMAIN, .PATH)),
		scanned: [($kept + ($found | map(del(.NEW))))[] | select(.DOMAIN as $d | $scanned | index($d))] | length,
		new: [$found[] | select(.NEW)]
	}' > "$work/merged.json"
malware_write "$dir/findings.json" "$(jq -c '.findings' "$work/merged.json")"
malware_unlock

new=$(jq '.new | length' "$work/merged.json")
status=done
if [ "${#scanned[@]}" -eq 0 ] && [ "${#problems[@]}" -gt 0 ]; then
	status=failed
fi
counts=$(jq -c --argjson files "$files" --argjson changed "$changed" --argjson skipped "$skipped" \
	--argjson errors "$errors" --arg error "$(printf '%s; ' "${problems[@]}" | sed 's/; $//')" '
	{ FILES: $files, CHANGED: $changed, SKIPPED: $skipped, ERRORS: $errors,
		FINDINGS: .scanned, NEW: (.new | length), ERROR: $error,
		NEW_SUMMARY: (.new | group_by(.DOMAIN) | map({ DOMAIN: .[0].DOMAIN,
			CRITICAL: map(select(.SEVERITY == "critical")) | length,
			HIGH: map(select(.SEVERITY == "high")) | length,
			MEDIUM: map(select(.SEVERITY == "medium")) | length })) }' "$work/merged.json")
result=$(record "$status" "$(date +'%F %T')" "$counts")
malware_write "$dir/scans/$id.json" "$result"

# Keep the newest scan records
find "$dir/scans" -maxdepth 1 -name '*.json' -printf '%f\n' | sort -r \
	| tail -n +$((MALWARE_KEEP_SCANS + 1)) | while IFS= read -r old; do
	rm -f "$dir/scans/$old"
done

if [ "$new" -gt 0 ]; then
	where='your web domains'
	where_admin='the web domains of the user'
	if [ -n "$domain" ]; then
		where=$domain
		where_admin=$domain
	fi
	"$BIN/v-add-user-notification" "$user" "Malware scan" \
		"<p>$new new suspicious file(s) on $where. <a href=\"/malware/$user\">Review them</a>.</p>" > /dev/null 2>&1
	if [ "$user" != "$ROOT_USER" ]; then
		"$BIN/v-add-user-notification" "$ROOT_USER" "Malware scan: $user" \
			"<p>$new new suspicious file(s) of $user on $where_admin. <a href=\"/malware/$user\">Review them</a>.</p>" > /dev/null 2>&1
	fi
fi

# A background scan started by v-start-user-malware-scan ends its task. The
# starter holds the data lock until it has stored this PID.
malware_lock "$user"
if [ "$(malware_task_get "$user" PID)" = "$$" ]; then
	exit_code=0
	if [ "$status" = 'failed' ]; then
		exit_code=$E_NOTEXIST
	fi
	malware_task_set "$user" "STATUS=$status" "EXIT=$exit_code" "END=$(date +'%F %T')" PID=
fi
malware_unlock

malware_print_object "$result" "$format"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

if [ "$status" = 'failed' ]; then
	log_event "$E_NOTEXIST" "$ARGUMENTS"
	exit "$E_NOTEXIST"
fi
log_event "$OK" "$ARGUMENTS"

exit
