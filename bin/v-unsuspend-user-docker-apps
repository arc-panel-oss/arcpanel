#!/bin/bash
# info: start the Docker apps of an unsuspended user again (E4)
# options: USER
#
# example: v-unsuspend-user-docker-apps alice
#
# This function lifts the suspension that v-suspend-user-docker-apps set on
# the Docker apps of USER (SUSPENDED='user') and starts the apps that were
# running. Apps suspended on their own stay suspended. It is run by the
# post_unsuspend_user hook.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/ports.sh
source $ARCPANEL/func/ports.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"
# shellcheck source=/usr/local/arcpanel/func/docker.sh
source $ARCPANEL/func/docker.sh

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ "$(dockerapp_count "$user")" -eq 0 ]; then
	exit
fi
dockerapp_lock "$user"
failed=''
for name in $(dockerapp_names "$user"); do
	if [ "$(dockerapp_get "$user" "$name" SUSPENDED)" = 'user' ]; then
		dockerapp_set "$user" "$name" SUSPENDED=no
		if ! dockerapp_resume "$user" "$name" > /dev/null; then
			failed="$failed $name"
		fi
	fi
done
if [ -n "$failed" ]; then
	echo "$(date +'%F %T') Docker apps of $user could not be started:$failed" >> "$ARCPANEL/log/system.log"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
