#!/bin/bash
# info: stop the Docker apps of a suspended user (E4)
# options: USER
#
# example: v-suspend-user-docker-apps alice
#
# This function stops every Docker app of USER and marks the apps that were
# not suspended on their own as suspended with the user (SUSPENDED='user'),
# so that v-unsuspend-user-docker-apps starts exactly those again. It is run
# by the post_suspend_user hook.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/tenancy.sh
source $HESTIA/func/tenancy.sh
# shellcheck source=/usr/local/hestia/func/ports.sh
source $HESTIA/func/ports.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"
# shellcheck source=/usr/local/hestia/func/docker.sh
source $HESTIA/func/docker.sh

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ "$(dockerapp_count "$user")" -eq 0 ]; then
	exit
fi
dockerapp_lock "$user"
for name in $(dockerapp_names "$user"); do
	dockerapp_halt "$user" "$name"
	if [ "$(dockerapp_get "$user" "$name" SUSPENDED)" = 'no' ]; then
		dockerapp_set "$user" "$name" SUSPENDED=user
	fi
done

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
