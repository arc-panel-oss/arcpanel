#!/bin/bash
# info: print the value of a secret of a user (E38)
# options: USER NAME [VERSION]
#
# example: v-get-user-secret alice /shop/db_password
#
# This function prints the value of the secret NAME of USER, or of a kept
# VERSION. It is for root on the shell only: it refuses to run through sudo,
# so neither the panel nor the APIs can read a value (spec D7).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
name=$2
version=$3

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "$(id -u)" != '0' ] || [ -n "$SUDO_USER" ]; then
	echo "Error: v-get-user-secret can only be executed by root on the shell"
	exit "$E_FORBIDEN"
fi
check_args '2' "$#" 'USER NAME [VERSION]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
secret_check_name "$name"
if [ -n "$version" ] && ! [[ "$version" =~ ^[1-9][0-9]{0,8}$ ]]; then
	check_result "$E_INVALID" "invalid version :: $version"
fi
secret_check_system

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

secret_check_exists "$user" "$name"
if [ -z "$version" ]; then
	version=$(secret_field "$(secret_line "$user" "$name")" VERSION)
fi
file="$(secret_vdir "$user" "$name")/v$version.age"
if [ ! -f "$file" ]; then
	check_result "$E_NOTEXIST" "version $version of $name is not kept"
fi
secret_decrypt "$user" "$file"
check_result $? "the secret could not be decrypted" "$E_FORBIDEN"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$user $name $version"

exit
