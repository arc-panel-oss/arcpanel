#!/bin/bash
# info: install the Docker engine in the background (E4)
# options: [DATA_ROOT]
#
# example: v-start-sys-docker-task
#
# This function starts v-add-sys-docker as a job of type docker.engine (E15),
# for the admin Docker page, and prints the job ID. The state and the output
# are read with v-list-job or v-list-sys-docker-task. One engine task (or
# system task) runs at a time.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
data_root=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/ports.sh
source $ARCPANEL/func/ports.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"
# shellcheck source=/usr/local/arcpanel/func/docker.sh
source $ARCPANEL/func/docker.sh
# shellcheck source=/usr/local/arcpanel/func/job.sh
source $ARCPANEL/func/job.sh

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ -n "$data_root" ] && ! [[ "$data_root" =~ ^/[A-Za-z0-9._/-]+$ ]]; then
	check_result "$E_INVALID" "invalid data root :: $data_root"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

job_start docker.engine system docker:engine "$(job_default_actor)" -- v-run-sys-docker-task ${data_root:+"$data_root"}
job_check_started "$?" "the Docker engine is being installed"
echo "$JOB_ID"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
