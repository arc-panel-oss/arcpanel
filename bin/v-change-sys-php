#!/bin/bash
# info: Change default php version server wide
# options: VERSION

# example: v-change-sys-php 8.0

version=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/php.sh
source $ARCPANEL/func/php.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

check_args '1' "$#" 'VERSION'

# An exact version that is installed (E39 W5 P6)
if ! php_version_format_valid "$version"; then
	check_result "$E_INVALID" "invalid PHP version :: $version (for example 8.4)"
fi
if ! php_version_installed "$version"; then
	check_result "$E_NOTEXIST" "PHP $version is not installed"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

php_lock "$version"

# The www pool moves to the new default version; the other versions lose
# theirs only once it is in place
if ! cp -f "$ARCPANEL/install/deb/php-fpm/www.conf" "/etc/php/$version/fpm/pool.d/www.conf"; then
	check_result "$E_UPDATE" "the www pool of PHP $version could not be written"
fi
for conf in /etc/php/*/fpm/pool.d/www.conf; do
	if [ "$conf" != "/etc/php/$version/fpm/pool.d/www.conf" ]; then
		rm -f "$conf"
	fi
done

for user in $("$BIN/v-list-users" list); do
	$BIN/v-rebuild-web-domains "$user" 'no' > /dev/null 2>&1
	$BIN/v-rebuild-mail-domains "$user" 'no' > /dev/null 2>&1
done

# Reload "current" php version before reload everthing
$BIN/v-restart-web-backend '' "$(multiphp_default_version)"
$BIN/v-restart-web-backend
$BIN/v-restart-web
$BIN/v-restart-proxy

update-alternatives --set php "/usr/bin/php$version"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"
