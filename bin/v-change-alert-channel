#!/bin/bash
# info: change an alert channel of a scope (E16)
# options: SCOPE ID NAME ENABLED [TARGET] [SECRET_FILE]
#
# example: v-change-alert-channel system 17940000001234 'Ops mail' yes ops@example.com
# example: v-change-alert-channel alice 17940000001234 'My chat' yes 123456789 /tmp/token
#
# This function changes the name, the switch (yes or no) and, when given,
# the target of channel ID of SCOPE. A SECRET_FILE replaces the stored token
# or webhook URL (the file is deleted); an empty or missing SECRET_FILE
# keeps it. Turning a channel on clears its failure count. The panel channel
# takes a name and the switch only.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
scope=$1
id=$2
name=$3
enabled=$4
secret_file=${6-}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/alerts.sh
source $ARCPANEL/func/alerts.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '4' "$#" 'SCOPE ID NAME ENABLED [TARGET] [SECRET_FILE]'
alerts_check_scope "$scope"
if ! alerts_channel_exists "$scope" "$id"; then
	check_result "$E_NOTEXIST" "channel $id does not exist in scope $scope"
fi
alerts_check_channel_name "$name"
if [ "$enabled" != 'yes' ] && [ "$enabled" != 'no' ]; then
	check_result "$E_INVALID" "ENABLED must be yes or no"
fi
alerts_channel_read "$scope" "$id"
type=${CH[TYPE]}
target=${CH[TARGET]}
if [ "$#" -ge 5 ]; then
	target=$5
fi
if [ "$type" = 'panel' ]; then
	if [ "$target" != '' ] || [ -n "$secret_file" ]; then
		check_result "$E_INVALID" "the panel channel takes no target and no secret"
	fi
else
	alerts_check_target "$type" "$target"
fi
if [ -n "$secret_file" ] && ! alerts_type_has_secret "$type"; then
	check_result "$E_INVALID" "a $type channel takes no secret"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ -n "$secret_file" ]; then
	alerts_read_secret_file "$type" "$secret_file"
fi

alerts_check_lock
if [ -n "$secret_file" ]; then
	alerts_store_secret "$scope" "$id" "$name"
fi
alerts_channel_read "$scope" "$id"
CH[NAME]=$name
CH[TARGET]=$target
if [ -n "$secret_file" ]; then
	CH[SECRET]=$(alerts_secret_name "$id")
fi
if [ "$enabled" = 'yes' ] && [ "${CH[ENABLED]}" != 'yes' ]; then
	CH[FAILS]=0
fi
CH[ENABLED]=$enabled
alerts_channel_write "$scope"
alerts_unlock

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

alerts_log_action "$scope" "Alert channel changed (Name: $name, Enabled: $enabled)."
log_event "$OK" "$ARGUMENTS"

exit
