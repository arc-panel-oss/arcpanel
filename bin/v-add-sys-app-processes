#!/bin/bash
# info: set up app processes (E42)
# options: NONE
#
# example: v-add-sys-app-processes
#
# This function prepares a server for app processes: the root-owned folder
# of their run files, the app process keys of the "developer" package and
# the 5-minute v-check-sys-app-processes job that converges the units with
# the records (M3). It is safe to run again and keeps packages an administrator
# has changed.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/appprocess.sh
source $ARCPANEL/func/appprocess.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "$(id -u)" != '0' ]; then
	echo "Error: v-add-sys-app-processes can only be executed by the root user"
	exit "$E_FORBIDEN"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Run files: each user's folder is root:<user> 0750 (appproc_files_write)
mkdir -p "$APPPROC_RUN_DIR"
chown root:root "$APPPROC_RUN_DIR"
chmod 711 "$APPPROC_RUN_DIR"
chmod 755 "$APPPROC_RUNNER" 2> /dev/null

# The developer package allows app processes; other packages keep the
# default (no)
if [ -f "$ARCPANEL/data/packages/developer.tenancy" ]; then
	if ! grep -q "^APP_PROCESSES=" "$ARCPANEL/data/packages/developer.tenancy"; then
		tenancy_pkg_set developer APP_PROCESSES yes
	fi
	if ! grep -q "^APP_PROCESSES_MAX=" "$ARCPANEL/data/packages/developer.tenancy"; then
		tenancy_pkg_set developer APP_PROCESSES_MAX 10
	fi
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
