#!/bin/bash
# info: Schedule a backup
# options: USER BACKUP [FORMAT]
#
# example: v-schedule-user-backup-download admin 2019-04-22_01-00-00.tar
#
# This function for scheduling user backup creation.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
backup=$2
format=shell

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/queuetask.sh
source $ARCPANEL/func/queuetask.sh
# shellcheck source=/usr/local/arcpanel/func/domain.sh
source $ARCPANEL/func/domain.sh
# shellcheck source=/usr/local/arcpanel/func/db.sh
source $ARCPANEL/func/db.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "$#" -gt 3 ]; then
	check_result "$E_ARGS" "too many arguments"
fi
if [ "$#" -eq 3 ]; then
	format=$3
fi
check_args '2' "$#" 'USER BACKUP [FORMAT]'
is_format_valid 'user' 'backup' 'format'

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Adding backup task to the queue
qt_queue backup-download "$backup" "$ARCPANEL/data/queue/backup.pipe" \
	"$BIN/v-download-backup $user $backup 2>&1"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
