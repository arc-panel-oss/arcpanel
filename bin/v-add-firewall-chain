#!/bin/bash
# info: add firewall chain
# options: CHAIN [PORT] [PROTOCOL]
#
# example: v-add-firewall-chain CRM 5678 TCP
#
# This function adds a Fail2Ban chain to the system firewall: two ban sets
# (IPv4 and IPv6) that drop their addresses on the chain's ports

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
chain=$(echo "$1" | tr '[:lower:]' '[:upper:]')
port="$2"
port_ext="$2"
protocol="$3"
[ -z "$protocol" ] && protocol='TCP'
protocol=$(echo "$protocol" | tr '[:lower:]' '[:upper:]')

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source "$ARCPANEL/func/main.sh"
# shellcheck source=/usr/local/arcpanel/func/firewall.sh
source "$ARCPANEL/func/firewall.sh"
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# Get arcpanel port by reading nginx.conf
arcpanelport=$(sed -ne "/listen/{s/.*listen[^0-9]*\([0-9][0-9]*\)[ \t]*ssl\;/\1/p;q}" "$ARCPANEL/nginx/conf/nginx.conf")
if [ -z "$arcpanelport" ]; then
	arcpanelport=8083
fi

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'CHAIN [PORT] [PROTOCOL]'
is_format_valid 'chain' 'port_ext' 'protocol'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

# A server left on iptables has no sets; v-update-firewall, which loads the
# table itself, may still add the SSH chain (spec §16 H5)
if [ -z "${ARCPANEL_FIREWALL_NO_RELOAD:-}" ]; then
	fw_require_nftables
fi

fw_lock

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Checking known chains
case $chain in
	SSH) # Get ssh port (or ports) using v-list-sys-sshd-port.
		sshport="$($BIN/v-list-sys-sshd-port plain | sed ':a;N;$!ba;s/\n/,/g')"
		if [ -z "$sshport" ]; then
			sshport=22
		fi
		port=$sshport
		protocol=TCP
		;;
	FTP)
		port=21
		protocol=TCP
		;;
	MAIL)
		port='25,465,587,110,995,143,993'
		protocol=TCP
		;;
	DNS)
		port=53
		protocol=UDP
		;;
	WEB)
		port='80,443'
		protocol=TCP
		;;
	DB)
		port='3306,5432'
		protocol=TCP
		;;
	ARCPANEL)
		port=$arcpanelport
		protocol=TCP
		;;
	RECIDIVE)
		port='1:65535'
		protocol=TCP
		;;
	*) check_args '2' "$#" 'CHAIN PORT' ;;
esac

# Preserving chain
chains="$ARCPANEL/data/firewall/chains.conf"
check_chain=""
[ -f "$chains" ] && check_chain=$(grep "CHAIN='$chain'" "$chains")
if [ -z "$check_chain" ]; then
	echo "CHAIN='$chain' PORT='$port' PROTOCOL='$protocol'" >> "$chains"
	reload='yes'
elif ! "$FW_NFT" list set inet arcpanel "$(fw_ban_set "$chain" 4)" > /dev/null 2>&1; then
	# Every Fail2Ban start lands here for a known chain: reload only when
	# its sets are missing
	reload='yes'
fi

# Changing permissions
[ -f "$chains" ] && chmod 660 "$chains"

if [ "${reload:-no}" = 'yes' ] && [ -z "${ARCPANEL_FIREWALL_NO_RELOAD:-}" ]; then
	"$BIN/v-update-firewall"
	check_result $? "Unable to reload the firewall" "$E_UPDATE"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
if [ -z "$check_chain" ]; then
	$BIN/v-log-action "system" "Info" "Firewall" "Added service to firewall (Service: $chain, Port: $port, Protocol: $protocol)."
fi
log_event "$OK" "$ARGUMENTS"

exit
