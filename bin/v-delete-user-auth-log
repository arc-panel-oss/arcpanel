#!/bin/bash
# info: Delete auth log file for user
# options: USER
#
# example: v-delete-user-auth-log admin
#
# This function for deleting a users auth log file

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Remove log file and log event
if [ -f "$USER_DATA/auth.log" ]; then
	rm -f $USER_DATA/auth.log
	$BIN/v-log-action "system" "Warning" "Security" "User authentication log deleted (User: $user)."
	$BIN/v-log-action "$user" "Warning" "Security" "Login history cleared."
	log_event "$OK" "$ARGUMENTS"
fi

exit
