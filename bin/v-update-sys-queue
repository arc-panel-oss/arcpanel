#!/bin/bash
# info: update system queue
# options: PIPE
#
# example: v-update-sys-queue
#
# This function is responsible queue processing. Restarts of services,
# scheduled backups, web log parsing and other heavy resource consuming
# operations are handled by this script. It helps to optimize system behaviour.
# In a nutshell Apache will be restarted only once even if 10 domains are
# added or deleted.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#
# Argument definition
queue=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/queuetask.sh
source $ARCPANEL/func/queuetask.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'QUEUE'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

b_task=$(ps auxf | grep -v "grep" | grep "$BIN/v-update-sys-queue backup")
b_task=$(echo "$b_task" | grep -v sudo | wc -l)
d_task=$(ps auxf | grep -v "grep" | grep "$BIN/v-update-sys-queue dns")
d_task=$(echo "$d_task" | grep -v sudo | wc -l)
if [ "$b_task" -gt 2 ] || [ "$d_task" -gt 2 ]; then
	exit
fi

# Defining pipe functions
case $queue in
	restart) bash $ARCPANEL/data/queue/$queue.pipe > /dev/null 2>&1 ;;
	webstats) bash $ARCPANEL/data/queue/$queue.pipe > /dev/null 2>&1 ;;
	backup) bash $ARCPANEL/data/queue/$queue.pipe > /dev/null 2>&1 ;;
	disk) bash $ARCPANEL/data/queue/$queue.pipe > /dev/null 2>&1 ;;
	daily)
		bash $ARCPANEL/data/queue/$queue.pipe > /dev/null 2>&1
		qt_cleanup_all
		# A cloned machine gets its own server identifier (E43 B1)
		$BIN/v-update-sys-server-id > /dev/null 2>&1
		# The request journal of REST API v2 keeps 7 days (E43 B4)
		journal="$ARCPANEL/web-app/storage/app/api-requests"
		cutoff=$(date -d '-7 days' +%F)
		for file in "$journal"/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].jsonl; do
			if [ -f "$file" ] && [[ "$(basename "$file" .jsonl)" < "$cutoff" ]]; then
				rm -f "$file"
			fi
		done
		;;
	traffic) bash $ARCPANEL/data/queue/$queue.pipe > /dev/null 2>&1 ;;
	dns-cluster) bash $ARCPANEL/data/queue/$queue.pipe > /dev/null 2>&1 ;;
	letsencrypt) bash $ARCPANEL/data/queue/$queue.pipe > /dev/null 2>&1 ;;
	*) check_args '1' '0' 'QUEUE' ;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
