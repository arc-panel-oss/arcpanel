#!/bin/bash
# info: list the tasks of a user
# options: USER [ID] [LINES] [FORMAT]
#
# example: v-list-user-tasks admin json
# example: v-list-user-tasks admin 17280000001234 100 json
#
# This function prints the queue tasks of USER, newest first, or one task:
# since E15 the jobs of the backup, restore, letsencrypt and deploy types,
# in the format of the old records (KIND, ARGS). LOG is the last LINES lines
# of the job log (default 100, at most 1000). ATTEMPTS counts the runs of a
# task that the queue retries. Deprecated in 3.0.0 (v-list-job,
# v-list-jobs); removed in 3.1.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

user=$1
id=''
lines=100
format=shell

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/queuetask.sh
source $ARCPANEL/func/queuetask.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [ID] [LINES] [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

shift
while [ "$#" -gt 0 ]; do
	case "$1" in
		json | plain | shell | csv) format=$1 ;;
		*)
			if [[ "$1" =~ ^[0-9]{1,4}$ ]]; then
				lines=$1
			elif [[ "$1" =~ ^[0-9]{10,20}$ ]]; then
				id=$1
			else
				check_result "$E_INVALID" "invalid argument :: $1"
			fi
			;;
	esac
	shift
done
if [[ ! "$lines" =~ ^[0-9]+$ ]] || [ "$lines" -lt 1 ] || [ "$lines" -gt 1000 ]; then
	check_result "$E_INVALID" "invalid number of lines :: $lines (1 to 1000)"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# The queue-task jobs of USER, newest first
user_job_ids() {
	[ -d "$JOB_DIR" ] || return 0
	grep -rlE --include='*.conf' "(^| )TYPE='($QT_TYPES)'" "$JOB_DIR" 2> /dev/null \
		| xargs -r grep -lF " USER='$user' " 2> /dev/null \
		| sed -E 's|.*/([0-9]{14})\.conf$|\1|' | grep -E '^[0-9]{14}$' | sort -r
}

record_json() {
	local task="$1" text type status
	job_read "$task"
	type=${JOB[TYPE]}
	status=${JOB[STATUS]}
	text=$(job_log_tail "$task" "$lines")
	# cancelled is new in E15; the old records knew failed only
	[ "$status" = 'cancelled' ] && status=failed
	jq -nc \
		--arg ID "$task" \
		--arg KIND "$(qt_kind "$type")" \
		--arg task_args "$(qt_args "$task")" \
		--arg STATUS "$status" \
		--arg EXIT "${JOB[EXIT]}" \
		--arg ERROR "${JOB[ERROR]}" \
		--arg QUEUED "${JOB[QUEUED]}" \
		--arg START "${JOB[START]}" \
		--arg END "${JOB[END]}" \
		--arg ATTEMPTS "${JOB[ATTEMPTS]}" \
		--arg LOG "$text" \
		'{ID: $ID, KIND: $KIND, ARGS: $task_args, STATUS: $STATUS, EXIT: $EXIT,
			ERROR: $ERROR, QUEUED: $QUEUED, START: $START, END: $END,
			ATTEMPTS: $ATTEMPTS, LOG: $LOG}'
}

print_shell() {
	local task="$1" json
	json=$(record_json "$task")
	jq -r 'to_entries[] | select(.key != "LOG") | "\(.key): \(.value)"' <<< "$json"
	echo
	jq -r .LOG <<< "$json"
}

if [ -n "$id" ]; then
	if ! job_exists "$id" || [ "$(job_get "$id" USER)" != "$user" ] \
		|| ! [[ "$(job_get "$id" TYPE)" =~ ^($QT_TYPES)$ ]]; then
		check_result "$E_NOTEXIST" "task $id doesn't exist"
	fi
	job_reap_one "$id" > /dev/null 2>&1 || true
	json=$(record_json "$id")
	case "$format" in
		json) printf '%s\n' "$json" ;;
		*) print_shell "$id" ;;
	esac
else
	mapfile -t ids < <(user_job_ids)
	case "$format" in
		json)
			for task in "${ids[@]}"; do
				record_json "$task"
			done | jq -sc 'map({key: .ID, value: .}) | from_entries'
			;;
		*)
			for task in "${ids[@]}"; do
				print_shell "$task"
				echo
			done
			;;
	esac
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
