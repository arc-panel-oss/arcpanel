#!/bin/bash
# info: delete file
# options: USER FILE
#
# example: v-delete-fs-file admin /home/admin/readme.txt
#
# This function deletes file on the file system as the user. The path must be
# absolute and inside the user's home.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

user=$1
dst_file=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/fs.sh
source $ARCPANEL/func/fs.sh

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER FILE'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

# Checking destination path
fs_check_entry "$dst_file"

# Deleting file
user_exec rm -f -- "$dst_file" > /dev/null 2>&1
if [ $? -ne 0 ]; then
	echo "Error: file $dst_file was not deleted"
	exit 3
fi

# Exiting
exit
