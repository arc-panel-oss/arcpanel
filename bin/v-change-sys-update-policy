#!/bin/bash
# info: change the automatic update policy of ArcPanel
# options: POLICY [DAYS] [HOURS] [DELAY]
#
# example: v-change-sys-update-policy patch
# example: v-change-sys-update-policy patch mon,tue,wed,thu,fri 03-05 2
# example: v-change-sys-update-policy off
#
# This function sets the update policy of the panel packages
# (docs/features/specs/2026-10-20-005-e33-update-center-phase-1-design.md
# §7.2). POLICY is off (no checks), notify (check hourly and announce new
# versions) or patch (also install patch releases of the installed line that
# need no attention). DAYS is all or a comma list of mon ... sun, HOURS the
# window HH-HH in the server's time zone (start included, end excluded, may
# wrap past midnight) and DELAY the days to wait after a release (0-30); a
# value left out keeps the current one. The policies notify and patch install
# the hourly cron line of v-run-sys-arcpanel-autoupdate, off removes it.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
policy=$1
days=$2
hours=$3
delay=$4

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/updates.sh
source $ARCPANEL/func/updates.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'POLICY [DAYS] [HOURS] [DELAY]'
days="${days:-$(upd_policy_get UPDATE_WINDOW_DAYS)}"
hours="${hours:-$(upd_policy_get UPDATE_WINDOW_HOURS)}"
delay="${delay:-$(upd_policy_get UPDATE_DELAY_DAYS)}"
if ! upd_policy_valid "$policy"; then
	check_result "$E_INVALID" "invalid policy $policy (off, notify or patch)"
fi
if ! upd_days_valid "$days"; then
	check_result "$E_INVALID" "invalid days $days (all or a comma list of mon, tue, wed, thu, fri, sat, sun)"
fi
if ! upd_hours_valid "$hours"; then
	check_result "$E_INVALID" "invalid hours $hours (HH-HH, for example 03-05 or 23-02)"
fi
if ! upd_delay_valid "$delay"; then
	check_result "$E_INVALID" "invalid delay $delay (0 to 30 days)"
fi
delay="$((10#$delay))"
is_system_enabled "$CRON_SYSTEM" 'CRON_SYSTEM'

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

change_sys_value 'UPDATE_POLICY' "$policy"
change_sys_value 'UPDATE_WINDOW_DAYS' "$days"
change_sys_value 'UPDATE_WINDOW_HOURS' "$hours"
change_sys_value 'UPDATE_DELAY_DAYS' "$delay"
upd_dir

if [ "$policy" = 'off' ]; then
	upd_cron_remove
else
	upd_cron_install
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "Updates" "Update policy changed (Policy: $policy, Days: $days, Hours: $hours, Delay: $delay days)."
log_event "$OK" "$ARGUMENTS"

exit
