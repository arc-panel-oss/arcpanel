#!/bin/bash
# info: delete firewall chain
# options: CHAIN
#
# example: v-delete-firewall-chain WEB
#
# This function deletes a Fail2Ban chain and its bans from the system
# firewall

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
chain=$(echo "$1" | tr '[:lower:]' '[:upper:]')

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source "$ARCPANEL/func/main.sh"
# shellcheck source=/usr/local/arcpanel/func/firewall.sh
source "$ARCPANEL/func/firewall.sh"
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'CHAIN'
is_format_valid 'chain'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

fw_lock

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Deleting chain
chains="$ARCPANEL/data/firewall/chains.conf"
banlist="$ARCPANEL/data/firewall/banlist.conf"
chain_param=""
[ -f "$chains" ] && chain_param=$(grep "CHAIN='$chain'" "$chains")
if [ -n "$chain_param" ]; then
	sed -i "/CHAIN='$chain'/d" "$chains"
	[ -f "$banlist" ] && sed -i "/CHAIN='$chain'/d" "$banlist"
	if fw_loaded; then
		"$BIN/v-update-firewall"
		check_result $? "Unable to reload the firewall" "$E_UPDATE"
	fi
fi

# Changing permissions
[ -f "$chains" ] && chmod 660 "$chains"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
