#!/bin/bash
# info: start a Quick Install of an application on a web domain in the background (E7 batch 2)
# options: USER DOMAIN APP OPTIONS_FILE
#
# example: v-start-user-quick-install alice example.com DokuWiki /tmp/options.json
#
# This function checks the arguments of a Quick Install, keeps a root-only
# copy of the options (a JSON object, at most 64 KiB) as the request of a
# job of type quick-install (E15) that runs v-add-web-domain-app, and prints
# the job ID. A user runs one install at a time; the state and the output
# are read with v-list-job or v-list-user-quick-install-task.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
app=$3
options_file=$4

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/quickinstall.sh
source $ARCPANEL/func/quickinstall.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '4' "$#" 'USER DOMAIN APP OPTIONS_FILE'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"
if ! qi_app_exists "$app"; then
	check_result "$E_NOTEXIST" "installer $app does not exist"
fi
if [ ! -f "$options_file" ] || [ -L "$options_file" ]; then
	check_result "$E_NOTEXIST" "options file $options_file does not exist"
fi
if [ "$(stat -c %s "$options_file")" -gt 65536 ]; then
	check_result "$E_INVALID" "options file is too large"
fi
if ! jq -e 'type == "object"' "$options_file" > /dev/null 2>&1; then
	check_result "$E_INVALID" "options file is not a JSON object"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

exec {lock}> "$(qi_task_lock "$user")"
flock -x "$lock"

if qi_task_running "$user"; then
	check_result "$E_INUSE" "Another installation is running for $user"
fi

# The runner starts once the options are its request
job_create quick-install "$user" "web:$domain" "$(job_default_actor)" -- \
	v-run-user-quick-install "$user" "$domain" "$app"
job_check_started "$?" "Another installation is running for $user"
id=$JOB_ID
if ! job_request_store "$id" "$options_file"; then
	job_set "$id" STATUS=failed "END=$(date +'%F %T')" "ERROR=the options could not be stored"
	check_result "$E_DISK" "the options could not be stored"
fi
job_dispatch

flock -u "$lock"
echo "$id"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
