#!/bin/bash
# info: stop system firewall
# options: NONE
#
# example: v-stop-firewall
#
# This function deletes the nftables table inet arcpanel and disables its
# boot unit, so every port is reachable

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/firewall.sh
source $ARCPANEL/func/firewall.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

fw_lock

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if fw_loaded; then
	"$FW_NFT" delete table inet arcpanel
fi

# The rules, ipsets and unit of the iptables engine
fw_legacy_cleanup

# The boot unit stays installed but no longer runs at boot
if [ -e "$FW_UNIT" ]; then
	systemctl -q is-enabled arcpanel-firewall 2> /dev/null && systemctl -q disable arcpanel-firewall
	systemctl -q stop arcpanel-firewall 2> /dev/null
fi
rm -f "$FW_SAVED" "$FW_STATE"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
