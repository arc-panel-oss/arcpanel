#!/bin/bash
# info: import an archive from a backup destination (E48)
# options: DESTINATION BACKUP
#
# example: v-import-user-backup offsite alice.2026-10-22_05-10-00.tar
#
# This function copies the archive BACKUP (USER.YYYY-MM-DD_HH-MM-SS.tar)
# from DESTINATION to the backup folder of this server, decrypting it with
# the destination's key when it is stored encrypted, so that v-restore-user
# can restore it, for example on a new server after the recovery kit was
# imported. When USER exists, its archive records learn that DESTINATION
# holds the archive.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
destination=$1
backup=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/backup-driver.sh
source $ARCPANEL/func/backup-driver.sh
# shellcheck source=/usr/local/arcpanel/func/backup-job.sh
source $ARCPANEL/func/backup-job.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'DESTINATION BACKUP'
is_format_valid 'backup'
bd_check_exists "$destination"
if [[ ! "$backup" =~ ^([a-z0-9][a-z0-9_.-]*)\.[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}\.tar$ ]]; then
	check_result "$E_INVALID" "invalid archive name"
fi
owner=${BASH_REMATCH[1]}

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

bd_check_keys
bd_session
files=$(bd_list "$destination" | cut -f1)
if grep -qx -- "$backup.age" <<< "$files"; then
	encrypted=yes
elif grep -qx -- "$backup" <<< "$files"; then
	encrypted=no
else
	check_result "$E_NOTEXIST" "$destination does not hold $backup"
fi
BACKUP=${BACKUP:-/backup}
mkdir -p "$BACKUP"
if [ "$encrypted" = yes ]; then
	bd_get "$destination" "$backup.age" - | bd_decrypt "$destination" > "$BACKUP/$backup.part"
else
	bd_get "$destination" "$backup" "$BACKUP/$backup.part" > /dev/null
fi
if ! tar -tf "$BACKUP/$backup.part" > /dev/null 2>&1; then
	rm -f "$BACKUP/$backup.part"
	check_result "$E_CONNECT" "the archive could not be read from $destination"
fi
mv -f "$BACKUP/$backup.part" "$BACKUP/$backup"
chmod 640 "$BACKUP/$backup"

if [ -f "$ARCPANEL/data/users/$owner/user.conf" ]; then
	chown "arcpanelweb:$owner" "$BACKUP/$backup" 2> /dev/null
	registry=$(bj_registry "$owner")
	touch "$registry"
	if grep -q "^BACKUP='$backup' " "$registry"; then
		dests=$(bj_archive_destinations "$owner" "$backup")
		if [[ ",$dests," != *",$destination,"* ]]; then
			bj_registry_set "$owner" "$backup" "DESTINATIONS=${dests:+$dests,}$destination"
		fi
	else
		size=$(($(stat -c %s "$BACKUP/$backup") / 1024 / 1024))
		stamp=${backup#"$owner".}
		stamp=${stamp%.tar}
		echo "BACKUP='$backup' TYPE='$(bd_value "$destination" DRIVER)' SIZE='$size' WEB='' DNS='' MAIL='' DB='' CRON='' UDIR='' RUNTIME='1' TIME='$(tr _- ' :' <<< "${stamp#*_}" | tr ' ' ':')' DATE='${stamp%%_*}' JOB='' DESTINATIONS='$destination' ENCRYPTED='$([ "$encrypted" = yes ] && echo "$destination")'" >> "$registry"
		chmod 660 "$registry"
	fi
	bj_update_counter "$owner"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "Backup" "Archive imported (Destination: $destination, Archive: $backup)."
log_event "$OK" "$ARGUMENTS"

exit
