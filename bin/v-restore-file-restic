#!/bin/bash
# info: restore a file or folder from a restic snapshot
# options: USER SNAPSHOT PATH [NOTIFY]
#
# example: v-restore-file-restic alice 4f2a91c0 /home/alice/web/example.com/public_html/index.php
#
# This function restores PATH, a file or folder in the home directory of
# USER, from a restic snapshot. restic restores into a working folder of
# root; the user copies the result into the home, so the files belong to
# the user and nothing outside the user's permissions is written (E39 W1).
# The restore overwrites the current file.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
file=$3
notify=${4-no}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/backup-driver.sh
source $ARCPANEL/func/backup-driver.sh
# shellcheck source=/usr/local/arcpanel/func/backup-job.sh
source $ARCPANEL/func/backup-job.sh
# shellcheck source=/usr/local/arcpanel/func/safe-fs.sh
source $ARCPANEL/func/safe-fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

args_usage='USER SNAPSHOT PATH [NOTIFY]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user' 'snapshot'
is_object_valid 'user' 'USER' "$user"

file="${file%/}"
if [ "$file" = "$HOMEDIR/$user" ] || ! is_snapshot_path_valid "$file"; then
	check_result "$E_FORBIDEN" "the path is outside the home directory of $user"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

# The user's repository on the destination that holds the snapshot (E48)
restic_select "$user" "$snapshot"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if ! restic_user "$user" cat snapshot -- "$snapshot" > /dev/null 2>&1; then
	check_result "$E_NOTEXIST" "snapshot $snapshot doesn't exist"
fi

safe_workdir restore-file
tmpdir=$SAFE_WORKDIR
restic_user "$user" restore --target "$tmpdir" --include="$file" -- "$snapshot" > /dev/null
check_result $? "restic restore failed" "$E_NOTEXIST"

parent=$(dirname -- "$file")
if [ ! -e "$tmpdir$file" ]; then
	check_result "$E_NOTEXIST" "$file is not in snapshot $snapshot"
fi
copy_into_home "$tmpdir$parent" "$parent"
check_result $? "the restored files could not be copied into the home" "$E_FORBIDEN"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

safe_workdir_cleanup

# Update user counters
$BIN/v-update-user-counters "$user"

# Logging
$BIN/v-log-action "system" "Info" "Backup" "File restored from a snapshot (User: $user, Snapshot: $snapshot, Path: $file)."
$BIN/v-log-action "$user" "Info" "Backup" "File restored from a snapshot (Snapshot: $snapshot, Path: $file)."
log_event "$OK" "$ARGUMENTS"
exit
