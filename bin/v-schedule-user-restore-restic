#!/bin/bash
# info: schedule user backup restoration
# options: USER SNAPSHOT [OBJECT] [VALUE] [FORMAT]
#
# example: v-schedule-user-restore 2019-04-22_01-00-00.tar
#
# This function for scheduling user backup restoration.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
object=$3
value=$4
format=shell

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/queuetask.sh
source $ARCPANEL/func/queuetask.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "$#" -gt 5 ]; then
	check_result "$E_ARGS" "too many arguments"
fi
if [ "$#" -eq 5 ]; then
	format=$5
fi
check_args '2' "$#" 'USER SNAPSHOT [OBJECT] [VALUE] [FORMAT]'
is_format_valid 'user' 'snapshot' 'value' 'format'
is_system_enabled "$BACKUP_SYSTEM" 'BACKUP_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_backup_scheduled 'restore'

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

source_conf $ARCPANEL/conf/restic.conf
#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

log=$ARCPANEL/log/restore.log

#Verify if snapshot / repo exists
tmpdir=$(mktemp -p /home/$user/tmp/ -d)
# Check if snapshot exists
restic --repo "${REPO%/}/$user" --password-file "$USER_DATA/restic.conf" dump "$snapshot" "/home/$user/backup/backup.conf" > "$tmpdir/backup.conf"
if [ "$?" -ne 0 ]; then
	check_result "$E_NOTEXIST" "Unable to download from snapshot"
fi
rm -fr "$tmpdir"

pipe="$ARCPANEL/data/queue/backup.pipe"
if [ -z "$object" ]; then
	qt_queue snapshot-restore "$snapshot" "$pipe" \
		"$BIN/v-restore-user-restic '$user' '$snapshot' '*' '*' '*' '*' 'yes' 'yes' 'yes' >> $log 2>&1"
else
	if [ "$object" = "web" ]; then
		qt_queue snapshot-restore "$snapshot $object $value" "$pipe" \
			"$BIN/v-restore-web-domain-restic '$user' '$snapshot' '$value' 'yes' >> $log 2>&1"
	elif [ "$object" = "dns" ]; then
		qt_queue snapshot-restore "$snapshot $object $value" "$pipe" \
			"$BIN/v-restore-dns-domain-restic '$user' '$snapshot' '$value' 'yes' >> $log 2>&1"
	elif [ "$object" = "mail" ]; then
		qt_queue snapshot-restore "$snapshot $object $value" "$pipe" \
			"$BIN/v-restore-mail-domain-restic '$user' '$snapshot' '$value' 'yes' >> $log 2>&1"
	elif [ "$object" = "db" ]; then
		qt_queue snapshot-restore "$snapshot $object $value" "$pipe" \
			"$BIN/v-restore-database-restic '$user' '$snapshot' '$value' 'yes' >> $log 2>&1"
	elif [ "$object" = "cron" ]; then
		qt_queue snapshot-restore "$snapshot $object" "$pipe" \
			"$BIN/v-restore-cron-job-restic '$user' '$snapshot' 'yes' >> $log 2>&1"
	else
		check_result "$E_INVALID" "Not supported"
	fi
fi
#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "Backup" "Restore of backup snapshot requested (User: $user, Archive: $snapshot)."
log_event "$OK" "$ARGUMENTS"

exit
