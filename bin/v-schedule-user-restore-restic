#!/bin/bash
# info: schedule user backup restoration
# options: USER SNAPSHOT [OBJECT] [VALUE] [FORMAT]
#
# example: v-schedule-user-restore-restic alice 4f2a91c0 web example.com
#
# This function for scheduling user backup restoration from a restic
# snapshot.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
object=$3
value=$4
format=shell

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/backup-driver.sh
source $ARCPANEL/func/backup-driver.sh
# shellcheck source=/usr/local/arcpanel/func/backup-job.sh
source $ARCPANEL/func/backup-job.sh
# shellcheck source=/usr/local/arcpanel/func/queuetask.sh
source $ARCPANEL/func/queuetask.sh
# shellcheck source=/usr/local/arcpanel/func/safe-fs.sh
source $ARCPANEL/func/safe-fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "$#" -gt 5 ]; then
	check_result "$E_ARGS" "too many arguments"
fi
if [ "$#" -eq 5 ]; then
	format=$5
fi
check_args '2' "$#" 'USER SNAPSHOT [OBJECT] [VALUE] [FORMAT]'
is_format_valid 'user' 'snapshot' 'value' 'format'
is_system_enabled "$BACKUP_INCREMENTAL" 'BACKUP_INCREMENTAL'
is_object_valid 'user' 'USER' "$user"
is_backup_scheduled 'restore'

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

# The user's repository on the destination that holds the snapshot (E48)
restic_select "$user" "$snapshot"
#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

log=$ARCPANEL/log/restore.log

# Check if snapshot exists
if ! restic_user "$user" cat snapshot -- "$snapshot" > /dev/null 2>&1; then
	check_result "$E_NOTEXIST" "Unable to download from snapshot"
fi

# A job of the backup queue (E15)
if [ -z "$object" ]; then
	qt_job restore.restic "user:$user" -- v-restore-user-restic "$user" "$snapshot" '*' '*' '*' '*' yes yes yes
else
	if [ "$object" = "web" ]; then
		qt_job restore.restic "user:$user" -- v-restore-web-domain-restic "$user" "$snapshot" "$value" yes
	elif [ "$object" = "dns" ]; then
		qt_job restore.restic "user:$user" -- v-restore-dns-domain-restic "$user" "$snapshot" "$value" yes
	elif [ "$object" = "mail" ]; then
		qt_job restore.restic "user:$user" -- v-restore-mail-domain-restic "$user" "$snapshot" "$value" yes
	elif [ "$object" = "db" ]; then
		qt_job restore.restic "user:$user" -- v-restore-database-restic "$user" "$snapshot" "$value" yes
	elif [ "$object" = "cron" ]; then
		qt_job restore.restic "user:$user" -- v-restore-cron-job-restic "$user" "$snapshot" yes
	else
		check_result "$E_INVALID" "Not supported"
	fi
fi
#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "Backup" "Restore of backup snapshot requested (User: $user, Archive: $snapshot)."
log_event "$OK" "$ARGUMENTS"

exit
