#!/bin/bash
# info: run a Quick Install started by v-start-user-quick-install (E7 batch 2)
# options: USER DOMAIN APP
#
# example: v-run-user-quick-install alice example.com DokuWiki
#
# This function is the command of the quick-install jobs that
# v-start-user-quick-install starts (E15): it runs v-add-web-domain-app with
# the options of the job's request; the job runner records the result and
# removes the request when the install succeeds. It refuses to run outside
# such a job.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
app=$3

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/quickinstall.sh
source $ARCPANEL/func/quickinstall.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ -z "$app" ]; then
	echo "Usage: v-run-user-quick-install USER DOMAIN APP"
	exit "$E_ARGS"
fi
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
if ! job_is_current 'quick-install' || [ "${JOB[OBJECT]}" != "web:$domain" ] || [ "${JOB[USER]}" != "$user" ]; then
	check_result "$E_FORBIDEN" "the install was not started by v-start-user-quick-install"
fi
options=$(job_request_file "$JOB_ID")
if [ ! -f "$options" ]; then
	check_result "$E_NOTEXIST" "the options of the install are not kept any more; start it again"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

echo "$ v-add-web-domain-app $user $domain $app"
"$BIN/v-add-web-domain-app" "$user" "$domain" "$app" "$options"
rc=$?
if [ "$rc" -ne 0 ]; then
	echo "Exit code $rc"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit "$rc"
