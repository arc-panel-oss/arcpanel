#!/bin/bash
# info: list what a restic snapshot of a user holds
# options: USER SNAPSHOT [FORMAT]
#
# example: v-list-user-backup-restic alice 4f2a91c0 json
#
# This function prints the backup.conf stored in a restic snapshot of USER:
# the web, DNS and mail domains, databases, cron jobs and folders it holds.
# The file is read into a working folder of root and parsed as untrusted
# input (E39 W1).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
format=${3-plain}
# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/backup-driver.sh
source $ARCPANEL/func/backup-driver.sh
# shellcheck source=/usr/local/arcpanel/func/backup-job.sh
source $ARCPANEL/func/backup-job.sh
# shellcheck source=/usr/local/arcpanel/func/safe-fs.sh
source $ARCPANEL/func/safe-fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER SNAPSHOT [FORMAT]'
is_format_valid 'user' 'snapshot'
is_system_enabled "$BACKUP_INCREMENTAL" 'BACKUP_INCREMENTAL'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# JSON list function
json_list() {
	echo '{'
	echo '    "snapshot": {
		"TYPE": "'$TYPE'",
		"WEB": "'$WEB'",
		"DNS": "'$DNS'",
		"MAIL": "'$MAIL'",
		"DB": "'$DB'",
		"CRON": "'$CRON'",
		"UDIR": "'$UDIR'",
		"RUNTIME": "'$RUNTIME'",
		"TIME": "'$TIME'",
		"DATE": "'$DATE'"
	}'
	echo '}'
}

# SHELL list function
shell_list() {
	echo "BACKUP:         snapshot"
	echo "TYPE:           $TYPE"
	echo "RUNTIME:        $RUNTIME min"
	echo "WEB:            ${WEB//,/ }"
	echo "DNS:            ${DNS//,/ }"
	echo "MAIL:           ${MAIL//,/ }"
	echo "DB:             ${DB//,/ }"
	echo "CRON:           $CRON"
	echo "UDIR:           ${UDIR//,/ }"
	echo "TIME:           $TIME"
	echo "DATE:           $DATE"
}

# PLAIN list function
plain_list() {
	echo -ne "snapshot\t$TYPE\t$WEB\t$DNS\t$MAIL\t$DB\t$CRON\t"
	echo -e "$UDIR\t$RUNTIME\t$TIME\t$DATE"
}

# The user's repository on the destination that holds the snapshot (E48)
restic_select "$user" "$snapshot"

safe_workdir list-backup
read_snapshot_index "$SAFE_WORKDIR" "$snapshot"
check_result $? "snapshot $snapshot cannot be read"
unset -v TYPE RUNTIME TIME DATE
parse_backup_record 'TYPE RUNTIME TIME DATE' "$(head -n 1 -- "$SAFE_WORKDIR/backup.conf")"
check_result $? "invalid backup.conf in snapshot $snapshot" "$E_PARSING"
safe_workdir_cleanup

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	shell) shell_list ;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
