#!/bin/bash
# info: roll a secret of a user back to an earlier version (E38)
# options: USER NAME VERSION [RESTART]
#
# example: v-rollback-user-secret alice /shop/db_password 2
#
# This function copies VERSION of the secret NAME of USER into a new
# version, so the history only moves forward. Like v-change-user-secret it
# prints the apps that reference the secret and, with RESTART set to yes,
# restarts the ones that run.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
name=$2
version=$3
restart=${4-no}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER NAME VERSION [RESTART]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
secret_check_name "$name"
if ! [[ "$version" =~ ^[1-9][0-9]{0,8}$ ]]; then
	check_result "$E_INVALID" "invalid version :: $version"
fi
if [ "$restart" != 'yes' ] && [ "$restart" != 'no' ]; then
	check_result "$E_INVALID" "RESTART must be yes or no"
fi
secret_check_system

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

secret_check_user "$user"
secret_lock "$user"
secret_check_exists "$user" "$name"
old="$(secret_vdir "$user" "$name")/v$version.age"
if [ ! -f "$old" ]; then
	check_result "$E_NOTEXIST" "version $version of $name is not kept"
fi
out=$(secret_decrypt "$user" "$old" | secret_check_value_usable "$user" "$name")
check_result $? "$out"
secret_decrypt "$user" "$old" | secret_store_version "$user" "$name" > /dev/null
check_result $? "the secret could not be stored" "$E_FORBIDEN"
secret_after_change "$user" "$name" "$restart"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

$BIN/v-log-action "$user" "Info" "Secrets" "Secret rolled back to version $version (Name: $name)."
log_event "$OK" "$user $name $version"

exit
