#!/bin/bash
# info: restore user
# options: USER BACKUP [WEB] [DNS] [MAIL] [DB] [CRON] [UDIR] [NOTIFY]
#
# example: v-restore-user admin 2019-04-22_01-00-00.tar
#
# This function for restoring user from backup. To be able to restore the backup,
# the archive needs to be placed in /backup. Root unpacks the archive in a
# working folder of its own; names and records read from it are validated,
# and the user's files are unpacked into the home by the user (E39 W1).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
backup=$2
web=$3
dns=$4
mail=$5
db=$6
cron=$7
udir=$8
notify=${9-no}

# Define backup dir
if [ -z "$BACKUP" ]; then
	BACKUP=/backup
fi

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/backup.sh
source $ARCPANEL/func/backup.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/domain.sh
source $ARCPANEL/func/domain.sh
# shellcheck source=/usr/local/arcpanel/func/ip.sh
source $ARCPANEL/func/ip.sh
# shellcheck source=/usr/local/arcpanel/func/db.sh
source $ARCPANEL/func/db.sh
# shellcheck source=/usr/local/arcpanel/func/rebuild.sh
source $ARCPANEL/func/rebuild.sh
# shellcheck source=/usr/local/arcpanel/func/syshealth.sh
source $ARCPANEL/func/syshealth.sh
# shellcheck source=/usr/local/arcpanel/func/safe-fs.sh
source $ARCPANEL/func/safe-fs.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/ports.sh
source $ARCPANEL/func/ports.sh
# shellcheck source=/usr/local/arcpanel/func/docker.sh
source $ARCPANEL/func/docker.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

args_usage='USER BACKUP [WEB] [DNS] [MAIL] [DB] [CRON] [UDIR] [NOTIFY]'
check_args '2' "$#" "$args_usage"
is_format_valid 'user' 'backup'

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Check if backup folder exists and have the correct permission: users may
# not list the archives of others (E39 W1 D8)
if [[ ! -d "$BACKUP" ]]; then
	mkdir -p "$BACKUP"
fi
if [ "$(stat -c %a "$BACKUP")" != 711 ]; then
	chmod 711 "$BACKUP"
fi

# Checking local backup
if [ ! -e "$BACKUP/$backup" ]; then
	if [[ "$BACKUP_SYSTEM" =~ "sftp" ]] && [ -z "$downloaded" ]; then
		sftp_download "$backup"
		downloaded='yes'
	fi
	if [[ "$BACKUP_SYSTEM" =~ "ftp" ]] && [ -z "$downloaded" ]; then
		ftp_download "$backup"
		downloaded='yes'
	fi
	if [[ "$BACKUP_SYSTEM" =~ "b2" ]] && [ -z "$downloaded" ]; then
		b2_download "$backup"
		downloaded='yes'
	fi
	if [[ "$BACKUP_SYSTEM" =~ "rclone" ]] && [ -z "$downloaded" ]; then
		rclone_download "$backup"
		downloaded='yes'
	fi
	if [ -z "$downloaded" ]; then
		check_result "$E_NOTEXIST" "backup file $backup doesn't exist in '${BACKUP}' folder"
	fi
fi

if [ ! -e "$BACKUP/$backup" ]; then
	check_result "$E_NOTEXIST" "backup file $backup doesn't exist in '${BACKUP}' folder"
fi

# Checking user existence on the server
check_user=$(is_object_valid 'user' 'USER' "$user")
if [ -z "$check_user" ]; then
	is_object_unsuspended 'user' 'USER' "$user"
	subj="$user → restore failed"
	email=$(get_user_value '$CONTACT')
else
	create_user="yes"
	email=$(grep CONTACT "$ARCPANEL/data/users/$ROOT_USER/user.conf" | cut -f2 -d \')
fi

# Checking available disk space
disk_usage=$(df $BACKUP | tail -n1 | tr ' ' '\n' | grep % | cut -f 1 -d %)
if [ "$disk_usage" -ge "$BACKUP_DISK_LIMIT" ]; then
	echo "Error: Not enough disk space" | $SENDMAIL -s "$subj" $email $notify
	sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
	check_result "$E_DISK" "Not enough disk space"
fi

# Checking load average
la=$(cat /proc/loadavg | cut -f 1 -d ' ' | cut -f 1 -d '.')
i=0
while [ "$la" -ge "$BACKUP_LA_LIMIT" ]; do
	echo -e "$(date "+%F %T") Load Average $la"
	sleep 60
	if [ "$i" -ge "15" ]; then
		la_error="LoadAverage $la is above threshold"
		echo "Error: $la_error" | $SENDMAIL -s "$subj" $email $notify
		sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
		check_result "$E_LA" "$la_error"
	fi
	la=$(cat /proc/loadavg | cut -f 1 -d ' ' | cut -f 1 -d '.')
	((++i))
done

if [ -z "$BACKUP_TEMP" ]; then
	BACKUP_TEMP=$BACKUP
fi

# Creating temporary directory, root's only
safe_workdir restore-user
tmpdir=$SAFE_WORKDIR
if [ -z "$tmpdir" ]; then
	echo "Can't create tmp dir $tmpdir" | $SENDMAIL -s "$subj" $email $notify
	sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
	check_result "$E_NOTEXIST" "Can't create tmp dir"
fi

# Set default backup source system
backup_system="arcpanel"
backup_mode="gzip"

# Archives of HestiaCP and ArcPanel 1.x keep the objects in ./hestia,
# archives of VestaCP in ./vesta (D8 of the full rename spec)
if tar -tf "$BACKUP/$backup" ./hestia > /dev/null 2>&1; then
	backup_system="hestia"
elif tar -tf "$BACKUP/$backup" ./vesta > /dev/null 2>&1; then
	backup_system="vesta"
fi

if tar -tf "$BACKUP/$backup" ./.zstd > /dev/null 2>&1; then
	backup_mode="zstd"
fi

# Restoring user account
if [ "$create_user" = 'yes' ]; then

	# Add check if user already exists as Linux User
	getent passwd "$user" > /dev/null 2>&1
	if [ "$?" == 0 ]; then
		check_result "$E_EXISTS" "User already exists"
	fi

	echo "-- USER --" | tee $tmpdir/restore.log
	echo -e "$(date "+%F %T") $user" | tee -a $tmpdir/restore.log

	# Unpacking user container
	tar xf "$BACKUP/$backup" -C "$tmpdir" --no-wildcards "./$backup_system" 2> /dev/null
	tar_status=$?
	find "$tmpdir/$backup_system" \( -type l -o \( ! -type f ! -type d \) \) -delete 2> /dev/null
	if [ "$tar_status" -ne 0 ]; then
		rm -rf $tmpdir
		echo "Can't unpack user container" | $SENDMAIL -s "$subj" $email $notify
		sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
		check_result "$E_PARSING" "Can't unpack user container"
	fi

	# Restoring user.conf
	mkdir $USER_DATA
	cp $tmpdir/$backup_system/user.conf $USER_DATA/
	# Archives of 1.x keep the 2FA QR code, which holds the secret (E39 W5 §11.2)
	sed -i "s/^QRCODE='[^']*'$/QRCODE=''/" $USER_DATA/user.conf
	cp -r $tmpdir/$backup_system/ssl $USER_DATA/ > /dev/null 2>&1
	cp $tmpdir/$backup_system/backup-excludes.conf $USER_DATA/ > /dev/null 2>&1

	# Secret store (E38): restored only with the master key that encrypted it
	if [ -d "$tmpdir/$backup_system/secret-store" ]; then
		echo -e "$(date "+%F %T") $(secret_restore_from "$user" "$tmpdir/$backup_system/secret-store")" | tee -a $tmpdir/restore.log
	fi

	# Rebuilding user
	rebuild_user_conf
fi

# Unpacking pam container
tar xf $BACKUP/$backup -C $tmpdir ./pam
if [ "$?" -ne 0 ]; then
	rm -rf $tmpdir
	echo "Can't unpack PAM container" | $SENDMAIL -s "$subj" $email $notify
	sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
	check_result "$E_PARSING" "Can't unpack PAM container"
fi
old_user=$(head -n 1 $tmpdir/pam/passwd | cut -f 1 -d :)
old_uid=$(head -n 1 $tmpdir/pam/passwd | cut -f 3 -d :)
new_uid=$(grep "^$user:" /etc/passwd | cut -f 3 -d :)
# The old name ends up in patterns, the uid in find
if ! is_restore_name_valid user "$old_user"; then
	old_user=$user
fi
if ! [[ "$old_uid" =~ ^[0-9]{1,10}$ ]]; then
	old_uid=$new_uid
fi

# Restoring web domains
if [ "$web" != 'no' ] && [ -n "$WEB_SYSTEM" ]; then
	echo -e "\n-- WEB --" | tee -a $tmpdir/restore.log

	# Creating web domain restore list
	backup_domains=$(tar -tf $BACKUP/$backup | grep "^./web")
	if [ "$backup_mode" = "zstd" ]; then
		backup_domains=$(echo "$backup_domains" | grep domain_data.tar.zst)
	else
		backup_domains=$(echo "$backup_domains" | grep domain_data.tar.gz)
	fi
	backup_domains=$(echo "$backup_domains" | cut -f 3 -d /)
	if [ -z "$web" ] || [ "$web" = '*' ]; then
		domains="$backup_domains"
	else
		echo "$web" | tr ',' '\n' > $tmpdir/selected.txt
		domains=$(echo "$backup_domains" | egrep -x -f $tmpdir/selected.txt)
	fi

	# Restoring web domain
	for domain in $domains; do
		if ! is_restore_name_valid domain "$domain"; then
			restore_skip "web domain" "$domain" "invalid name" | tee -a $tmpdir/restore.log
			continue
		fi
		echo -e "$(date "+%F %T") $domain" | tee -a $tmpdir/restore.log

		# Cleanup previous domain keys
		restore_record_reset web
		unset -v old_ip

		# Checking domain existence
		check_config=$(grep -F "DOMAIN='$domain'" $USER_DATA/web.conf)
		if [ -z "$check_config" ]; then
			check_new=$(is_domain_new 'web' $domain)
			if [ -n "$check_new" ]; then
				rm -rf $tmpdir
				error="$domain belongs to another user"
				echo "$error" | $SENDMAIL -s "$subj" $email $notify
				sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
				check_result "$E_PARSING" "$error"
			fi
		fi

		# Unpacking domain container
		tar xf $BACKUP/$backup -C $tmpdir ./web/$domain
		tar_status=$?
		find "$tmpdir/web/$domain" \( -type l -o \( ! -type f ! -type d \) \) -delete 2> /dev/null
		if [ "$tar_status" -ne 0 ]; then
			rm -rf $tmpdir
			error="Can't unpack $domain web container"
			echo "$error" | $SENDMAIL -s "$subj" $email $notify
			sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
			check_result "$E_PARSING" "$error"
		fi

		# Restoring web.conf
		if [ -z "$check_config" ]; then
			if ! parse_backup_record "$(restore_record_keys web)" "$(head -n 1 -- "$tmpdir/web/$domain/$backup_system/web.conf" 2> /dev/null)"; then
				restore_skip "web domain" "$domain" "invalid record" | tee -a $tmpdir/restore.log
				continue
			fi
			DOMAIN=$domain

			# Aliases: valid names that no other user holds
			aliases=''
			for dom_alias in ${ALIAS//,/ }; do
				if is_restore_name_valid domain "$dom_alias" && [ -z "$(is_domain_new 'web' "$dom_alias")" ]; then
					aliases+=",$dom_alias"
				fi
			done
			ALIAS=${aliases#,}

			# Checking IP address
			if ! is_restore_ip_valid "$IP"; then
				IP=''
			fi
			check_ip=$(is_ip_valid $IP $user)
			if [ -n "$check_ip" ]; then
				local_ip=''
				get_user_ip $user
				old_ip=$IP
				IP=$ip
			fi
			if [ -n "$IP6" ] && ! is_restore_ip_valid "$IP6"; then
				IP6=''
			fi

			# Checking web, proxy and backend templates
			if ! is_restore_template_valid "$TPL" || [ -n "$(is_web_template_valid "$TPL")" ] \
				|| [ -n "$(is_template_allowed_for "$TPL" web "$user")" ]; then
				TPL='default'
			fi
			if ! is_restore_template_valid "$PROXY" || [ -n "$(is_proxy_template_valid "$PROXY")" ] \
				|| [ -n "$(is_template_allowed_for "$PROXY" proxy "$user")" ]; then
				PROXY='default'
			fi
			if ! is_restore_template_valid "$BACKEND" || [ -n "$(is_backend_template_valid "$BACKEND")" ]; then
				BACKEND='default'
			fi
			# Only a PHP version the package allows (E39 W5 P3, P5)
			if ! php_backend_allowed_for_user "$user" "$BACKEND"; then
				echo "$(date "+%F %T") $domain: backend template $BACKEND uses a PHP version the package does not allow, the domain uses default" | tee -a $tmpdir/restore.log
				BACKEND='default'
			fi

			# Custom roots move to the new name and stay below ~/web
			old_web="$HOMEDIR/$old_user/web/"
			CUSTOM_DOCROOT=${CUSTOM_DOCROOT/#"$old_web"/"$HOMEDIR/$user/web/"}
			CUSTOM_PHPROOT=${CUSTOM_PHPROOT/#"$old_web"/"$HOMEDIR/$user/web/"}
			if ! is_restore_web_root_valid "$CUSTOM_DOCROOT"; then
				CUSTOM_DOCROOT=''
			fi
			if ! is_restore_web_root_valid "$CUSTOM_PHPROOT"; then
				CUSTOM_PHPROOT=''
			fi

			# Converting FTP users to the new name, then keeping the valid ones
			if [ -n "$FTP_USER" ]; then
				ftp_users=''
				for ftp_user in ${FTP_USER//:/ }; do
					ftp_users+=":${user}_${ftp_user#"${old_user}"_}"
				done
				FTP_USER=${ftp_users#:}
			fi
			restore_web_ftp_filter

			# Copying SSL certificates
			if [ "$SSL" = 'yes' ]; then

				for ext in crt key ca pem; do
					if [ -f "$tmpdir/web/$domain/$backup_system/$domain.crt" ]; then
						copy_from_work "$tmpdir/web/$domain/$backup_system/$domain.$ext" "$USER_DATA/ssl/$domain.$ext"
					else
						copy_from_work "$tmpdir/web/$domain/conf/ssl.$domain.$ext" "$USER_DATA/ssl/$domain.$ext"
					fi
				done
			fi

			# Merging web.conf keys
			str=$(restore_record web "U_BANDWIDTH='0' SUSPENDED='no' TIME='$(date +%T)' DATE='$(date +%F)'")
			if [ -z "$str" ]; then
				restore_skip "web domain" "$domain" "invalid record" | tee -a $tmpdir/restore.log
				continue
			fi
			echo "$str" >> $USER_DATA/web.conf

			# PHP-FPM profile of the domain (E41): a profile this server does not
			# have, or the package does not allow, falls back to the package's
			# default profile (E39 W5 P3)
			php_profile=$(grep -oE "PROFILE='[a-z0-9][a-z0-9-]{0,31}'" "$tmpdir/web/$domain/$backup_system/web.php.conf" 2> /dev/null | head -n1 | cut -d\' -f2)
			if [ -n "$php_profile" ] && [ "$WEB_BACKEND_POOL" != 'user' ]; then
				restored_profile=$(php_restore_profile "$user" "$php_profile")
				if [ "$restored_profile" != "$php_profile" ]; then
					echo "$(date "+%F %T") $domain: PHP-FPM profile $php_profile does not exist on this server or is not allowed by the package, the domain uses $restored_profile" | tee -a $tmpdir/restore.log
				fi
				php_domain_profile_set "$user" "$domain" "$restored_profile"
			fi

			# Rebuilding backend
			if [ -n "$WEB_BACKEND" ]; then
				$BIN/v-add-web-domain-backend $user $domain $BACKEND
			fi
		fi

		# Restoring custom user config
		# Except certificates, .conf files
		if [ ! -d "$HOMEDIR/$user/conf/web/$domain/" ]; then
			mkdir -p $HOMEDIR/$user/conf/web/$domain/
		fi
		if root_dir_safe "$HOMEDIR/$user/conf/web/$domain"; then
			for file in "$tmpdir/web/$domain/conf"/*; do
				if [[ "$file" == *.ca ]] || [[ "$file" == *.crt ]] || [[ "$file" == *.key ]] || [[ "$file" == *.pem ]] || [[ "$file" == *.conf ]]; then
					continue
				fi
				if grep -qs "fastcgi_pass" "$file"; then
					# Do not allow to run php under a different user
					continue
				fi
				filename=$(basename -- "$file")
				copy_from_work "$file" "$HOMEDIR/$user/conf/web/$domain/$filename"
			done
		fi

		# Rebuilding vhost to prevent user overwrite default config changes not ideal
		rebuild_web_domain_conf

		# Restoring web domain data as the user; root reads the archive from
		# its working folder. The web root is emptied by the user, so a link
		# in its place cannot make root delete elsewhere.
		if [ -d "$HOMEDIR/$user/web/$domain/public_html" ]; then
			user_exec find "$HOMEDIR/$user/web/$domain/public_html/" -mindepth 1 -delete
		fi
		user_exec chmod u+w "$HOMEDIR/$user/web/$domain"
		[[ -d $HOMEDIR/$user/web/$domain/stats ]] && user_exec chmod u+w "$HOMEDIR/$user/web/$domain/stats"

		if [ "$backup_mode" = "zstd" ]; then
			user_exec tar -I pzstd -xpf - \
				-C "$HOMEDIR/$user/web/$domain/" \
				--anchored \
				--exclude='logs/*' < "$tmpdir/web/$domain/domain_data.tar.zst"
		else
			user_exec tar -xzpf - \
				-C "$HOMEDIR/$user/web/$domain/" \
				--anchored \
				--exclude='logs/*' < "$tmpdir/web/$domain/domain_data.tar.gz"
		fi

		if [ "$?" -ne 0 ]; then
			rm -rf $tmpdir
			error="Can't unpack $domain data tarball"
			echo "$error" | $SENDMAIL -s "$subj" $email $notify
			sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
			check_result "$E_PARSING" "$error"
		fi

		# Re-chowning files if uid differs
		if [ "$old_uid" -ne "$new_uid" ]; then
			find $HOMEDIR/$user/web/$domain/ -user $old_uid \
				-exec chown -h $user:$user {} \;
		fi

		# Rebuilding web config for the second time to make sure ftp users keep working
		rebuild_web_domain_conf
	done

	# Adding user to traffic queue
	sed -i "/ $user /d" $ARCPANEL/data/queue/traffic.pipe
	echo "$BIN/v-update-web-domains-traff $user" >> $ARCPANEL/data/queue/traffic.pipe

	# Restarting web server
	$BIN/v-restart-web
	check_result $? "Web restart failed"
	if [ -n "$PROXY_SYSTEM" ]; then
		$BIN/v-restart-proxy
		check_result $? "Proxy restart failed"
	fi
fi

# Restoring DNS domains
if [ "$dns" != 'no' ] && [ -n "$DNS_SYSTEM" ]; then
	echo -e "\n-- DNS --" | tee -a $tmpdir/restore.log

	# Creating dns domain restore list
	backup_domains=$(tar -tf $BACKUP/$backup | grep "^./dns")
	backup_domains=$(echo "$backup_domains" | grep "dns.conf$")
	backup_domains=$(echo "$backup_domains" | cut -f 3 -d /)
	if [ -z "$dns" ] || [ "$dns" = '*' ]; then
		domains="$backup_domains"
	else
		echo "$dns" | tr ',' '\n' > $tmpdir/selected.txt
		domains=$(echo "$backup_domains" | egrep -x -f $tmpdir/selected.txt)
	fi

	# Restoring DNS domain
	for domain in $domains; do
		if ! is_restore_name_valid domain "$domain"; then
			restore_skip "DNS domain" "$domain" "invalid name" | tee -a $tmpdir/restore.log
			continue
		fi
		echo -e "$(date "+%F %T") $domain" | tee -a $tmpdir/restore.log
		domain_idn="$domain"
		# Cleanup previous config keys
		restore_record_reset dns
		unset -v old_ip

		# Checking domain existence
		check_config=$(grep -F "DOMAIN='$domain'" $USER_DATA/dns.conf)
		if [ -z "$check_config" ]; then
			check_new=$(is_domain_new 'dns' $domain)
			if [ -n "$check_new" ]; then
				rm -rf $tmpdir
				error="$domain belongs to another user"
				echo "$error" | $SENDMAIL -s "$subj" $email $notify
				sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
				check_result "$E_PARSING" "$error"
			fi
		fi

		# Unpacking domain container
		tar xf $BACKUP/$backup -C $tmpdir ./dns/$domain
		tar_status=$?
		find "$tmpdir/dns/$domain" \( -type l -o \( ! -type f ! -type d \) \) -delete 2> /dev/null
		if [ "$tar_status" -ne 0 ]; then
			rm -rf $tmpdir
			error="Can't unpack $domain dns container"
			echo "$error" | $SENDMAIL -s "$subj" $email $notify
			sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
			check_result "$E_PARSING" "$error"
		fi

		# Restoring dns.conf
		if [ -z "$check_config" ]; then
			if ! parse_backup_record "$(restore_record_keys dns)" "$(head -n 1 -- "$tmpdir/dns/$domain/$backup_system/dns.conf" 2> /dev/null)"; then
				restore_skip "DNS domain" "$domain" "invalid record" | tee -a $tmpdir/restore.log
				continue
			fi
			DOMAIN=$domain

			# Checking IP address (an address only: it becomes a sed pattern)
			if ! is_restore_ip_valid "$IP"; then
				IP=''
			fi
			check_ip=$(is_ip_valid $IP $user)
			if [ -n "$check_ip" ]; then
				export local_ip=''
				get_user_ip $user
				old_ip=$IP
				IP=$ip
			fi

			# Checking DNS template
			check_tpl=$(is_dns_template_valid $TPL)
			if [ -n "$check_tpl" ]; then
				TPL='default'
			fi

			if ! is_restore_template_valid "$TPL"; then
				TPL='default'
			fi
			if ! is_restore_ip_valid "$IP"; then
				restore_skip "DNS domain" "$domain" "no valid IP address" | tee -a $tmpdir/restore.log
				continue
			fi

			# Merging dns.conf keys
			str=$(restore_record dns "SUSPENDED='no' TIME='$(date +%T)' DATE='$(date +%F)'")
			if [ -z "$str" ]; then
				restore_skip "DNS domain" "$domain" "invalid record" | tee -a $tmpdir/restore.log
				continue
			fi
			echo "$str" >> $USER_DATA/dns.conf
		else
			parse_object_kv_list "$check_config"
		fi

		if [ "$DNSSEC" = "yes" ]; then
			format_domain_idn
			# Only the key files of this domain, as regular files
			for key_file in "$tmpdir/dns/$domain/conf/keys"/K"$domain_idn".+*; do
				key_name=$(basename -- "$key_file")
				if [[ "$key_name" =~ ^K[A-Za-z0-9.-]+\.\+[0-9]+\+[0-9]+\.(key|private)$ ]]; then
					copy_from_work "$key_file" "/var/cache/bind/$key_name" || continue
					chown bind:bind "/var/cache/bind/$key_name"
					chmod 644 "/var/cache/bind/$key_name"
				fi
			done
		fi

		# Restoring DNS records
		dropped=$(restore_records_file dnsrec "$tmpdir/dns/$domain/$backup_system/$domain.conf" "$USER_DATA/dns/$domain.conf")
		if [ "${dropped:-0}" -gt 0 ]; then
			restore_skip "DNS records of" "$domain" "$dropped invalid records" | tee -a $tmpdir/restore.log
		fi

		# Update IP in records
		if [ -n "$old_ip" ] && is_restore_ip_valid "$old_ip"; then
			sed -i "s/$old_ip/$IP/g" "$USER_DATA/dns/$domain.conf"
		fi

		# Rebuilding DNS domain
		rebuild_dns_domain_conf

		# Updating dns-cluster queue
		if [ -n "$DNS_CLUSTER" ]; then
			cmd="$BIN/v-add-remote-dns-domain $user $domain yes"
			echo "$cmd" >> $ARCPANEL/data/queue/dns-cluster.pipe
		fi
	done

	# Restarting DNS
	$BIN/v-restart-dns
	check_result $? "DNS restart failed"
fi

# Restoring mail domains
if [ "$mail" != 'no' ] && [ -n "$MAIL_SYSTEM" ]; then
	echo -e "\n-- MAIL --" | tee -a $tmpdir/restore.log

	# Creating mail domain restore list
	backup_domains=$(tar -tf $BACKUP/$backup | grep "^./mail")
	backup_domains=$(echo "$backup_domains" | grep "mail.conf$")
	backup_domains=$(echo "$backup_domains" | cut -f 3 -d /)
	if [ -z "$mail" ] || [ "$mail" = '*' ]; then
		domains="$backup_domains"
	else
		echo "$mail" | tr ',' '\n' > $tmpdir/selected.txt
		domains=$(echo "$backup_domains" | egrep -x -f $tmpdir/selected.txt)
	fi

	# Checking exim username for later chowning
	exim_user="exim"
	check_exim_username=$(grep -c '^Debian-exim:' /etc/passwd)
	if [ "$check_exim_username" -eq 1 ]; then
		exim_user="Debian-exim"
	fi

	# Restoring mail domain
	for domain in $domains; do
		if ! is_restore_name_valid domain "$domain"; then
			restore_skip "mail domain" "$domain" "invalid name" | tee -a $tmpdir/restore.log
			continue
		fi
		echo -e "$(date "+%F %T") $domain" | tee -a $tmpdir/restore.log

		# Checking domain existence
		check_config=$(grep -F "DOMAIN='$domain'" $USER_DATA/mail.conf)
		if [ -z "$check_config" ]; then
			check_new=$(is_domain_new 'mail' $domain)
			if [ -n "$check_new" ]; then
				rm -rf $tmpdir
				error="$domain belongs to another user"
				echo "$error" | $SENDMAIL -s "$subj" $email $notify
				sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
				check_result "$E_PARSING" "$error"
			fi
		fi

		# Unpacking domain container
		tar xf $BACKUP/$backup -C $tmpdir ./mail/$domain
		tar_status=$?
		find "$tmpdir/mail/$domain" \( -type l -o \( ! -type f ! -type d \) \) -delete 2> /dev/null
		if [ "$tar_status" -ne 0 ]; then
			rm -rf $tmpdir
			error="Can't unpack $domain mail container"
			echo "$error" | $SENDMAIL -s "$subj" $email $notify
			sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
			check_result "$E_PARSING" "$error"
		fi

		# Restoring mail.conf
		if [ -z "$check_config" ]; then
			restore_record_reset mail
			if ! parse_backup_record "$(restore_record_keys mail)" "$(head -n 1 -- "$tmpdir/mail/$domain/$backup_system/mail.conf" 2> /dev/null)"; then
				restore_skip "mail domain" "$domain" "invalid record" | tee -a $tmpdir/restore.log
				continue
			fi
			DOMAIN=$domain
			str=$(restore_record mail "SUSPENDED='no' TIME='$(date +%T)' DATE='$(date +%F)'")
			if [ -z "$str" ]; then
				restore_skip "mail domain" "$domain" "invalid record" | tee -a $tmpdir/restore.log
				continue
			fi
			echo "$str" >> $USER_DATA/mail.conf
		fi

		# Restoring DKIM
		if [ -f "$tmpdir/mail/$domain/$backup_system/$domain.pem" ]; then
			copy_from_work "$tmpdir/mail/$domain/$backup_system/$domain.pem" "$USER_DATA/mail/$domain.pem"
			copy_from_work "$tmpdir/mail/$domain/$backup_system/$domain.pub" "$USER_DATA/mail/$domain.pub"
		fi

		# Restore SSL
		check_config=$(grep "DOMAIN='$domain'" $USER_DATA/mail.conf | grep -o "SSL='yes'")
		if [ -n "$check_config" ]; then
			if [ ! -e "$ARCPANEL/data/users/$user/ssl/" ]; then
				mkdir -p $ARCPANEL/data/users/$user/ssl/
			fi

			if [ ! -e "$HOMEDIR/$user/conf/mail/$domain/" ]; then
				mkdir -p "$HOMEDIR/$user/conf/mail/$domain/"
			fi
			if ! root_dir_safe "$HOMEDIR/$user/conf/mail/$domain"; then
				check_result "$E_FORBIDEN" "$HOMEDIR/$user/conf/mail/$domain is not root's"
			fi
			if [ ! -d "$HOMEDIR/$user/conf/mail/$domain/ssl/" ] || [ -L "$HOMEDIR/$user/conf/mail/$domain/ssl" ]; then
				rm -f -- "$HOMEDIR/$user/conf/mail/$domain/ssl"
				mkdir -p "$HOMEDIR/$user/conf/mail/$domain/ssl/"
			fi

			# Add certificate to ArcPanel user configuration data directory
			if [ -f $tmpdir/mail/$domain/$backup_system/ssl/$domain.crt ]; then
				cp -f $tmpdir/mail/$domain/$backup_system/ssl/$domain.crt $USER_DATA/ssl/mail.$domain.crt
				cp -f $tmpdir/mail/$domain/$backup_system/ssl/$domain.key $USER_DATA/ssl/mail.$domain.key
				cp -f $tmpdir/mail/$domain/$backup_system/ssl/$domain.crt $USER_DATA/ssl/mail.$domain.pem
				if [ -e "$tmpdir/mail/$domain/$backup_system/ssl/$domain.ca" ]; then
					cp -f $tmpdir/mail/$domain/$backup_system/ssl/$domain.ca $USER_DATA/ssl/mail.$domain.ca
					echo >> $USER_DATA/ssl/mail.$domain.pem
					cat $USER_DATA/ssl/mail.$domain.ca >> $USER_DATA/ssl/mail.$domain.pem
				fi
			elif [ -f "$tmpdir/mail/$domain/conf/ssl/$domain.crt" ]; then
				cp -f $tmpdir/mail/$domain/conf/ssl/$domain.crt $USER_DATA/ssl/mail.$domain.crt
				cp -f $tmpdir/mail/$domain/conf/ssl/$domain.key $USER_DATA/ssl/mail.$domain.key
				cp -f $tmpdir/mail/$domain/conf/ssl/$domain.crt $USER_DATA/ssl/mail.$domain.pem
				if [ -e "$tmpdir/mail/$domain/conf/ssl/$domain.ca" ]; then
					cp -f $tmpdir/mail/$domain/conf/ssl/$domain.ca $USER_DATA/ssl/mail.$domain.ca
					echo >> $USER_DATA/ssl/mail.$domain.pem
					cat $USER_DATA/ssl/mail.$domain.ca >> $USER_DATA/ssl/mail.$domain.pem
				fi

			fi

			chmod 660 $USER_DATA/ssl/mail.$domain.*

			# Add certificate to user home directory
			cp -f $USER_DATA/ssl/mail.$domain.crt $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.crt
			cp -f $USER_DATA/ssl/mail.$domain.key $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.key
			cp -f $USER_DATA/ssl/mail.$domain.pem $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.pem
			if [ -e "$USER_DATA/ssl/mail.$domain.ca" ]; then
				cp -f $USER_DATA/ssl/mail.$domain.ca $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.ca
			fi

			if [ ! -d /etc/dovecot/conf.d/domains ]; then
				mkdir /etc/dovecot/conf.d/domains
			fi

			# Add domain SSL configuration to dovecot
			if [ -f /etc/dovecot/conf.d/domains/$domain.conf ]; then
				rm -f /etc/dovecot/conf.d/domains/$domain.conf
			fi

			dovecot_version="$(dovecot --version | cut -f -2 -d .)"
			if [[ "$dovecot_version" = "2.4" ]]; then
				echo "" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "local_name mail.$domain {" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "  sssl_server_cert_file = $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.pem" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "  ssl_server_key_file = $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.key" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "}" >> /etc/dovecot/conf.d/domains/$domain.conf
			else
				echo "" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "local_name mail.$domain {" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "  ssl_cert = <$HOMEDIR/$user/conf/mail/$domain/ssl/$domain.pem" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "  ssl_key = <$HOMEDIR/$user/conf/mail/$domain/ssl/$domain.key" >> /etc/dovecot/conf.d/domains/$domain.conf
				echo "}" >> /etc/dovecot/conf.d/domains/$domain.conf
			fi

			if [ ! -d /usr/local/arcpanel/ssl/mail ]; then
				mkdir /usr/local/arcpanel/ssl/mail
			fi

			# Add domain SSL configuration to exim4
			# Cleanup broken symlinks
			find /usr/local/arcpanel/ssl/mail -xtype l -delete

			ln -s -f $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.pem /usr/local/arcpanel/ssl/mail/mail.$domain.crt
			ln -s -f $HOMEDIR/$user/conf/mail/$domain/ssl/$domain.key /usr/local/arcpanel/ssl/mail/mail.$domain.key

			# Set correct permissions on certificates
			chmod 750 $HOMEDIR/$user/conf/mail/$domain/ssl
			chown -hR $MAIL_USER:mail $HOMEDIR/$user/conf/mail/$domain/ssl
			chmod 0644 $HOMEDIR/$user/conf/mail/$domain/ssl/*
			chown -h $user:mail $HOMEDIR/$user/conf/mail/$domain/ssl/*
			chmod -R 0644 /usr/local/arcpanel/ssl/mail/*
			chown -h $user:mail /usr/local/arcpanel/ssl/mail/*
		fi

		# Restoring email accounts
		dropped=$(restore_records_file mailacc "$tmpdir/mail/$domain/$backup_system/$domain.conf" "$USER_DATA/mail/$domain.conf")
		if [ "${dropped:-0}" -gt 0 ]; then
			restore_skip "mail accounts of" "$domain" "$dropped invalid records" | tee -a $tmpdir/restore.log
		fi

		domain_idn=$domain
		format_domain_idn

		# ~/mail belongs to root, so root may create the domain folder in it
		if [ ! -e "$HOMEDIR/$user/mail/$domain_idn" ] && [ ! -L "$HOMEDIR/$user/mail/$domain_idn" ]; then
			mkdir $HOMEDIR/$user/mail/$domain_idn
		fi

		# Current ArcPanel store email in the $HOMEDIR/$user/mail/$domain_idn
		chown -h $user:$user "$HOMEDIR/$user/mail/$domain_idn"
		user_exec chmod u+w "$HOMEDIR/$user/mail/$domain_idn"

		# Restoring emails, unpacked by the user from root's working folder
		if [ $backup_mode = 'zstd' ]; then
			if [ -e "$tmpdir/mail/$domain/accounts.tar.zst" ]; then
				user_exec tar -I pzstd -xf - -C "$HOMEDIR/$user/mail/$domain_idn/" < "$tmpdir/mail/$domain/accounts.tar.zst"
				if [ "$?" -ne 0 ]; then
					rm -rf $tmpdir
					error="Can't unpack $domain mail account container"
					echo "$error" | $SENDMAIL -s "$subj" $email $notify
					sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
					check_result "$E_PARSING" "$error"
				fi

				# Chowning as owner needs to be user:mail instead of user:user
				find $HOMEDIR/$user/mail/$domain_idn -user $user \
					-exec chown -h $user:mail {} \;
			fi
		else
			if [ -e "$tmpdir/mail/$domain/accounts.tar.gz" ]; then
				user_exec tar -xzf - -C "$HOMEDIR/$user/mail/$domain_idn/" < "$tmpdir/mail/$domain/accounts.tar.gz"
				if [ "$?" -ne 0 ]; then
					rm -rf $tmpdir
					error="Can't unpack $domain mail account container"
					echo "$error" | $SENDMAIL -s "$subj" $email $notify
					sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
					check_result "$E_PARSING" "$error"
				fi

				# Chowning as owner needs to be user:mail instead of user:user
				find $HOMEDIR/$user/mail/$domain_idn -user $user \
					-exec chown -h $user:mail {} \;
			fi
		fi
		# Chowning mail conf files to exim user
		if [ -d "$HOMEDIR/$user/conf/mail/$domain" ] && root_dir_safe "$HOMEDIR/$user/conf/mail/$domain"; then
			find $HOMEDIR/$user/conf/mail/$domain -user root \
				-exec chown -h $exim_user {} \;
		fi

		$BIN/v-rebuild-mail-domain $user $domain

	done

	# Restarting web server
	$BIN/v-restart-web
	check_result $? "Web restart failed"
	if [ -n "$PROXY_SYSTEM" ]; then
		$BIN/v-restart-proxy
		check_result $? "Proxy restart failed"
	fi
fi

# Restoring databases
if [ "$db" != 'no' ] && [ -n "$DB_SYSTEM" ]; then
	echo -e "\n-- DB --" | tee -a $tmpdir/restore.log

	# Creating database restore list
	backup_databases=$(tar -tf $BACKUP/$backup | grep "^./db")
	backup_databases=$(echo "$backup_databases" | grep db.conf)
	backup_databases=$(echo "$backup_databases" | cut -f 3 -d / | sort -u)
	if [ -z "$db" ] || [ "$db" = '*' ]; then
		databases="$backup_databases"
	else
		echo "$db" | tr ',' '\n' > $tmpdir/selected.txt
		databases=$(echo "$backup_databases" | egrep -x -f $tmpdir/selected.txt)
	fi

	# Restoring database
	for database in $databases; do
		if ! is_restore_name_valid database "$database"; then
			restore_skip database "$database" "invalid name" | tee -a $tmpdir/restore.log
			continue
		fi
		echo -e "$(date "+%F %T") $database" | tee -a $tmpdir/restore.log

		# Cleanup previous config keys
		unset -v DB DBUSER MD5 HOST TYPE CHARSET U_DISK

		# Checking database existence
		check_config=$(grep -F "DB='$database'" $USER_DATA/db.conf)

		# Unpacking database container
		tar xf $BACKUP/$backup -C $tmpdir ./db/$database
		tar_status=$?
		find "$tmpdir/db/$database" \( -type l -o \( ! -type f ! -type d \) \) -delete 2> /dev/null
		if [ "$tar_status" -ne 0 ]; then
			rm -rf $tmpdir
			error="Can't unpack $database database container"
			echo "$error" | $SENDMAIL -s "$subj" $email $notify
			sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
			check_result "$E_PARSING" "$error"
		fi

		# Restore database config
		if [ -z "$check_config" ]; then
			if ! parse_backup_record "$(restore_record_keys db)" "$(head -n 1 -- "$tmpdir/db/$database/$backup_system/db.conf" 2> /dev/null)"; then
				restore_skip database "$database" "invalid record" | tee -a $tmpdir/restore.log
				continue
			fi

			if [ -z "$MD5" ]; then
				echo "Warning!: Database ${DB} backup does not contain a password for user ${DBUSER}."
				echo "- Please use the web interface to set a password after the restore process finishes."
			fi

			DB="${user}_${DB#"${old_user}"_}"
			DBUSER="${user}_${DBUSER#"${old_user}"_}"
			if ! is_restore_database_valid || is_database_of_other_user "$DB"; then
				restore_skip database "$database" "invalid user, type, host or charset" | tee -a $tmpdir/restore.log
				continue
			fi
			str=$(restore_record db "SUSPENDED='no' TIME='$(date +%T)' DATE='$(date +%F)'")
			if [ -z "$str" ]; then
				restore_skip database "$database" "invalid record" | tee -a $tmpdir/restore.log
				continue
			fi
			echo "$str" >> $USER_DATA/db.conf
		else
			parse_object_kv_list "$check_config"
		fi

		# Unzipping database dump
		if [ $backup_mode = 'zstd' ]; then
			pzstd -d $tmpdir/db/$database/$database.*.sql.zst
		else
			gzip -d $tmpdir/db/$database/$database.*.sql.gz
		fi

		# Importing database dump, with an account limited to the database
		database_dump="$tmpdir/db/$database/$database.$TYPE.sql"
		case $TYPE in
			mysql)
				delete_mysql_database
				rebuild_mysql_database
				;;
			pgsql)
				delete_pgsql_database
				rebuild_pgsql_database
				;;
		esac
		if ! restore_import_database "$database_dump"; then
			echo "[ ! ] The dump of $database was not imported completely" | tee -a $tmpdir/restore.log
		fi
	done
fi

# Restoring cron jobs
if [ "$cron" != 'no' ] && [ -n "$CRON_SYSTEM" ]; then
	echo -e "\n-- CRON --" | tee -a $tmpdir/restore.log

	# Unpacking cron container
	tar xf $BACKUP/$backup -C $tmpdir ./cron
	tar_status=$?
	find "$tmpdir/cron" \( -type l -o \( ! -type f ! -type d \) \) -delete 2> /dev/null
	if [ "$tar_status" -ne 0 ]; then
		rm -rf $tmpdir
		error="Can't unpack cron container"
		echo "$error" | $SENDMAIL -s "$subj" $email $notify
		sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
		check_result "$E_PARSING" "$error"
	fi

	sed -i 's/\r//g' $tmpdir/cron/cron.conf
	jobs=$(wc -l $tmpdir/cron/cron.conf | cut -f 1 -d' ')
	if [ "$jobs" -eq 1 ]; then
		echo -e "$(date "+%F %T") $jobs cron job" | tee -a $tmpdir/restore.log
	else
		echo -e "$(date "+%F %T") $jobs cron jobs" | tee -a $tmpdir/restore.log
	fi

	# Paths and command names of the panel that made the archive
	# (/usr/local/hestia/bin/v-update-sys-hestia-all and the like)
	if [ "$backup_system" != 'arcpanel' ] && [ "$user" == "$ROOT_USER" ]; then
		sed -i "s/$backup_system/arcpanel/g" $tmpdir/cron/cron.conf
	fi

	# Restoring cron jobs, rebuilt from known keys
	dropped=$(restore_records_file cron "$tmpdir/cron/cron.conf" "$USER_DATA/cron.conf")
	if [ "${dropped:-0}" -gt 0 ]; then
		restore_skip "cron jobs" "$dropped" "invalid records" | tee -a $tmpdir/restore.log
	fi

	# Rebuilding cron jobs
	sync_cron_jobs

	# Restarting cron
	$BIN/v-restart-cron
	check_result $? "CRON restart failed"
fi

# Restoring user files and directories
if [ "$udir" != 'no' ]; then
	echo -e "\n-- USER FILES --" | tee -a $tmpdir/restore.log

	# Unpacking user dir container
	if [ -n "$(tar -tf $BACKUP/$backup | grep './user_dir')" ]; then

		# Creating user dir restore list
		backup_dirs=$(tar -tf $BACKUP/$backup | grep "^./user_dir")
		if [ $backup_mode = 'zstd' ]; then
			backup_dirs=$(echo "$backup_dirs" | grep tar.zst)
			backup_dirs=$(echo "$backup_dirs" | cut -f 3 -d /)
			backup_dirs=$(echo "$backup_dirs" | sed "s/.tar.zst//")
		else
			backup_dirs=$(echo "$backup_dirs" | grep tar.gz)
			backup_dirs=$(echo "$backup_dirs" | cut -f 3 -d /)
			backup_dirs=$(echo "$backup_dirs" | sed "s/.tar.gz//")
		fi
		if [ -z "$udir" ] || [ "$udir" = '*' ]; then
			user_dirs="$backup_dirs"
		else
			echo "$udir" | tr ',' '\n' > $tmpdir/selected.txt
			user_dirs=$(echo "$backup_dirs" | egrep -x -f $tmpdir/selected.txt)
		fi

		while IFS= read -r user_dir; do
			[ -n "$user_dir" ] || continue
			if ! is_restore_name_valid segment "$user_dir"; then
				restore_skip "user folder" "$user_dir" "invalid name" | tee -a $tmpdir/restore.log
				continue
			fi
			echo -e "$(date "+%F %T") $user_dir" | tee -a $tmpdir/restore.log
			if [ "$backup_mode" = 'zstd' ]; then
				tar xf "$BACKUP/$backup" -C "$tmpdir" --no-wildcards "./user_dir/$user_dir.tar.zst"
			else
				tar xf "$BACKUP/$backup" -C "$tmpdir" --no-wildcards "./user_dir/$user_dir.tar.gz"
			fi
			if [ $? -ne 0 ]; then
				rm -rf "$tmpdir"
				error="Can't unpack $user_dir user dir container"
				echo "$error" | $SENDMAIL -s "$subj" $email $notify
				sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
				check_result "$E_PARSING" "$error"
			fi

			# A home of root (users without a shell) gets the folder from root,
			# owned by the user; the user cannot replace entries of a folder
			# they cannot write, so this does not race. The content is
			# unpacked by the user, reading the archive root opened.
			if [ "$backup_mode" = 'zstd' ]; then
				udir_archive="$tmpdir/user_dir/$user_dir.tar.zst"
				udir_filter='-I pzstd'
			else
				udir_archive="$tmpdir/user_dir/$user_dir.tar.gz"
				udir_filter='-z'
			fi
			home_owner=$(stat -c %u -- "$HOMEDIR/$user")
			if [ "$home_owner" = 0 ] && [ ! -e "$HOMEDIR/$user/$user_dir" ] && [ ! -L "$HOMEDIR/$user/$user_dir" ]; then
				# A folder when the archive holds entries below the name
				# shellcheck disable=SC2086
				if tar $udir_filter -tf - < "$udir_archive" 2> /dev/null \
					| awk -v p="$user_dir/" 'index($0, p) == 1 || index($0, "./" p) == 1 { found = 1 } END { exit !found }'; then
					mkdir -m 700 -- "$HOMEDIR/$user/$user_dir"
				else
					install -m 600 /dev/null "$HOMEDIR/$user/$user_dir"
				fi
				chown -h "$user:$user" -- "$HOMEDIR/$user/$user_dir"
			fi
			# shellcheck disable=SC2086
			user_exec tar $udir_filter -xf - --overwrite -C "$HOMEDIR/$user" < "$udir_archive"
			cmdstatus="$?"
			if [ "$cmdstatus" -ne 0 ]; then
				rm -rf "$tmpdir"
				error="Can't unpack $user_dir user dir container"
				echo "$error" | "$SENDMAIL" -s "$subj" "$email" "$notify"
				sed -i "/ $user /d" "$ARCPANEL"/data/queue/backup.pipe
				check_result "$E_PARSING" "$error"
			fi

			# Re-chowning files if uid differs
			if [ "$old_uid" -ne "$new_uid" ]; then
				find "$HOMEDIR/$user/$user_dir" -user "$old_uid" \
					-exec chown -h "$user:$user" {} \;
			fi
		done <<< "$user_dirs"
	fi
fi

# Restoring the data of Docker apps (E39 W1): root unpacks each archive in
# its working folder, the user copies the volumes into the data folder
if [ "$udir" != 'no' ] && tar -tf "$BACKUP/$backup" ./docker_data > /dev/null 2>&1; then
	echo -e "\n-- DOCKER DATA --" | tee -a $tmpdir/restore.log
	tar xf "$BACKUP/$backup" -C "$tmpdir" ./docker_data 2> /dev/null
	find "$tmpdir/docker_data" \( -type l -o \( ! -type f ! -type d \) \) -delete 2> /dev/null
	for app_archive in "$tmpdir"/docker_data/*.tar.zst "$tmpdir"/docker_data/*.tar.gz; do
		[ -f "$app_archive" ] || continue
		app=$(basename -- "$app_archive")
		app=${app%.tar.*}
		if ! [[ "$app" =~ ^[a-z0-9][a-z0-9-]{1,31}$ ]]; then
			restore_skip "Docker app data" "$app" "invalid name" | tee -a $tmpdir/restore.log
			continue
		fi
		echo -e "$(date "+%F %T") $app" | tee -a $tmpdir/restore.log
		mkdir -p "$tmpdir/docker_data/$app"
		if [[ "$app_archive" == *.zst ]]; then
			tar -I pzstd -xpf "$app_archive" -C "$tmpdir/docker_data/$app"
		else
			tar -xzpf "$app_archive" -C "$tmpdir/docker_data/$app"
		fi
		if ! dockerapp_data_fill "$user" "$app" "$tmpdir/docker_data/$app"; then
			echo "[ ! ] The data of the Docker app $app was not restored completely" | tee -a $tmpdir/restore.log
		fi
		rm -rf -- "$tmpdir/docker_data/$app"
	done
fi

# Object storage (E44): the buckets of the backup whose names are free, with
# their objects when the archive holds them; S3 keys are never restored.
# Restored with the user folders, like the data of Docker apps.
if [ "$udir" != 'no' ] && [ ! -e "$tmpdir/$backup_system/buckets.conf" ]; then
	tar xf "$BACKUP/$backup" -C "$tmpdir" --no-wildcards "./$backup_system/buckets.conf" 2> /dev/null
	[ -L "$tmpdir/$backup_system/buckets.conf" ] && rm -f "$tmpdir/$backup_system/buckets.conf"
fi
if [ "$udir" != 'no' ] && [ -f "$tmpdir/$backup_system/buckets.conf" ] && [ -s "$tmpdir/$backup_system/buckets.conf" ]; then
	echo -e "\n-- OBJECT STORAGE --" | tee -a $tmpdir/restore.log
	# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
	source $ARCPANEL/func/tenancy.sh
	# shellcheck source=/usr/local/arcpanel/func/silo.sh
	source $ARCPANEL/func/silo.sh
	objects="$tmpdir/object_storage_files"
	if tar -tf "$BACKUP/$backup" ./object_storage > /dev/null 2>&1; then
		tar xf "$BACKUP/$backup" -C "$tmpdir" ./object_storage 2> /dev/null
		find "$tmpdir/object_storage" \( -type l -o \( ! -type f ! -type d \) \) -delete 2> /dev/null
		for archive in "$tmpdir"/object_storage/*.tar.zst "$tmpdir"/object_storage/*.tar.gz; do
			[ -f "$archive" ] || continue
			bucket=$(basename -- "$archive")
			bucket=${bucket%.tar.*}
			silo_bucket_name_valid "$bucket" || continue
			mkdir -p "$objects/$bucket"
			if [[ "$archive" == *.zst ]]; then
				tar -I pzstd -xf "$archive" -C "$objects/$bucket" --no-same-owner
			else
				tar -xzf "$archive" -C "$objects/$bucket" --no-same-owner
			fi
			find "$objects/$bucket" \( -type l -o \( ! -type f ! -type d \) \) -delete 2> /dev/null
		done
	fi
	silo_restore_user "$user" "$tmpdir/$backup_system/buckets.conf" "$objects" | tee -a $tmpdir/restore.log
	rm -rf -- "$objects" "$tmpdir/object_storage"
fi

# Data of Docker apps unpacked into the home by an archive made before
# E39 W1 moves out of it
$BIN/v-update-sys-user-homes "$user" | tee -a $tmpdir/restore.log

# Create tmp/
if [ ! -e "$HOMEDIR/$user/tmp" ] && [ ! -L "$HOMEDIR/$user/tmp" ]; then
	mkdir -m 700 "$HOMEDIR/$user/tmp"
	chown -h $user:$user "$HOMEDIR/$user/tmp"
fi

# Delete ArcPanel File manager key
user_exec rm -f -- "$HOMEDIR/$user/.ssh/arcpanel-filemanager-key" "$HOMEDIR/$user/.ssh/arcpanel-filemanager-key.pub"

# Sending mail notification
subj="$user → restore has been completed"
cat $tmpdir/restore.log | $SENDMAIL -s "$subj" $email $notify

# Send notification to panel
$BIN/v-add-user-notification "$user" "Backup restored successfully" "<p><span class='u-text-bold'>Archive:</span> <code>$backup</code></p>"

# Deleting temporary data
rm -rf $tmpdir

# Cleaning restore queue
sed -i "/v-restore-user $user /d" $ARCPANEL/data/queue/backup.pipe

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Update user counters
$BIN/v-update-user-counters "$user"
$BIN/v-update-user-counters "$ROOT_USER"
$BIN/v-update-sys-ip-counters

# Logging
$BIN/v-log-action "system" "Info" "Backup" "Restored backup contents (User: $user, Archive: $backup)."
$BIN/v-log-action "$user" "Info" "Backup" "Restored backup contents (Archive: $backup)."
log_event "$OK" "$ARGUMENTS"

exit
