#!/bin/bash
# info: disable the file manager of the panel
# options: [MODE]
#
# example: v-delete-sys-filemanager
#
# This function turns the file manager of the panel app off (FILE_MANAGER)
# and removes what is left of the FileGator install of ArcPanel 1.x.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

MODE=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Checking root permissions
if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

# Ensure that $ARCPANEL (/usr/local/arcpanel/) and other variables are valid.
if [ -z "$ARCPANEL" ]; then
	ARCPANEL="/usr/local/arcpanel"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# FileGator of 1.x
rm --recursive --force "$ARCPANEL/web/fm"
$BIN/v-change-sys-config-value 'FILE_MANAGER' 'false'

if [ "$MODE" != "quiet" ]; then
	echo "File Manager is disabled."
fi

#----------------------------------------------------------#
#                       Logging                            #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "Plugins" "File Manager disabled."
log_event "$OK" "$ARGUMENTS"
