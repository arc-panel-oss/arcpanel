#!/bin/bash
# info: disable the file manager of the panel
# options: [MODE]
#
# example: v-delete-sys-filemanager
#
# This function turns the file manager of the panel app off (FILE_MANAGER)
# and removes what is left of the FileGator install of ArcPanel 1.x.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

MODE=$1

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Checking root permissions
if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

# Ensure that $HESTIA (/usr/local/hestia/) and other variables are valid.
if [ -z "$HESTIA" ]; then
	HESTIA="/usr/local/hestia"
fi

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# FileGator of 1.x
rm --recursive --force "$HESTIA/web/fm"
$BIN/v-change-sys-config-value 'FILE_MANAGER' 'false'

if [ "$MODE" != "quiet" ]; then
	echo "File Manager is disabled."
fi

#----------------------------------------------------------#
#                       Logging                            #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "Plugins" "File Manager disabled."
log_event "$OK" "$ARGUMENTS"
