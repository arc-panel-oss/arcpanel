#!/bin/bash
# info: change sysconfig value
# options: KEY VALUE
#
# example: v-change-sys-config-value VERSION 1.0
#
# This function is for changing main config settings such as COMPANY_NAME or
# COMPANY_EMAIL and so on.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
key=$(echo "$1" | tr '[:lower:]' '[:upper:]')
value=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'KEY VALUE'
is_common_format_valid "$key" 'key'
format_no_quotes "$value" 'value'
# Keys with a fixed range (E23 audit log)
case "$key" in
	AUDIT_RETENTION_DAYS)
		if ! [[ "$value" =~ ^[0-9]{1,4}$ ]] || [ "$value" -lt 7 ] || [ "$value" -gt 3650 ]; then
			check_result "$E_INVALID" "invalid audit retention :: $value (7 to 3650 days)"
		fi
		;;
	AUDIT_SYSLOG)
		if [ "$value" != 'yes' ] && [ "$value" != 'no' ]; then
			check_result "$E_INVALID" "invalid audit syslog :: $value (yes or no)"
		fi
		;;
esac
#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

change_sys_value "$key" "$value"

# Sort configuration file in alphabetical order on change
sort $ARCPANEL/conf/arcpanel.conf -o /tmp/updconf
mv $ARCPANEL/conf/arcpanel.conf $ARCPANEL/conf/arcpanel.conf.bak
mv /tmp/updconf $ARCPANEL/conf/arcpanel.conf
rm -f $ARCPANEL/conf/arcpanel.conf.bak
# Again after the sort: a reader between the two moves found no file
sys_config_changed

# The panel's PHP pool may read the backup folder only (E39 W5 L15)
if [ "$key" = 'BACKUP' ]; then
	# shellcheck source=/usr/local/arcpanel/func/panel-headers.sh
	source "$ARCPANEL/func/panel-headers.sh"
	panel_php_basedir_write
	if [ "$PANEL_PHP_CHANGED" = yes ]; then
		panel_php_reload
	fi
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "System" "System configuration value changed (Key: $key, Value: $value)."
log_event "$OK" "$ARGUMENTS"

exit
