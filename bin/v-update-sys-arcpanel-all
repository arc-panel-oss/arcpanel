#!/bin/bash
# info: update all arcpanel packages
# options: [MODE]
#
# example: v-update-sys-arcpanel-all
# example: v-update-sys-arcpanel-all auto
#
# This function updates every ArcPanel package to its newest version. With the
# mode auto, which the automatic update cron line uses, it stays on the
# installed release line X.Y (docs/features/specs/2026-10-20-005-e33-update-center-phase-1-design.md
# §6): it installs the newest patch release of that line, updates the engine
# packages only while no newer line is available, and announces a newer line
# to the administrator once per version (panel notification and, with
# UPGRADE_SEND_EMAIL, an e-mail). In auto mode the output goes to
# $ARCPANEL/log/autoupdate.log and only an error is printed. Both modes fail
# when the ArcPanel APT source or its keyring is missing or apt cannot read the
# repository; auto mode then also notifies the administrator once.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
mode=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/updates.sh
source $ARCPANEL/func/updates.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# The packages of this server: the engines and, when installed, the web terminal
installed_packages() {
	echo arcpanel arcpanel-nginx arcpanel-php
	if dpkg-query -W -f='${Status}' arcpanel-web-terminal 2> /dev/null | grep -q 'install ok installed'; then
		echo arcpanel-web-terminal
	fi
}

# With UPGRADE_SEND_EMAIL, mails standard input to the administrator under SUBJECT
mail_admin() {
	local subject="$1" admin_email
	if [ "$UPGRADE_SEND_EMAIL" != "true" ]; then
		return 0
	fi
	admin_email=$($BIN/v-list-user "${ROOT_USER:-admin}" json | grep '"CONTACT"' | cut -d'"' -f4)
	if [ -n "$admin_email" ]; then
		$ARCPANEL/lib/mail-wrapper.php -s "$subject" "$admin_email" > /dev/null 2>&1
	fi
}

# Announces VERSION of a newer line than LINE to the administrator once
announce_line() {
	local version="$1" line="$2" admin="${ROOT_USER:-admin}" notified
	if upd_in_list "$version" "${UPDATE_NOTIFIED_VERSION:-}"; then
		return 0
	fi
	$BIN/v-add-user-notification "$admin" "ArcPanel $version is available" \
		"<p>ArcPanel <b>$version</b> is a new release line. Automatic updates install only patch releases of ArcPanel $line, so this one waits for you.</p><p>Read the release notes, then update from Server › Updates.</p>" > /dev/null 2>&1
	{
		echo "ArcPanel $version is available on $HOSTNAME."
		echo
		echo "Automatic updates install only patch releases of the installed line, ArcPanel $line,"
		echo "so this release waits for you. Read the release notes first:"
		echo "https://arcpanel.org/changelog"
		echo
		echo "Then update from Server > Updates in the panel."
	} | mail_admin "ArcPanel $version is available"
	notified="${UPDATE_NOTIFIED_VERSION:+$UPDATE_NOTIFIED_VERSION,}$version"
	$BIN/v-change-sys-config-value 'UPDATE_NOTIFIED_VERSION' "$notified" > /dev/null
	echo "Announced ArcPanel $version"
}

# Tells the administrator that automatic updates cannot read the ArcPanel
# repository, for the reason PROBLEM. A notification with the same topic that
# is still in the administrator's list is not added again; the e-mail goes with
# each new notification.
notify_repository() {
	local problem="$1" admin="${ROOT_USER:-admin}"
	local topic='Automatic updates cannot read the ArcPanel repository'
	if $BIN/v-list-user-notifications "$admin" json 2> /dev/null | grep -qF "\"TOPIC\": \"$topic\""; then
		return 0
	fi
	$BIN/v-add-user-notification "$admin" "$topic" \
		"<p>$problem</p><p>Until this is fixed, this server gets no ArcPanel updates. The details and how to restore the repository are in $ARCPANEL/log/autoupdate.log.</p>" > /dev/null 2>&1
	{
		echo "The automatic update of ArcPanel on $HOSTNAME failed:"
		echo
		echo "$problem"
		echo
		echo "Until this is fixed, this server gets no ArcPanel updates."
		echo "The details and how to restore the repository are in $ARCPANEL/log/autoupdate.log."
	} | mail_admin "$topic"
	echo "Notified $admin"
}

# The automatic update: patch releases of the installed line only
auto_update() {
	local installed line target newer package out rc=0
	installed="${VERSION:-$(upd_upstream_version "$(dpkg-query -W -f='${Version}' arcpanel)")}"
	line="$(upd_version_line "$installed")"

	out="$(upd_apt_update)" || rc=$?
	[ -z "$out" ] || echo "$out"
	if [ "$rc" -ne 0 ]; then
		notify_repository "$(grep -m1 '^Error: ' <<< "$out" | cut -c8-)"
		return "$rc"
	fi

	read -r target newer < <(apt-cache madison arcpanel | awk -F'|' '{gsub(/ /, "", $2); print $2}' \
		| upd_pick_versions "$installed")
	[ "$target" = - ] && target=''
	[ "$newer" = - ] && newer=''

	echo "Installed $installed, line $line, patch release: ${target:-none}, newer line: ${newer:-none}"
	if [ -n "$target" ]; then
		$BIN/v-update-sys-arcpanel arcpanel "$target" || rc=$?
	fi
	if [ -n "$newer" ]; then
		announce_line "$newer" "$line"
		echo "Engine packages stay with ArcPanel $line"
	else
		for package in $(installed_packages); do
			[ "$package" = arcpanel ] && continue
			$BIN/v-update-sys-arcpanel "$package" || rc=$?
		done
	fi
	return "$rc"
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ -n "$mode" ] && [ "$mode" != 'auto' ]; then
	check_result "$E_INVALID" "invalid mode $mode (auto or none)"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ "$mode" = 'auto' ]; then
	log="$ARCPANEL/log/autoupdate.log"
	{
		echo "=== $(date '+%F %T') automatic update"
		auto_update
	} >> "$log" 2>&1
	rc=$?
	if [ "$rc" -ne 0 ]; then
		echo "Error: the automatic update of ArcPanel failed, see $log"
		log_event "$rc" "$ARGUMENTS"
		exit "$rc"
	fi
else
	# Stop at once, with one error, when the repository cannot be read; a
	# package that fails to update does not keep the others back
	upd_apt_update
	rc=$?
	if [ "$rc" -eq 0 ]; then
		for package in $(installed_packages); do
			$BIN/v-update-sys-arcpanel "$package" || rc=$?
		done
	fi
	if [ "$rc" -ne 0 ]; then
		log_event "$rc" "$ARGUMENTS"
		exit "$rc"
	fi
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
