#!/bin/bash
# info: update arcpanel package/configs
# options: PACKAGE [VERSION]
#
# example: v-update-sys-arcpanel arcpanel-php
# example: v-update-sys-arcpanel arcpanel 2.2.2-1+ubuntu24.04
#
# This function installs the newest version of an ArcPanel package from the
# ArcPanel APT repository, or VERSION when given (the repository keeps every
# version, docs/features/specs/2026-10-20-005-e33-update-center-phase-1-design.md
# §6). Valid packages: arcpanel, arcpanel-nginx, arcpanel-php and
# arcpanel-web-terminal. The output of apt-get is printed.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
package=$1
version=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Checking arg number
check_args '1' "$#" 'PACKAGE [VERSION]'
is_arcpanel_package "arcpanel arcpanel-nginx arcpanel-php arcpanel-web-terminal" "$package"
if [ -n "$version" ] && ! [[ "$version" =~ ^[0-9][0-9A-Za-z.+~-]*$ ]]; then
	check_result "$E_INVALID" "invalid package version $version"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Update repo
apt-get update -o Dir::Etc::sourcelist="sources.list.d/arcpanel.list" \
	-o Dir::Etc::sourceparts="-" -o APT::Get::List-Cleanup="0" -qq

# Update arcpanel package; keep changed configuration files, never ask
target="$package"
if [ -n "$version" ]; then
	target="$package=$version"
fi
DEBIAN_FRONTEND=noninteractive apt-get install -y -q \
	-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$target" 2>&1
check_result $? "$package update failed" "$E_UPDATE"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
