#!/bin/bash
# info: update hestia package/configs (alias of v-update-sys-hestia)
# options: PACKAGE
#
# example: v-update-sys-arcpanel
#
# ArcPanel name for v-update-sys-hestia. It runs the original command with the same
# arguments, so output, exit codes and logging are identical (ADR-0006).

exec "$(dirname "$(readlink -f "$0")")/v-update-sys-hestia" "$@"
