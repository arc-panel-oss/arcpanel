#!/bin/bash
# info: update arcpanel package/configs
# options: PACKAGE
#
# example: v-update-sys-arcpanel arcpanel-php
#
# This function runs as apt update trigger. It pulls shell script from arcpanel
# server and runs it. (arcpanel, arcpanel-nginx and arcpanel-php are valid options)

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
package=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Checking arg number
check_args '1' "$#" 'PACKAGE'
is_arcpanel_package "arcpanel arcpanel-nginx arcpanel-php" "$package"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Update repo
apt-get update -o Dir::Etc::sourcelist="sources.list.d/arcpanel.list" \
	-o Dir::Etc::sourceparts="-" -o APT::Get::List-Cleanup="0" -qq

# Update arcpanel package
apt-get install $package -qq > /dev/null 2>&1
check_result $? "$package update failed" "$E_UPDATE"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
