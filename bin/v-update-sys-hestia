#!/bin/bash
# info: update hestia package/configs
# options: PACKAGE
#
# example: v-update-sys-hestia arcpanel-php
#
# This function runs as apt update trigger. It pulls shell script from hestia
# server and runs it. (arcpanel, arcpanel-nginx and arcpanel-php are valid options;
# the old hestia names are accepted and mapped to the arcpanel packages)

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
package=$1

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Checking arg number
check_args '1' "$#" 'PACKAGE'
is_hestia_package "arcpanel arcpanel-nginx arcpanel-php hestia hestia-nginx hestia-php" "$package"

# Map old package names to the ArcPanel packages (ADR-0006)
package="${package/#hestia/arcpanel}"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Update repo
apt-get update -o Dir::Etc::sourcelist="sources.list.d/arcpanel.list" \
	-o Dir::Etc::sourceparts="-" -o APT::Get::List-Cleanup="0" -qq

# Update hestia package
apt-get install $package -qq > /dev/null 2>&1
check_result $? "$package update failed" "$E_UPDATE"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
