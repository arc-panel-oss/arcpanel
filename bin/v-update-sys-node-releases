#!/bin/bash
# info: refresh the Node.js release index (E13)
# options: NONE
#
# example: v-update-sys-node-releases
#
# This function downloads index.json from the Node.js release server and the
# release schedule (LTS and end-of-life dates) into the cache. A failed
# download keeps the files of the last successful run.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/node.sh
source $ARCPANEL/func/node.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

node_with_cache_lock index node_releases_refresh
check_result $? "Could not download the release index from $(node_url_host "$(node_releases_url)")" "$E_CONNECT"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
