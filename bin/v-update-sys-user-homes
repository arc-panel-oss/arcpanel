#!/bin/bash
# info: bring user homes to the current layout (E39 W1)
# options: [USER]
#
# example: v-update-sys-user-homes
#
# This function removes from the homes of users what older versions left
# there for root to manage: the private key of the legacy file manager in
# ~/.ssh, its line in authorized_keys and the ACL that let arcpanelweb into
# ~/.ssh. Every change in a home runs as the user. Without USER it works on
# every user. It is safe to run on every upgrade.
# See docs/features/specs/2026-10-10-001-e39-w1-root-in-user-paths-design.md.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
only_user=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# The legacy file manager key of USER's home, removed as the user
homes_drop_filemanager_key() {
	local ssh_dir="$HOMEDIR/$user/.ssh"
	if ! user_exec test -d "$ssh_dir" 2> /dev/null; then
		return 0
	fi
	user_exec rm -f -- "$ssh_dir/arcpanel-filemanager-key" "$ssh_dir/arcpanel-filemanager-key.pub"
	if user_exec grep -qs 'filemanager\.ssh\.key$' "$ssh_dir/authorized_keys"; then
		user_exec sh -c 'umask 077
t=$(mktemp "$1/.authorized_keys.XXXXXX") || exit 1
grep -v "filemanager\.ssh\.key\$" "$1/authorized_keys" > "$t"
chmod --reference="$1/authorized_keys" "$t" && mv -f "$t" "$1/authorized_keys" || rm -f "$t"' sh "$ssh_dir"
	fi
	if command -v setfacl > /dev/null 2>&1; then
		user_exec setfacl -x u:arcpanelweb "$ssh_dir" > /dev/null 2>&1
	fi
	return 0
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "$(id -u)" != '0' ]; then
	echo "Error: v-update-sys-user-homes can only be executed by the root user"
	exit "$E_FORBIDEN"
fi
if [ -n "$only_user" ]; then
	is_user_format_valid "$only_user" 'user'
	is_object_valid 'user' 'USER' "$only_user"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

for user_dir in "$ARCPANEL"/data/users/*/; do
	user=$(basename -- "$user_dir")
	if [ -n "$only_user" ] && [ "$user" != "$only_user" ]; then
		continue
	fi
	if ! getent passwd "$user" > /dev/null 2>&1; then
		continue
	fi
	homes_drop_filemanager_key
done

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
