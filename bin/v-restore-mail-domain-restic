#!/bin/bash
# info: restore mail domain
# options: USER SNAPSHOT DOMAIN [NOTIFY]
#
# example: v-restore-mail-domain-restic user snapshot domain.com
# example: v-restore-mail-domain-restic user snapshot 'domain.com,domain2.com'
# example: v-restore-mail-domain-restic user snapshot '*'
#
# This function for restoring mail domains from restic snapshot. Names,
# records and certificates read from the snapshot are validated; the
# mailboxes are copied into the home as the user (E39 W1).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
mail=$3
notify=${4-no}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/backup-driver.sh
source $ARCPANEL/func/backup-driver.sh
# shellcheck source=/usr/local/arcpanel/func/backup-job.sh
source $ARCPANEL/func/backup-job.sh
# shellcheck source=/usr/local/arcpanel/func/domain.sh
source $ARCPANEL/func/domain.sh
# shellcheck source=/usr/local/arcpanel/func/ip.sh
source $ARCPANEL/func/ip.sh
# shellcheck source=/usr/local/arcpanel/func/rebuild.sh
source $ARCPANEL/func/rebuild.sh
# shellcheck source=/usr/local/arcpanel/func/syshealth.sh
source $ARCPANEL/func/syshealth.sh
# shellcheck source=/usr/local/arcpanel/func/safe-fs.sh
source $ARCPANEL/func/safe-fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

args_usage='USER SNAPSHOT DOMAIN [NOTIFY]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user' 'snapshot'
is_object_valid 'user' 'USER' "$user"

# The user's repository on the destination that holds the snapshot (E48)
restic_select "$user" "$snapshot"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

safe_workdir restore-mail
tmpdir=$SAFE_WORKDIR
read_snapshot_index "$tmpdir" "$snapshot"
check_result $? "Unable to download snapshot"

domains=""
IFS=',' read -r -a domains <<< "$MAIL"

# Checking exim username for later chowning
exim_user="exim"
check_exim_username=$(grep -c '^Debian-exim:' /etc/passwd)
if [ "$check_exim_username" -eq 1 ]; then
	exim_user="Debian-exim"
fi

for domain in "${domains[@]}"; do
	if [[ ",$mail," == *",$domain,"* || "$mail" = '*' ]]; then
		if ! is_restore_name_valid domain "$domain"; then
			restore_skip "mail domain" "$domain" "invalid name"
			continue
		fi

		# Checking domain existance
		check_config=$(grep -F "DOMAIN='$domain'" $USER_DATA/mail.conf)
		if [ -z "$check_config" ]; then
			check_new=$(is_domain_new 'mail' $domain)
			if [ "$check_new" = 'yes' ]; then
				error="$domain belongs to another user"
				echo "$error" | $SENDMAIL -s "$subj" $email $notify
				sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
				check_result "$E_PARSING" "$error"
			fi
		fi

		restic_restore_config "$tmpdir" "$snapshot" --include="/home/$user/backup/mail/$domain"
		check_result $? "Unable to download domain from snapshot"
		src="$tmpdir/home/$user/backup/mail/$domain"

		# Restoring mail.conf
		if [ -z "$check_config" ]; then
			restore_record_reset mail
			if ! parse_backup_record "$(restore_record_keys mail)" "$(head -n 1 -- "$src/arcpanel/mail.conf" 2> /dev/null)"; then
				restore_skip "mail domain" "$domain" "invalid record"
				continue
			fi
			DOMAIN=$domain
			str=$(restore_record mail "SUSPENDED='no' TIME='$(date +%T)' DATE='$(date +%F)'")
			if [ -z "$str" ]; then
				restore_skip "mail domain" "$domain" "invalid record"
				continue
			fi
			echo "$str" >> $USER_DATA/mail.conf
		fi

		# Restoring DKIM
		if [ -f "$src/arcpanel/$domain.pem" ]; then
			copy_from_work "$src/arcpanel/$domain.pem" "$USER_DATA/mail/$domain.pem"
			copy_from_work "$src/arcpanel/$domain.pub" "$USER_DATA/mail/$domain.pub"
		fi

		# Restore SSL
		check_config=$(grep -F "DOMAIN='$domain'" $USER_DATA/mail.conf | grep -o "SSL='yes'")
		if [ -n "$check_config" ]; then
			if [ ! -e "$ARCPANEL/data/users/$user/ssl/" ]; then
				mkdir -p $ARCPANEL/data/users/$user/ssl/
			fi

			# Add certificate to ArcPanel user configuration data directory
			ssl_src=''
			if [ -f "$src/arcpanel/ssl/$domain.crt" ]; then
				ssl_src="$src/arcpanel/ssl"
			elif [ -f "$src/conf/ssl/$domain.crt" ]; then
				ssl_src="$src/conf/ssl"
			fi
			if [ -n "$ssl_src" ]; then
				copy_from_work "$ssl_src/$domain.crt" "$USER_DATA/ssl/mail.$domain.crt"
				copy_from_work "$ssl_src/$domain.key" "$USER_DATA/ssl/mail.$domain.key"
				copy_from_work "$ssl_src/$domain.crt" "$USER_DATA/ssl/mail.$domain.pem"
				if copy_from_work "$ssl_src/$domain.ca" "$USER_DATA/ssl/mail.$domain.ca"; then
					echo >> $USER_DATA/ssl/mail.$domain.pem
					cat $USER_DATA/ssl/mail.$domain.ca >> $USER_DATA/ssl/mail.$domain.pem
				fi
			fi

			chmod 660 $USER_DATA/ssl/mail.$domain.*

			# Add certificate to the configuration folder in the home, which
			# root owns down from ~/conf
			ssl_dir="$HOMEDIR/$user/conf/mail/$domain/ssl"
			if [ ! -d "$HOMEDIR/$user/conf/mail/$domain" ]; then
				mkdir -p "$HOMEDIR/$user/conf/mail/$domain"
			fi
			if ! root_dir_safe "$HOMEDIR/$user/conf/mail/$domain"; then
				restore_skip "mail certificate of" "$domain" "$HOMEDIR/$user/conf/mail/$domain is not root's"
			else
				if [ ! -d "$ssl_dir" ] || [ -L "$ssl_dir" ]; then
					rm -f -- "$ssl_dir"
					mkdir -- "$ssl_dir"
				fi
				for ext in crt key pem ca; do
					copy_from_work "$USER_DATA/ssl/mail.$domain.$ext" "$ssl_dir/$domain.$ext"
				done

				if [ ! -d /etc/dovecot/conf.d/domains ]; then
					mkdir /etc/dovecot/conf.d/domains
				fi

				# Add domain SSL configuration to dovecot
				if [ -f /etc/dovecot/conf.d/domains/$domain.conf ]; then
					rm -f /etc/dovecot/conf.d/domains/$domain.conf
				fi

				dovecot_version="$(dovecot --version | cut -f -2 -d .)"
				if [[ "$dovecot_version" = "2.4" ]]; then
					echo "" >> /etc/dovecot/conf.d/domains/$domain.conf
					echo "local_name mail.$domain {" >> /etc/dovecot/conf.d/domains/$domain.conf
					echo "  sssl_server_cert_file = $ssl_dir/$domain.pem" >> /etc/dovecot/conf.d/domains/$domain.conf
					echo "  ssl_server_key_file = $ssl_dir/$domain.key" >> /etc/dovecot/conf.d/domains/$domain.conf
					echo "}" >> /etc/dovecot/conf.d/domains/$domain.conf
				else
					echo "" >> /etc/dovecot/conf.d/domains/$domain.conf
					echo "local_name mail.$domain {" >> /etc/dovecot/conf.d/domains/$domain.conf
					echo "  ssl_cert = <$ssl_dir/$domain.pem" >> /etc/dovecot/conf.d/domains/$domain.conf
					echo "  ssl_key = <$ssl_dir/$domain.key" >> /etc/dovecot/conf.d/domains/$domain.conf
					echo "}" >> /etc/dovecot/conf.d/domains/$domain.conf
				fi

				if [ ! -d /usr/local/arcpanel/ssl/mail ]; then
					mkdir /usr/local/arcpanel/ssl/mail
				fi

				# Add domain SSL configuration to exim4
				# Cleanup broken symlinks
				find /usr/local/arcpanel/ssl/mail -xtype l -delete

				ln -s -f $ssl_dir/$domain.pem /usr/local/arcpanel/ssl/mail/mail.$domain.crt
				ln -s -f $ssl_dir/$domain.key /usr/local/arcpanel/ssl/mail/mail.$domain.key

				# Set correct permissions on certificates
				chmod 750 "$ssl_dir"
				chown -hR $MAIL_USER:mail "$ssl_dir"
				chmod 0644 "$ssl_dir"/*
				chown -h $user:mail "$ssl_dir"/*
				chmod -R 0644 /usr/local/arcpanel/ssl/mail/*
				chown -h $user:mail /usr/local/arcpanel/ssl/mail/*
			fi
		fi

		# Restoring email accounts
		dropped=$(restore_records_file mailacc "$src/arcpanel/$domain.conf" "$USER_DATA/mail/$domain.conf")
		if [ "${dropped:-0}" -gt 0 ]; then
			restore_skip "mail accounts of" "$domain" "$dropped invalid records"
		fi

		domain_idn=$domain
		format_domain_idn

		# ~/mail belongs to root, so root may create the domain folder in it;
		# the mailboxes are copied into it by the user
		if [ ! -e "$HOMEDIR/$user/mail/$domain_idn" ] && [ ! -L "$HOMEDIR/$user/mail/$domain_idn" ]; then
			mkdir "$HOMEDIR/$user/mail/$domain_idn"
			chown -h "$user:mail" "$HOMEDIR/$user/mail/$domain_idn"
			chmod 770 "$HOMEDIR/$user/mail/$domain_idn"
		fi

		restic_restore_data "$tmpdir" "$snapshot" --include="/home/$user/mail/$domain_idn"
		check_result $? "Unable to download user data"
		if [ -d "$tmpdir/home/$user/mail/$domain_idn" ]; then
			copy_into_home "$tmpdir/home/$user/mail/$domain_idn" "$HOMEDIR/$user/mail/$domain_idn"
			check_result $? "the mailboxes could not be copied into the home" "$E_FORBIDEN"
			rm -rf -- "$tmpdir/home/$user/mail/$domain_idn"
		fi

		# Chowning mail conf files to exim user
		if [ -d "$HOMEDIR/$user/conf/mail/$domain" ] && root_dir_safe "$HOMEDIR/$user/conf/mail/$domain"; then
			find "$HOMEDIR/$user/conf/mail/$domain" -user root \
				-exec chown -h $exim_user {} \;
		fi

		$BIN/v-rebuild-mail-domain "$user" "$domain"
	fi
done
#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

safe_workdir_cleanup

# Update user counters
$BIN/v-update-user-counters $user
$BIN/v-update-user-counters "$ROOT_USER"
$BIN/v-update-sys-ip-counters

sed -i "/v-restore-mail-domain-restic '$user' '$snapshot' '$mail' /d" $ARCPANEL/data/queue/backup.pipe

# Logging
$BIN/v-log-action "system" "Info" "Backup" "Mail domain successfully restored (User: $user, Snapshot: $snapshot, Domain: $mail)."
$BIN/v-log-action "$user" "Info" "Backup" "Mail domain successfully restored (User: $user, Snapshot: $snapshot, Domain: $mail)."
log_event "$OK" "$ARGUMENTS"
exit
