#!/bin/bash
# info: list all API access keys
# options: ACCESS_KEY_ID [FORMAT]
#
# example: v-list-access-key 1234567890ABCDefghij json

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
access_key_id="$1"
format="${2:-shell}"

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# JSON list function
json_list() {
	local PERMISSIONS_ARR='[]'
	if [[ -n "$PERMISSIONS" ]]; then
		PERMISSIONS_ARR="[\"$(echo "$PERMISSIONS" | sed -E 's|,|", "|g')\"]"
	fi

	local ALLOWED_IPS_ARR='[]'
	if [[ -n "$ALLOWED_IPS" ]]; then
		ALLOWED_IPS_ARR="[\"$(echo "$ALLOWED_IPS" | sed -E 's|,|", "|g')\"]"
	fi

	echo '{
    "ACCESS_KEY_ID": "'$access_key_id'",
    "SECRET_ACCESS_KEY": "'$SECRET_ACCESS_KEY'",
    "USER": "'$USER'",
    "PERMISSIONS": '$PERMISSIONS_ARR',
    "COMMENT": "'$COMMENT'",
    "TIME": "'$TIME'",
    "DATE": "'$DATE'",
    "ALLOWED_IPS": '$ALLOWED_IPS_ARR',
    "EXPIRES": "'$EXPIRES'"
}'
}

# SHELL list function
shell_list() {
	echo "ACCESS_KEY_ID:      $access_key_id"
	echo "SECRET_ACCESS_KEY:  $SECRET_ACCESS_KEY"
	echo "USER:               $USER"
	echo "PERMISSIONS:        $PERMISSIONS"
	echo "COMMENT:            $COMMENT"
	echo "TIME:               $TIME"
	echo "DATE:               $DATE"
	echo "ALLOWED_IPS:        $ALLOWED_IPS"
	echo "EXPIRES:            $EXPIRES"
}

plain_list() {
	echo $access_key_id:$SECRET_ACCESS_KEY
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'ACCESS_KEY_ID [FORMAT]'
is_format_valid 'access_key_id'
is_object_valid 'key' 'KEY' "$access_key_id"
if ! access_key_file_ok "${ARCPANEL}/data/access-keys/${access_key_id}"; then
	check_result "$E_FORBIDEN" "Access key $access_key_id is damaged"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Avoid "USER" receive "root" in old keys
USER="$ROOT_USER"
PERMISSIONS=""
COMMENT=""
DATE=""
TIME=""
ALLOWED_IPS=""
EXPIRES=""

source_conf "${ARCPANEL}/data/access-keys/${access_key_id}"

# Listing data
case $format in
	json) json_list ;;
	shell) shell_list ;;
	plain) plain_list ;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
