#!/bin/bash
# info: list the secrets of a user (E38)
# options: USER [FORMAT] [USAGE]
#
# example: v-list-user-secret-store alice json
#
# This function lists the secrets of USER with their description, current
# version, fingerprint (8 hex characters of a keyed hash of the value) and
# the number of apps that reference them. It never prints a value. With
# USAGE set to no, USED_BY stays empty and the apps are not read (the
# reference pickers of the panel need the names only).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
format=${2-shell}
usage=${3-yes}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# NAME|DESCRIPTION|VERSION|FINGERPRINT|USED_BY|TIME|DATE per secret
rows() {
	local line name refs
	if [ "$usage" != 'no' ]; then
		refs=$(secret_refs_of_user "$user")
	fi
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		name=$(secret_field "$line" NAME)
		echo "$name|$(secret_field "$line" DESCRIPTION)|$(secret_field "$line" VERSION)|$(secret_field "$line" FINGERPRINT)|$([ "$usage" != 'no' ] && secret_used_count "$refs" "$name")|$(secret_field "$line" TIME)|$(secret_field "$line" DATE)"
	done < <(grep "^ID=" "$(secret_index "$user")" 2> /dev/null | sort -t"'" -k4,4)
}

json_list() {
	local name description version fingerprint used time date i=0
	echo '{'
	while IFS='|' read -r name description version fingerprint used time date; do
		[ -n "$name" ] || continue
		if [ "$i" -gt 0 ]; then
			echo ','
		fi
		i=$((i + 1))
		printf '    %s: {\n' "$(secret_json_string "$name")"
		printf '        "NAME": %s,\n' "$(secret_json_string "$name")"
		printf '        "DESCRIPTION": %s,\n' "$(secret_json_string "$description")"
		printf '        "VERSION": "%s",\n' "$version"
		printf '        "FINGERPRINT": "%s",\n' "$fingerprint"
		printf '        "USED_BY": "%s",\n' "$used"
		printf '        "TIME": "%s",\n' "$time"
		printf '        "DATE": "%s"\n' "$date"
		printf '    }'
	done < <(rows)
	if [ "$i" -gt 0 ]; then
		echo
	fi
	echo '}'
}

shell_list() {
	echo "NAME VERSION FINGERPRINT USED_BY DATE"
	echo "---- ------- ----------- ------- ----"
	rows | awk -F'|' '{ print $1, $3, $4, $5, $7 }'
}

plain_list() {
	rows | tr '|' '\t'
}

csv_list() {
	echo "NAME,DESCRIPTION,VERSION,FINGERPRINT,USED_BY,TIME,DATE"
	rows | awk -F'|' -v OFS=',' '{ $2 = "\"" $2 "\""; print }'
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [FORMAT] [USAGE]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

case $format in
	json) json_list ;;
	plain) plain_list ;;
	csv) csv_list ;;
	shell) shell_list | column -t ;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
