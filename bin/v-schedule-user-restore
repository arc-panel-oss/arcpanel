#!/bin/bash
# info: schedule user backup restoration
# options: USER BACKUP [WEB] [DNS] [MAIL] [DB] [CRON] [UDIR] [FORMAT]
#
# example: v-schedule-user-restore 2019-04-22_01-00-00.tar
#
# This function for scheduling user backup restoration.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
backup=$2
web=$3
dns=$4
mail=$5
db=$6
cron=$7
udir=$8
format=shell

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/queuetask.sh
source $ARCPANEL/func/queuetask.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ "$#" -gt 9 ]; then
	check_result "$E_ARGS" "too many arguments"
fi
if [ "$#" -eq 9 ]; then
	format=$9
fi
check_args '2' "$#" 'USER BACKUP [WEB] [DNS] [MAIL] [DB] [CRON] [UDIR] [FORMAT]'
is_format_valid 'user' 'backup' 'format'
is_system_enabled "$BACKUP_SYSTEM" 'BACKUP_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_valid 'backup' 'BACKUP' "$2"
is_backup_enabled
is_backup_scheduled 'restore'

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Adding restore task to the queue
log="$ARCPANEL/log/restore.log"
queue_file="$ARCPANEL/data/queue/backup.pipe"
# Store a safely serialized command line for the legacy Bash queue consumer.
body=$(printf 'nice -n 19 ionice -c 3 %q %q %q %q %q %q %q %q %q yes >> %q 2>&1' \
	"$BIN/v-restore-user" \
	"$user" \
	"$backup" \
	"$web" \
	"$dns" \
	"$mail" \
	"$db" \
	"$cron" \
	"$udir" \
	"$log")
qt_queue restore "$backup" "$queue_file" "$body"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "Backup" "Restore of backup archive requested (User: $user, Archive: $backup)."
log_event "$OK" "$ARGUMENTS"

exit
