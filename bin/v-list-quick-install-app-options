#!/usr/local/arcpanel/php/bin/php
<?php
//# info: list the form of a Quick Install application for a web domain (E7 batch 2)
//# options: USER DOMAIN APP [FORMAT]
//#
//# example: v-list-quick-install-app-options alice example.com WordPress json
//#
//# This function prints APP, VERSION, ROOT_CLEAN (no when public_html holds
//# files the installer would overwrite) and FIELDS: KEY, TYPE (text,
//# password, boolean, select), LABEL, VALUE, PLACEHOLDER, OPTIONS (VALUE,
//# LABEL) and REQUIRED. The domain must belong to the user.

require_once __DIR__ . "/../func/quickinstall.php";

[$user, $domain, $app, $format] = [$argv[1] ?? "", $argv[2] ?? "", $argv[3] ?? "", $argv[4] ?? "shell"];
if ($app === "") {
	echo "Usage: v-list-quick-install-app-options USER DOMAIN APP [FORMAT]\n";
	exit(QI_E_ARGS);
}
if (!qi_valid_user($user) || !is_dir("/usr/local/arcpanel/data/users/$user")) {
	qi_fail(QI_E_NOTEXIST, "user $user does not exist");
}
if (!qi_valid_domain($domain)) {
	qi_fail(QI_E_INVALID, "invalid domain format :: $domain");
}
if (!qi_valid_app($app)) {
	qi_fail(QI_E_NOTEXIST, "installer $app does not exist");
}

qi_session($user);
qi_quiet_errors();
$arcpanel = new QiArcPanelApp();
$installer = qi_installer($app, $arcpanel);
if (!$installer->getInfo()->isInstallable()) {
	qi_fail(QI_E_INVALID, "Unable to install $app, required php version is not available.");
}
try {
	$wizard = new \ArcPanel\WebApp\AppWizard($installer, $domain, $arcpanel);
} catch (\Throwable) {
	qi_fail(QI_E_NOTEXIST, "web domain $domain does not exist for $user");
}

$result = [
	"APP" => $app,
	"VERSION" => $installer->getInfo()->version,
	"ROOT_CLEAN" => $wizard->isDomainRootClean() ? "yes" : "no",
	"FIELDS" => qi_fields($wizard->getOptions()),
];

if ($format === "json") {
	qi_print_json($result);
	exit(0);
}
echo "APP: {$result["APP"]}\nVERSION: {$result["VERSION"]}\nROOT_CLEAN: {$result["ROOT_CLEAN"]}\n";
foreach ($result["FIELDS"] as $field) {
	echo "{$field["KEY"]}\t{$field["TYPE"]}\t{$field["VALUE"]}\t{$field["REQUIRED"]}\n";
}
