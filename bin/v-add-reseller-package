#!/bin/bash
# info: add a package owned by a reseller
# options: RESELLER TMPFILE NAME
#
# example: v-add-reseller-package agency /tmp/package.XXXX starter
#
# This function adds the package RESELLER_NAME from TMPFILE (same format as
# v-add-user-package) for RESELLER, when POLICY_RESELLER_CREATE_PACKAGES is
# yes. No limit may be higher than the reseller's own limit.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
reseller=$1
tmpfile=$2
name=$3

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

package="${reseller}_${name}"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'RESELLER TMPFILE NAME'
is_user_format_valid "$reseller" 'reseller'
is_object_format_valid "$name" 'name'
is_format_valid 'package'
is_object_valid 'user' 'USER' "$reseller"
if ! tenancy_is_reseller "$reseller"; then
	check_result "$E_INVALID" "user $reseller is not a reseller"
fi
if [ "$POLICY_RESELLER_CREATE_PACKAGES" != 'yes' ]; then
	check_result "$E_DISABLED" "resellers may not create packages"
fi
if [ ! -f "$tmpfile" ]; then
	check_result "$E_NOTEXIST" "$tmpfile does not exist"
fi
if [ -e "$ARCPANEL/data/packages/$package.pkg" ]; then
	check_result "$E_EXISTS" "package $name already exists"
fi
exceeded=$(tenancy_check_package_limits "$reseller" "$tmpfile")
check_result $? "reseller plan has no room for $exceeded" "$E_LIMIT"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

$BIN/v-add-user-package "$tmpfile" "$package"
check_result $? "package $name was not created" > /dev/null

tenancy_pkg_set "$package" USERS '0'
tenancy_pkg_set "$package" RESELLER_VISIBLE 'no'
tenancy_pkg_set "$package" RESELLER_OWNER "$reseller"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

$BIN/v-log-action "$reseller" "Info" "Packages" "Package added (Name: $name)."
log_event "$OK" "$ARGUMENTS"

exit
