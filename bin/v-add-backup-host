#!/bin/bash
# info: add backup host
# options: TYPE HOST USERNAME PASSWORD [PATH] [PORT]
#
# example: v-add-backup-host sftp backup.acme.com admin 'P4$$w@rD'
#          v-add-backup-host b2 bucketName keyID applicationKey
#          v-add-backup-host local
#
# Add a remote backup location of the kind earlier versions knew: local,
# SFTP, FTP, Backblaze B2 or an rclone remote of root's rclone
# configuration. Since E48 the host is the backup destination named TYPE,
# and it becomes a target of the backup job "Nightly archives" (created
# when missing, daily at 05:10 for all users). For SFTP, PASSWORD may be a
# file with a private key; the server's host key is pinned on first use.
# The host is checked; it is not kept when the check fails. Use
# v-add-backup-destination for more destinations of a kind and for the
# other drivers.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
type=$1
host=$2
user=$3
password=$4
raw_password=$4
HIDE=4
path=${5-/backup}
port=$6

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/backup-driver.sh
source $ARCPANEL/func/backup-driver.sh
# shellcheck source=/usr/local/arcpanel/func/backup-job.sh
source $ARCPANEL/func/backup-job.sh
# shellcheck source=/usr/local/arcpanel/func/backup-legacy.sh
source $ARCPANEL/func/backup-legacy.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" "TYPE HOST USERNAME PASSWORD [PATH] [PORT]"
is_type_valid 'local,sftp,ftp,b2,rclone' "$type"
privatekey=no
if [ "$type" != 'local' ]; then
	check_args '2' "$#" "TYPE HOST USERNAME PASSWORD [PATH] [PORT]"
	if [ "$type" != b2 ]; then
		is_format_valid 'host'
	fi
	[ -n "$port" ] && is_format_valid 'port'
	if [ "$type" = ftp ] || [ "$type" = sftp ]; then
		is_username_format_valid "$user" "username"
		if [ -f "$raw_password" ] && grep -q "PRIVATE KEY" "$raw_password"; then
			privatekey=yes
		else
			is_password_valid
		fi
	elif [ "$type" = b2 ]; then
		is_password_valid
	fi
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

bd_check_keys
bd_session
options="$BD_RUN/options"
secrets="$BD_RUN/secrets"
mkdir -p "$secrets"
: > "$options"
case "$type" in
	local)
		printf "PATH='%s'\n" "${BACKUP:-/backup}" >> "$options"
		;;
	ftp | sftp)
		printf "HOST='%s'\nUSERNAME='%s'\n" "$host" "$user" >> "$options"
		[ -n "$port" ] && printf "PORT='%s'\n" "$port" >> "$options"
		[ -n "$path" ] && printf "PATH='%s'\n" "$path" >> "$options"
		# Earlier versions sent FTP without TLS
		[ "$type" = ftp ] && printf "TLS='none'\n" >> "$options"
		if [ "$privatekey" = yes ]; then
			cp -- "$raw_password" "$secrets/PRIVATE_KEY"
		else
			printf '%s' "$password" > "$secrets/PASSWORD"
		fi
		;;
	b2)
		printf "BUCKET='%s'\nKEY_ID='%s'\n" "$host" "$user" >> "$options"
		printf '%s' "$password" > "$secrets/APP_KEY"
		;;
	rclone)
		section=$(bl_rclone_section "$host")
		if [ -z "$section" ]; then
			check_result "$E_CONNECT" "Rclone config does not exist"
		fi
		printf '%s\n' "$section" > "$secrets/CONFIG"
		printf "REMOTE='%s'\n" "$host" >> "$options"
		# As given: earlier versions copied to HOST:PATH, so an absolute folder stays absolute
		[ -n "$path" ] && printf "PATH='%s'\n" "${path%/}" >> "$options"
		;;
esac
existed=no
bd_exists "$type" && existed=yes
out=$(bl_destination "$type" "$type" "$options" "$secrets" 2>&1)
check_result $? "$out"
# Archives of earlier versions are not encrypted; a host added this way
# keeps that until the administrator turns encryption on
if [ "$existed" = no ] && [ "$type" != local ]; then
	bd_set "$type" ENCRYPT=no
fi
if [ "$type" != local ] && ! bl_check "$type"; then
	error=$("$BIN/v-check-backup-destination" "$type" '' json 2> /dev/null | jq -r --arg n "$type" '.[$n].ERROR // empty')
	if [ "$existed" = no ]; then
		"$BIN/v-delete-backup-destination" "$type" > /dev/null 2>&1
	fi
	check_result "$E_CONNECT" "can't connect to the $type backup host${error:+: $error}"
fi
bl_target_set "$BL_ARCHIVE_JOB" archive daily:05:10 "$type:-1"
check_result $? "the backup job could not be changed"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

bd_sync_backup_system
$BIN/v-log-action "system" "Info" "Backup" "Added backup host (Type: $type)."
log_event "$OK" "$ARGUMENTS"

exit
