#!/bin/bash
# info: restore Database
# options: USER SNAPSHOT DATABASE
#
# example: v-restore-database-restic user snapshot user_database
# example: v-restore-database-restic user snapshot 'user_database,user_database2'
# example: v-restore-database-restic user snapshot '*'
#
# This function for restoring database from restic snapshot. The records and
# dumps of a snapshot are untrusted: names must carry the user's prefix, and
# the dump is imported with an account limited to the database (E39 W1).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
database=$3
notify=${4-no}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/backup-driver.sh
source $ARCPANEL/func/backup-driver.sh
# shellcheck source=/usr/local/arcpanel/func/backup-job.sh
source $ARCPANEL/func/backup-job.sh
# shellcheck source=/usr/local/arcpanel/func/db.sh
source $ARCPANEL/func/db.sh
# shellcheck source=/usr/local/arcpanel/func/rebuild.sh
source $ARCPANEL/func/rebuild.sh
# shellcheck source=/usr/local/arcpanel/func/syshealth.sh
source $ARCPANEL/func/syshealth.sh
# shellcheck source=/usr/local/arcpanel/func/safe-fs.sh
source $ARCPANEL/func/safe-fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

args_usage='USER SNAPSHOT DATABSE [NOTIFY]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user' 'snapshot'
is_object_valid 'user' 'USER' "$user"

# The user's repository on the destination that holds the snapshot (E48)
restic_select "$user" "$snapshot"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

safe_workdir restore-db
tmpdir=$SAFE_WORKDIR
read_snapshot_index "$tmpdir" "$snapshot"
check_result $? "Unable to download snapshot"
snapshot_mode=$BACKUP_MODE

IFS=',' read -r -a databases <<< "$DB"

for db in "${databases[@]}"; do
	if [[ ",$database," == *",$db,"* || "$database" = '*' ]]; then
		if ! is_restore_name_valid database "$db" || [[ "$db" != "${user}_"* ]]; then
			restore_skip database "$db" "invalid name"
			continue
		fi
		unset -v DB DBUSER MD5 HOST TYPE CHARSET U_DISK
		check_config=$(grep -F "DB='$db'" $USER_DATA/db.conf)
		if [ -z "$check_config" ]; then
			if is_database_of_other_user "$db"; then
				restore_skip database "$db" "belongs to another user"
				continue
			fi
			restic_restore_config "$tmpdir" "$snapshot" --include="/home/$user/backup/db/$db/arcpanel/db.conf"
			check_result $? "Unable to download user data"
			if ! parse_backup_record "$(restore_record_keys db)" "$(head -n 1 -- "$tmpdir/home/$user/backup/db/$db/arcpanel/db.conf" 2> /dev/null)"; then
				restore_skip database "$db" "invalid record"
				continue
			fi
			DB=$db
			if ! is_restore_database_valid; then
				restore_skip database "$db" "invalid user, type, host or charset"
				continue
			fi
			str=$(restore_record db "SUSPENDED='no' TIME='$(date +%T)' DATE='$(date +%F)'")
			if [ -z "$str" ]; then
				restore_skip database "$db" "invalid record"
				continue
			fi
			echo "$str" >> $USER_DATA/db.conf
		else
			parse_object_kv_list "$check_config"
		fi

		# Download database
		if [ "$snapshot_mode" = "zstd" ]; then
			ext=zst
		else
			ext=gz
		fi
		restic_restore_config "$tmpdir" "$snapshot" --include="/home/$user/backup/db/$db/$db.$TYPE.sql.$ext"
		check_result $? "Unable to download database"
		dump="$tmpdir/home/$user/backup/db/$db/$db.$TYPE.sql"
		if [ ! -f "$dump.$ext" ]; then
			restore_skip database "$db" "no dump in the snapshot"
			continue
		fi
		if [ "$ext" = zst ]; then
			pzstd -q -d "$dump.$ext"
		else
			gzip -d "$dump.$ext"
		fi

		# Restore and rebuild
		echo "- Restore database: $db (Type: $TYPE)"
		case $TYPE in
			mysql)
				delete_mysql_database
				rebuild_mysql_database
				;;
			pgsql)
				delete_pgsql_database
				rebuild_pgsql_database
				;;
		esac
		restore_import_database "$dump"
		if [ $? -ne 0 ]; then
			echo "[ ! ] The dump of $db was not imported completely"
		fi
	fi
done

safe_workdir_cleanup
#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Update user counters
$BIN/v-update-user-counters $user
$BIN/v-update-user-counters "$ROOT_USER"
$BIN/v-update-sys-ip-counters

sed -i "/v-restore-database-restic '$user' '$snapshot' '$database' /d" $ARCPANEL/data/queue/backup.pipe

# Logging
$BIN/v-log-action "system" "Info" "Backup" "Database successfully restored (User: $user, Snapshot: $snapshot, Databse: $database)."
$BIN/v-log-action "$user" "Info" "Backup" "Database successfully restored (User: $user, Snapshot: $snapshot, Databse: $database)."
log_event "$OK" "$ARGUMENTS"
exit
