#!/bin/bash
# info: delete the object storage of a user
# options: USER
#
# example: v-delete-user-object-storage alice
#
# This function deletes every bucket of USER with its objects, every S3 key,
# the object storage user and its policy. v-delete-user runs it.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/silo.sh
source $ARCPANEL/func/silo.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user'
if [ ! -f "$(silo_buckets_file "$user")" ] && [ ! -f "$(silo_keys_file "$user")" ]; then
	exit
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

silo_lock
buckets=$(silo_buckets "$user" | paste -sd ' ' -)
keys=$(silo_keys "$user" | paste -sd ' ' -)
rm -f "$(silo_buckets_file "$user")" "$(silo_keys_file "$user")"
# What Silo does not remove now, because it does not answer or fails, is
# kept for the repair, which removes it once Silo answers; otherwise the
# buckets and the keys would keep working without an account
if silo_installed && { ! silo_wait || ! silo_purge "$user" "$buckets" "$keys"; }; then
	silo_orphan_add "$user" "$buckets" "$keys"
	echo "Warning: object storage did not remove the buckets and S3 keys of $user; the next repair removes them" >&2
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

log_event "$OK" "$ARGUMENTS"

exit
