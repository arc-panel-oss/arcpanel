#!/bin/bash
# info: unsuspend firewall rule
# options: RULE
#
# example: v-unsuspend-firewall-rule 7
#
# This function unsuspends a certain firewall rule.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
rule=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/firewall.sh
source $ARCPANEL/func/firewall.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'RULE'
is_format_valid 'rule'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'
is_object_valid '../../../data/firewall/rules' 'RULE' "$rule"
is_object_suspended '../../../data/firewall/rules' 'RULE' "$rule"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# The rules before the change, put back when the load fails
fw_keep_rules

# Suspending rule
update_object_value '../../../data/firewall/rules' 'RULE' "$rule" '$SUSPENDED' "no"

# Updating system firewall; a table nft refuses fails the command
fw_apply_rules

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "Firewall" "Unsuspended firewall rule (Rule: $rule)."
log_event "$OK" "$ARGUMENTS"

exit
