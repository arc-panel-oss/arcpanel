#!/bin/bash
# info: add directory
# options: USER DIRECTORY
#
# example: v-add-fs-directory admin /home/admin/mybar
#
# This function creates new directory on the file system, with its missing
# parents, as the user. The path must be absolute and inside the user's home.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

user=$1
dst_dir=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/fs.sh
source $ARCPANEL/func/fs.sh

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DIR'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

# Checking destination path: inside the home, missing parents allowed
fs_check_new_path "$dst_dir"

# The folder that receives a new directory must be writable
if [ ! -d "$dst_dir" ]; then
	fs_check_writable_parent "$dst_dir"
fi

# Adding directory
user_exec mkdir -p -- "$dst_dir" > /dev/null 2>&1
if [ $? -ne 0 ]; then
	echo "Error: directory $dst_dir was not created"
	exit 3
fi

# Exiting
exit
