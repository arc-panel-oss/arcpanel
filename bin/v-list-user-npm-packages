#!/bin/bash
# info: list the global npm packages of a user (E13)
# options: USER VERSION [FORMAT]
#
# example: v-list-user-npm-packages alice 24.3.0 json
#
# This function lists the global packages of the runtime VERSION: NAME,
# VERSION, LATEST and OUTDATED (from the last v-check-user-npm-outdated when
# it is younger than 6 hours, else empty) and BUNDLED (npm and corepack come
# with Node.js). CHECKED is the time of that check.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
version=${2#v}
format=${3-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/node.sh
source $ARCPANEL/func/node.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER VERSION [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

[ -z "$HOMEDIR" ] && check_result "$E_NOTEXIST" "ArcPanel environment vars not present"

if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
	check_result "$E_INVALID" "invalid version :: $version"
fi
if ! node_version_installed "$user" "$version"; then
	check_result "$E_NOTEXIST" "Node.js v$version is not installed"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

outdated='{}'
checked=''
if node_outdated_fresh "$user" "$version"; then
	file=$(node_outdated_file "$user" "$version")
	outdated=$(jq -c 'if type == "object" then . else {} end' "$file" 2> /dev/null || echo '{}')
	checked=$(date -d "@$(stat -c %Y "$file")" +'%F %T')
fi

json=$(node_packages_lines "$user" "$version" | jq -sc \
	--arg user "$user" --arg version "$version" --arg checked "$checked" \
	--argjson outdated "$outdated" '
	map(select(.name != ""))
	| sort_by(.name)
	| map(.name as $n | ($outdated[$n] // null) as $o | {
		NAME: $n,
		VERSION: .version,
		LATEST: (if $o then ($o.latest // "") else "" end),
		OUTDATED: (if $checked == "" then "" elif $o and ($o.latest // .version) != .version then "yes" else "no" end),
		BUNDLED: (if $n == "npm" or $n == "corepack" then "yes" else "no" end)
	})
	| { USER: $user, VERSION: $version, CHECKED: $checked, PACKAGES: . }')

node_print "$format" "$json" '.PACKAGES' 'NAME VERSION LATEST OUTDATED BUNDLED'

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
