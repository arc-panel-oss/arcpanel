#!/bin/bash
# info: show the current or last system task (E7 batch 3)
# options: [LINES] [FORMAT]
#
# example: v-list-sys-task 100 json
#
# This function prints the newest job of a sys.KIND type (E15) in the format
# of the system task record (ID, KIND, ARGS, STATUS, EXIT, START, END) and
# the last LINES lines of its output (default 100, at most 1000). STATUS is
# running, done or failed; a running task whose runner is gone is reported,
# and stored, as failed. Without a task, STATUS is empty.
# Deprecated in 3.0.0: read the job with v-list-job; removed in 3.1.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
lines=${1-100}
format=${2-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/systask.sh
source $ARCPANEL/func/systask.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [[ ! "$lines" =~ ^[0-9]{1,4}$ ]] || [ "$lines" -lt 1 ] || [ "$lines" -gt 1000 ]; then
	check_result "$E_INVALID" "invalid number of lines :: $lines (1 to 1000)"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

st_task_reap
id=$(st_task_id || true)
log=''
if [ -n "$id" ]; then
	log=$(job_log_tail "$id" "$lines")
fi

json=$(jq -nc --arg id "$(st_task_get ID)" --arg kind "$(st_task_get KIND)" \
	--arg args "$(st_task_get ARGS)" --arg status "$(st_task_get STATUS)" \
	--arg exit "$(st_task_get EXIT)" --arg start "$(st_task_get START)" \
	--arg end "$(st_task_get END)" --arg log "$log" '
	{ ID: $id, KIND: $kind, ARGS: $args, STATUS: $status, EXIT: $exit,
		START: $start, END: $end, LOG: $log }')

case "$format" in
	json) printf '%s\n' "$json" | jq . ;;
	*)
		printf '%s\n' "$json" | jq -r 'to_entries[] | select(.key != "LOG") | "\(.key): \(.value)"'
		echo
		printf '%s\n' "$log"
		;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
