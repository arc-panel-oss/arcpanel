#!/bin/bash
# info: show the current or last system task (E7 batch 3)
# options: [LINES] [FORMAT]
#
# example: v-list-sys-task 100 json
#
# This function prints the task record (ID, KIND, ARGS, STATUS, EXIT,
# START, END) and the last LINES lines of its output (default 100, at most
# 1000). STATUS is running, done or failed; a running task whose runner is
# gone is reported, and stored, as failed. Without a task, STATUS is empty.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
lines=${1-100}
format=${2-shell}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/systask.sh
source $HESTIA/func/systask.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [[ ! "$lines" =~ ^[0-9]{1,4}$ ]] || [ "$lines" -lt 1 ] || [ "$lines" -gt 1000 ]; then
	check_result "$E_INVALID" "invalid number of lines :: $lines (1 to 1000)"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ -f "$(st_task_conf)" ]; then
	exec {lock}> "$(st_task_lock)"
	flock -x "$lock"
	st_task_reap
	flock -u "$lock"
fi

log=''
if [ -f "$(st_task_log)" ]; then
	# no colours, no carriage returns of progress bars and spinners
	log=$(tail -n "$lines" "$(st_task_log)" | sed -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' -e 's/\r$//' -e 's/.*\r//' -e 's/.\x08//g')
fi

json=$(jq -nc --arg id "$(st_task_get ID)" --arg kind "$(st_task_get KIND)" \
	--arg args "$(st_task_get ARGS)" --arg status "$(st_task_get STATUS)" \
	--arg exit "$(st_task_get EXIT)" --arg start "$(st_task_get START)" \
	--arg end "$(st_task_get END)" --arg log "$log" '
	{ ID: $id, KIND: $kind, ARGS: $args, STATUS: $status, EXIT: $exit,
		START: $start, END: $end, LOG: $log }')

case "$format" in
	json) printf '%s\n' "$json" | jq . ;;
	*)
		printf '%s\n' "$json" | jq -r 'to_entries[] | select(.key != "LOG") | "\(.key): \(.value)"'
		echo
		printf '%s\n' "$log"
		;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
