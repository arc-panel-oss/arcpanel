#!/bin/bash
# info: run a system task started by v-start-sys-task (E7 batch 3)
# options: KIND [ARG...]
#
# example: v-run-sys-task php 8.3 -
#
# This function is the command of the sys.KIND jobs that v-start-sys-task
# starts (E15): it runs the steps of the task, prints "$ COMMAND" before
# each and stops at the first failure; the job runner records the result.
# It refuses to run outside such a job.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
kind=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/systask.sh
source $ARCPANEL/func/systask.sh
# shellcheck source=/usr/local/arcpanel/func/job.sh
source $ARCPANEL/func/job.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# Run one step; remember the exit code of the first failure
rc=0
step() {
	if [ "$rc" -ne 0 ]; then
		return
	fi
	echo "\$ $*"
	"$BIN/$1" "${@:2}"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		echo "Exit code $rc"
	fi
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'KIND [ARG...]'
if ! [[ "$kind" =~ ^[a-z-]{1,32}$ ]] || ! job_is_current "sys\.$kind"; then
	check_result "$E_FORBIDEN" "the task was not started by v-start-sys-task"
fi
id=$JOB_ID

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

args=("${@:2}")

case "$kind" in
	php)
		if [ "${args[0]}" != '-' ]; then
			for version in ${args[0]//,/ }; do
				step v-add-web-php "$version"
			done
		fi
		if [ "${args[1]}" != '-' ]; then
			for version in ${args[1]//,/ }; do
				step v-delete-web-php "$version"
			done
		fi
		;;
	php-ext)
		if [ "${args[1]}" != '-' ]; then
			for name in ${args[1]//,/ }; do
				step v-add-sys-php-extension "${args[0]}" "$name"
			done
		fi
		if [ "${args[2]}" != '-' ]; then
			for name in ${args[2]//,/ }; do
				step v-delete-sys-php-extension "${args[0]}" "$name"
			done
		fi
		;;
	plugin)
		if [ "${args[1]}" = 'on' ]; then
			step "v-add-sys-${args[0]}"
		else
			step "v-delete-sys-${args[0]}"
		fi
		;;
	arcpanel-update)
		if [ -n "${args[0]}" ]; then
			step v-update-sys-arcpanel "${args[0]}"
		else
			step v-update-sys-arcpanel-all
		fi
		;;
	arcpanel-release)
		# The steps of the update task are in func/updates.sh (E33 phase 1 §7.6)
		# shellcheck source=/usr/local/arcpanel/func/updates.sh
		source "$ARCPANEL/func/updates.sh"
		upd_task_run "${args[0]}" "${args[1]}" "${args[2]-}" "$id"
		rc=$?
		;;
	arcpanel-rollback)
		step v-rollback-sys-arcpanel "${args[0]}"
		;;
	package)
		if [ "${args[1]}" = 'add' ]; then
			step v-add-sys-package "${args[0]}"
		else
			step v-delete-sys-package "${args[0]}"
		fi
		;;
	*)
		echo "Unknown task kind $kind"
		rc=$E_INVALID
		;;
esac

if [ "$rc" -eq 0 ]; then
	status='done'
else
	status=failed
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

if [ "$status" = 'done' ]; then
	$BIN/v-log-action "system" "Info" "System" "System task finished (Task: $kind ${args[*]})."
else
	$BIN/v-log-action "system" "Error" "System" "System task failed (Task: $kind ${args[*]}, exit code $rc)."
fi

exit "$rc"
