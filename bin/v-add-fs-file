#!/bin/bash
# info: add file
# options: USER FILE
#
# example: v-add-fs-file admin /home/admin/readme.md
#
# This function creates new files on file system as the user. The path must
# be absolute and inside the user's home; its folder must exist.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

user=$1
dst_file=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/fs.sh
source $ARCPANEL/func/fs.sh

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER FILE'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

# Checking destination path
fs_check_path "$dst_file"

# The folder that receives the file must be writable
fs_check_writable_parent "$dst_file"

# Creating file
user_exec touch -- "$dst_file" > /dev/null 2>&1
if [ $? -ne 0 ]; then
	echo "Error: file $dst_file was not created"
	exit 3
fi

# Exiting
exit
