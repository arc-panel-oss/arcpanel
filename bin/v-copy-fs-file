#!/bin/bash
# info: copy file
# options: USER SRC_FILE DST_FILE
#
# example: v-copy-fs-file admin /home/admin/readme.txt /home/admin/readme_new.txt
#
# This function copies file on the file system as the user. Both paths must
# be absolute and inside the user's home; the folder of DST_FILE must exist.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

user=$1
src_file=$2
dst_file=$3

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/fs.sh
source $ARCPANEL/func/fs.sh

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER SRC_FILE DST_FILE'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

# Checking source and destination paths, then the source file
fs_check_path "$src_file"
fs_check_path "$dst_file"
if [ ! -f "$src_file" ]; then
	echo "Error: $src_file doesn't exist"
	exit 3
fi

# The folder that receives the copy must be writable
fs_check_writable_target "$dst_file"

# Copying file
user_exec cp -- "$src_file" "$dst_file" > /dev/null 2>&1
if [ $? -ne 0 ]; then
	echo "Error: file $src_file was not copied"
	exit 3
fi

# Exiting
exit
