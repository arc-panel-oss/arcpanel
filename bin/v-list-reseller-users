#!/bin/bash
# info: list the customers of a reseller
# options: RESELLER [FORMAT]
#
# example: v-list-reseller-users agency json
#
# This function lists the users owned by RESELLER, with the fields of
# v-list-users and their OWNER.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
reseller=$1
format=${2-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# JSON list function
json_list() {
	local sep=''
	echo '{'
	for customer in $customer_list; do
		printf '%s' "$sep"
		tenancy_user_json "$customer"
		sep=$',\n'
	done
	echo
	echo '}'
}

# SHELL list function
shell_list() {
	echo "USER   PKG   WEB   DNS   MAIL   DB   DISK   BW   SPND   DATE"
	echo "----   ---   ---   ---   ----   --   ----   --   ----   ----"
	for customer in $customer_list; do
		(
			source_conf "$ARCPANEL/data/users/$customer/user.conf"
			echo "$customer $PACKAGE $U_WEB_DOMAINS $U_DNS_DOMAINS $U_MAIL_DOMAINS $U_DATABASES $U_DISK $U_BANDWIDTH $SUSPENDED $DATE"
		)
	done
}

# PLAIN list function
plain_list() {
	for customer in $customer_list; do
		(
			source_conf "$ARCPANEL/data/users/$customer/user.conf"
			echo -e "$customer\t$NAME\t$CONTACT\t$PACKAGE\t$SUSPENDED\t$U_DISK\t$U_BANDWIDTH\t$U_WEB_DOMAINS\t$DATE"
		)
	done
}

# CSV list function
csv_list() {
	echo "USER,NAME,CONTACT,PACKAGE,SUSPENDED,U_DISK,U_BANDWIDTH,U_WEB_DOMAINS,DATE"
	for customer in $customer_list; do
		(
			source_conf "$ARCPANEL/data/users/$customer/user.conf"
			echo "$customer,\"$NAME\",$CONTACT,$PACKAGE,$SUSPENDED,$U_DISK,$U_BANDWIDTH,$U_WEB_DOMAINS,$DATE"
		)
	done
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'RESELLER [FORMAT]'
is_user_format_valid "$reseller" 'reseller'
is_object_valid 'user' 'USER' "$reseller"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

customer_list=$(tenancy_customers "$reseller")

case $format in
	json) json_list ;;
	plain) plain_list ;;
	csv) csv_list ;;
	shell) shell_list | column -t ;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
