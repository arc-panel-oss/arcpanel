#!/bin/bash
# info: add the incremental backup host
# options: REPO SNAPSHOTS DAILY WEEKLY MONTHLY YEARLY
#
# example: v-add-backup-host-restic /backup/restic 30 -1 -1 -1 -1
#          v-add-backup-host-restic rclone:offsite:restic 10 7 4 12 -1
#
# This function sends incremental (restic) backups to REPO, as earlier
# versions did: a folder of this server or rclone:REMOTE:PATH of a remote in
# root's rclone configuration (an S3 host: v-add-backup-host-s3). Since E48
# the repository is the backup destination restic and the target of the
# backup job "Nightly snapshots" (created when missing, daily at 05:40 for
# all users), with the retention given (-1 keeps all). The repository of
# each user is REPO/USER, as before. Other restic URLs are refused: add a
# backup destination instead.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
repo=$1
snapshots=$2
daily=$3
weekly=$4
monthly=$5
yearly=$6

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/backup-driver.sh
source $ARCPANEL/func/backup-driver.sh
# shellcheck source=/usr/local/arcpanel/func/backup-job.sh
source $ARCPANEL/func/backup-job.sh
# shellcheck source=/usr/local/arcpanel/func/backup-legacy.sh
source $ARCPANEL/func/backup-legacy.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '6' "$#" "REPO SNAPSHOTS DAILY WEEKLY MONTHLY YEARLY"
format_no_quotes "$repo" 'Repository host'
is_negative_one_or_int "$snapshots" 'Snapshots'
is_negative_one_or_int "$daily" 'Daily snapshots'
is_negative_one_or_int "$weekly" 'Weekly snapshots'
is_negative_one_or_int "$monthly" 'Monthly snapshots'
is_negative_one_or_int "$yearly" 'Yearly snapshots'
repo="${repo%/}"
if ! parsed=$(bl_restic_repo "$repo"); then
	check_result "$E_INVALID" "unsupported repository: use a folder or rclone:REMOTE:PATH, or add a backup destination"
fi
IFS=$'\t' read -r kind path remote <<< "$parsed"
if [ "$kind" = local ] && [ ! -d "$path" ]; then
	check_result "$E_NOTEXIST" "Directory '$path' does not exist"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if ! command -v restic > /dev/null 2>&1; then
	apt-get -y install restic > /dev/null 2>&1
fi
bd_check_keys
bd_session
retention="$snapshots:$daily:$weekly:$monthly:$yearly"
if [ "$kind" = s3 ]; then
	# The S3 host of v-add-backup-host-s3: only the retention changes
	if ! bd_exists s3; then
		check_result "$E_NOTEXIST" "no S3 backup host: use v-add-backup-host-s3"
	fi
	dest=s3
else
	dest=restic
	options="$BD_RUN/options"
	secrets="$BD_RUN/secrets"
	mkdir -p "$secrets"
	if [ "$kind" = local ]; then
		printf "PATH='%s'\n" "$path" > "$options"
		driver=local
	else
		section=$(bl_rclone_section "$remote")
		if [ -z "$section" ]; then
			check_result "$E_NOTEXIST" "Rclone repository '$remote' does not exist"
		fi
		printf '%s\n' "$section" > "$secrets/CONFIG"
		printf "REMOTE='%s'\nPATH='%s'\n" "$remote" "$path" > "$options"
		driver=rclone
	fi
	# Earlier versions had one incremental host: a folder or remote replaces S3
	if bd_exists s3 && [ "$(bl_snapshot_destination)" = s3 ]; then
		bl_drop_destination s3
	fi
	if bd_exists restic && [ "$(bd_value restic DRIVER)" != "$driver" ]; then
		bl_drop_destination restic
	fi
	out=$(bl_destination restic "$driver" "$options" "$secrets" 2>&1)
	check_result $? "$out"
	# Repositories of earlier versions are REPO/USER
	bd_set restic RESTIC_PREFIX= ENCRYPT=no
	if ! "$BIN/v-check-backup-destination" restic > /dev/null 2>&1; then
		check_result "$E_NOTEXIST" "Rclone repository '$remote:$path' does not exist"
	fi
fi
bl_target_set "$BL_SNAPSHOT_JOB" snapshot daily:05:40 "$dest:$retention"
check_result $? "the backup job could not be changed"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "Backup" "Incremental backups go to $dest."
log_event "$OK" "$ARGUMENTS"

exit
