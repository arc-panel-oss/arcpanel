#!/bin/bash
# info: restore user via Restic
# options: USER SNAPSHOT KEY
#
# example: v-restore-user-full-restic user snapshot key
#
# Full user restore from a non existing user

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
key=${3}
notify=${4-no}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/domain.sh
source $ARCPANEL/func/domain.sh
# shellcheck source=/usr/local/arcpanel/func/ip.sh
source $ARCPANEL/func/ip.sh
# shellcheck source=/usr/local/arcpanel/func/rebuild.sh
source $ARCPANEL/func/rebuild.sh
# shellcheck source=/usr/local/arcpanel/func/syshealth.sh
source $ARCPANEL/func/syshealth.sh
# shellcheck source=/usr/local/arcpanel/func/safe-fs.sh
source $ARCPANEL/func/safe-fs.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/ports.sh
source $ARCPANEL/func/ports.sh
# shellcheck source=/usr/local/arcpanel/func/docker.sh
source $ARCPANEL/func/docker.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

args_usage='USER SNAPSHOT KEY [NOTIFY]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user' 'snapshot'

source_conf $ARCPANEL/conf/restic.conf

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

check_user=$(is_object_valid 'user' 'USER' "$user")

if [ -n "$check_user" ]; then
	if [ -z "$key" ]; then
		check_result "$E_PASSWORD" "Invalid Restic encryption key"
	fi
	$BIN/v-add-user "$user" "$key" 'info@arcpanel.top'

	echo "$key" > $USER_DATA/restic.conf

	if ! restic_user "$user" snapshots > /dev/null; then
		check_result "$E_PASSWORD" "Invalid Restic repository / encryption key"
	fi
fi

safe_workdir restore-user-full
tmpdir=$SAFE_WORKDIR
if ! restic_user "$user" cat snapshot -- "$snapshot" > /dev/null 2>&1; then
	check_result "$E_NOTEXIST" "Invalid snapshot"
fi

# Download the account configuration
restic_restore_config "$tmpdir" "$snapshot" --include="/home/$user/backup/arcpanel"
check_result $? "Unable to download user data"
src="$tmpdir/home/$user/backup/arcpanel"

# The account record is rebuilt from known keys; the role stays the one
# the account has on this server, never the one of the backup
role=$(grep -o "ROLE='[a-z-]*'" "$USER_DATA/user.conf" | head -n 1)
restore_record_reset user
if parse_backup_record "$(restore_record_keys user)" "$(head -n 1 -- "$src/user.conf" 2> /dev/null)" \
	&& str=$(restore_record user "${role:-ROLE='user'}") && [ -n "$str" ]; then
	echo "$str" > "$USER_DATA/user.conf.restore"
	mv -f "$USER_DATA/user.conf.restore" "$USER_DATA/user.conf"
else
	restore_skip "account record of" "$user" "invalid record"
fi

# Certificates: regular files with known extensions
mkdir -p "$USER_DATA/ssl"
for cert in "$src"/ssl/*; do
	name=$(basename -- "$cert")
	if [[ "$name" =~ ^[A-Za-z0-9._-]+\.(crt|key|ca|pem)$ ]]; then
		copy_from_work "$cert" "$USER_DATA/ssl/$name"
	fi
done
restore_excludes_file "$src/backup-excludes.conf" "$USER_DATA/backup-excludes.conf"

# Rebuilding user
rebuild_user_conf

# Restore web domains
echo "[ * ] Restore Web domains"
$BIN/v-restore-web-domain-restic "$user" "$snapshot" '*' 'no' 'yes'
echo "[ * ] Restore DNS domains"
$BIN/v-restore-dns-domain-restic "$user" "$snapshot" '*'
echo "[ * ] Restore Mail domains"
$BIN/v-restore-mail-domain-restic "$user" "$snapshot" '*'
echo "[ * ] Restore Databases"
$BIN/v-restore-database-restic "$user" "$snapshot" '*'
echo "[ * ] Restore Cronjobs"
$BIN/v-restore-cron-job-restic "$user" "$snapshot"
echo "[ * ] Restore user files"
restic_restore_data "$tmpdir" "$snapshot" --include="/home/$user" --exclude="/home/$user/web" \
	--exclude="/home/$user/conf" --exclude="/home/$user/mail" --exclude="/home/$user/backup"
check_result $? "Unable to download user folders"
if [ -d "$tmpdir/home/$user" ]; then
	copy_into_home "$tmpdir/home/$user" "$HOMEDIR/$user" || echo "[ ! ] Some user files could not be restored"
fi
# The data of Docker apps, outside the home (E39 W1)
restic_restore_data "$tmpdir" "$snapshot" --include="$HOMEDIR/.arcpanel-apps/$user" > /dev/null 2>&1
for app_dir in "$tmpdir$HOMEDIR/.arcpanel-apps/$user"/*/; do
	app=$(basename -- "$app_dir")
	if [ -d "$app_dir" ] && [[ "$app" =~ ^[a-z0-9][a-z0-9-]{1,31}$ ]]; then
		dockerapp_data_fill "$user" "$app" "${app_dir%/}" || echo "[ ! ] The data of the Docker app $app was not restored completely"
	fi
done
# Data unpacked into the home from a snapshot made before E39 W1
$BIN/v-update-sys-user-homes "$user"

# Rebuilding user
rebuild_user_conf

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

safe_workdir_cleanup

# Update user counters
$BIN/v-update-user-counters $user
$BIN/v-update-user-counters "$ROOT_USER"
$BIN/v-update-sys-ip-counters

sed -i "/v-restore-user-full-restic '$user' /d" $ARCPANEL/data/queue/backup.pipe

# Logging
$BIN/v-log-action "system" "Info" "Backup" "User successfully restored (User: $user, Snapshot: $snapshot)."
$BIN/v-log-action "$user" "Info" "Backup" "User successfully restored (Snapshot: $snapshot)."
log_event "$OK" "$ARGUMENTS"
exit
