#!/bin/bash
# info: update system firewall rules
# options: NONE
#
# example: v-update-firewall
#
# This function rebuilds the nftables table inet arcpanel (IPv4 and IPv6)
# from data/firewall and loads it in one transaction

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
source /etc/profile.d/arcpanel.sh
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source "$ARCPANEL/func/main.sh"
# shellcheck source=/usr/local/arcpanel/func/firewall.sh
source "$ARCPANEL/func/firewall.sh"
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'

# Serialize firewall changes (Fail2Ban bans, rule changes, IP lists)
fw_lock

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

rules="$ARCPANEL/data/firewall/rules.conf"

if [ ! -e "$rules" ]; then
	exit
fi

chains="$ARCPANEL/data/firewall/chains.conf"

# Detect custom OpenSSH port(s) and update SSH chain
sshport=$("$BIN/v-list-sys-sshd-port" plain | paste -sd ',' -)
if [[ "$sshport" =~ ^[0-9]+(,[0-9]+)*$ ]]; then
	sed -i -E "s/(PORT=')[0-9]+(,[0-9]+)*('.*COMMENT='SSH')/\1${sshport}\3/" "$rules"
	if [[ -f "$chains" ]]; then
		sed -i "/CHAIN='SSH'/c\\CHAIN='SSH' PORT='${sshport}' PROTOCOL='TCP'" "$chains"
	else
		ARCPANEL_FIREWALL_NO_RELOAD=1 "$BIN/v-add-firewall-chain" 'SSH' "$sshport" 'TCP'
	fi
fi

# Render and load the table; the running table stays when nft refuses it
fw_reload

# The rules, ipsets and unit of the iptables engine, once
fw_legacy_cleanup

# Checking custom trigger
if [ -x "$ARCPANEL/data/firewall/custom.sh" ]; then
	if fw_custom_sh_uses_iptables; then
		echo "Warning: data/firewall/custom.sh calls iptables, whose rules cannot open ports the nftables table drops; use data/firewall/custom.nft" >&2
	fi
	bash "$ARCPANEL/data/firewall/custom.sh"
fi

# Boot unit
fw_install_unit

# The distribution's nftables.service flushes the ruleset: masked while unused
fw_mask_distro_unit

# A Fail2Ban action from before 2.3 is replaced; Fail2Ban restarts once the
# lock is free
fw_unlock
fw_sync_f2b_action

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
