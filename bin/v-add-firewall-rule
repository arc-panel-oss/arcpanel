#!/bin/bash
# info: add firewall rule
# options: ACTION IP_CIDR PORT [PROTOCOL] [COMMENT] [RULE]
#
# example: v-add-firewall-rule DROP 185.137.111.77 25
#
# This function adds new rule to system firewall

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
action=$(echo "$1" | tr '[:lower:]' '[:upper:]')
ip_cidr=$2
port_ext=$3
protocol=${4-TCP}
protocol=$(echo "$protocol" | tr '[:lower:]' '[:upper:]')
comment=$5
rule=$6

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/firewall.sh
source $ARCPANEL/func/firewall.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# Get next firewall rule id
get_next_fw_rule() {
	if [ -z "$rule" ]; then
		curr_str=$(grep "RULE=" $ARCPANEL/data/firewall/rules.conf \
			| cut -f 2 -d \' | sort -n | tail -n1)
		rule="$((curr_str + 1))"
	fi
}

sort_fw_rules() {
	cat $ARCPANEL/data/firewall/rules.conf \
		| sort -n -k 2 -t \' > $ARCPANEL/data/firewall/rules.conf.tmp
	mv -f $ARCPANEL/data/firewall/rules.conf.tmp \
		$ARCPANEL/data/firewall/rules.conf
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'ACTION IP_CIDR PORT [PROTOCOL] [COMMENT] [RULE]'
is_format_valid 'action' 'protocol' 'port_ext'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'
get_next_fw_rule
is_format_valid 'rule'
is_object_new '../../../data/firewall/rules' 'RULE' "$rule"
if [ -n "$comment" ]; then
	is_format_valid 'comment'
fi
if [[ "$ip_cidr" =~ ^ipset: ]]; then
	ipset_name="${ip_cidr#ipset:}"
	$BIN/v-list-firewall-ipset plain | grep "^$ipset_name\s" > /dev/null
	check_result $? 'ipset object not found' "$E_NOTEXIST"
else
	is_format_valid 'ip_cidr'
	# IPv6 addresses are kept in lower case
	ip_cidr=$(echo "$ip_cidr" | tr '[:upper:]' '[:lower:]')
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# The rules before the change, put back when the load fails
fw_keep_rules

# Generating timestamp
time_n_date=$(date +'%T %F')
time=$(echo "$time_n_date" | cut -f 1 -d \ )
date=$(echo "$time_n_date" | cut -f 2 -d \ )

# Concatenating rule
str="RULE='$rule' ACTION='$action' PROTOCOL='$protocol' PORT='$port_ext'"
str="$str IP='$ip_cidr' COMMENT='$comment' SUSPENDED='no'"
str="$str TIME='$time' DATE='$date'"

# Adding to config
echo "$str" >> $ARCPANEL/data/firewall/rules.conf

# Changing permissions
chmod 660 $ARCPANEL/data/firewall/rules.conf

# Sorting firewall rules by id number
sort_fw_rules

# Updating system firewall; a table nft refuses fails the command
fw_apply_rules

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Fix missing port value in log if zero
if [ -z "$port_ext" ]; then
	port_ext="0"
fi

# Logging
$BIN/v-log-action "system" "Info" "Firewall" "Added firewall rule (Action: $action, Port: $port_ext, Protocol: $protocol)."
log_event "$OK" "$ARGUMENTS"

exit
