#!/bin/bash
# info: move file
# options: USER SRC_DIRECTORY DST_DIRECTORY
#
# example: v-move-fs-directory admin /home/admin/web /home/admin/www/
#
# This function moved file or directory on the file system. This function
# can also be used to rename files just like normal mv command. It runs as
# the user; both paths must be absolute and inside the user's home, and the
# home itself cannot be moved.

user=$1
src_dir=$2
dst_dir=$3

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/fs.sh
source $ARCPANEL/func/fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER SRC_DIRECTORY DST_DIRECTORY'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

# Checking source and destination paths, then the source directory
fs_check_entry "$src_dir"
fs_check_path "$dst_dir"
if [ ! -d "$src_dir" ]; then
	echo "Error: source directory $src_dir doesn't exist"
	exit 3
fi

# The folders that lose and receive the directory must be writable
fs_check_writable_parent "$src_dir"
fs_check_writable_target "$dst_dir"

# Moving directory
user_exec mv -- "$src_dir" "$dst_dir" > /dev/null 2>&1
if [ $? -ne 0 ]; then
	echo "Error: directory $src_dir was not moved"
	exit 3
fi

# Exiting
exit
