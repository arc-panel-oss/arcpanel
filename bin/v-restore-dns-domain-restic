#!/bin/bash
# info: restore DNS domain
# options: USER SNAPSHOT DOMAIN
#
# example: v-restore-dns-domain-restic user snapshot domain.com
#
# This function for restoring DNS domains from restic snapshot. Names and
# records read from the snapshot are validated and rebuilt (E39 W1).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
dns=$3
notify=${4-no}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/backup-driver.sh
source $ARCPANEL/func/backup-driver.sh
# shellcheck source=/usr/local/arcpanel/func/backup-job.sh
source $ARCPANEL/func/backup-job.sh
# shellcheck source=/usr/local/arcpanel/func/domain.sh
source $ARCPANEL/func/domain.sh
# shellcheck source=/usr/local/arcpanel/func/ip.sh
source $ARCPANEL/func/ip.sh
# shellcheck source=/usr/local/arcpanel/func/rebuild.sh
source $ARCPANEL/func/rebuild.sh
# shellcheck source=/usr/local/arcpanel/func/syshealth.sh
source $ARCPANEL/func/syshealth.sh
# shellcheck source=/usr/local/arcpanel/func/safe-fs.sh
source $ARCPANEL/func/safe-fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

args_usage='USER SNAPSHOT DOMAIN [NOTIFY]'
check_args '3' "$#" "$args_usage"
is_format_valid 'user' 'snapshot'
is_object_valid 'user' 'USER' "$user"

# The user's repository on the destination that holds the snapshot (E48)
restic_select "$user" "$snapshot"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

safe_workdir restore-dns
tmpdir=$SAFE_WORKDIR
read_snapshot_index "$tmpdir" "$snapshot"
check_result $? "Unable to download snapshot data"

domains=''
IFS=',' read -r -a domains <<< "$DNS"
for domain in "${domains[@]}"; do
	if [[ ",$dns," == *",$domain,"* || "$dns" = '*' ]]; then
		if ! is_restore_name_valid domain "$domain"; then
			restore_skip "DNS domain" "$domain" "invalid name"
			continue
		fi
		# Cleanup previous config keys
		restore_record_reset dns
		unset -v old_ip
		# Checking domain existence
		check_config=$(grep -F "DOMAIN='$domain'" $USER_DATA/dns.conf)
		if [ -z "$check_config" ]; then
			check_new=$(is_domain_new 'dns' "$domain")
			if [ "$check_new" = "yes" ]; then
				error="$domain belongs to another user"
				echo "$error" | $SENDMAIL -s "$subj" "$email" "$notify"
				sed -i "/ $user /d" $ARCPANEL/data/queue/backup.pipe
				check_result "$E_PARSING" "$error"
			fi
		fi
		restic_restore_config "$tmpdir" "$snapshot" --include="/home/$user/backup/dns/$domain"
		check_result $? "Unable to download domain from snapshot"
		src="$tmpdir/home/$user/backup/dns/$domain"

		# Restoring dns.conf
		if [ -z "$check_config" ]; then
			if ! parse_backup_record "$(restore_record_keys dns)" "$(head -n 1 -- "$src/arcpanel/dns.conf" 2> /dev/null)"; then
				restore_skip "DNS domain" "$domain" "invalid record"
				continue
			fi
			DOMAIN=$domain

			# Checking IP address (an address only: it becomes a sed pattern)
			if ! is_restore_ip_valid "$IP"; then
				IP=''
			fi
			check_ip=$(is_ip_valid $IP $user)
			if [ -n "$check_ip" ]; then
				export local_ip=''
				get_user_ip $user
				old_ip=$IP
				IP=$ip
			fi
			if ! is_restore_ip_valid "$IP"; then
				restore_skip "DNS domain" "$domain" "no valid IP address"
				continue
			fi

			# Checking DNS template
			check_tpl=$(is_dns_template_valid $TPL)
			if [ -n "$check_tpl" ]; then
				TPL='default'
			fi

			# Merging dns.conf keys
			str=$(restore_record dns "SUSPENDED='no' TIME='$(date +%T)' DATE='$(date +%F)'")
			if [ -z "$str" ]; then
				restore_skip "DNS domain" "$domain" "invalid record"
				continue
			fi
			echo "$str" >> $USER_DATA/dns.conf
		else
			parse_object_kv_list "$check_config"
		fi
		if [ "$DNSSEC" = "yes" ]; then
			domain_idn=$domain
			format_domain_idn
			# Only the key files of this domain, as regular files
			for key_file in "$src"/conf/keys/K"$domain_idn".+*; do
				key_name=$(basename -- "$key_file")
				if [[ "$key_name" =~ ^K[A-Za-z0-9.-]+\.\+[0-9]+\+[0-9]+\.(key|private)$ ]]; then
					copy_from_work "$key_file" "/var/cache/bind/$key_name" || continue
					chown bind:bind "/var/cache/bind/$key_name"
					chmod 644 "/var/cache/bind/$key_name"
				fi
			done
		fi

		# Restoring DNS records
		dropped=$(restore_records_file dnsrec "$src/arcpanel/$domain.conf" "$USER_DATA/dns/$domain.conf")
		if [ "${dropped:-0}" -gt 0 ]; then
			restore_skip "DNS records of" "$domain" "$dropped invalid records"
		fi

		# Update IP in records
		if [ -n "$old_ip" ]; then
			sed -i "s/$old_ip/$IP/g" "$USER_DATA/dns/$domain.conf"
		fi

		# Rebuilding DNS domain
		rebuild_dns_domain_conf

		# Updating dns-cluster queue
		if [ -n "$DNS_CLUSTER" ]; then
			cmd="$BIN/v-add-remote-dns-domain $user $domain yes"
			echo "$cmd" >> $ARCPANEL/data/queue/dns-cluster.pipe
		fi

	fi
done
#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

safe_workdir_cleanup

# Update user counters
$BIN/v-update-user-counters $user
$BIN/v-update-user-counters "$ROOT_USER"
$BIN/v-update-sys-ip-counters

sed -i "/v-restore-dns-domain-restic '$user' '$snapshot' '$dns' /d" $ARCPANEL/data/queue/backup.pipe

# Logging
$BIN/v-log-action "system" "Info" "Backup" "DNS Domain successfully restored (User: $user, Snapshot: $snapshot, Databse: $database)."
$BIN/v-log-action "$user" "Info" "Backup" "DNS Domain successfully restored (User: $user, Snapshot: $snapshot, Databse: $database)."
log_event "$OK" "$ARGUMENTS"
exit
