#!/bin/bash
# info: list all API access keys
# options: [USER] [FORMAT]
#
# example: v-list-access-keys json

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

# Argument definition
user="$1"
format="${2:-shell}"

# JSON list function
json_list() {
	echo -n '{'
	local quote=''
	local PERMISSIONS_ARR ALLOWED_IPS_ARR ACCESS_KEY_ID
	for key_file in $ARCPANEL/data/access-keys/*; do
		key_file="$(basename -- "$key_file")"
		if [[ "$key_file" =~ ^[[:alnum:]]{20}$ ]]; then
			USER="$ROOT_USER" SECRET_ACCESS_KEY="" PERMISSIONS="" DATE="" TIME="" COMMENT="" ALLOWED_IPS="" EXPIRES=""
			source_conf "$ARCPANEL/data/access-keys/$key_file"
			if [ "$user" = "$USER" ] || [ -z "$user" ]; then
				PERMISSIONS_ARR='[]'
				if [[ -n "$PERMISSIONS" ]]; then
					PERMISSIONS_ARR="[\"$(echo "$PERMISSIONS" | sed -E 's|,|", "|g')\"]"
				fi
				ALLOWED_IPS_ARR='[]'
				if [[ -n "$ALLOWED_IPS" ]]; then
					ALLOWED_IPS_ARR="[\"$(echo "$ALLOWED_IPS" | sed -E 's|,|", "|g')\"]"
				fi

				ACCESS_KEY_ID="$(basename "$key_file")"

				echo -en "${quote:-\n}"
				echo -n '    "'$ACCESS_KEY_ID'": {'
				echo -n '"ACCESS_KEY_ID": "'${ACCESS_KEY_ID}'", '
				echo -n '"USER": "'${USER}'", '
				echo -n '"PERMISSIONS": '${PERMISSIONS_ARR}', '
				echo -n '"COMMENT": "'${COMMENT}'", '
				echo -n '"TIME": "'${TIME}'", '
				echo -n '"DATE": "'${DATE}'", '
				echo -n '"ALLOWED_IPS": '${ALLOWED_IPS_ARR}', '
				echo -n '"EXPIRES": "'${EXPIRES}'"'
				echo -n '}'
				quote=",\n"
			fi
		fi
	done

	[[ -n "$quote" ]] && echo
	echo -e '}'
}

# SHELL list function
shell_list() {
	list="ID\tUSER\tPERMISSIONS\tCOMMENT\tTIME\tDATE\n"
	list+="--\t------\t----\t-----------\t-------\t----\t----\n"

	for key_file in $ARCPANEL/data/access-keys/*; do
		key_file="$(basename -- "$key_file")"
		if [[ "$key_file" =~ ^[[:alnum:]]{20}$ ]]; then
			USER="$ROOT_USER" SECRET_ACCESS_KEY="" PERMISSIONS="" DATE="" TIME="" COMMENT=""
			source_conf "$ARCPANEL/data/access-keys/$key_file"
			if [ "$user" = "$USER" ] || [ -z "$user" ]; then
				ACCESS_KEY_ID="$(basename "$key_file")"
				list+="${ACCESS_KEY_ID}\t${USER}\t${PERMISSIONS:--}\t${COMMENT:--}\t${TIME}\t${DATE}\n"
			fi
		fi
	done

	echo -e "$list" | column -t -s "	"
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Listing data
case $format in
	json) json_list ;;
	shell) shell_list ;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
