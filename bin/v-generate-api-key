#!/bin/bash
# info: generate api key
# options: NONE
#
# example: v-generate-api-key
#
# This function creates a key file in $ARCPANEL/data/keys/

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

keygen() {
	tr < /dev/urandom -dc _A-Z-a-z-0-9 | head -c 32
	echo
}
HASH=$(keygen)

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ ! -d "$ARCPANEL/data/keys/" ]; then
	mkdir -p $ARCPANEL/data/keys/
	chown arcpanelweb:root $ARCPANEL/data/keys/
	chmod 750 $ARCPANEL/data/keys/
fi

if [[ -e "$ARCPANEL/data/keys/$HASH" ]]; then
	while [[ -e "$ARCPANEL/data/keys/$HASH" ]]; do
		HASH=$(keygen)
	done
fi

touch $ARCPANEL/data/keys/$HASH
echo "$HASH"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Warning" "System" "New system API key generated (Key: ${HASH})."

exit
