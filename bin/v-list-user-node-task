#!/bin/bash
# info: show the current or last Node.js task of a user (E13)
# options: USER [LINES] [FORMAT]
#
# example: v-list-user-node-task alice 100 json
#
# This function prints the task record (ID, ACTION, ARGS, STATUS, EXIT,
# START, END) and the last LINES lines of its output (default 100, at most
# 1000). STATUS is running, done or failed; a running task whose process is
# gone is reported, and stored, as failed. Without a task, STATUS is empty.
# Since E15 it reads the newest node.* job of USER; deprecated in 2.7.0
# (read the job with v-list-job), removed in 2.8.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
lines=${2-100}
format=${3-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/node.sh
source $ARCPANEL/func/node.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [LINES] [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
if [[ ! "$lines" =~ ^[0-9]{1,4}$ ]] || [ "$lines" -lt 1 ] || [ "$lines" -gt 1000 ]; then
	check_result "$E_INVALID" "invalid number of lines :: $lines (1 to 1000)"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

node_task_reap "$user"
id=$(node_task_id "$user" || true)
action=''
args=''
if [ -n "$id" ]; then
	action=$(job_argv_word "$id" 2)
	args=$(job_legacy_args "$id" 3)
fi
json=$(job_legacy_json "$id" lines "$lines" | jq -c --arg action "$action" --arg args "$args" --arg user "$user" '
	{ USER: $user, ID, ACTION: $action, ARGS: $args, STATUS, EXIT, START, END, LOG }')
log=$(jq -r .LOG <<< "$json")

case "$format" in
	json) printf '%s\n' "$json" | jq . ;;
	*)
		printf '%s\n' "$json" | jq -r 'to_entries[] | select(.key != "LOG") | "\(.key): \(.value)"'
		echo
		printf '%s\n' "$log"
		;;
esac

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
