#!/bin/bash
# info: enable the file manager of the panel
# options: [MODE]
#
# example: v-add-sys-filemanager quiet
#
# This function turns the file manager of the panel app on (FILE_MANAGER).
# ArcPanel 2.0 ships the file manager with the panel; FileGator is no longer
# downloaded or installed.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

MODE=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source "$ARCPANEL/func/main.sh"
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Checking root permissions
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: v-add-sys-filemanager can only be executed by the root user" >&2
	exit 10
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

"$BIN/v-change-sys-config-value" 'FILE_MANAGER' 'true'

if [ "$MODE" != "quiet" ]; then
	echo "File Manager is enabled."
fi

#----------------------------------------------------------#
#                       Logging                            #
#----------------------------------------------------------#

"$BIN/v-log-action" "system" "Info" "Plugins" "File Manager enabled."
log_event "$OK" "$ARGUMENTS"
