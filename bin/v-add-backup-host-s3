#!/bin/bash
# info: add an S3 backup host for incremental backups
# options: ENDPOINT BUCKET[/PATH] CREDENTIALS_FILE [REGION] [SNAPSHOTS] [DAILY] [WEEKLY] [MONTHLY] [YEARLY]
#
# example: v-add-backup-host-s3 https://s3.example.com backups/server1 /tmp/s3.env us-east-1 10 -1 -1 -1 -1
#
# This function sends incremental (restic) backups to an S3-compatible
# provider (AWS, Cloudflare R2, Wasabi, Silo on another server). Since E48
# the connection is the backup destination s3 (its secret encrypted) and
# the target of the backup job "Nightly snapshots"; the repository of each
# user stays BUCKET/PATH/USER.
# CREDENTIALS_FILE holds AWS_ACCESS_KEY_ID= and AWS_SECRET_ACCESS_KEY= lines;
# it is read, never printed. Retention: as v-add-backup-host-restic (-1 is
# no limit), 10 snapshots by default.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
endpoint=${1%/}
target=${2%/}
credentials=$3
region=${4:-us-east-1}
snapshots=${5:-10}
daily=${6:--1}
weekly=${7:--1}
monthly=${8:--1}
yearly=${9:--1}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/secret.sh
source $ARCPANEL/func/secret.sh
# shellcheck source=/usr/local/arcpanel/func/backup-driver.sh
source $ARCPANEL/func/backup-driver.sh
# shellcheck source=/usr/local/arcpanel/func/backup-job.sh
source $ARCPANEL/func/backup-job.sh
# shellcheck source=/usr/local/arcpanel/func/backup-legacy.sh
source $ARCPANEL/func/backup-legacy.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

REMOTE=arcpanel-s3

# Value of NAME= in the credentials file
credential() {
	sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$credentials" | head -n 1 | tr -d "\r\"'"
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'ENDPOINT BUCKET[/PATH] CREDENTIALS_FILE [REGION] [SNAPSHOTS] [DAILY] [WEEKLY] [MONTHLY] [YEARLY]'
if [ "$(id -u)" != '0' ]; then
	echo "Error: v-add-backup-host-s3 can only be executed by the root user"
	exit "$E_FORBIDEN"
fi
if [[ "$endpoint" =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$ ]]; then
	:
elif [[ "$endpoint" =~ ^http://(127\.0\.0\.1|localhost)(:[0-9]{1,5})?$ ]]; then
	# Plain HTTP only to this server
	:
else
	check_result "$E_INVALID" "invalid endpoint :: $endpoint (https://HOST[:PORT])"
fi
if ! [[ "$target" =~ ^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9](/[A-Za-z0-9._-]+)*$ ]]; then
	check_result "$E_INVALID" "invalid bucket or path :: $target (BUCKET or BUCKET/PATH)"
fi
if ! [[ "$region" =~ ^[a-z0-9-]{1,32}$ ]]; then
	check_result "$E_INVALID" "invalid region :: $region"
fi
for value in "$snapshots" "$daily" "$weekly" "$monthly" "$yearly"; do
	if [ "$value" != '-1' ] && ! [[ "$value" =~ ^[0-9]{1,4}$ ]]; then
		check_result "$E_INVALID" "invalid retention :: $value (a number or -1)"
	fi
done
if [ ! -f "$credentials" ]; then
	check_result "$E_NOTEXIST" "credentials file $credentials does not exist"
fi
key_id=$(credential AWS_ACCESS_KEY_ID)
secret=$(credential AWS_SECRET_ACCESS_KEY)
if ! [[ "$key_id" =~ ^[A-Za-z0-9+/=._-]{3,128}$ ]] || [ -z "$secret" ] || [ "${#secret}" -gt 256 ]; then
	check_result "$E_INVALID" "the credentials file needs AWS_ACCESS_KEY_ID= and AWS_SECRET_ACCESS_KEY= lines"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

$BIN/v-add-sys-rclone > /dev/null
check_result $? "rclone could not be installed"

bd_check_keys
bd_session
options="$BD_RUN/options"
secrets="$BD_RUN/secrets"
mkdir -p "$secrets"
bucket=${target%%/*}
path=
[[ "$target" == */* ]] && path=${target#*/}
printf "PROVIDER='Other'\nENDPOINT='%s'\nREGION='%s'\nBUCKET='%s'\nACCESS_KEY_ID='%s'\nPATH_STYLE='yes'\n" \
	"$endpoint" "$region" "$bucket" "$key_id" > "$options"
[ -n "$path" ] && printf "PATH='%s'\n" "$path" >> "$options"
printf '%s' "$secret" > "$secrets/SECRET_ACCESS_KEY"
existed=no
bd_exists s3 && existed=yes
out=$(bl_destination s3 s3 "$options" "$secrets" 2>&1)
check_result $? "$out"
# Repositories of E44 are BUCKET/PATH/USER
bd_set s3 RESTIC_PREFIX=
if ! "$BIN/v-check-backup-destination" s3 > /dev/null 2>&1; then
	[ "$existed" = no ] && "$BIN/v-delete-backup-destination" s3 > /dev/null 2>&1
	check_result "$E_CONNECT" "the bucket $bucket cannot be listed at $endpoint with these credentials"
fi
# Earlier versions had one incremental host: S3 replaces a folder or remote
if bd_exists restic; then
	bl_drop_destination restic
fi
bl_target_set "$BL_SNAPSHOT_JOB" snapshot daily:05:40 "s3:$snapshots:$daily:$weekly:$monthly:$yearly"
check_result $? "the backup job could not be changed"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "Backup" "Incremental backups go to S3 (Endpoint: $endpoint, Bucket: $target)."
log_event "$OK" "$endpoint $target"

exit
