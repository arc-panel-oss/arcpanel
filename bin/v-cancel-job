#!/bin/bash
# info: cancel a job (E15)
# options: ID [ACTOR]
#
# example: v-cancel-job 17286400001234 alice
#
# This function cancels a queued or running job. A queued job is cancelled
# at once. A running job is stopped: its systemd unit with systemctl stop
# (KILL after 10 seconds), or without systemd a TERM to the runner's session
# and a KILL after 10 seconds. STATUS becomes cancelled and ERROR names
# ACTOR (default cli). A finished job is refused.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
id=$1
actor=${2:-cli}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/job.sh
source $ARCPANEL/func/job.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'ID [ACTOR]'
if ! job_id_valid "$id"; then
	check_result "$E_INVALID" "invalid job ID :: $id"
fi
if ! job_actor_valid "$actor"; then
	check_result "$E_INVALID" "invalid actor :: $actor"
fi
if ! job_exists "$id"; then
	check_result "$E_NOTEXIST" "job $id does not exist"
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

type=$(job_get "$id" TYPE)
job_cancel "$id" "cancelled by $actor"
rc=$?
if [ "$rc" -ne 0 ]; then
	check_result "$rc" "$JOB_REASON"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "System" "Job cancelled (Job: $id, Type: $type, Actor: $actor)."
log_event "$OK" "$ARGUMENTS"

exit
