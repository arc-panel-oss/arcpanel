#!/bin/bash
# info: change a reseller setting of a package
# options: PACKAGE KEY VALUE
#
# example: v-change-package-tenancy reseller USERS 25
#
# This function sets USERS (integer or unlimited), RESELLER_PACKAGES (comma
# list of packages, or *), RESELLER_VISIBLE (yes or no), PORTS (integer
# or unlimited), NODE (yes or no), NODE_VERSIONS and NODE_APPS (integer or
# unlimited), NODE_ALLOWED (lts, * or a comma list of majors), DOCKER (yes or
# no), DOCKER_APPS (integer or unlimited), DOCKER_CPUS (CPUs per app, like
# 0.5, or unlimited) or DOCKER_MEMORY (memory per app, like 512M, or
# unlimited) of a package. PORTS, NODE_VERSIONS, NODE_APPS, DOCKER_APPS,
# DOCKER_CPUS and DOCKER_MEMORY of a reseller's own package cannot be above
# the reseller's, its NODE and DOCKER cannot be yes when the reseller's are
# no, and its NODE_ALLOWED allows only what the reseller's allows.
# PHP_VERSIONS (* or a comma list of catalog versions), PHP_PROFILES (* or a
# comma list of PHP-FPM profiles) and
# PHP_DEFAULT_PROFILE (one of the allowed profiles) choose the PHP of the
# package's web domains (E41): a reseller's own package may only allow what
# the reseller's package allows, * only when that is *, and the package's
# BACKEND_TEMPLATE must name an allowed version.
# APP_PROCESSES (yes or no), APP_PROCESSES_MAX (integer or unlimited),
# APP_PROCESSES_MEMORY (memory per process, like 512M, or unlimited) and
# APP_PROCESSES_CPUS (CPUs per process, like 0.5, or unlimited) allow app
# processes (E42); a reseller's own package cannot go beyond the reseller's.
# OBJECT_STORAGE (yes or no), OBJECT_STORAGE_BUCKETS (integer or unlimited),
# OBJECT_STORAGE_QUOTA (MB, or with G or T, or unlimited) and
# OBJECT_STORAGE_BACKUP (yes or no) allow object storage (E44): buckets and
# the sum of their quotas, and whether backups carry the objects.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
package=$1
key=${2^^}
value=$3

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/php.sh
source $ARCPANEL/func/php.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'PACKAGE KEY VALUE'
is_format_valid 'package'
is_package_valid "$package"
case "$key" in
	USERS | RESELLER_PACKAGES | RESELLER_VISIBLE | PORTS | NODE | NODE_VERSIONS | NODE_APPS | NODE_ALLOWED) ;;
	DOCKER | DOCKER_APPS | DOCKER_CPUS | DOCKER_MEMORY) ;;
	PHP_VERSIONS | PHP_PROFILES | PHP_DEFAULT_PROFILE) ;;
	APP_PROCESSES | APP_PROCESSES_MAX | APP_PROCESSES_MEMORY | APP_PROCESSES_CPUS) ;;
	OBJECT_STORAGE | OBJECT_STORAGE_BUCKETS | OBJECT_STORAGE_QUOTA | OBJECT_STORAGE_BACKUP) ;;
	*) check_result "$E_INVALID" "invalid key $key" ;;
esac
if ! tenancy_pkg_value_valid "$key" "$value"; then
	check_result "$E_INVALID" "invalid $key value :: $value"
fi
# PHP of the package (E41): known versions and profiles, a default profile
# among the allowed ones, a backend template of an allowed version
case "$key" in
	PHP_VERSIONS)
		if [ "$value" != '*' ]; then
			for item in ${value//,/ }; do
				if ! php_version_valid "$item" && ! php_version_installed "$item"; then
					check_result "$E_INVALID" "unknown PHP version :: $item"
				fi
			done
		fi
		backend=$(tenancy_pkg_limit "$package" BACKEND_TEMPLATE)
		if [[ "$backend" =~ PHP-[0-9]{1,2}_[0-9]{1,2}$ ]] || [ "$backend" = 'default' ]; then
			backend_version=$(php_backend_version "$backend")
			if [ "$value" != '*' ] && [[ ",$value," != *",$backend_version,"* ]]; then
				check_result "$E_INVALID" "the backend template $backend of $package uses PHP $backend_version, which PHP_VERSIONS does not allow"
			fi
		fi
		;;
	PHP_PROFILES)
		if [ "$value" != '*' ]; then
			for item in ${value//,/ }; do
				if ! php_profile_exists "$item"; then
					check_result "$E_NOTEXIST" "profile $item does not exist"
				fi
			done
			default_profile=$(php_pkg_get "$package" PHP_DEFAULT_PROFILE)
			if [[ ",$value," != *",$default_profile,"* ]]; then
				check_result "$E_INVALID" "PHP_PROFILES must keep the default profile $default_profile"
			fi
		fi
		;;
	PHP_DEFAULT_PROFILE)
		if ! php_profile_exists "$value"; then
			check_result "$E_NOTEXIST" "profile $value does not exist"
		fi
		if ! php_pkg_allows_profile "$package" "$value"; then
			check_result "$E_INVALID" "the default profile must be one of PHP_PROFILES"
		fi
		;;
esac

reseller=$(tenancy_pkg_get "$package" RESELLER_OWNER)
if [ -n "$reseller" ]; then
	# Only what the reseller's own package allows (D12, E39 W4 spec §8.3)
	own_package=$(tenancy_user_value "$reseller" PACKAGE)
	if [ "$key" = 'PHP_DEFAULT_PROFILE' ]; then
		if ! php_pkg_allows_profile "$own_package" "$value"; then
			check_result "$E_LIMIT" "profile $value is not allowed by the reseller's package"
		fi
	elif [[ " $TENANCY_PACKAGE_TENANCY_LIMIT_KEYS " == *" $key "* ]]; then
		limit=$(tenancy_pkg_get "$own_package" "$key")
		if tenancy_pkg_tenancy_above "$key" "$value" "$limit"; then
			check_result "$E_LIMIT" "$key of $package cannot go beyond the reseller's package ($key='$limit')"
		fi
		# Under the reseller's *, a list names only versions that * gives the
		# reseller: installed and not at their end of life (E39 W5 P4)
		if [ "$key" = 'PHP_VERSIONS' ] && [ "$value" != '*' ] && [ "$(php_pkg_get "$own_package" PHP_VERSIONS)" = '*' ]; then
			for item in ${value//,/ }; do
				if ! php_pkg_allows_version "$own_package" "$item"; then
					check_result "$E_LIMIT" "PHP $item is not allowed by the reseller's package"
				fi
			done
		fi
	fi
fi

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

tenancy_pkg_set "$package" "$key" "$value"
check_result $? "package $package was not updated" "$E_UPDATE"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "System" "Package reseller setting changed (Package: $package, $key: $value)."
log_event "$OK" "$ARGUMENTS"

exit
