#!/bin/bash
# info: change a reseller setting of a package
# options: PACKAGE KEY VALUE
#
# example: v-change-package-tenancy reseller USERS 25
#
# This function sets USERS (integer or unlimited), RESELLER_PACKAGES (comma
# list of packages, or *), RESELLER_VISIBLE (yes or no), PORTS (integer
# or unlimited), NODE (yes or no), NODE_VERSIONS (integer or unlimited) or
# NODE_ALLOWED (lts, * or a comma list of majors) of a package. PORTS and
# NODE_VERSIONS of a reseller's own package cannot be above the reseller's,
# and its NODE cannot be yes when the reseller's is no.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
package=$1
key=${2^^}
value=$3

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/tenancy.sh
source $HESTIA/func/tenancy.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'PACKAGE KEY VALUE'
is_format_valid 'package'
is_package_valid "$package"
case "$key" in
	USERS | RESELLER_PACKAGES | RESELLER_VISIBLE | PORTS | NODE | NODE_VERSIONS | NODE_ALLOWED) ;;
	*) check_result "$E_INVALID" "invalid key $key" ;;
esac
if ! tenancy_pkg_value_valid "$key" "$value"; then
	check_result "$E_INVALID" "invalid $key value :: $value"
fi
reseller=$(tenancy_pkg_get "$package" RESELLER_OWNER)
if [ -n "$reseller" ]; then
	case "$key" in
		PORTS | NODE_VERSIONS)
			limit=$(tenancy_pkg_get "$(tenancy_user_value "$reseller" PACKAGE)" "$key")
			if [ "$limit" != 'unlimited' ] && { [ "$value" = 'unlimited' ] || [ "$value" -gt "$limit" ]; }; then
				check_result "$E_LIMIT" "$key of $package cannot be above the reseller's $key ($limit)"
			fi
			;;
		NODE)
			limit=$(tenancy_pkg_get "$(tenancy_user_value "$reseller" PACKAGE)" NODE)
			if [ "$value" = 'yes' ] && [ "$limit" != 'yes' ]; then
				check_result "$E_LIMIT" "NODE of $package cannot be yes: the reseller's package has NODE='no'"
			fi
			;;
	esac
fi

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

tenancy_pkg_set "$package" "$key" "$value"
check_result $? "package $package was not updated" "$E_UPDATE"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "System" "Package reseller setting changed (Package: $package, $key: $value)."
log_event "$OK" "$ARGUMENTS"

exit
