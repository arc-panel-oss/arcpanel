#!/bin/bash
# info: run a Node.js task started by v-start-user-node-task (E13)
# options: ID USER ACTION [ARGS...]
#
# example: v-run-user-node-task 17286400001234 alice add-version lts
#
# This function is the background part of v-start-user-node-task: it runs
# the command of the task and records its result. It refuses to run a task
# that v-start-user-node-task did not start.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
id=$1
user=$2
action=$3
shift 3 2> /dev/null

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/tenancy.sh
source $HESTIA/func/tenancy.sh
# shellcheck source=/usr/local/hestia/func/node.sh
source $HESTIA/func/node.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ -z "$action" ]; then
	echo "Usage: v-run-user-node-task ID USER ACTION [ARGS...]"
	exit "$E_ARGS"
fi
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
if [ "$(node_task_get "$user" ID)" != "$id" ] || [ "$(node_task_get "$user" STATUS)" != 'running' ]; then
	check_result "$E_FORBIDEN" "task $id was not started by v-start-user-node-task"
fi
case "$action" in
	add-version) command=v-add-user-node-version ;;
	add-package) command=v-add-user-npm-package ;;
	update-packages) command=v-update-user-npm-packages ;;
	check-outdated) command=v-check-user-npm-outdated ;;
	app-install) command=v-run-node-app-install ;;
	app-build) command=v-run-node-app-build ;;
	*) check_result "$E_INVALID" "invalid action :: $action" ;;
esac

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

echo "$ $command $user $*"
"$BIN/$command" "$user" "$@"
rc=$?
if [ "$rc" -eq 0 ]; then
	status=done
else
	status=failed
	echo "Exit code $rc"
fi

exec {lock}> "$HESTIA/data/users/$user/node-task.lock"
flock -x "$lock"
if [ "$(node_task_get "$user" ID)" = "$id" ]; then
	node_task_set "$user" "STATUS=$status" "EXIT=$rc" "END=$(date +'%F %T')"
fi
flock -u "$lock"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit "$rc"
