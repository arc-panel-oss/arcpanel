#!/bin/bash
# info: run a Node.js task started by v-start-user-node-task (E13)
# options: USER ACTION [ARGS...]
#
# example: v-run-user-node-task alice add-version lts
#
# This function is the command of the node.* jobs that v-start-user-node-task
# starts (E15): it runs the command of the task; the job runner records the
# result. It refuses to run outside such a job.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
action=$2
shift 2 2> /dev/null

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/node.sh
source $ARCPANEL/func/node.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if [ -z "$action" ]; then
	echo "Usage: v-run-user-node-task USER ACTION [ARGS...]"
	exit "$E_ARGS"
fi
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
if ! job_is_current 'node\.(install|npm|build)' || [ "${JOB[TYPE]}" != "$(node_task_type "$action")" ] \
	|| [ "${JOB[OBJECT]}" != "node:$user" ]; then
	check_result "$E_FORBIDEN" "the task was not started by v-start-user-node-task"
fi
case "$action" in
	add-version) command=v-add-user-node-version ;;
	add-package) command=v-add-user-npm-package ;;
	update-packages) command=v-update-user-npm-packages ;;
	check-outdated) command=v-check-user-npm-outdated ;;
	app-install) command=v-run-node-app-install ;;
	app-build) command=v-run-node-app-build ;;
	*) check_result "$E_INVALID" "invalid action :: $action" ;;
esac

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# The task log is written by root from output npm and the user control:
# capped (E39 W1)
echo "$ $command $user $*"
"$BIN/$command" "$user" "$@" 2>&1 | log_cap
rc=${PIPESTATUS[0]}
if [ "$rc" -ne 0 ]; then
	echo "Exit code $rc"
fi

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit "$rc"
