#!/bin/bash
# info: list the app processes of a user (E42)
# options: USER [FORMAT]
#
# example: v-list-app-processes alice json
#
# This function lists the app processes of USER with their live state from
# systemd (STATUS running, starting, stopping, stopped, failed, suspended or
# missing; PID, MEMORY_USED in MB, CPU_SECONDS, RESTARTS, UPTIME in
# seconds) and the limits of the user's package.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
format=${2-shell}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/tenancy.sh
source $ARCPANEL/func/tenancy.sh
# shellcheck source=/usr/local/arcpanel/func/appprocess.sh
source $ARCPANEL/func/appprocess.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER [FORMAT]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

json=$(appproc_rows_json "$user" | jq -sc \
	--arg user "$user" --arg enabled "$(appproc_pkg "$user" APP_PROCESSES)" \
	--arg limit "$(appproc_limit "$user")" --arg memory "$(appproc_max_memory "$user")" \
	--arg default "$(appproc_default_memory "$user")" --arg cpus "$(appproc_max_cpus "$user")" '
	{ USER: $user, ENABLED: $enabled, LIMIT: $limit, COUNT: (length | tostring),
		MAX_MEMORY: $memory, DEFAULT_MEMORY: $default, MAX_CPUS: $cpus, PROCESSES: . }')

node_print "$format" "$json" '.PROCESSES' 'DOMAIN NAME KIND PRESET PORT STATUS MEMORY_USED RESTARTS UPTIME'

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

exit
