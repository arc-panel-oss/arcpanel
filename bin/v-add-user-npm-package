#!/bin/bash
# info: install a global npm package for a user (E13)
# options: USER VERSION SPEC
#
# example: v-add-user-npm-package alice 24.3.0 pm2
# example: v-add-user-npm-package alice 24.3.0 @nestjs/cli@11
#
# This function runs `npm install -g SPEC` as the user with the runtime
# VERSION. SPEC is a package name, optionally scoped, with an optional
# version, range or dist-tag; URLs, git, file and path specs are refused.
# pnpm and yarn are installed this way too.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
version=${2#v}
spec=$3

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/tenancy.sh
source $HESTIA/func/tenancy.sh
# shellcheck source=/usr/local/hestia/func/node.sh
source $HESTIA/func/node.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER VERSION SPEC'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

[ -z "$HOMEDIR" ] && check_result "$E_NOTEXIST" "ArcPanel environment vars not present"

node_check_enabled_package "$user"
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
	check_result "$E_INVALID" "invalid version :: $version"
fi
if ! node_version_installed "$user" "$version"; then
	check_result "$E_NOTEXIST" "Node.js v$version is not installed"
fi
if ! node_pkg_spec_valid "$spec"; then
	check_result "$E_INVALID" "invalid package :: $spec (a package name with an optional @version)"
fi
dir=$(node_version_dir "$user" "$version")
node_check_path "$user" "$dir"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

echo "Installing $spec for Node.js v$version"
NODE_RUN_VERSION="$version" node_as_user_long "$user" \
	npm install --global --no-fund --no-audit --prefix "$dir" "$spec"
rc=$?
if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
	check_result "$E_CONNECT" "npm did not finish within $((NODE_NPM_TIMEOUT / 60)) minutes"
fi
check_result "$rc" "npm could not install $spec" "$E_INVALID"
node_outdated_clear "$user" "$version"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "$user" "Info" "Node.js" "Global npm package installed (Package: $spec, Version: $version)."
log_event "$OK" "$ARGUMENTS"

exit
