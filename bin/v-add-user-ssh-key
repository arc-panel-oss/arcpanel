#!/bin/bash
# info: add ssh key
# options: USER KEY
#
# example: v-add-user-ssh-key user 'valid ssh key'
#
# Function check if $user/.ssh/authorized_keys exists and create it.
# After that it append the new key. Every read and write of the file runs as
# the user, so a link in ~/.ssh cannot make root write elsewhere (E39 W1).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
key=$2

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER SSH_PUBLIC_KEY'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

SSH_DIR="$HOMEDIR/$user/.ssh"
AUTHKEY_FILE="$SSH_DIR/authorized_keys"
# An early, readable error; the safety comes from writing as the user
[ -z "$(readlink -f "$AUTHKEY_FILE" | grep -E "^$HOMEDIR/$user/.ssh/")" ] && check_result "$E_FORBIDEN" "Invalid authorized keys path"

[ -z "$key" ] && check_result "$E_NOTEXIST" "Empty ssh public key"
if [[ "$key" == *$'\n'* ]] || [[ "$key" == *$'\r'* ]]; then
	check_result "$E_INVALID" "One ssh public key per call"
fi

if ! echo "$key" | ssh-keygen -l -f - > /dev/null 2>&1; then
	check_result "$E_PARSING" "Validating user private key"
fi

# ~/.ssh: in a home of root (users without a shell) root creates it for the
# user, which cannot race because the user cannot write in that home
if [ ! -e "$SSH_DIR" ] && [ ! -L "$SSH_DIR" ]; then
	if [ "$(stat -c %u -- "$HOMEDIR/$user")" = 0 ]; then
		mkdir -m 700 -- "$SSH_DIR"
		chown -h "$user:$user" -- "$SSH_DIR"
	else
		user_exec mkdir -m 700 -- "$SSH_DIR"
	fi
fi

# Append the key as the user, after a missing end of line
printf '%s\n' "$key" | user_exec sh -c 'umask 077
f="$1/authorized_keys"
if [ -s "$f" ] && [ -n "$(tail -c 1 "$f")" ]; then echo >> "$f" || exit 1; fi
cat >> "$f"' sh "$SSH_DIR"
check_result $? "the key could not be written to $AUTHKEY_FILE" "$E_FORBIDEN"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "$user" "Info" "System" "Added a new SSH key."
log_event "$OK" "$ARGUMENTS"

exit
