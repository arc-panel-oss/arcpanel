#!/bin/bash
# info: restore single cron job
# options: USER SNAPSHOT [NOTIFY]
#
# example: v-restore-cron-job USER BACKUP [NOTIFY]
#
# This function allows the user to restore a cron jobs
# from a snapshot. The jobs are read from the snapshot as untrusted
# records: each line is rebuilt from the known keys (E39 W1 D6).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
snapshot=$2
notify=${3-no}

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/domain.sh
source $ARCPANEL/func/domain.sh
# shellcheck source=/usr/local/arcpanel/func/ip.sh
source $ARCPANEL/func/ip.sh
# shellcheck source=/usr/local/arcpanel/func/rebuild.sh
source $ARCPANEL/func/rebuild.sh
# shellcheck source=/usr/local/arcpanel/func/syshealth.sh
source $ARCPANEL/func/syshealth.sh
# shellcheck source=/usr/local/arcpanel/func/safe-fs.sh
source $ARCPANEL/func/safe-fs.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

args_usage='USER SNAPSHOT [NOTIFY]'
check_args '2' "$#" "$args_usage"
is_format_valid 'user' 'snapshot'
is_object_valid 'user' 'USER' "$user"

source_conf $ARCPANEL/conf/restic.conf

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

safe_workdir restore-cron
tmpdir=$SAFE_WORKDIR

restic_restore_config "$tmpdir" "$snapshot" --include="/home/$user/backup/cron/cron.conf"
check_result $? "Unable to download cron jobs from snapshot"

# Restoring cron jobs
dropped=$(restore_records_file cron "$tmpdir/home/$user/backup/cron/cron.conf" "$USER_DATA/cron.conf")
check_result $? "the snapshot holds no cron jobs" "$E_NOTEXIST"
if [ "$dropped" -gt 0 ]; then
	restore_skip "cron jobs" "$dropped" "invalid records"
fi

# Rebuilding cron jobs
sync_cron_jobs

# Restarting cron
$BIN/v-restart-cron
check_result $? "CRON restart failed"

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

safe_workdir_cleanup

# Update user counters
$BIN/v-update-user-counters $user
$BIN/v-update-user-counters "$ROOT_USER"
$BIN/v-update-sys-ip-counters

sed -i "/v-restore-cron-job-restic '$user' '$snapshot'/d" $ARCPANEL/data/queue/backup.pipe

# Logging
$BIN/v-log-action "system" "Info" "Backup" "Cron jobs successfully restored (User: $user, Snapshot: $snapshot)."
$BIN/v-log-action "$user" "Info" "Backup" "Cron jobs  successfully restored (User: $user, Snapshot: $snapshot)."
log_event "$OK" "$ARGUMENTS"
exit
