#!/bin/bash
# info: delete 2fa of existing user
# options: USER
#
# example: v-delete-user-2fa admin
#
# This function deletes 2fa token of a user, with its recovery codes and a
# pending enrolment.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1

# Includes
# shellcheck source=/etc/arcpanel/arcpanel.conf
source /etc/arcpanel/arcpanel.conf
# shellcheck source=/usr/local/arcpanel/func/main.sh
source $ARCPANEL/func/main.sh
# shellcheck source=/usr/local/arcpanel/func/twofa.sh
source $ARCPANEL/func/twofa.sh
# load config file
source_conf "$ARCPANEL/conf/arcpanel.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'USER'
is_format_valid 'user' 'system'
is_object_valid 'user' 'USER' "$user"

# Perform verification if read-only mode is enabled
check_arcpanel_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# An enrolment that was not confirmed goes too
rm -f "$(twofa_pending_file "$user")"

# Reading user values
source_conf "$USER_DATA/user.conf"

# Check if 2FA is enabled
if [ -z "$TWOFA" ]; then
	echo "Error: two-factor authentication is not enabled"
	exit "$E_NOTEXIST"
fi

# Remove 2FA from user config, with the replay step and the recovery codes
update_user_value "$user" '$TWOFA' ""
update_user_value "$user" '$QRCODE' ""
update_user_value "$user" '$TWOFA_STEP' ""
update_user_value "$user" '$TWOFA_RECOVERY' ""

#----------------------------------------------------------#
#                         ArcPanel                         #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Warning" "System" "Two-factor authentication disabled (User: $user)."
$BIN/v-log-action "$user" "Warning" "System" "Two-factor authentication disabled."
log_event "$OK" "$ARGUMENTS"

exit
