#!/usr/local/arcpanel/php/bin/php
<?php
//# info: install a Quick Install application on a web domain (E7 batch 2)
//# options: USER DOMAIN APP OPTIONS_FILE
//#
//# example: v-add-web-domain-app alice example.com DokuWiki /root/options.json
//#
//# This function reads a JSON object of option values (the KEYs of
//# v-list-quick-install-app-options) from OPTIONS_FILE, fills in the
//# defaults, checks the required fields and runs the installer. Option
//# values are never printed; a failing sub-command is named without its
//# arguments. v-start-user-quick-install runs it in the background.

require_once __DIR__ . "/../func/quickinstall.php";

[$user, $domain, $app, $file] = [$argv[1] ?? "", $argv[2] ?? "", $argv[3] ?? "", $argv[4] ?? ""];
if ($file === "") {
	echo "Usage: v-add-web-domain-app USER DOMAIN APP OPTIONS_FILE\n";
	exit(QI_E_ARGS);
}
if (!qi_valid_user($user) || !is_dir("/usr/local/arcpanel/data/users/$user")) {
	qi_fail(QI_E_NOTEXIST, "user $user does not exist");
}
if (!qi_valid_domain($domain)) {
	qi_fail(QI_E_INVALID, "invalid domain format :: $domain");
}
if (!qi_valid_app($app)) {
	qi_fail(QI_E_NOTEXIST, "installer $app does not exist");
}
if (!is_file($file) || !is_readable($file) || filesize($file) > 65536) {
	qi_fail(QI_E_INVALID, "options file is missing or too large");
}
$given = json_decode((string) file_get_contents($file), true);
if (!is_array($given) || array_is_list($given) && $given !== []) {
	qi_fail(QI_E_INVALID, "options file is not a JSON object");
}

qi_session($user);
qi_quiet_errors();
$arcpanel = new QiArcPanelApp();
$installer = qi_installer($app, $arcpanel);
if (!$installer->getInfo()->isInstallable()) {
	qi_fail(QI_E_INVALID, "Unable to install $app, required php version is not available.");
}
try {
	$wizard = new \ArcPanel\WebApp\AppWizard($installer, $domain, $arcpanel);
} catch (\Throwable) {
	qi_fail(QI_E_NOTEXIST, "web domain $domain does not exist for $user");
}

// Defaults as v-quick-install-app takes them: the value, else the first option
$values = [];
$required = [];
foreach (qi_fields($wizard->getOptions()) as $field) {
	$key = $field["KEY"];
	$value = $field["VALUE"] !== "" ? $field["VALUE"] : ($field["OPTIONS"][0]["VALUE"] ?? "");
	if (array_key_exists($key, $given) && is_scalar($given[$key])) {
		$value = is_bool($given[$key]) ? ($given[$key] ? "true" : "") : trim((string) $given[$key]);
	}
	$values[$key] = $value;
	$required[$key] = $field["REQUIRED"] === "yes";
}
// An existing database needs its name, user and password
if (array_key_exists("database_create", $values) && $values["database_create"] === "") {
	foreach (["database_name", "database_user", "database_password"] as $key) {
		$required[$key] = true;
	}
}
foreach ($values as $key => $value) {
	if (($required[$key] ?? false) && $value === "") {
		qi_fail(QI_E_ARGS, "Missing required field: $key");
	}
}

echo "Installing $app on $domain\n";
$options = [];
foreach ($values as $key => $value) {
	$options[$wizard->formNamespace() . $key] = $value;
}
try {
	$wizard->execute($options);
} catch (\Symfony\Component\Process\Exception\ProcessFailedException $e) {
	$line = $e->getProcess()->getCommandLine();
	$name = preg_match('#/bin/(v-[a-z0-9-]+)#', $line, $match) === 1 ? $match[1] : "a command";
	qi_fail(QI_E_INVALID, "Unable to install $app: $name failed");
} catch (\Throwable $e) {
	qi_fail(QI_E_INVALID, "Unable to install $app: " . $e->getMessage());
}

exec(ARCPANEL_CMD . "v-log-action " . escapeshellarg($user) . " Info Web " . escapeshellarg("Installed $app on $domain."), $output);
echo "$app installed successfully.\n";
exit(0);
