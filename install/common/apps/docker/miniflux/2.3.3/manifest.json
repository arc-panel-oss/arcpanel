{
	"schema": 1,
	"slug": "miniflux",
	"version": "2.3.3",
	"name": "Miniflux",
	"summary": "Minimalist feed reader for RSS and Atom, with a PostgreSQL database.",
	"description": "Miniflux reads RSS, Atom and JSON feeds in a fast, distraction-free interface, with keyboard shortcuts, full-text fetching and integrations. It runs with its own PostgreSQL database; the database is dumped into the app's data folder before every nightly backup.\n\nLog in with the administrator name and password chosen at installation.",
	"category": "other",
	"homepage": "https://miniflux.app",
	"changelog": "https://github.com/miniflux/v2/releases",
	"license": "Apache-2.0",
	"admin_only": false,
	"arch": ["amd64", "arm64"],
	"images": [
		"miniflux/miniflux:2.3.3-distroless@sha256:59e4e31b349f008ecd34b547f23498b1d8abc0c03d5f6d12bdb713ab7f7c04bf",
		"postgres:16.15-alpine@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea"
	],
	"requirements": { "memory": "128M", "disk": "1G" },
	"limits": { "memory": "256M", "cpus": "0.5" },
	"ports": { "web": { "service": "app", "container": 8080 } },
	"volumes": [{ "name": "db" }],
	"variables": [
		{
			"name": "ADMIN_USERNAME",
			"label": "Administrator name",
			"type": "string",
			"default": "admin",
			"required": true,
			"immutable": true,
			"pattern": "^[A-Za-z0-9._-]{3,32}$"
		},
		{
			"name": "ADMIN_PASSWORD",
			"label": "Administrator password",
			"type": "password",
			"required": true,
			"immutable": true
		},
		{
			"name": "DB_PASSWORD",
			"label": "Database password",
			"type": "password",
			"default": "{{random:32}}",
			"required": true,
			"immutable": true
		}
	],
	"healthcheck": { "type": "http", "path": "/healthcheck", "expect": [200], "timeout": 180 },
	"dumps": [
		{
			"service": "db",
			"command": "pg_dump -U miniflux --no-owner miniflux",
			"file": "miniflux.sql"
		}
	],
	"post_install": "Open {{url}} and log in with the administrator name and password you chose."
}
