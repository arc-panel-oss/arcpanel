{
	"schema": 1,
	"slug": "umami",
	"version": "2.20.2",
	"name": "Umami",
	"summary": "Privacy-focused web analytics without cookies, with a PostgreSQL database.",
	"description": "Umami collects page views and events of your websites without cookies and shows them in a clean dashboard. It runs with its own PostgreSQL database; the database is dumped into the app's data folder before every nightly backup.\n\nThe first login is admin with the password umami: change it right away.",
	"category": "analytics",
	"homepage": "https://umami.is",
	"changelog": "https://github.com/umami-software/umami/releases",
	"license": "MIT",
	"admin_only": false,
	"arch": ["amd64", "arm64"],
	"images": [
		"ghcr.io/umami-software/umami:postgresql-v2.20.2@sha256:950133e4158949061b84fa29ce1a87f734655dca5a49a08e727eb23c4e3582cd",
		"postgres:16.15-alpine@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea"
	],
	"requirements": {
		"memory": "512M",
		"disk": "2G"
	},
	"limits": {
		"memory": "512M",
		"cpus": "1"
	},
	"ports": {
		"web": {
			"service": "app",
			"container": 3000
		}
	},
	"volumes": [
		{
			"name": "db"
		}
	],
	"variables": [
		{
			"name": "DB_PASSWORD",
			"label": "Database password",
			"type": "password",
			"default": "{{random:32}}",
			"required": true,
			"immutable": true
		},
		{
			"name": "APP_SECRET",
			"label": "Secret of the sessions",
			"type": "password",
			"default": "{{random:48}}",
			"required": true,
			"immutable": true
		}
	],
	"healthcheck": {
		"type": "http",
		"path": "/api/heartbeat",
		"expect": [200],
		"timeout": 300
	},
	"dumps": [
		{
			"service": "db",
			"command": "pg_dump -U umami --no-owner umami",
			"file": "umami.sql"
		}
	],
	"post_install": "Open {{url}} and log in as admin with the password umami, then change the password in the profile settings."
}
