{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://arcpanel.top/schemas/docker-app.schema.json",
	"title": "ArcPanel Docker app manifest",
	"description": "manifest.json of one version of a catalog app (install/common/apps/docker/<slug>/<version>/). v-check-docker-catalog enforces these rules with jq, together with the checks of the rendered Compose project (docs/features/specs/2026-10-05-009-e4-docker-apps-design.md, sections 5.3 and 5.4).",
	"type": "object",
	"required": [
		"schema",
		"slug",
		"version",
		"name",
		"summary",
		"category",
		"arch",
		"images",
		"requirements",
		"limits",
		"healthcheck"
	],
	"properties": {
		"schema": { "const": 1 },
		"slug": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{1,31}$",
			"description": "Equal to the app folder name."
		},
		"version": {
			"type": "string",
			"pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,39}$",
			"description": "Equal to the version folder name."
		},
		"name": { "type": "string", "minLength": 1, "maxLength": 64 },
		"summary": { "type": "string", "minLength": 1, "maxLength": 200 },
		"description": { "type": "string", "description": "Markdown shown on the detail page." },
		"category": {
			"enum": [
				"monitoring",
				"automation",
				"dev",
				"cms",
				"storage",
				"security",
				"database",
				"analytics",
				"other"
			]
		},
		"homepage": { "type": "string", "pattern": "^https://[^ ]+$" },
		"changelog": { "type": "string", "pattern": "^https://[^ ]+$" },
		"license": { "type": "string" },
		"admin_only": { "type": "boolean", "default": false },
		"arch": { "type": "array", "minItems": 1, "items": { "enum": ["amd64", "arm64"] } },
		"images": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/:-]*@sha256:[a-f0-9]{64}$" },
			"description": "Every image the Compose file uses, pinned by digest."
		},
		"requirements": {
			"type": "object",
			"required": ["memory", "disk"],
			"properties": {
				"memory": { "$ref": "#/$defs/size" },
				"disk": { "$ref": "#/$defs/size" }
			}
		},
		"limits": {
			"type": "object",
			"required": ["memory", "cpus"],
			"properties": {
				"memory": { "$ref": "#/$defs/size" },
				"cpus": { "type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,2})?$" }
			},
			"description": "Default limits of each service, capped by DOCKER_CPUS, DOCKER_MEMORY and MEMORY_LIMIT of the package."
		},
		"ports": {
			"type": "object",
			"propertyNames": { "pattern": "^[a-z][a-z0-9]{0,15}$" },
			"additionalProperties": {
				"type": "object",
				"required": ["service", "container"],
				"properties": {
					"service": { "$ref": "#/$defs/service" },
					"container": { "type": "integer", "minimum": 1, "maximum": 65535 },
					"description": { "type": "string" }
				}
			},
			"description": "\"web\" is proxied by NGINX from the app's domain; other ports are extra registry ports, private unless made public."
		},
		"volumes": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["name"],
				"properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" } }
			},
			"description": "Folders under ~/apps/<name>/data/, available to compose.yaml as ${ARC_DATA_<NAME>}."
		},
		"variables": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["name", "label", "type"],
				"properties": {
					"name": {
						"type": "string",
						"pattern": "^[A-Z][A-Z0-9_]{0,63}$",
						"not": { "pattern": "^ARC_" }
					},
					"label": { "type": "string", "minLength": 1 },
					"type": { "enum": ["string", "int", "bool", "enum", "password", "email", "url"] },
					"options": { "type": "array", "items": { "type": "string" } },
					"default": {
						"type": "string",
						"description": "May use {{server.timezone}}, {{domain}}, {{url}}, {{user}}, {{user.email}} and {{random:N}}."
					},
					"required": { "type": "boolean" },
					"immutable": { "type": "boolean", "description": "Set at installation only." },
					"pattern": { "type": "string" }
				}
			}
		},
		"healthcheck": {
			"type": "object",
			"required": ["type", "timeout"],
			"properties": {
				"type": { "enum": ["http", "container"] },
				"path": { "type": "string", "pattern": "^/[^ ]*$" },
				"expect": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
				"timeout": { "type": "integer", "minimum": 10, "maximum": 1800 }
			}
		},
		"dumps": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["service", "command", "file"],
				"properties": {
					"service": { "$ref": "#/$defs/service" },
					"command": { "type": "string", "minLength": 1 },
					"file": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }
				}
			},
			"description": "Commands run in a service before the nightly backup; their output is saved to data/.dumps/<file>."
		},
		"post_install": {
			"type": "string",
			"description": "Shown after the installation; may use {{url}} and {{domain}}."
		}
	},
	"$defs": {
		"size": { "type": "string", "pattern": "^[0-9]{1,7}[MG]$" },
		"service": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$" }
	}
}
