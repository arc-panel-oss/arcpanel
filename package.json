{
	"name": "arcpanel",
	"private": true,
	"version": "2.0.0",
	"description": "ArcPanel, an open-source Linux hosting control panel.",
	"repository": "https://github.com/arc-panel-oss/arcpanel",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"packageManager": "npm@11.19.1",
	"scripts": {
		"build": "node build.js",
		"lint": "prettier --cache --check . && biome lint . && markdownlint-cli2 *.md docs/**/*.md",
		"lint-staged": "lint-staged",
		"format": "prettier --cache --write .",
		"preinstall": "npx only-allow npm",
		"prepare": "husky",
		"dev": "node build.js --watch",
		"test:js": "vitest run --config web-app/vitest.config.js",
		"test:e2e": "playwright test --config test/e2e/playwright.config.js"
	},
	"dependencies": {
		"@alpinejs/collapse": "^3.17.3",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-php": "^6.0.2",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.12.4",
		"@codemirror/legacy-modes": "^6.5.4",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@lezer/highlight": "^1.2.5",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/xterm": "^6.0.0",
		"alpinejs": "^3.17.3",
		"chart.js": "^4.5.1",
		"check-password-strength": "^3.0.0",
		"codemirror": "^6.0.2",
		"floating-vue": "^5.4.0",
		"nanoid": "^6.0.1",
		"normalize.css": "^8.0.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "2.5.14",
		"@playwright/test": "^1.63.0",
		"@prettier/plugin-php": "^0.25.0",
		"@testing-library/vue": "^8.1.0",
		"@vitejs/plugin-vue": "^6.0.9",
		"browserslist": "^4.29.0",
		"esbuild": "^0.28.2",
		"husky": "^9.1.7",
		"jsdom": "^30.1.0",
		"lighthouse": "^12.8.2",
		"lightningcss": "^1.33.0",
		"lint-staged": "^17.5.1",
		"markdownlint-cli2": "^0.23.3",
		"prettier": "^3.9.8",
		"prettier-plugin-nginx": "^2.0.0",
		"prettier-plugin-sh": "^0.19.0",
		"prettier-plugin-sql": "^0.20.0",
		"vitest": "^4.1.11",
		"vue": "^3.5.43"
	},
	"browserslist": [
		"defaults"
	],
	"overrides": {
		"vite": "^6.4.3",
		"postcss": {
			"nanoid": "^6.0.1"
		}
	},
	"allowScripts": {
		"fsevents@2.3.3": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true
	}
}
