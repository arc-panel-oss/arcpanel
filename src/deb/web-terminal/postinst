#!/bin/bash

set -e

if [ "$1" != "configure" ]; then
	exit 0
fi

# The ticket key the server needs to start (E39 W2), on install and upgrade
if [ -x /usr/local/arcpanel/bin/v-add-sys-web-terminal-key ]; then
	/usr/local/arcpanel/bin/v-add-sys-web-terminal-key > /dev/null 2>&1 || true
fi

# Run triggers below only on updates
if [ ! -e "/usr/local/arcpanel/data/users/admin" ]; then
	exit
fi

###############################################################
#                Initialize functions/variables               #
###############################################################

if [ -z "$ARCPANEL" ]; then
	export ARCPANEL='/usr/local/arcpanel'
	PATH=$PATH:/usr/local/arcpanel/bin
	export PATH
fi

# Load upgrade functions and variables
source /usr/local/arcpanel/func/main.sh
source /usr/local/arcpanel/func/upgrade.sh
source /usr/local/arcpanel/conf/arcpanel.conf
source /usr/local/arcpanel/install/upgrade/upgrade.conf

# Restart arcpanel-web-terminal service if enabled
if [ -f "/etc/systemd/system/arcpanel-web-terminal.service" ]; then
	systemctl daemon-reload > /dev/null 2>&1
	if systemctl is-enabled arcpanel-web-terminal > /dev/null 2>&1; then
		systemctl restart arcpanel-web-terminal
	fi
fi
