[Unit]
Description=ArcPanel Web Terminal
Documentation=https://arcpanel.org/docs
After=network.target

[Service]
User=root
Group=arcpanel-users
Environment=NODE_ENV=production
Environment=ARCPANEL=/usr/local/arcpanel
ExecStart=/usr/local/arcpanel/web-terminal/server.js
ExecStop=/bin/kill -s TERM $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target
