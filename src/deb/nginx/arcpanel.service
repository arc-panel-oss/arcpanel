[Unit]
Description=ArcPanel (panel web server and PHP-FPM)
Documentation=https://arcpanel.org/docs
After=network-online.target remote-fs.target nss-lookup.target
Wants=network-online.target

[Service]
# Runs the panel start script (nginx and PHP-FPM of the panel). A native unit
# wins over the unit that systemd would generate from /etc/init.d/arcpanel.
Type=forking
RemainAfterExit=yes
GuessMainPID=no
KillMode=process
TimeoutSec=5min
IgnoreSIGPIPE=no
ExecStart=/etc/init.d/arcpanel start
ExecStop=/etc/init.d/arcpanel stop
ExecReload=/etc/init.d/arcpanel reload

[Install]
WantedBy=multi-user.target
