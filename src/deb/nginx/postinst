#!/bin/bash

set -e

if [ "$1" != "configure" ]; then
	exit 0
fi

# Run triggers only on updates
if [ ! -e "/usr/local/arcpanel/data/users/" ]; then
	exit
fi

# Prevent running and causes issues with outdated arcpanel version
if ! id "arcpanelweb" &> /dev/null; then
	exit
fi

# Touch and set permisions on default log files on installation
update-rc.d arcpanel defaults > /dev/null
if [ -f /lib/systemd/system/arcpanel.service ]; then
	systemctl daemon-reload > /dev/null 2>&1 || true
	systemctl enable arcpanel > /dev/null 2>&1 || true
fi
invoke-rc.d arcpanel start || true

# Adapt Port Listing in ARCPANEL NGINX Backend
source /usr/local/arcpanel/func/syshealth.sh # Load syshealth functions

# Check if the function syshealth_adapt_arcpanel_nginx_listen_ports exists
if ! declare -f syshealth_adapt_arcpanel_nginx_listen_ports > /dev/null; then
	exit
fi
syshealth_adapt_arcpanel_nginx_listen_ports # Adapt port listing
syshealth_adapt_nginx_resolver

# Content-Security-Policy and HSTS files of the panel (E39 W5)
if [ -x /usr/local/arcpanel/bin/v-update-sys-panel-headers ]; then
	/usr/local/arcpanel/bin/v-update-sys-panel-headers > /dev/null 2>&1 || true
fi

###############################################################
#                Initialize functions/variables               #
###############################################################

if [ -z "$ARCPANEL" ]; then
	export ARCPANEL='/usr/local/arcpanel'
	PATH=$PATH:/usr/local/arcpanel/bin
	export PATH
fi

# Check if preinstall hook exists
if [ -e "/etc/arcpanel/hooks/nginx/pre_install.sh" ]; then
	/etc/arcpanel/hooks/nginx/pre_install.sh
fi

# Load upgrade functions and variables
source /usr/local/arcpanel/func/main.sh
source /usr/local/arcpanel/func/upgrade.sh
source /usr/local/arcpanel/conf/arcpanel.conf
source /usr/local/arcpanel/install/upgrade/upgrade.conf

# Reset backend port
if [ -n "$BACKEND_PORT" ]; then
	/usr/local/arcpanel/bin/v-change-sys-port $BACKEND_PORT
fi

if [ -e "/etc/arcpanel/hooks/nginx/post_install.sh" ]; then
	/etc/arcpanel/hooks/nginx/post_install.sh
fi

# Restart arcpanel service
if [ -f "/etc/init.d/arcpanel" ]; then
	systemctl restart arcpanel > /dev/null 2>&1
fi
