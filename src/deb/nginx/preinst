#!/bin/bash

# Run triggers only on updates
if [ ! -e "/usr/local/arcpanel/data/users/admin" ]; then
	exit
fi

# Create a new Backup folder
ARCPANEL_BACKUP="/root/arcpanel_nginx_backups/$(date +%d%m%Y%H%M)"
mkdir -p "$ARCPANEL_BACKUP"

# Create a backup of the current configuration
cp -r /usr/local/arcpanel/nginx/conf/nginx.conf $ARCPANEL_BACKUP/nginx.conf

exit
