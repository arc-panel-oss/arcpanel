#!/bin/bash

set -e

if [ "$1" != "configure" ]; then
	exit 0
fi

# Run triggers below only on updates
if [ ! -e "/usr/local/arcpanel/data/users/" ]; then
	exit
fi

# Prevent running and causes issues with outdated arcpanel version
if ! id "arcpanelweb" &> /dev/null; then
	exit
fi

# Check if preinstall hook exists
if [ -e "/etc/arcpanel/hooks/php/pre_install.sh" ]; then
	/etc/arcpanel/hooks/php/pre_install.sh
fi

###############################################################
#                Initialize functions/variables               #
###############################################################

if [ -z "$ARCPANEL" ]; then
	export ARCPANEL='/usr/local/arcpanel'
	PATH=$PATH:/usr/local/arcpanel/bin
	export PATH
fi

# Load upgrade functions and variables
source /usr/local/arcpanel/func/main.sh
source /usr/local/arcpanel/func/upgrade.sh
source /usr/local/arcpanel/conf/arcpanel.conf
source /usr/local/arcpanel/install/upgrade/upgrade.conf

# Restart arcpanel service
if [ -f "/etc/init.d/arcpanel" ]; then
	systemctl restart arcpanel > /dev/null 2>&1
fi

# Check if preinstall hook exists
if [ -e "/etc/arcpanel/hooks/php/post_install.sh" ]; then
	/etc/arcpanel/hooks/php/post_install.sh
fi
